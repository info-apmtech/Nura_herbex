@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject BrowserInterop Browser
@inject CartState Cart
@inject AuthState Auth
@inject ContentState Content

@* Port of App.jsx AppContent shell (storefront variant): ambient orbs, sticky header, routed main, footer, cart drawer, modals. *@
<div class="min-h-screen @(IsStorefront ? "bg-white text-gray-900" : (IsLightAccountPage ? "account-page-shell" : "bg-[#07050b] text-slate-100")) flex flex-col selection:bg-purple-600 selection:text-white relative">
    @if (!IsStorefront)
    {
        <div class="scroll-progress-bar"></div>
    }

    @if (!IsLightAccountPage && !IsStorefront)
    {
        <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-[1400px] h-full pointer-events-none z-0 opacity-40 overflow-hidden">
            <div class="floating-orb w-[650px] h-[650px] bg-purple-700/20 top-[10%] -left-[10%]" style="transform: translate3d(0, calc(var(--scroll-y, 0px) * -0.08), 0)"></div>
            <div class="floating-orb w-[750px] h-[750px] bg-indigo-700/15 top-[40%] -right-[15%]" style="transform: translate3d(0, calc(var(--scroll-y, 0px) * -0.12), 0)"></div>
            <div class="floating-orb w-[600px] h-[600px] bg-purple-900/20 top-[75%] -left-[5%]" style="transform: translate3d(0, calc(var(--scroll-y, 0px) * -0.06), 0)"></div>
        </div>
    }

    @if (!IsStorefront)
    {
        <Header />
    }

    <main class="flex-1 relative z-10" id="main-content">
        @if (_contentReady) { @Body }
    </main>

    @if (!IsAccountPage && !IsStorefront)
    {
        <CinematicFooter />
    }

    <CartDrawer />
    <Modals />
    <BackToTop />
    <StamixAssistant />
</div>

@code {
    private bool IsHome
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path.Length == 0;
        }
    }

    private bool IsStorefrontCatalog
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path is "/shop" or "/store" or "/products" or "/product" or "/products/stamix" or "/product/stamix" or "/shop/stamix"
                || path.StartsWith("/catalog/", StringComparison.Ordinal);
        }
    }

    // The signed-out sign-in / register screen shares the light storefront shell (own navbar + footer).
    private bool IsCheckout => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals("/checkout", StringComparison.OrdinalIgnoreCase);

    private bool IsPolicyPage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path is "/terms" or "/terms-and-conditions" or "/privacy" or "/privacy-policy" or "/shipping-policy" or "/shipping"
                or "/refund-policy" or "/refunds" or "/returns" or "/disclaimer"
                or "/track" or "/track-order" or "/formulation" or "/ingredients" or "/the-formula";
        }
    }

    // Pages that bring their own navbar and footer (the current navigation) instead of the legacy header.
    private bool IsStandalonePage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path is "/our-story" or "/about" or "/verify" or "/verify-product" or "/verify-batch"
                || path.StartsWith("/quality-reports", StringComparison.Ordinal) || path.StartsWith("/trust-passport", StringComparison.Ordinal);
        }
    }

    private bool IsStorefront => IsHome || IsStorefrontCatalog || IsCheckout || IsPolicyPage || IsAccountPage || IsStandalonePage;

    private bool IsAccountPage
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path is "/account" or "/my-account" or "/profile" || path.StartsWith("/account/", StringComparison.Ordinal);
        }
    }

    private bool _contentReady;

    private bool IsLightAccountPage => IsAccountPage && Auth.IsAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        Cart.Changed += Refresh;
        Auth.Changed += Refresh;
        Content.Changed += Refresh;
        await Task.WhenAll(Cart.InitAsync(), Auth.InitAsync(), Content.InitAsync());
        _contentReady = true; // pages read admin-edited copy and media, so wait for it once to avoid a flash of the defaults
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.InitScrollEffectsAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Same behaviour as App.jsx navigate(): jump to top on page change, unless targeting a #section.
        if (!new Uri(e.Location).Fragment.StartsWith('#') || new Uri(e.Location).Fragment.Length <= 1)
            await Browser.ScrollToTopAsync();
        else
            await Browser.ScrollToIdAsync(new Uri(e.Location).Fragment.TrimStart('#'));
        await InvokeAsync(StateHasChanged);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Cart.Changed -= Refresh;
        Auth.Changed -= Refresh;
        Content.Changed -= Refresh;
    }
}
