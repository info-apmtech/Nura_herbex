@using Nuraherbex.UI.Components.Account
@using Nuraherbex.UI.Components.Home
@inject AuthState Auth
@inject NavigationManager Nav
@inject ModalState Modal
@implements IDisposable

<div class="nh-storefront au-page">
    <HomeNavbar />

    <main class="au-main">
        <span class="au-blob b1" aria-hidden="true"></span>
        <span class="au-blob b2" aria-hidden="true"></span>

        <div class="au-card">

            @* ============ LEFT · BRAND PANEL ============ *@
            <aside class="au-brand">
                <span class="au-brand-glow" aria-hidden="true"></span>
                <div class="au-brand-top">
                    <span class="au-eyebrow"><i></i> MEMBERS PORTAL</span>
                    <h2>Your ritual,<br /><em>your records.</em></h2>
                    <p>One secure account for orders, live shipment tracking and everything Nura Herbex.</p>
                </div>

                <div class="au-jar" aria-hidden="true">
                    <span class="au-jar-ring"></span>
                    <img src="_content/Nuraherbex.UI/images/product-2.png" alt="" />
                </div>

                <ul class="au-perks">
                    <li><span><Icon Name="ShieldCheck" Size="18" /></span><div><strong>Secure member access</strong><small>Encrypted sessions on any device</small></div></li>
                    <li><span><Icon Name="Truck" Size="18" /></span><div><strong>Track every shipment</strong><small>Live dispatch and delivery updates</small></div></li>
                    <li><span><Icon Name="Package" Size="18" /></span><div><strong>Manage your ritual</strong><small>Reorder and review past orders</small></div></li>
                </ul>
            </aside>

            @* ============ RIGHT · AUTH PANEL ============ *@
            <section class="au-panel" aria-labelledby="au-title">

                <div class="au-switch" role="tablist" aria-label="Choose sign in or create account">
                    <button type="button" role="tab" aria-selected="@(_authMode == "login")" class="@(_authMode == "login" ? "on" : "")" @onclick="@(() => SetMode("login"))">Sign in</button>
                    <button type="button" role="tab" aria-selected="@(_authMode == "register")" class="@(_authMode == "register" ? "on" : "")" @onclick="@(() => SetMode("register"))">Create account</button>
                </div>

                <header class="au-head">
                    <span class="au-kicker">@(_authMode == "login" ? "SECURE ACCESS" : "JOIN THE CLUB")</span>
                    <h1 id="au-title">@(_authMode == "login" ? "Welcome back" : "Create your account")</h1>
                    <p>
                        @(_authMode == "login"
                            ? "Sign in to view orders, track shipments and manage your membership."
                            : "Join the Nura Herbex community in a few seconds — it's free.")
                    </p>
                </header>

                @if (!string.IsNullOrEmpty(_authError))
                {
                    <div class="au-alert err" role="alert"><Icon Name="AlertCircle" Size="16" /><span>@_authError</span></div>
                }
                @if (!string.IsNullOrEmpty(_authSuccess))
                {
                    <div class="au-alert ok" role="status"><Icon Name="CheckCircle2" Size="16" /><span>@_authSuccess</span></div>
                }

                @if (_authMode == "login")
                {
                    <div class="au-method" role="tablist" aria-label="Sign-in method">
                        <button type="button" class="@(_loginMethod == "password" ? "on" : "")" @onclick="@(() => SetMethod("password"))">Password</button>
                        <button type="button" class="@(_loginMethod == "otp" ? "on" : "")" @onclick="@(() => SetMethod("otp"))">Email OTP</button>
                    </div>

                    @if (_loginMethod == "password")
                    {
                        <form @onsubmit="HandleLoginSubmit" @onsubmit:preventDefault class="au-form">
                            <label class="au-field">
                                <span>Email or mobile</span>
                                <div><Icon Name="User" Size="17" />
                                    <input type="text" required autocomplete="username" placeholder="name@@example.com or 9876543210" @bind="_emailOrPhone" @bind:event="oninput" /></div>
                            </label>
                            <label class="au-field">
                                <span>Password</span>
                                <div><Icon Name="KeyRound" Size="17" />
                                    <input type="@(_showPassword ? "text" : "password")" required autocomplete="current-password" placeholder="Enter your account password" @bind="_password" @bind:event="oninput" />
                                    <button type="button" class="au-eye" @onclick="() => _showPassword = !_showPassword" aria-label="@(_showPassword ? "Hide password" : "Show password")"><Icon Name="@(_showPassword ? "EyeOff" : "Eye")" Size="17" /></button></div>
                            </label>
                            <button type="submit" class="au-cta" disabled="@_authLoading">
                                @if (_authLoading) { <Icon Name="RefreshCw" Size="16" Class="animate-spin" /> <span>Signing you in...</span> }
                                else { <span>Sign in</span> <Icon Name="ArrowRight" Size="16" /> }
                            </button>
                        </form>
                    }
                    else if (!_otpSent)
                    {
                        <form @onsubmit="HandleSendOtp" @onsubmit:preventDefault class="au-form">
                            <label class="au-field">
                                <span>Registered email</span>
                                <div><Icon Name="Mail" Size="17" />
                                    <input type="email" required autocomplete="email" inputmode="email" placeholder="name@@example.com" value="@OtpEmailDisplay" @oninput="OnOtpEmailInput" /></div>
                                <small>We'll email a 6-digit one-time code — no password needed.</small>
                            </label>
                            <button type="submit" class="au-cta" disabled="@_authLoading">
                                @if (_authLoading) { <Icon Name="RefreshCw" Size="16" Class="animate-spin" /> <span>Sending code...</span> }
                                else { <Icon Name="Mail" Size="16" /> <span>Send me a code</span> }
                            </button>
                        </form>
                    }
                    else
                    {
                        <form @onsubmit="HandleVerifyOtp" @onsubmit:preventDefault class="au-form">
                            <div class="au-sent">
                                <span><Icon Name="Mail" Size="15" /> Code sent to <strong>@_otpEmail</strong></span>
                                <button type="button" @onclick="EditOtpEmail">Edit</button>
                            </div>
                            <label class="au-field">
                                <span>6-digit code</span>
                                <input type="text" class="au-otp" required maxlength="6" inputmode="numeric" placeholder="000000" value="@_otpCode" @oninput="OnOtpInput" />
                            </label>
                            <button type="submit" class="au-cta" disabled="@_authLoading">
                                @if (_authLoading) { <Icon Name="RefreshCw" Size="16" Class="animate-spin" /> <span>Verifying...</span> }
                                else { <Icon Name="CheckCircle2" Size="16" /> <span>Verify &amp; sign in</span> }
                            </button>
                            <div class="au-resend">
                                @if (_otpCountdown > 0) { <span>Resend code in @(_otpCountdown)s</span> }
                                else { <button type="button" @onclick="HandleSendOtp">Resend code</button> }
                            </div>
                        </form>
                    }

                    <p class="au-switch-line">Don't have an account yet? <button type="button" @onclick="@(() => { _authMode = "register"; _authError = ""; })">Create one</button></p>
                }
                else
                {
                    <form @onsubmit="HandleRegisterSubmit" @onsubmit:preventDefault class="au-form">
                        <label class="au-field">
                            <span>Full name</span>
                            <div><Icon Name="User" Size="17" />
                                <input type="text" required autocomplete="name" placeholder="e.g. Siddharth Rao" @bind="_regFullName" @bind:event="oninput" /></div>
                        </label>

                        <div class="au-two">
                            <label class="au-field">
                                <span>Email</span>
                                <div><Icon Name="Mail" Size="17" />
                                    <input type="email" required autocomplete="email" inputmode="email" placeholder="name@@example.com" @bind="_regEmail" @bind:event="oninput" /></div>
                            </label>
                            <label class="au-field">
                                <span>Phone</span>
                                <div><Icon Name="Phone" Size="17" />
                                    <input type="tel" required autocomplete="tel" inputmode="tel" placeholder="10-digit number" @bind="_regPhone" @bind:event="oninput" /></div>
                            </label>
                        </div>

                        <label class="au-field">
                            <span>Password</span>
                            <div><Icon Name="KeyRound" Size="17" />
                                <input type="@(_showPassword ? "text" : "password")" required minlength="6" autocomplete="new-password" placeholder="Create a password (min. 6 characters)" @bind="_regPassword" @bind:event="oninput" />
                                <button type="button" class="au-eye" @onclick="() => _showPassword = !_showPassword" aria-label="@(_showPassword ? "Hide password" : "Show password")"><Icon Name="@(_showPassword ? "EyeOff" : "Eye")" Size="17" /></button></div>
                            <div class="au-strength @StrengthTone">
                                <div>@for (var i = 0; i < 4; i++) { <i class="@(PwdScore > i ? "on" : "")"></i> }</div>
                                <span>@StrengthLabel</span>
                            </div>
                        </label>

                        <p class="au-note"><Icon Name="ShieldCheck" Size="15" /> Your details are encrypted and never shared with third parties.</p>

                        <button type="submit" class="au-cta" disabled="@_authLoading">
                            @if (_authLoading) { <Icon Name="RefreshCw" Size="16" Class="animate-spin" /> <span>Creating your account...</span> }
                            else { <span>Create my account</span> <Icon Name="ArrowRight" Size="16" /> }
                        </button>
                    </form>

                    <p class="au-switch-line">Already registered? <button type="button" @onclick="@(() => { _authMode = "login"; _authError = ""; })">Sign in here</button></p>
                }

                <p class="au-legal">By continuing you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
            </section>
        </div>

        <button type="button" class="au-back" @onclick="@(() => Nav.NavigateTo("/"))"><Icon Name="ArrowLeft" Size="15" /> Back to store</button>
    </main>

    <HomeFooter />
</div>

@code {
    private string _authMode = "login";
    private string _loginMethod = "password";
    private string _emailOrPhone = "";
    private string _password = "";
    private bool _showPassword;
    private string _regFullName = "", _regEmail = "", _regPhone = "", _regPassword = "";
    private bool _authLoading;
    private string _authError = "";
    private string _authSuccess = "";

    private string _otpEmail = "";
    private string _otpCode = "";
    private bool _otpSent;
    private int _otpCountdown;
    private System.Threading.CancellationTokenSource? _cts;

    private string OtpEmailDisplay =>
        !string.IsNullOrEmpty(_otpEmail) ? _otpEmail : (_emailOrPhone.Contains('@') ? _emailOrPhone : "");

    // Live password strength (presentation only — no API impact)
    private int PwdScore
    {
        get
        {
            if (string.IsNullOrEmpty(_regPassword)) return 0;
            var s = 0;
            if (_regPassword.Length >= 6) s++;
            if (_regPassword.Length >= 10) s++;
            if (_regPassword.Any(char.IsDigit) && _regPassword.Any(char.IsLetter)) s++;
            if (_regPassword.Any(char.IsUpper) && _regPassword.Any(char.IsLower)) s++;
            return Math.Min(s, 4);
        }
    }

    private string StrengthLabel => PwdScore switch
    {
        0 => "Enter a password",
        1 => "Weak",
        2 => "Fair",
        3 => "Good",
        _ => "Strong",
    };

    private string StrengthTone => PwdScore switch { 0 => "", 1 => "weak", 2 => "fair", 3 => "good", _ => "strong" };

    private void SetMode(string m) { _authMode = m; _authError = ""; _authSuccess = ""; }
    private void SetMethod(string m) { _loginMethod = m; _authError = ""; _authSuccess = ""; }

    private void OnOtpEmailInput(ChangeEventArgs e) => _otpEmail = e.Value?.ToString() ?? "";

    private void OnOtpInput(ChangeEventArgs e) =>
        _otpCode = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());

    private void EditOtpEmail() { _otpSent = false; _otpCode = ""; }

    private async Task HandleLoginSubmit()
    {
        _authError = ""; _authSuccess = ""; _authLoading = true;
        var res = await Auth.LoginAsync(_emailOrPhone, _password);
        if (!res.Success) _authError = res.Message ?? "Login failed. Please verify your credentials.";
        _authLoading = false;
    }

    private async Task HandleSendOtp()
    {
        if (string.IsNullOrWhiteSpace(_otpEmail)) _otpEmail = OtpEmailDisplay;
        if (string.IsNullOrWhiteSpace(_otpEmail))
        {
            _authError = "Please enter your email address to receive a login code";
            return;
        }
        _authError = ""; _authSuccess = ""; _authLoading = true;
        var res = await Auth.SendOtpAsync(_otpEmail);
        if (res.Success)
        {
            _otpSent = true;
            _otpCountdown = 30;
            _authSuccess = res.Message ?? $"Login code dispatched to {_otpEmail}";
            _ = RunCountdown();
        }
        else _authError = res.Message ?? "Failed to dispatch verification code";
        _authLoading = false;
    }

    private async Task RunCountdown()
    {
        _cts?.Cancel();
        _cts = new System.Threading.CancellationTokenSource();
        var ct = _cts.Token;
        try
        {
            while (_otpCountdown > 0)
            {
                await Task.Delay(1000, ct);
                _otpCountdown--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task HandleVerifyOtp()
    {
        if (string.IsNullOrWhiteSpace(_otpCode) || _otpCode.Trim().Length < 6)
        {
            _authError = "Please enter the 6-digit verification code";
            return;
        }
        _authError = ""; _authSuccess = ""; _authLoading = true;
        var res = await Auth.VerifyOtpAsync(_otpEmail, _otpCode);
        if (!res.Success) _authError = res.Message ?? "Invalid or expired code. Please try again.";
        _authLoading = false;
    }

    private async Task HandleRegisterSubmit()
    {
        _authError = ""; _authSuccess = ""; _authLoading = true;
        var res = await Auth.RegisterAsync(new RegisterRequest
        {
            FullName = _regFullName,
            Email = _regEmail,
            Phone = _regPhone,
            Password = _regPassword,
        });
        if (!res.Success) _authError = res.Message ?? "Account registration failed. Please try again.";
        _authLoading = false;
    }

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
