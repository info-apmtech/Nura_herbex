@using System.Globalization
@implements IDisposable
@inject AuthState Auth
@inject BrowserInterop Browser
@inject CartState Cart
@inject NavigationManager Nav

@if (Auth.Customer is { } customer)
{
    var customerName = string.IsNullOrWhiteSpace(customer.FullName) ? "Customer" : customer.FullName.Trim();

<div class="customer-account min-h-screen bg-[#07060b] text-slate-100 font-sans antialiased pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-left">

    @* 1. Header Profile Banner *@
    <div class="customer-account-header bg-[#0e0a1b] border border-white/10 rounded-lg p-6 shadow-xl mb-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">

            <div class="flex items-center gap-4">
                <div class="customer-account-logo-frame">
                    <img src="_content/Nuraherbex.UI/images/logo-mark.png" alt="Nura Herbex logo" />
                </div>
                <div>
                    <div class="customer-account-brandline">
                        <span class="customer-account-brand-name">Nura Herbex<span>®</span></span>
                        <span class="customer-account-brand-divider" aria-hidden="true"></span>
                        <span class="customer-account-eyebrow">VITALITY MEMBER PORTAL</span>
                    </div>
                    <h1 class="text-xl font-bold tracking-tight text-[#fff3bf]">Welcome back, @customerName</h1>

                    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 mt-1 font-mono">
                        <span>@customer.Email</span>
                        @if (!string.IsNullOrEmpty(customer.Phone))
                        {
                            <span>·</span>
                            <span>@customer.Phone</span>
                        }
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button @onclick="@(() => Nav.NavigateTo("/products/stamix"))"
                        class="px-4 py-2 rounded-md bg-[#9929ea] hover:bg-[#8620cf] text-white text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 transition-colors cursor-pointer shadow-sm">
                    <Icon Name="ShoppingBag" Size="13" />
                    <span>Shop Stamix</span>
                </button>

                <button @onclick="Logout"
                        class="px-3.5 py-2 rounded-md bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer">
                    <Icon Name="LogOut" Size="13" />
                    <span>Sign Out</span>
                </button>
            </div>

        </div>
    </div>

    @* 2. KPI Scorecards *@
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

        <div class="customer-account-stat bg-[#0e0a1b] border border-white/10 p-4 rounded-lg shadow-sm">
            <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-medium">Total Orders</span>
                <Icon Name="Package" Size="14" Class="text-purple-400" />
            </div>
            <div class="text-2xl font-bold font-mono text-white mt-1.5">@_orders.Count</div>
            <div class="text-[11px] text-slate-500 mt-0.5 font-mono">Your order history</div>
        </div>

        <div class="customer-account-stat bg-[#0e0a1b] border border-white/10 p-4 rounded-lg shadow-sm">
            <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-medium">Lifetime Spend</span>
                <Icon Name="CreditCard" Size="14" Class="text-[#fff3bf]" />
            </div>
            <div class="text-2xl font-bold font-mono text-[#fff3bf] mt-1.5">₹@Money(TotalLifetimeSpend)</div>
            <div class="text-[11px] text-emerald-400 mt-0.5 font-mono">Across your orders</div>
        </div>

        <div class="customer-account-stat bg-[#0e0a1b] border border-white/10 p-4 rounded-lg shadow-sm">
            <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-medium">Active Shipments</span>
                <Icon Name="Truck" Size="14" Class="text-[#38bdf8]" />
            </div>
            <div class="text-2xl font-bold font-mono text-white mt-1.5">@ActiveDeliveriesCount</div>
            <div class="text-[11px] text-slate-500 mt-0.5 font-mono">Currently on the way</div>
        </div>

        <a href="/quality-reports" class="customer-account-stat bg-[#0e0a1b] border border-white/10 p-4 rounded-lg shadow-sm">
            <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-medium">Product quality</span>
                <Icon Name="FileText" Size="14" Class="text-[#10b981]" />
            </div>
            <div class="text-2xl font-bold font-mono text-emerald-400 mt-1.5">Batch COA</div>
            <div class="text-[11px] text-emerald-500/80 mt-0.5 font-mono">View available lab reports</div>
        </a>

    </section>

    @* 3. Segmented Navigation Bar *@
    <nav class="customer-account-tabs" aria-label="Account sections" role="tablist">
            <button role="tab" aria-selected="@(_activeTab == "profile")" @onclick="@(() => _activeTab = "profile")"
                    class="customer-account-tab @(_activeTab == "profile" ? "is-active" : "")">
                <Icon Name="UserRound" Size="14" />
                <span>My profile</span>
            </button>
            <button role="tab" aria-selected="@(_activeTab == "orders")" @onclick="@(() => _activeTab = "orders")"
                    class="customer-account-tab @(_activeTab == "orders" ? "is-active" : "")">
                <Icon Name="Package" Size="14" />
                <span>Orders <span class="customer-account-tab-count">@_orders.Count</span></span>
            </button>

            <button role="tab" aria-selected="@(_activeTab == "address")" @onclick="@(() => _activeTab = "address")"
                    class="customer-account-tab @(_activeTab == "address" ? "is-active" : "")">
                <Icon Name="MapPin" Size="14" />
                <span>Delivery address</span>
            </button>

            <button role="tab" aria-selected="@(_activeTab == "reviews")" @onclick="@(() => _activeTab = "reviews")"
                    class="customer-account-tab @(_activeTab == "reviews" ? "is-active" : "")">
                <Icon Name="MessageSquare" Size="14" />
                <span>Write a review</span>
            </button>
    </nav>

    @if (_activeTab == "profile")
    {
        <div class="customer-account-profile-stack">
            <section class="customer-account-panel max-w-3xl bg-[#0e0a1b] border border-white/10 p-6 sm:p-8 rounded-lg shadow-xl">
                <div class="customer-account-panel-heading">
                    <span class="customer-account-icon"><Icon Name="UserRound" Size="18" /></span>
                    <div>
                        <h2>Your profile</h2>
                        <p>Keep your account details current for a smoother shopping and delivery experience.</p>
                    </div>
                </div>

                <div class="customer-account-photo-row">
                    <div class="customer-account-photo-avatar" aria-label="Profile photo preview">
                        @if (!string.IsNullOrWhiteSpace(customer.ProfileImageData))
                        {
                            <img src="@customer.ProfileImageData" alt="@($"{customerName} profile photo")" />
                        }
                        else
                        {
                            <span>@ProfileInitial(customerName)</span>
                        }
                    </div>
                    <div class="customer-account-photo-controls">
                        <strong>Profile photo</strong>
                        <p>Choose a JPG, PNG, or WebP image. Photos are resized before they are saved. Your current photo may appear beside an approved review.</p>
                        <div class="customer-account-photo-actions">
                            <label class="customer-account-photo-upload">
                                <Icon Name="Upload" Size="14" />
                                <span>@(_savingPhoto ? "Uploading…" : "Choose photo")</span>
                                <InputFile @key="_photoInputVersion" id="customer-profile-photo" accept="image/jpeg,image/png,image/webp" aria-label="Upload profile photo" OnChange="HandleProfilePhotoSelected" disabled="@_savingPhoto" class="customer-account-photo-input" />
                            </label>
                            @if (!string.IsNullOrWhiteSpace(customer.ProfileImageData))
                            {
                                <button type="button" class="customer-account-photo-remove" disabled="@_savingPhoto" @onclick="RemoveProfilePhotoAsync">Remove photo</button>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_profilePhotoMessage))
                        {
                            <p class="customer-account-profile-success" role="status">@_profilePhotoMessage</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_profilePhotoError))
                        {
                            <p class="customer-account-form-error" role="alert">@_profilePhotoError</p>
                        }
                    </div>
                </div>

                <form class="customer-account-form" @onsubmit="SaveProfileAsync" @onsubmit:preventDefault>
                    <div class="customer-account-form-grid">
                        <label>
                            Full name
                            <input required maxlength="200" autocomplete="name" @bind="_profileFullName" @bind:event="oninput" />
                        </label>
                        <label>
                            Email address <span>(used to sign in)</span>
                            <input type="email" required maxlength="256" autocomplete="email" @bind="_profileEmail" @bind:event="oninput" />
                        </label>
                        <label>
                            Phone number <span>(optional)</span>
                            <input type="tel" maxlength="24" autocomplete="tel" @bind="_profilePhone" @bind:event="oninput" placeholder="Your contact number" />
                        </label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_profileSavedMessage))
                    {
                        <p class="customer-account-profile-success" role="status">@_profileSavedMessage</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_profileError))
                    {
                        <p class="customer-account-form-error" role="alert">@_profileError</p>
                    }
                    <div class="customer-account-form-footer">
                        <p>Your name, email address and phone number are kept with your customer account.</p>
                        <button type="submit" disabled="@_savingProfile">
                            <Icon Name="Save" Size="15" />
                            @(_savingProfile ? "Saving…" : "Save profile")
                        </button>
                    </div>
                </form>
            </section>

            <section class="customer-account-panel max-w-3xl bg-[#0e0a1b] border border-white/10 p-6 sm:p-8 rounded-lg shadow-xl">
                <div class="customer-account-panel-heading">
                    <span class="customer-account-icon"><Icon Name="LockKeyhole" Size="18" /></span>
                    <div>
                        <h2>Change password</h2>
                        <p>Confirm your current password, then choose a new password with at least 8 characters.</p>
                    </div>
                </div>

                <form class="customer-account-form" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault>
                    <div class="customer-account-form-grid">
                        <label>
                            Current password
                            <input type="password" required autocomplete="current-password" @bind="_currentPassword" @bind:event="oninput" />
                        </label>
                        <label>
                            New password
                            <input type="password" required minlength="8" maxlength="72" autocomplete="new-password" @bind="_newPassword" @bind:event="oninput" />
                        </label>
                        <label>
                            Confirm new password
                            <input type="password" required minlength="8" maxlength="72" autocomplete="new-password" @bind="_confirmPassword" @bind:event="oninput" />
                        </label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_passwordSavedMessage))
                    {
                        <p class="customer-account-profile-success" role="status">@_passwordSavedMessage</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_passwordError))
                    {
                        <p class="customer-account-form-error" role="alert">@_passwordError</p>
                    }
                    <div class="customer-account-form-footer">
                        <p>For your security, your current password is required to make this change.</p>
                        <button type="submit" disabled="@_savingPassword">
                            <Icon Name="KeyRound" Size="15" />
                            @(_savingPassword ? "Updating…" : "Update password")
                        </button>
                    </div>
                </form>
            </section>
        </div>
    }
    @if (_activeTab == "orders")
    {
        <div class="space-y-6">

            @if (_loadingOrders)
            {
                <div class="bg-[#0e0a1b] border border-white/10 p-12 rounded-lg text-center text-slate-400 space-y-3">
                    <Icon Name="RefreshCw" Size="20" Class="animate-spin mx-auto text-[#9929ea]" />
                    <div class="text-sm">Loading your order history…</div>
                </div>
            }
            else if (_orders.Count == 0)
            {
                <div class="bg-[#0e0a1b] border border-white/10 p-12 sm:p-16 rounded-lg text-center space-y-4 shadow-xl">
                    <div class="w-12 h-12 rounded-full bg-black/40 border border-white/10 flex items-center justify-center mx-auto text-[#fff3bf]">
                        <Icon Name="Package" Size="22" />
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white">Your order history will appear here</h3>
                        <p class="text-sm text-slate-400 max-w-md mx-auto mt-1 leading-relaxed">
                            Explore Nura Herbex products, review product information, and place your first order.
                        </p>
                    </div>
                    <button @onclick="@(() => Nav.NavigateTo("/products/stamix"))"
                            class="px-5 py-2.5 rounded-md bg-[#9929ea] hover:bg-[#8620cf] text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer inline-flex items-center gap-1.5 shadow-sm">
                        <span>Explore Stamix</span>
                        <Icon Name="ArrowRight" Size="13" />
                    </button>
                </div>
            }
            else
            {
                <div class="space-y-4">

                    @* Filter Tabs *@
                    <div class="flex items-center gap-1 bg-black/40 p-1 rounded-md border border-white/10 max-w-fit text-xs font-semibold">
                        @foreach (var f in _filters)
                        {
                            var filter = f;
                            <button @key="filter" @onclick="@(() => _orderFilter = filter)"
                                    class="@($"px-3 py-1 rounded transition-colors cursor-pointer {(_orderFilter == filter ? "bg-[#9929ea] text-white font-bold" : "text-slate-400 hover:text-white")}")">
                                @(filter == "ALL" ? "All Orders" : filter.Replace("_", " "))
                            </button>
                        }
                    </div>

                    @* Order Cards *@
                    @foreach (var order in FilteredOrders)
                    {
                        var isDelivered = (order.DeliveryStatus ?? "").ToLowerInvariant().Contains("delivered");
                        var hasAwb = !string.IsNullOrEmpty(order.ShiprocketAwb) && !order.ShiprocketAwb.StartsWith("SR-PENDING-");
                        var items = order.Items is { Count: > 0 }
                            ? order.Items
                            : new List<OrderItemDto> { new() { Id = "stamix-single", Name = "STAMIX™ Botanical Vitality Formula", Quantity = 1, Price = order.TotalAmount > 0 ? order.TotalAmount : 1899, Image = Media.StamixMockup1 } };

                        <div @key="order.Id" class="customer-account-order bg-[#0e0a1b] rounded-lg border border-white/10 shadow-xl overflow-hidden">
                            @* Header Bar *@
                            <div class="p-4 bg-black/40 border-b border-white/10 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
                                <div class="flex items-center gap-4 flex-wrap">
                                    <div>
                                        <span class="text-[10px] text-slate-500 uppercase block font-bold">ORDER ID</span>
                                        <span class="font-bold text-white text-sm">#@order.Id</span>
                                    </div>

                                    <div class="h-6 w-px bg-white/10 hidden sm:block"></div>

                                    <div>
                                        <span class="text-[10px] text-slate-500 uppercase block font-bold">DATE</span>
                                        <span class="text-slate-300">
                                            @(order.CreatedAt != default ? order.CreatedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture) : "Recent")
                                        </span>
                                    </div>

                                    <div class="h-6 w-px bg-white/10 hidden sm:block"></div>

                                    <div>
                                        <span class="text-[10px] text-slate-500 uppercase block font-bold">AMOUNT</span>
                                        <span class="font-bold text-[#fff3bf] text-sm">₹@Money(order.TotalAmount)</span>
                                    </div>

                                    <div class="h-6 w-px bg-white/10 hidden sm:block"></div>

                                    <div>
                                        <span class="text-[10px] text-slate-500 uppercase block font-bold">PAYMENT</span>
                                        <span class="@($"inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold {(order.PaymentMethod == "COD" ? "bg-amber-950/60 text-amber-300 border border-amber-500/30" : "bg-emerald-950/60 text-emerald-300 border border-emerald-500/30")}")">
                                            @(order.PaymentMethod == "COD" ? "Cash on Delivery" : "Prepaid Online")
                                        </span>
                                    </div>
                                </div>

                                @* Delivery Status Badge *@
                                <span class="@($"inline-flex items-center px-2.5 py-1 rounded text-xs font-bold tracking-wider uppercase font-mono {(isDelivered ? "bg-emerald-950/70 text-emerald-300 border border-emerald-500/30" : "bg-purple-950/70 text-purple-300 border border-purple-500/30")}")">
                                    @(string.IsNullOrEmpty(order.DeliveryStatus) ? "Order Confirmed" : order.DeliveryStatus)
                                </span>
                            </div>

                            @* Order Details Body *@
                            <div class="p-5 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

                                @* Products List (7 cols) *@
                                <div class="lg:col-span-7 space-y-3">
                                    <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono">ITEMS IN SHIPMENT</div>

                                    @foreach (var item in items)
                                    {
                                        var it = item;
                                        var qty = it.Quantity > 0 ? it.Quantity : 1;
                                        var unit = it.Price > 0 ? it.Price : 1899;
                                        <div class="flex items-center justify-between p-3 rounded-md bg-black/40 border border-white/5">
                                            <div class="flex items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(it.Image) ? Media.StamixMockup1 : it.Image)"
                                                     alt="@it.Name"
                                                     class="w-12 h-12 object-contain rounded bg-black/50 p-1 border border-white/10" />
                                                <div>
                                                    <div class="font-bold text-white text-xs">
                                                        @(string.IsNullOrEmpty(it.Name) ? "STAMIX™ Botanical Vitality Formula" : it.Name)
                                                    </div>
                                                    <div class="text-[11px] text-slate-400">
                                                        Qty: @qty · 300g Canister (15-Day Supply)
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="text-right font-mono">
                                                <div class="font-bold text-xs text-white">₹@Money(unit * qty)</div>
                                                <button @onclick="() => ReorderAsync(it)"
                                                        class="text-[11px] text-purple-400 hover:text-purple-300 hover:underline font-bold cursor-pointer">
                                                    Reorder
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    @* Batch quality report link *@
                                    <div class="pt-1">
                                        <button @onclick="@(() => Nav.NavigateTo("/quality-reports"))"
                                                class="w-full py-2 px-3 rounded-md bg-purple-950/30 hover:bg-purple-950/50 border border-purple-500/30 text-purple-200 text-xs font-semibold flex items-center justify-between transition-colors cursor-pointer">
                                            <div class="flex items-center gap-2">
                                                <Icon Name="ShieldCheck" Size="14" Class="text-purple-400" />
                                                <span>View batch lab reports (COA)</span>
                                            </div>
                                            <span class="text-[11px] text-purple-400 font-mono flex items-center gap-1">
                                                View reports <Icon Name="ChevronRight" Size="13" />
                                            </span>
                                        </button>
                                    </div>
                                </div>

                                @* Shiprocket Telemetry (5 cols) *@
                                <div class="lg:col-span-5 p-4 rounded-md bg-black/40 border border-white/5 space-y-3">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="font-bold text-slate-300 uppercase tracking-wider text-[11px]">Delivery updates</span>
                                        <span class="text-purple-400 font-mono text-[11px]">
                                            @(string.IsNullOrEmpty(order.ShiprocketCourier) ? "Courier details pending" : order.ShiprocketCourier)
                                        </span>
                                    </div>

                                    @if (hasAwb)
                                    {
                                        <div class="space-y-2 text-xs">
                                            <div class="flex items-center justify-between bg-white/[0.03] p-2 rounded border border-white/5">
                                                <span class="text-slate-400 font-mono text-[11px]">AWB Tracking:</span>
                                                <span class="text-white font-mono font-bold tracking-wider">@order.ShiprocketAwb</span>
                                            </div>

                                            <a href="@(string.IsNullOrEmpty(order.ShiprocketTrackUrl) ? (order.Courier == "Shadowfax" ? "#" : $"https://shiprocket.co/tracking/{order.ShiprocketAwb}") : order.ShiprocketTrackUrl)"
                                               target="_blank" rel="noreferrer"
                                               class="customer-account-track-shipment w-full py-2 rounded-md text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 transition-colors shadow-sm">
                                                <Icon Name="Truck" Size="13" />
                                                <span>Track Shipment</span>
                                                <Icon Name="ExternalLink" Size="11" />
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-3 rounded bg-white/[0.02] border border-white/5 text-xs text-slate-400 space-y-1">
                                            <div class="flex items-center gap-1.5 font-bold text-slate-300">
                                                <Icon Name="Clock" Size="13" Class="text-amber-400" />
                                                <span>Shipment In Preparation</span>
                                            </div>
                                            <p class="text-[11px] leading-relaxed text-slate-500">
                                                Tracking details will appear here once your order has been handed to the courier.
                                            </p>
                                        </div>
                                    }

                                    @if (order.ShippingAddress is not null && !string.IsNullOrEmpty(order.ShippingAddress.AddressLine1))
                                    {
                                        <div class="pt-2 border-t border-white/10 text-xs space-y-0.5">
                                            <span class="text-[10px] uppercase font-bold text-slate-500 block font-mono">DELIVERY DESTINATION</span>
                                            <div class="text-slate-200 font-medium">
                                                @order.ShippingAddress.AddressLine1@(!string.IsNullOrEmpty(order.ShippingAddress.AddressLine2) ? $", {order.ShippingAddress.AddressLine2}" : "")
                                            </div>
                                            <div class="text-slate-400 text-[11px]">
                                                @order.ShippingAddress.City, @order.ShippingAddress.State - @order.ShippingAddress.Pincode
                                            </div>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>
                    }

                </div>
            }

        </div>
    }

    @if (_activeTab == "address")
    {
        <div class="customer-account-panel max-w-2xl bg-[#0e0a1b] border border-white/10 p-6 sm:p-8 rounded-lg shadow-xl space-y-5">
            <div>
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <Icon Name="MapPin" Size="16" Class="text-purple-400" />
                    <span>Delivery address</span>
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">
                    Your saved address will be available at checkout. You can update it at any time.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_addressSavedMsg))
            {
                <div class="p-3 rounded bg-emerald-950/50 border border-emerald-500/30 text-xs text-emerald-200 flex items-center gap-2">
                    <Icon Name="CheckCircle2" Size="15" Class="shrink-0 text-emerald-400" />
                    <span>@_addressSavedMsg</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(_addressError))
            {
                <div class="p-3 rounded bg-red-950/50 border border-red-500/30 flex items-start gap-2.5 text-xs text-red-200">
                    <Icon Name="AlertCircle" Size="15" Class="shrink-0 mt-0.5 text-red-400" />
                    <span>@_addressError</span>
                </div>
            }

            <form @onsubmit="HandleAddressSave" @onsubmit:preventDefault class="space-y-4 text-xs">
                <div class="space-y-1.5">
                    <label class="font-semibold text-slate-300 block">Address line 1 *</label>
                    <input type="text" required placeholder="e.g. Plot No. 79, SV Nagar"
                           @bind="_addr.AddressLine1" @bind:event="oninput"
                           class="w-full px-3 py-2.5 rounded-md border border-white/15 bg-black/40 text-white outline-none focus:border-[#9929ea] focus:ring-1 focus:ring-[#9929ea] transition-all placeholder:text-slate-600" />
                </div>

                <div class="space-y-1.5">
                    <label class="font-semibold text-slate-300 block">Address line 2 (optional)</label>
                    <input type="text" placeholder="e.g. Near Bus Stand, 2nd Floor"
                           @bind="_addr.AddressLine2" @bind:event="oninput"
                           class="w-full px-3 py-2.5 rounded-md border border-white/15 bg-black/40 text-white outline-none focus:border-[#9929ea] focus:ring-1 focus:ring-[#9929ea] transition-all placeholder:text-slate-600" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <label class="font-semibold text-slate-300 block">City *</label>
                        <input type="text" required placeholder="e.g. Chennai"
                               @bind="_addr.City" @bind:event="oninput"
                               class="w-full px-3 py-2.5 rounded-md border border-white/15 bg-black/40 text-white outline-none focus:border-[#9929ea] focus:ring-1 focus:ring-[#9929ea] transition-all placeholder:text-slate-600" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-semibold text-slate-300 block">State *</label>
                        <input type="text" required placeholder="e.g. Tamil Nadu"
                               @bind="_addr.State" @bind:event="oninput"
                               class="w-full px-3 py-2.5 rounded-md border border-white/15 bg-black/40 text-white outline-none focus:border-[#9929ea] focus:ring-1 focus:ring-[#9929ea] transition-all placeholder:text-slate-600" />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="font-semibold text-slate-300 block">PIN code *</label>
                    <input type="text" required maxlength="6" placeholder="6-digit pincode"
                           value="@_addr.Pincode"
                           @oninput="OnPincodeInput"
                           class="w-full sm:w-1/2 px-3 py-2.5 rounded-md border border-white/15 bg-black/40 text-white font-mono outline-none focus:border-[#9929ea] focus:ring-1 focus:ring-[#9929ea] transition-all placeholder:text-slate-600" />
                </div>

                <div class="pt-2">
                    <button type="submit" disabled="@_savingAddress"
                            class="px-4 py-2.5 rounded-md bg-[#9929ea] hover:bg-[#8620cf] text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer disabled:opacity-50 shadow-sm">
                        @(_savingAddress ? "Saving…" : "Save address")
                    </button>
                </div>
            </form>
        </div>
    }

    @if (_activeTab == "reviews")
    {
        <section class="customer-account-panel customer-account-review max-w-3xl bg-[#0e0a1b] border border-white/10 p-6 sm:p-8 rounded-lg shadow-xl">
            <div class="customer-account-panel-heading">
                <span class="customer-account-icon"><Icon Name="MessageSquare" Size="18" /></span>
                <div>
                    <h2>Share your experience</h2>
                    <p>Your feedback is reviewed by our team before it can appear on the product page or home page.</p>
                </div>
            </div>

            @if (_reviewSubmitted)
            {
                <div class="customer-account-review-success" role="status">
                    <Icon Name="CheckCircle2" Size="22" />
                    <div>
                        <strong>Review submitted</strong>
                        <p>Thank you for sharing your experience. It is pending review and will only be published if approved.</p>
                    </div>
                </div>
            }
            else
            {
                <form class="customer-account-form" @onsubmit="SubmitReviewAsync" @onsubmit:preventDefault>
                    <div class="customer-account-form-grid">
                        <div class="customer-account-review-identity">
                            <span>Review submitted under your account</span>
                            <strong>@customer.FullName</strong>
                            <small>Your account name may be shown with the review if it is approved.</small>
                        </div>
                        <label>
                            City <span>(optional)</span>
                            <input maxlength="100" @bind="_reviewCity" @bind:event="oninput" autocomplete="address-level2" />
                        </label>
                        <label>
                            Rating
                            <select @bind="_reviewRating">
                                <option value="5">5 — Excellent</option>
                                <option value="4">4 — Very good</option>
                                <option value="3">3 — Good</option>
                                <option value="2">2 — Fair</option>
                                <option value="1">1 — Needs improvement</option>
                            </select>
                        </label>
                        <label>
                            Review title <span>(optional)</span>
                            <input maxlength="120" @bind="_reviewTitle" @bind:event="oninput" placeholder="Summarize your experience" />
                        </label>
                        <label class="customer-account-form-full">
                            Your review
                            <textarea required minlength="10" maxlength="1500" rows="5" @bind="_reviewBody" @bind:event="oninput" placeholder="Tell us about your experience with the product. Please keep your feedback to your personal experience and avoid medical claims or sensitive health information."></textarea>
                        </label>
                    </div>

                    <label class="customer-account-consent">
                        <input type="checkbox" @bind="_reviewConsent" />
                        <span>I agree that my display name, review, and current profile photo (if set) may be published if approved by the Nura Herbex team.</span>
                    </label>

                    @if (!string.IsNullOrWhiteSpace(_reviewError))
                    {
                        <p class="customer-account-form-error" role="alert">@_reviewError</p>
                    }

                    <div class="customer-account-form-footer">
                        <p>Reviews are not medical advice and do not replace guidance from a qualified professional.</p>
                        <button type="submit" disabled="@_submittingReview">
                            <Icon Name="Send" Size="15" />
                            @(_submittingReview ? "Submitting…" : "Submit for review")
                        </button>
                    </div>
                </form>
            }
        </section>
    }

</div>
}
else
{
    <div class="customer-account-loading min-h-screen px-4 py-16 text-center text-slate-500" role="status">Signing out…</div>
}


@code {
    private static readonly string[] _filters = { "ALL", "IN_TRANSIT", "DELIVERED", "PENDING" };

    private string _activeTab = "orders";
    private List<OrderDto> _orders = new();
    private bool _loadingOrders;
    private string _orderFilter = "ALL";

    private string _profileFullName = "";
    private string _profileEmail = "";
    private string _profilePhone = "";
    private string? _profileError, _profileSavedMessage;
    private string? _profilePhotoError, _profilePhotoMessage;
    private string _currentPassword = "", _newPassword = "", _confirmPassword = "";
    private string? _passwordError, _passwordSavedMessage;
    private bool _savingProfile, _savingPhoto, _savingPassword;
    private int _photoInputVersion;
    private AddressDto _addr = new();
    private bool _savingAddress;
    private string _addressSavedMsg = "";
    private string _addressError = "";
    private string? _loadedForCustomerId;
    private string _reviewCity = "";
    private string _reviewTitle = "";
    private string _reviewBody = "";
    private int _reviewRating = 5;
    private bool _reviewConsent;
    private bool _submittingReview;
    private bool _reviewSubmitted;
    private string _reviewError = "";

    private static readonly CultureInfo Inr = MakeInr();
    private static CultureInfo MakeInr()
    {
        try { return CultureInfo.GetCultureInfo("en-IN"); } catch { return CultureInfo.InvariantCulture; }
    }
    private static string Money(decimal v) => v.ToString("#,##0.##", Inr);

    private decimal TotalLifetimeSpend => _orders.Sum(o => o.TotalAmount);

    private int ActiveDeliveriesCount => _orders.Count(o =>
    {
        var s = (o.DeliveryStatus ?? "").ToLowerInvariant();
        return s.Contains("transit") || s.Contains("shipped") || s.Contains("processing") || s.Contains("created");
    });

    private IEnumerable<OrderDto> FilteredOrders => _orders.Where(o =>
    {
        if (_orderFilter == "ALL") return true;
        var s = (o.DeliveryStatus ?? "").ToUpperInvariant();
        return _orderFilter switch
        {
            "DELIVERED" => s.Contains("DELIVERED"),
            "IN_TRANSIT" => s.Contains("TRANSIT") || s.Contains("SHIPPED"),
            "PENDING" => s.Contains("CONFIRMED") || s.Contains("PROCESSING") || s.Contains("CREATED"),
            _ => true,
        };
    });

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        _profileFullName = Auth.Customer?.FullName ?? "";
        _profileEmail = Auth.Customer?.Email ?? "";
        _profilePhone = Auth.Customer?.Phone ?? "";
        SyncAddress();
        _reviewCity = Auth.Customer?.ShippingAddress?.City?.Trim() ?? "";
        if (new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals("/account/reviews", StringComparison.OrdinalIgnoreCase))
            _activeTab = "reviews";
        await LoadOrdersAsync();
    }

    private void OnAuthChanged() => _ = InvokeAsync(StateHasChanged);

    private void SyncAddress()
    {
        var a = Auth.Customer?.ShippingAddress;
        if (a is null) return;
        _addr = new AddressDto
        {
            AddressLine1 = a.AddressLine1 ?? "",
            AddressLine2 = a.AddressLine2 ?? "",
            City = a.City ?? "",
            State = a.State ?? "",
            Pincode = a.Pincode ?? "",
            Country = string.IsNullOrEmpty(a.Country) ? "India" : a.Country,
        };
    }

    private async Task LoadOrdersAsync()
    {
        _loadedForCustomerId = Auth.Customer?.Id;
        _loadingOrders = true;
        var res = await Api.MyOrdersAsync();
        _orders = res.Success ? res.Orders : new();
        _loadingOrders = false;
    }

    [Inject] private ApiClient Api { get; set; } = default!;

    private void OnPincodeInput(ChangeEventArgs e) =>
        _addr.Pincode = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());

    private static string ProfileInitial(string name) =>
        string.IsNullOrWhiteSpace(name) ? "N" : char.ToUpperInvariant(name.Trim()[0]).ToString();

    private async Task SaveProfileAsync()
    {
        if (_savingProfile) return;
        _savingProfile = true;
        _profileError = null;
        _profileSavedMessage = null;
        var response = await Auth.UpdateProfileAsync(new UpdateProfileRequest
        {
            FullName = _profileFullName,
            Email = _profileEmail,
            Phone = _profilePhone,
        });
        _savingProfile = false;
        if (response.Success)
            _profileSavedMessage = response.Message ?? "Your profile has been updated.";
        else
            _profileError = response.Message ?? "We could not update your profile. Please try again.";
    }

    private async Task HandleProfilePhotoSelected(InputFileChangeEventArgs args)
    {
        _profilePhotoError = null;
        _profilePhotoMessage = null;
        if (args.File.Size > 8 * 1024 * 1024)
        {
            _profilePhotoError = "Choose an image smaller than 8 MB.";
            return;
        }
        if (args.File.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            _profilePhotoError = "Upload a JPG, PNG, or WebP image.";
            return;
        }

        _savingPhoto = true;
        var photo = await Browser.CompressProfilePhotoAsync("customer-profile-photo");
        if (photo is null || string.IsNullOrWhiteSpace(photo.DataUrl))
        {
            _savingPhoto = false;
            _profilePhotoError = "We could not process that photo. Choose another JPG, PNG, or WebP image.";
            return;
        }

        var response = await Auth.UpdateProfileAsync(new UpdateProfileRequest { ProfileImageData = photo.DataUrl });
        _savingPhoto = false;
        if (response.Success)
        {
            _photoInputVersion++;
            _profilePhotoMessage = "Profile photo updated.";
        }
        else
        {
            _profilePhotoError = response.Message ?? "We could not save your profile photo.";
        }
    }

    private async Task RemoveProfilePhotoAsync()
    {
        if (_savingPhoto) return;
        _savingPhoto = true;
        _profilePhotoError = null;
        _profilePhotoMessage = null;
        var response = await Auth.UpdateProfileAsync(new UpdateProfileRequest { ProfileImageData = "" });
        _savingPhoto = false;
        if (response.Success)
        {
            _photoInputVersion++;
            _profilePhotoMessage = "Profile photo removed.";
        }
        else
        {
            _profilePhotoError = response.Message ?? "We could not remove your profile photo.";
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (_savingPassword) return;
        _passwordError = null;
        _passwordSavedMessage = null;
        if (_newPassword != _confirmPassword)
        {
            _passwordError = "The new password and confirmation do not match.";
            return;
        }

        _savingPassword = true;
        var response = await Api.ChangePasswordAsync(new ChangePasswordRequest
        {
            CurrentPassword = _currentPassword,
            NewPassword = _newPassword,
        });
        _savingPassword = false;
        if (response.Success)
        {
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
            _passwordSavedMessage = response.Message ?? "Your password has been updated.";
        }
        else
        {
            _passwordError = response.Message ?? "We could not update your password. Please try again.";
        }
    }
    private async Task HandleAddressSave()
    {
        _savingAddress = true;
        _addressSavedMsg = "";
        _addressError = "";
        var res = await Auth.UpdateProfileAsync(new UpdateProfileRequest
        {
            FullName = Auth.Customer?.FullName,
            Phone = Auth.Customer?.Phone,
            ShippingAddress = _addr,
        });
        _savingAddress = false;
        if (res.Success)
        {
            _addressSavedMsg = "Default shipping destination saved successfully.";
            StateHasChanged();
            await Task.Delay(4000);
            _addressSavedMsg = "";
        }
        else _addressError = res.Message ?? "Failed to save shipping address";
    }

    private async Task SubmitReviewAsync()
    {
        if (_submittingReview) return;
        if (!Auth.IsAuthenticated)
        {
            _reviewError = "Please sign in again before submitting your review.";
            return;
        }
        if (!_reviewConsent)
        {
            _reviewError = "Please confirm the review publication consent to continue.";
            return;
        }

        _submittingReview = true;
        _reviewError = "";
        var response = await Api.SubmitReviewAsync(new ReviewDto
        {
            Name = Auth.Customer?.FullName?.Trim() ?? "",
            City = string.IsNullOrWhiteSpace(_reviewCity) ? null : _reviewCity.Trim(),
            Rating = Math.Clamp(_reviewRating, 1, 5),
            Title = string.IsNullOrWhiteSpace(_reviewTitle) ? null : _reviewTitle.Trim(),
            Body = _reviewBody.Trim(),
        });
        _submittingReview = false;
        if (response.Success) _reviewSubmitted = true;
        else _reviewError = response.Message ?? "We could not submit your review. Please try again.";
    }

    private async Task ReorderAsync(OrderItemDto item)
    {
        await Cart.AddToCartAsync(new CartItem
        {
            Id = string.IsNullOrEmpty(item.Id) ? "stamix-single" : item.Id,
            Name = string.IsNullOrEmpty(item.Name) ? "STAMIX™ Botanical Vitality Formula" : item.Name,
            Price = item.Price > 0 ? item.Price : 1899,
            Quantity = 1,
            Image = string.IsNullOrEmpty(item.Image) ? Media.StamixMockup1 : item.Image,
            ServingsText = "15-Day Canister · Expert Formulated",
        }, 1);
        Nav.NavigateTo("/checkout");
    }

    private async Task Logout() => await Auth.SignOutAsync();

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
