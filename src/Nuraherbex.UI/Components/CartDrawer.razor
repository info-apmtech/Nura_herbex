@implements IDisposable
@using System.Globalization
@inject NavigationManager Nav
@inject CartState Cart

@* Port of CartDrawer.jsx *@
@if (Cart.IsCartOpen)
{
    var subtotal = Cart.Subtotal;
    var progress = Cart.FreeShippingProgress;
    var progressPercent = (int)Math.Round(progress, MidpointRounding.AwayFromZero);
    var amountToFreeShipping = Math.Max(0m, SiteConfig.FreeShippingThreshold - subtotal);
    <div class="fixed inset-0 z-50 overflow-hidden text-left">
        @* Backdrop *@
        <div @onclick="Close" class="absolute inset-0 bg-black/80 transition-opacity"></div>

        @* Drawer Container *@
        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-[#0a0712] border-l border-white/10 shadow-2xl flex flex-col justify-between">
                @* Header *@
                <div class="p-6 border-b border-white/10 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <Icon Name="ShoppingBag" Size="20" Class="text-purple-400" />
                        <h3 class="text-lg font-bold text-white">Your Stamix Protocol</h3>
                    </div>
                    <button @onclick="Close" aria-label="Close cart"
                            class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-slate-400 hover:text-white transition-all cursor-pointer">
                        <Icon Name="X" Size="18" />
                    </button>
                </div>

                @* Show the offer only when there is something in the cart. *@
                @if (Cart.ItemCount > 0)
                {
                    <section class="px-6 py-4 bg-white/[0.02] border-b border-white/5" aria-label="Free shipping offer">
                        <div class="mb-3 flex items-center justify-between gap-4">
                            <div class="flex min-w-0 items-center gap-2.5">
                                @if (subtotal >= SiteConfig.FreeShippingThreshold)
                                {
                                    <Icon Name="CheckCircle2" Size="18" Class="shrink-0 text-emerald-400" />
                                    <div>
                                        <p class="text-xs font-semibold text-emerald-300">Free shipping unlocked</p>
                                        <p class="mt-0.5 text-[11px] text-slate-400">Your order qualifies for complimentary shipping.</p>
                                    </div>
                                }
                                else
                                {
                                    <Icon Name="Package" Size="18" Class="shrink-0 text-purple-300" />
                                    <div class="min-w-0">
                                        <p class="text-xs font-semibold text-slate-200">Complimentary shipping</p>
                                        <p class="mt-0.5 text-[11px] text-slate-400">
                                            Add <span class="font-semibold text-white">@SiteConfig.Money(amountToFreeShipping)</span> to qualify.
                                        </p>
                                    </div>
                                }
                            </div>
                            <span class="shrink-0 rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-semibold tabular-nums text-slate-300"
                                  aria-label="@progressPercent percent of the free shipping threshold reached">
                                @progressPercent%
                            </span>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/10" role="progressbar"
                             aria-label="Free shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
                            <div class="h-full rounded-full bg-gradient-to-r from-purple-500 to-indigo-500 transition-all duration-500"
                                 style="width: @(progress.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </section>
                }

                @* Items List *@
                <div class="flex-1 overflow-y-auto p-6 space-y-4">
                    @if (Cart.Items.Count == 0)
                    {
                        <div class="text-center py-16 text-slate-500">
                            <Icon Name="ShoppingBag" Size="48" Class="mx-auto mb-4 opacity-20" />
                            <p class="text-sm font-medium">Your cart is currently empty.</p>
                            <button @onclick="Close"
                                    class="mt-4 px-6 py-2 rounded-full bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold uppercase tracking-wider transition-all cursor-pointer">
                                Browse Stamix Protocols
                            </button>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Cart.Items.ToList())
                        {
                            var id = item.Id;
                            <div @key="id" class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 flex gap-4 items-center">
                                <img src="@item.Image" alt="@item.Name" class="w-16 h-16 object-contain rounded-xl bg-black/40 p-2 border border-white/5" />
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-sm font-bold text-white truncate">@item.Name</h4>
                                    <p class="text-[11px] text-purple-400 font-mono">@item.ServingsText</p>
                                    <span class="text-xs font-bold text-white mt-1 block font-mono">
                                        @SiteConfig.Currency@(item.Price.ToString("0.##", CultureInfo.InvariantCulture))
                                    </span>
                                </div>

                                @* Quantity controls *@
                                <div class="flex flex-col items-end gap-2">
                                    <button @onclick="() => Cart.RemoveItemAsync(id)" class="text-slate-500 hover:text-red-400 transition-colors p-1" aria-label="Remove item">
                                        <Icon Name="Trash2" Size="14" />
                                    </button>
                                    <div class="flex items-center rounded-lg bg-white/5 border border-white/10 p-1">
                                        <button @onclick="() => Cart.UpdateQuantityAsync(id, -1)" class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-white" aria-label="Decrease quantity">
                                            <Icon Name="Minus" Size="12" />
                                        </button>
                                        <span class="text-xs font-mono font-bold px-2 text-white">@item.Quantity</span>
                                        <button @onclick="() => Cart.UpdateQuantityAsync(id, 1)" class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-white" aria-label="Increase quantity">
                                            <Icon Name="Plus" Size="12" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* Footer Checkout Area *@
                @if (Cart.Items.Count > 0)
                {
                    <div class="p-6 border-t border-white/10 bg-[#08050e] space-y-4">
                        <div class="space-y-1.5 text-xs text-slate-400">
                            <div class="flex justify-between">
                                <span>Subtotal</span>
                                <span class="font-mono text-white font-bold text-sm">
                                    @SiteConfig.Currency@(subtotal.ToString("F2", CultureInfo.InvariantCulture))
                                </span>
                            </div>
                            <div class="flex justify-between">
                                <span>Shipping</span>
                                <span class="@(subtotal >= SiteConfig.FreeShippingThreshold ? "text-emerald-400 font-bold" : "text-slate-300 font-medium")">
                                    @(subtotal >= SiteConfig.FreeShippingThreshold ? "FREE" : "Calculated at checkout")
                                </span>
                            </div>
                        </div>

                        @* Checkout Button (routes to /checkout) *@
                        <button @onclick="Checkout"
                                class="w-full py-4 rounded-2xl bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white font-bold text-sm uppercase tracking-wider shadow-xl shadow-purple-600/30 flex items-center justify-center gap-2 hover:scale-[1.02] transition-all cursor-pointer">
                            <span>Proceed To Secure Checkout</span>
                            <Icon Name="ArrowRight" Size="16" />
                        </button>

                        <div class="flex items-center justify-center gap-2 text-[11px] text-slate-500">
                            <Icon Name="ShieldCheck" Size="14" Class="text-emerald-400" />
                            <span>SSL Encrypted Checkout Powered by Stripe / Razorpay</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Cart.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Close() => Cart.SetOpen(false);

    private void Checkout()
    {
        Cart.SetOpen(false);
        Nav.NavigateTo("/checkout");
    }

    public void Dispose() => Cart.Changed -= OnChanged;
}
