@implements IDisposable
@using System.Globalization
@inject NavigationManager Nav
@inject CartState Cart

@if (Cart.IsCartOpen)
{
    var subtotal = Cart.Subtotal;
    var progress = Cart.FreeShippingProgress;
    var progressPercent = (int)Math.Round(progress, MidpointRounding.AwayFromZero);
    var amountToFreeShipping = Math.Max(0m, SiteConfig.FreeShippingThreshold - subtotal);
    var unlocked = subtotal >= SiteConfig.FreeShippingThreshold;

    <div class="cd" role="dialog" aria-modal="true" aria-label="Shopping cart">
        <div @onclick="Close" class="cd-backdrop"></div>

        <aside class="cd-panel">
            <header class="cd-head">
                <div>
                    <span class="cd-eyebrow">Your bag</span>
                    <h3>Shopping cart <small>@Cart.ItemCount @(Cart.ItemCount == 1 ? "item" : "items")</small></h3>
                </div>
                <button @onclick="Close" aria-label="Close cart" class="cd-close"><Icon Name="X" Size="18" /></button>
            </header>

            @if (Cart.ItemCount > 0)
            {
                <section class="cd-ship" aria-label="Free shipping offer">
                    <div class="cd-ship-row">
                        <span class="cd-ship-ico @(unlocked ? "is-done" : "")"><Icon Name="@(unlocked ? "CheckCircle2" : "Truck")" Size="17" /></span>
                        <p>
                            @if (unlocked) { <strong>Free shipping unlocked.</strong> <span>Your order ships on us.</span> }
                            else { <strong>Add @SiteConfig.Money(amountToFreeShipping) for free shipping</strong> }
                        </p>
                        <b>@progressPercent%</b>
                    </div>
                    <div class="cd-bar" role="progressbar" aria-label="Free shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
                        <i style="width: @(progress.ToString("0.##", CultureInfo.InvariantCulture))%"></i>
                    </div>
                </section>
            }

            <div class="cd-items">
                @if (Cart.Items.Count == 0)
                {
                    <div class="cd-empty">
                        <span><Icon Name="ShoppingBag" Size="34" /></span>
                        <h4>Your cart is empty</h4>
                        <p>Add a Stamix protocol to begin your daily ritual.</p>
                        <button @onclick="BrowseProducts" class="cd-btn cd-btn-gold">Browse products <Icon Name="ArrowRight" Size="15" /></button>
                    </div>
                }
                else
                {
                    @foreach (var item in Cart.Items.ToList())
                    {
                        var id = item.Id;
                        <article @key="id" class="cd-item">
                            <div class="cd-item-img"><img src="@item.Image" alt="@item.Name" /></div>
                            <div class="cd-item-info">
                                <div class="cd-item-top">
                                    <h4>@item.Name</h4>
                                    <button @onclick="() => Cart.RemoveItemAsync(id)" class="cd-remove" aria-label="Remove @item.Name"><Icon Name="Trash2" Size="15" /></button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.ServingsText)) { <p>@item.ServingsText</p> }
                                <div class="cd-item-bottom">
                                    <div class="cd-qty">
                                        <button @onclick="() => Cart.UpdateQuantityAsync(id, -1)" aria-label="Decrease quantity"><Icon Name="Minus" Size="13" /></button>
                                        <span>@item.Quantity</span>
                                        <button @onclick="() => Cart.UpdateQuantityAsync(id, 1)" aria-label="Increase quantity"><Icon Name="Plus" Size="13" /></button>
                                    </div>
                                    <strong>@SiteConfig.Money(item.Price * item.Quantity)</strong>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>

            @if (Cart.Items.Count > 0)
            {
                <footer class="cd-foot">
                    <dl>
                        <div><dt>Subtotal</dt><dd>@SiteConfig.Money(subtotal)</dd></div>
                        <div><dt>Shipping</dt><dd class="@(unlocked ? "is-free" : "")">@(unlocked ? "Free" : "Calculated at checkout")</dd></div>
                    </dl>
                    <button @onclick="Checkout" class="cd-btn cd-btn-gold cd-btn-block">Proceed to secure checkout <Icon Name="ArrowRight" Size="16" /></button>
                    <button @onclick="Close" class="cd-btn cd-btn-text">Continue shopping</button>
                    <p class="cd-secure"><Icon Name="ShieldCheck" Size="14" /> Secure, encrypted checkout</p>
                </footer>
            }
        </aside>
    </div>
}

@code {
    protected override void OnInitialized() => Cart.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void Close() => Cart.SetOpen(false);

    private void BrowseProducts()
    {
        Cart.SetOpen(false);
        Nav.NavigateTo("/shop");
    }

    private void Checkout()
    {
        Cart.SetOpen(false);
        Nav.NavigateTo("/checkout");
    }

    public void Dispose() => Cart.Changed -= OnChanged;
}
