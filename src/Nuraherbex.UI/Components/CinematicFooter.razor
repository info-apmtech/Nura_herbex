@inject NavigationManager Nav
@inject BrowserInterop Browser
@inject CartState Cart
@inject ModalState Modal


<footer class="nf" id="site-footer">

  @* Closing call to action *@
  <div class="nf-cta">
    <div class="nf-wrap nf-cta-inner">
      <div>
        <span class="nf-eyebrow">Begin your ritual</span>
        <h2>Strength, rooted in <em>nature.</em></h2>
        <p>Seventeen botanicals. One daily scoop. Backed by our empty-jar guarantee.</p>
      </div>
      <div class="nf-cta-actions">
        <button class="nf-btn nf-btn-gold" @onclick='() => GoPage("/shop")'>Shop Stamix <Icon Name="ArrowRight" Size="16" /></button>
        <button class="nf-btn nf-btn-line" @onclick='() => GoPage("/formulation")'>See the formulation</button>
      </div>
    </div>
  </div>

  @* Assurances *@
  <div class="nf-assure">
    <div class="nf-wrap nf-assure-grid">
      <div><Icon Name="ShieldCheck" Size="20" /><span>GMP certified facility</span></div>
      <div><Icon Name="Leaf" Size="20" /><span>100% botanical, no fillers</span></div>
      <div><Icon Name="Truck" Size="20" /><span>Free shipping on qualifying orders</span></div>
      <div><Icon Name="Award" Size="20" /><span>Batch-verified quality</span></div>
    </div>
  </div>

  @* Main columns *@
  <div class="nf-main">
    <div class="nf-wrap nf-grid">

      <div class="nf-brand">
        <button class="nf-logo" @onclick='() => GoPage("/")' aria-label="Nura Herbex home">
          <img src="_content/Nuraherbex.UI/images/logo-mark.png" alt="" />
          <span>Nura Herbex</span>
        </button>
        <p>A botanical vitality formula for men, made with 17 herbs, seeds and nuts, and designed to support everyday energy, stamina and recovery.</p>
        <div class="nf-social">
          <a href="https://instagram.com" target="_blank" rel="noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" /></svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z" /></svg>
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.91 0-1.64.73-1.64 1.64s.73 1.64 1.64 1.64 1.64-.73 1.64-1.64-.73-1.64-1.64-1.64Z" /></svg>
          </a>
        </div>
      </div>

      <div class="nf-col">
        <h3>Shop</h3>
        <button @onclick='() => GoPage("/shop")'>All products</button>
        <button @onclick='() => GoSection("products")'>Bestsellers</button>
        <button @onclick="() => Cart.SetOpen(true)">Shopping cart</button>
        <button @onclick='() => GoPage("/account")'>My account</button>
      </div>

      <div class="nf-col">
        <h3>Discover</h3>
        <button @onclick='() => GoSection("formula")'>Ingredient matrix</button>
        <button @onclick='() => GoPage("/formulation")'>Full formulation</button>
        <button @onclick='() => GoSection("how-to-use")'>Daily ritual</button>
        <button @onclick='() => GoSection("testimonials")'>Customer reviews</button>
      </div>

      <div class="nf-col">
        <h3>Support</h3>
        <button @onclick='() => GoPage("/track")'>Track your order</button>
        <button @onclick='() => GoPage("/quality-reports")'>Quality &amp; testing</button>
        <button @onclick='() => Modal.Open("terms")'>Empty-jar guarantee</button>
        <a href="mailto:care@nuraherbex.com">care@@nuraherbex.com</a>
      </div>

    </div>
  </div>

  @* Legal bar *@
  <div class="nf-legal">
    <div class="nf-wrap nf-legal-inner">
      <span>© 2026 Nura Herbex. All rights reserved.</span>
      <span class="nf-note">These statements have not been evaluated by any regulatory authority. This product is not intended to diagnose, treat, cure or prevent any disease.</span>
      <div>
        <button @onclick='() => Modal.Open("privacy")'>Privacy</button>
        <button @onclick='() => Modal.Open("terms")'>Terms</button>
        <button @onclick='() => Modal.Open("privacy")'>Cookies</button>
      </div>
    </div>
  </div>
</footer>

@code {
    private bool IsHome => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').Length == 0;

    private async Task GoSection(string id)
    {
        if (IsHome) await Browser.ScrollToIdAsync(id, 120);
        else Nav.NavigateTo("/#" + id);
    }

    private async Task GoPage(string route)
    {
        Nav.NavigateTo(route.Length == 0 ? "/" : route);
        await Browser.ScrollToTopAsync();
    }
}
