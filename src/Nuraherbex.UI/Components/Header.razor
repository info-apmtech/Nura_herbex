@implements IAsyncDisposable
@inject NavigationManager Nav
@inject BrowserInterop Browser
@inject CartState Cart
@inject AuthState Auth
@inject IJSRuntime JS


@* Sticky navbar: transparent over the home hero, frosted once the page scrolls. Inline links on desktop, drawer on mobile. *@
<header class="nv-bar @(IsLightAccountPage ? "account-page-header" : "") @(_isPastHero ? "is-solid" : "")">
    <div class="nv-inner">

        @* Brand *@
        <button @onclick="GoHome" class="nv-brand" aria-label="Nura Herbex home">
            <img src="_content/Nuraherbex.UI/images/logo-mark.png" alt="" />
            <span>Nura Herbex<sup>®</sup></span>
        </button>

        @* Primary links (desktop) *@
        <nav class="nv-links" aria-label="Primary">
            @foreach (var item in MainLinks())
            {
                <button @key="item.Label" @onclick="() => item.Action()" class="nv-link @(item.Active ? "is-active" : "")">@item.Label</button>
            }
        </nav>

        @* Actions *@
        <div class="nv-actions">
            <button @onclick='() => GoPage("/shop")' class="nv-cta">Shop now <Icon Name="ArrowRight" Size="14" /></button>

            <button @onclick='() => GoPage("/admin")' aria-label="Admin Portal" title="Admin Portal" class="nv-icon @(PathIs("/admin") || new Uri(Nav.Uri).AbsolutePath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")">
                <Icon Name="ShieldCheck" Size="18" />
            </button>

            <button @onclick="GoAccount" aria-label="Vitality Account" title="@AccountTitle" class="nv-icon @(IsAccount ? "is-active" : "")">
                <Icon Name="User" Size="18" />
                @if (Auth.IsAuthenticated) { <span class="nv-dot ring-black"></span> }
            </button>

            <button @onclick="OpenCart" aria-label="Open Cart" class="nv-icon">
                <Icon Name="ShoppingBag" Size="18" />
                @if (Cart.ItemCount > 0) { <span class="nv-count bg-[#9929ea]">@Cart.ItemCount</span> }
            </button>

            <button @onclick="OpenMenu" aria-label="Open Menu Drawer" class="nv-icon nv-burger">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

@* Drawer *@
<div @onclick="CloseMenu" class="nv-backdrop @(_isMenuOpen ? "is-open" : "")"></div>

<aside class="nv-drawer @(_isMenuOpen ? "is-open" : "")" aria-hidden="@(!_isMenuOpen)">
    <div class="nv-drawer-head">
        <span class="nv-drawer-brand"><img src="_content/Nuraherbex.UI/images/logo-mark.png" alt="" /> Nura Herbex</span>
        <button @onclick="CloseMenu" aria-label="Close Menu" class="nv-icon"><Icon Name="X" Size="18" /></button>
    </div>

    <nav class="nv-drawer-links">
        @{ var links = DrawerLinks(); }
        @for (var i = 0; i < links.Count; i++)
        {
            var item = links[i];
            var idx = i;
            <button @key="item.Label" @onclick="() => item.Action()" class="nv-drawer-link @(item.Active ? "is-active" : "")" style="transition-delay:@(_isMenuOpen ? idx * 40 : 0)ms">
                <small>0@(idx + 1)</small>
                <span>@item.Label</span>
                <Icon Name="ArrowRight" Size="18" />
            </button>
        }
    </nav>

    <div class="nv-drawer-foot">
        <button class="nv-cta nv-cta-block" @onclick='() => GoPage("/shop")'>Shop Stamix <Icon Name="ArrowRight" Size="14" /></button>
        <div class="nv-contact">
            <small>Write to us</small>
            <a href="mailto:care@nuraherbex.com">care@@nuraherbex.com</a>
        </div>
        <div class="nv-social">
            <a href="https://instagram.com" target="_blank" rel="noreferrer">Instagram <Icon Name="ArrowUpRight" Size="12" /></a>
            <a href="https://youtube.com" target="_blank" rel="noreferrer">YouTube <Icon Name="ArrowUpRight" Size="12" /></a>
            <a href="https://linkedin.com" target="_blank" rel="noreferrer">LinkedIn <Icon Name="ArrowUpRight" Size="12" /></a>
        </div>
    </div>
</aside>

@code {
    private sealed record NavItem(string Label, Action Action, bool Active = false);

    private bool _isPastHero;
    private bool _isMenuOpen;
    private bool _jsReady;
    private DotNetObjectReference<Header>? _self;

    private bool IsHome
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path.Length == 0;
        }
    }

    private bool PathIs(params string[] paths)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        return paths.Contains(path);
    }

    private bool IsAccount
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return path is "/account" or "/my-account" or "/profile" || path.StartsWith("/account/", StringComparison.Ordinal);
        }
    }

    private bool IsLightAccountPage => IsAccount && Auth.IsAuthenticated;

    private string AccountTitle => Auth.IsAuthenticated
        ? $"Account ({(string.IsNullOrEmpty(Auth.Customer?.FullName) ? "Member" : Auth.Customer!.FullName)})"
        : "Sign In / Account";

    private bool IsShop => PathIs("/shop", "/store", "/products/stamix", "/product/stamix", "/products", "/product", "/shop/stamix") || new Uri(Nav.Uri).AbsolutePath.StartsWith("/catalog/", StringComparison.OrdinalIgnoreCase);
    private bool IsQuality
    {
        get
        {
            var p = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
            return p.StartsWith("/quality-reports") || p.StartsWith("/trust-passport") || p is "/verify" or "/verify-product" or "/verify-batch";
        }
    }

    private List<NavItem> MainLinks() => new()
    {
        new("Home", GoHomeFromMenu, IsHome),
        new("Shop", () => GoPage("/shop"), IsShop),
        new("Ingredients", () => GoSection("formula")),
        new("Formulation", () => GoPage("/formulation"), PathIs("/formulation", "/ingredients", "/the-formula")),
        new("Reviews", () => GoSection("testimonials")),
        new("Quality", () => GoPage("/quality-reports"), IsQuality),
        new("Track Order", () => GoPage("/track"), PathIs("/track", "/track-order")),
    };

    private List<NavItem> DrawerLinks() => new()
    {
        new("Home", GoHomeFromMenu, IsHome),
        new("Shop Stamix", () => GoPage("/shop"), IsShop),
        new("Ingredient Matrix", () => GoSection("formula")),
        new("Full Formulation", () => GoPage("/formulation"), PathIs("/formulation", "/ingredients", "/the-formula")),
        new("Daily Ritual", () => GoSection("how-to-use")),
        new("Customer Reviews", () => GoSection("testimonials")),
        new("Quality & Testing", () => GoPage("/quality-reports"), IsQuality),
        new("Track Order", () => GoPage("/track"), PathIs("/track", "/track-order")),
        new(Auth.IsAuthenticated ? "My Account" : "Sign In / Account", () => GoPage("/account"), IsAccount),
        new("Admin Portal", () => GoPage("/admin")),
    };

    protected override void OnInitialized()
    {
        Cart.Changed += OnChanged;
        Auth.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("nuraHeader.init", _self, IsHome);
            _jsReady = true;
        }
        catch { }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _isMenuOpen = false;
        if (_jsReady)
        {
            try { await JS.InvokeVoidAsync("nuraHeader.lock", false); await JS.InvokeVoidAsync("nuraHeader.setHome", IsHome); } catch { }
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>"Past hero" now means the navbar should be solid (scrolled, or not on the home page).</summary>
    [JSInvokable]
    public void SetPastHero(bool past)
    {
        if (_isPastHero == past) return;
        _isPastHero = past;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnEscape()
    {
        if (!_isMenuOpen) return;
        await SetMenuAsync(false);
        StateHasChanged();
    }

    private async Task SetMenuAsync(bool open)
    {
        _isMenuOpen = open;
        if (_jsReady) { try { await JS.InvokeVoidAsync("nuraHeader.lock", open); } catch { } }
    }

    private Task OpenMenu() => SetMenuAsync(true);
    private Task CloseMenu() => SetMenuAsync(false);
    private void OpenCart() => Cart.SetOpen(true);

    private async Task GoHome()
    {
        Nav.NavigateTo("/");
        await Browser.ScrollToTopAsync();
    }

    private async void GoHomeFromMenu()
    {
        await SetMenuAsync(false);
        Nav.NavigateTo("/");
        await Browser.ScrollToTopAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void GoAccount() => Nav.NavigateTo("/account");

    private async void GoPage(string route)
    {
        await SetMenuAsync(false);
        Nav.NavigateTo(route);
        await InvokeAsync(StateHasChanged);
    }

    private async void GoSection(string id)
    {
        await SetMenuAsync(false);
        if (IsHome) await Browser.ScrollToIdAsync(id);
        else Nav.NavigateTo("/#" + id);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Cart.Changed -= OnChanged;
        Auth.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_jsReady) { try { await JS.InvokeVoidAsync("nuraHeader.dispose"); } catch { } }
        _self?.Dispose();
    }
}
