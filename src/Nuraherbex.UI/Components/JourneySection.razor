@using System.Globalization
@inject IJSRuntime JS
@implements IDisposable

<section
  class="relative bg-[#06040a] text-left h-[360vh] sm:h-[390vh]"
  id="how-it-helps">
  <div class="sticky top-0 h-screen w-full flex flex-col justify-center items-center overflow-hidden z-20 px-4 sm:px-6 pt-3 pb-8 sm:pt-4 sm:pb-12 transform-gpu">

    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[550px] bg-[radial-gradient(circle,rgba(88,28,135,0.14)_0%,transparent_70%)] pointer-events-none rounded-full"></div>

    <div class="max-w-6xl w-full mx-auto flex flex-col justify-center gap-3 sm:gap-6 h-full max-h-[760px] relative z-10">

      <div class="text-center max-w-2xl mx-auto shrink-0 pt-0 pb-1 sm:pb-2">
        <span class="text-[11px] sm:text-xs font-semibold text-[#faeb92] block mb-1 tracking-widest font-mono uppercase">
          How Nura Herbex Helps
        </span>

        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-[1.1] mb-1 font-heading">
          Your journey from
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#cc66da] via-[#faeb92] to-[#cc66da]">
            first dose to daily thrive
          </span>
        </h2>

        <p class="text-slate-400 text-xs sm:text-[13px] leading-relaxed max-w-md mx-auto font-normal hidden sm:block">
          Real change isn’t overnight. Here’s what happens inside you, step by step.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 xl:gap-10 items-center my-auto w-full px-4 sm:px-6">

        <div class="hidden lg:flex lg:col-span-5 flex-col items-center justify-center">

          <div class="w-full max-w-[280px] sm:max-w-[300px] h-[370px] sm:h-[390px] rounded-[24px] bg-[#090b10] border border-white/10 p-4 flex flex-col items-center justify-between shadow-2xl relative">

            <div
              class="absolute inset-0 m-auto w-[200px] h-[250px] rounded-full pointer-events-none transition-all duration-700 opacity-50"
              style="background: radial-gradient(circle, @(CurrentStep.DotColor)35 0%, #7c3aed20 55%, transparent 80%)"></div>

            <div class="relative w-full h-[270px] sm:h-[285px] flex items-center justify-center my-auto">
              <svg viewBox="0 0 230 460" class="w-full h-full relative z-10 overflow-visible" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <clipPath id="journeySilhouetteClip">
                    <path d="M115 22c-25 0-43 20-43 45s18 45 43 45 43-20 43-45-18-45-43-45Zm-32 96c-27 9-45 34-48 66l-9 103c-2 18 12 31 28 31h18l7 68c2 17 15 24 36 24s34-7 36-24l7-68h18c16 0 30-13 28-31l-9-103c-3-32-21-57-48-66l-12-4h-40l-12 4Z" />
                  </clipPath>

                  <linearGradient id="journeyBioGradient" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.95" />
                    <stop offset="35%" stop-color="#ea580c" stop-opacity="0.90" />
                    <stop offset="65%" stop-color="#8b5cf6" stop-opacity="0.88" />
                    <stop offset="85%" stop-color="#6366f1" stop-opacity="0.85" />
                    <stop offset="97%" stop-color="#38bdf8" stop-opacity="0.90" />
                    <stop offset="100%" stop-color="#93c5fd" stop-opacity="0.95" />
                  </linearGradient>

                  <filter id="nodeGlow" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation="4" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                  </filter>
                </defs>

                <path
                  d="M115 22c-25 0-43 20-43 45s18 45 43 45 43-20 43-45-18-45-43-45Zm-32 96c-27 9-45 34-48 66l-9 103c-2 18 12 31 28 31h18l7 68c2 17 15 24 36 24s34-7 36-24l7-68h18c16 0 30-13 28-31l-9-103c-3-32-21-57-48-66l-12-4h-40l-12 4Z"
                  fill="rgba(15, 23, 42, 0.4)" />

                <g clip-path="url(#journeySilhouetteClip)">
                  <rect x="0" y="@F(FillY)" width="230" height="@F(Math.Max(0, 420 - FillY))" fill="url(#journeyBioGradient)" />

                  @if (_smoothFill > 0.05 && _smoothFill < 0.98)
                  {
                    <line x1="26" y1="@F(FillY)" x2="204" y2="@F(FillY)" stroke="#93c5fd" stroke-width="1.5" opacity="0.8" />
                  }
                </g>

                <path
                  d="M115 22c-25 0-43 20-43 45s18 45 43 45 43-20 43-45-18-45-43-45Zm-32 96c-27 9-45 34-48 66l-9 103c-2 18 12 31 28 31h18l7 68c2 17 15 24 36 24s34-7 36-24l7-68h18c16 0 30-13 28-31l-9-103c-3-32-21-57-48-66l-12-4h-40l-12 4Z"
                  fill="none"
                  stroke="rgba(241, 245, 249, 0.85)"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
            </div>

            <div class="flex items-center gap-3.5 pb-1 z-10">
              @for (var idx = 0; idx < Steps.Length; idx++)
              {
                var i = idx;
                var s = Steps[i];
                var on = _activeStep == i;
                <button
                  @key="s.Id"
                  type="button"
                  @onclick="() => ScrollToStep(i)"
                  class="@($"w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer {(on ? "scale-125 ring-2 ring-offset-2 ring-offset-[#090b10]" : "opacity-35 hover:opacity-75")}")"
                  style="background-color: @s.DotColor; box-shadow: @(on ? $"0 0 10px {s.DotColor}" : "none")"
                  aria-label="@($"Jump to {s.Label}")"></button>
              }
            </div>

          </div>

          <div class="text-center mt-2 sm:mt-2.5">
            <span class="text-[11px] font-mono tracking-widest text-[#faeb92] block uppercase mb-0.5">
              @CurrentStep.Label
            </span>
            <span class="text-base font-bold font-heading text-white tracking-wide">
              @CurrentStep.Title
            </span>
          </div>

        </div>

        <div class="col-span-1 lg:col-span-7 relative w-full max-w-xl mx-auto lg:max-w-none">

          <div class="absolute left-[18px] sm:left-5 top-3 bottom-3 w-[2px] bg-white/10 -translate-x-1/2 rounded-full overflow-hidden pointer-events-none">
            <div
              class="w-full bg-gradient-to-b from-[#cc66da] via-[#9929ea] to-[#faeb92] shadow-[0_0_14px_#cc66da] transition-all duration-300 rounded-full"
              style="height: @(F(Math.Min(100, Math.Max(10, ((_activeStep + 0.35) / Steps.Length) * 100))))%"></div>
          </div>

          <div class="space-y-3 sm:space-y-4 xl:space-y-4.5">
            @for (var idx = 0; idx < Steps.Length; idx++)
            {
              var i = idx;
              var step = Steps[i];
              var isActive = _activeStep == i;
              var isPast = _activeStep > i;
              <div
                @key="step.Id"
                @onclick="() => ScrollToStep(i)"
                class="@($"flex items-start gap-3 sm:gap-4 group cursor-pointer relative z-10 transition-all duration-400 {(isActive ? "opacity-100" : "opacity-30 hover:opacity-70")}")">
                <div
                  class="@($"w-9 h-9 sm:w-10 sm:h-10 rounded-full flex items-center justify-center shrink-0 border transition-all duration-500 origin-center {(isActive ? "bg-[#150a24] border-[#cc66da] text-[#faeb92] shadow-[0_0_20px_rgba(153,41,234,0.85)] scale-105 ring-4 ring-[#cc66da]/25" : isPast ? "bg-[#0f071a] border-[#9929ea]/50 text-[#cc66da]" : "bg-[#090710] border-white/15 text-slate-500 group-hover:border-white/30 group-hover:text-slate-300")}")">
                  <Icon Name="@step.Icon" Size="16" Class="@(isActive ? "drop-shadow-[0_0_8px_#faeb92]" : "")" />
                </div>

                <div class="flex-1 text-left pt-0.5">
                  <span
                    class="@($"text-[11px] sm:text-xs font-semibold tracking-wider font-mono block mb-0.5 transition-colors duration-300 {(isActive ? "text-[#faeb92]" : "text-slate-500")}")">
                    @step.Label
                  </span>

                  <h3
                    class="@($"text-base sm:text-lg lg:text-xl font-bold font-heading tracking-tight mb-0.5 transition-colors duration-300 {(isActive ? "text-white" : "text-slate-400")}")">
                    @step.Title
                  </h3>

                  <p
                    class="@($"text-xs sm:text-[13.5px] leading-relaxed font-normal max-w-lg transition-colors duration-300 {(isActive ? "text-slate-200" : "text-slate-500")}")">
                    @step.Desc
                  </p>
                </div>
              </div>
            }
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

@code {
    private record JourneyStep(int Id, string Label, string Title, string Desc, string Icon, string DotColor);

    private static readonly JourneyStep[] Steps =
    {
        new(0, "Day 1", "Take It",
            "One 10 g scoop, twice daily. Mix with warm milk or lukewarm water — zero maltodextrin, zero artificial sweeteners, no fuss.",
            "Droplet", "#38bdf8"),
        new(1, "Days 2–7", "Absorb",
            "Whole botanical nutrition enters your system. Whole Ashwagandha, Shatavari and Safed Musli provide steady adaptogenic support while your body absorbs the natural nourishment.",
            "RotateCcw", "#2dd4bf"),
        new(2, "Week 2", "Feel The Shift",
            "Steadier energy through the afternoon. Mental fog lifts. You recover faster from stress and sleep deeper without grogginess.",
            "Sparkles", "#a78bfa"),
        new(3, "Week 4+", "Thrive Daily",
            "A new baseline. Sustained vitality, calmer mornings, sharper focus — the kind of resilience that compounds the longer you stay consistent.",
            "Sun", "#f59e0b"),
    };

    private static readonly double[] StepCenters = { 0.12, 0.38, 0.65, 0.89 };
    private const string TrackId = "how-it-helps";

    private int _activeStep;
    private double _targetFill = 0.22;
    private double _currentFill = 0.22;
    private double _smoothFill = 0.22;
    private CancellationTokenSource? _cts;

    private JourneyStep CurrentStep => Steps[_activeStep];
    private double FillY => 410 - _smoothFill * 390;
    private static string F(double v) => v.ToString("0.####", CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await HomeJs.EnsureAsync(JS);
        _cts = new CancellationTokenSource();
        _ = LoopAsync(_cts.Token);
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
            while (await timer.WaitForNextTickAsync(ct))
            {
                var probe = await HomeJs.ProbeAsync(JS, TrackId);
                var changed = false;

                if (probe is { Length: > 0 } && probe[0] is { } r)
                {
                    var top = r[0]; var height = r[1]; var winH = r[2];
                    var total = height - winH;
                    if (total > 0)
                    {
                        var progress = Math.Min(Math.Max(-top / total, 0), 1);
                        var step = progress < 0.25 ? 0 : progress < 0.52 ? 1 : progress < 0.78 ? 2 : 3;
                        if (step != _activeStep) { _activeStep = step; changed = true; }
                        _targetFill = 0.22 + progress * (1.0 - 0.22);
                    }
                }

                var diff = _targetFill - _currentFill;
                if (Math.Abs(diff) > 0.001) { _currentFill += diff * 0.18; _smoothFill = _currentFill; changed = true; }
                else if (_currentFill != _targetFill) { _currentFill = _targetFill; _smoothFill = _currentFill; changed = true; }

                if (changed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private Task ScrollToStep(int idx) =>
        HomeJs.ScrollToProgressAsync(JS, TrackId, idx < StepCenters.Length ? StepCenters[idx] : (double)idx / (Steps.Length - 1));

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
