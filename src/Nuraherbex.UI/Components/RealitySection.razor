<section class="py-28 bg-[#050409] relative z-10 overflow-hidden" id="why-stamix">
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-[radial-gradient(circle,rgba(147,51,234,0.12)_0%,transparent_70%)] pointer-events-none rounded-full"
    style="transform: translate3d(-50%, calc(-50% + var(--scroll-y, 0px) * 0.08), 0)"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6 text-left">
      <div>
        <span class="text-xs uppercase tracking-[0.25em] text-purple-400 font-bold block mb-3">
          The Reality
        </span>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
          Modern Life Is Draining<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-300 via-fuchsia-300 to-indigo-400 text-glow">
            Your Potential
          </span>
        </h2>
      </div>
      <p class="text-slate-400 text-sm sm:text-base max-w-md leading-relaxed">
        High stress, micro-pollutants, and disrupted circadian rhythms trigger systemic depletion. It is not natural aging; it is an uncalibrated biological baseline.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-5 sm:gap-6 items-start">
      @for (var idx = 0; idx < Symptoms.Length; idx++)
      {
        var item = Symptoms[idx];
        var isOdd = idx % 2 == 1;
        <div
          @key="item.Id"
          class="@($"group flex flex-col items-center text-center p-4 rounded-3xl bg-white/[0.02] border border-purple-500/20 hover:border-purple-400/50 hover:bg-purple-950/30 transition-all duration-500 hover:-translate-y-3 hover:shadow-2xl hover:shadow-purple-900/40 relative {(isOdd ? "lg:translate-y-6" : "")}")"
          style="will-change: transform">
          <div class="w-16 h-36 sm:w-20 sm:h-44 rounded-full border border-purple-400/50 bg-gradient-to-b from-purple-950/40 via-black/80 to-purple-950/60 p-1 flex flex-col justify-between items-center relative overflow-hidden shadow-[0_0_24px_rgba(168,85,247,0.2)] group-hover:shadow-[0_0_36px_rgba(192,132,252,0.5)] transition-all duration-500 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent pointer-events-none -skew-x-12"></div>

            <div class="flex-1 flex items-center justify-center relative z-10 pt-2 text-purple-300 drop-shadow-[0_0_10px_rgba(192,132,252,0.9)] group-hover:scale-115 transition-transform duration-300">
              <Icon Name="@item.Icon" Size="24" />
            </div>

            <div class="w-full h-1 bg-purple-300/50 rounded-full animate-meniscus relative z-10 shadow-[0_0_8px_#c084fc]"></div>

            <div class="w-full h-12 sm:h-16 rounded-b-full bg-gradient-to-t from-purple-600/70 via-purple-700/50 to-purple-500/30 relative overflow-hidden shadow-[inset_0_2px_12px_rgba(216,180,254,0.5)]">
              <div class="absolute inset-0 bg-purple-400/20 animate-pulse"></div>
            </div>
          </div>

          <h3 class="text-xs sm:text-sm font-bold text-purple-200 mt-4 tracking-wide group-hover:text-white transition-colors">
            @item.Title
          </h3>
        </div>
      }
    </div>
  </div>
</section>

@code {
    private record Symptom(string Id, string Title, string Icon);
    private static readonly Symptom[] Symptoms =
    {
        new("fatigue", "Chronic Fatigue", "BatteryCharging"),
        new("fog", "Brain Fog", "Eye"),
        new("drive", "Low Drive", "Zap"),
        new("recovery", "Poor Recovery", "Flame"),
        new("mood", "Mood Swings", "HeartPulse"),
        new("sleep", "Restless Sleep", "Moon"),
    };
}
