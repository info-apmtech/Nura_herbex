@inject NavigationManager Nav
@inject CartState Cart
@inject CatalogState Catalog

<section id="featured-products" class="nhp">
    <span class="nhp-orb o1" aria-hidden="true"></span>
    <span class="nhp-orb o2" aria-hidden="true"></span>

    <div class="nhp-inner">
        <div class="nhp-head" data-nh-reveal>
            <div>
                <span class="nh-eyebrow">OUR BESTSELLERS</span>
                <h2 class="nhp-title">Featured <em>Products</em></h2>
                <p class="nhp-sub">Two Ayurvedic formulas, one promise — pure whole-botanical wellness you can feel every day.</p>
            </div>
            <button @onclick='() => Nav.NavigateTo("/shop")' class="nh-view-all">
                <span>View All</span>
                <span style="font-weight: 800;">→</span>
            </button>
        </div>

        <div class="nhp-grid">
            @for (var i = 0; i < Products.Length; i++)
            {
                var idx = i;
                var p = Products[idx];
                <article class="nhp-card @p.Theme" data-nh-reveal style="--d:@(idx * 140)ms">
                    <div class="nhp-media">
                        <span class="nhp-badge">@p.Badge</span>
                        <span class="nhp-glow" aria-hidden="true"></span>
                        <span class="nhp-ring" aria-hidden="true"></span>
                        <img src="@p.Image" alt="@p.Name jar" class="nhp-jar" loading="lazy" />
                        <span class="nhp-pill"><Icon Name="@p.PillIcon" Size="14" /> @p.Pill</span>
                    </div>

                    <div class="nhp-body">
                        <span class="nhp-cat">@p.Category</span>
                        <h3 class="nhp-name">@p.Name</h3>
                        <p class="nhp-desc">@p.Desc</p>

                        <ul class="nhp-points">
                            @foreach (var pt in p.Points)
                            {
                                <li><Icon Name="CheckCircle2" Size="16" /><span class="nhp-point-text">@pt</span></li>
                            }
                        </ul>

                        <div class="nhp-meta">@p.Serving</div>

                        <div class="nhp-buy">
                            <div class="nhp-price">
                                <strong>₹@p.Price.ToString("N0")</strong>
                                <small>Free shipping above ₹@SiteConfig.FreeShippingThreshold.ToString("N0")</small>
                            </div>
                            <div class="nhp-qty" role="group" aria-label="Quantity for @p.Name">
                                <button type="button" @onclick="() => Step(idx, -1)" aria-label="Decrease quantity" disabled="@(_qty[idx] <= 1)">−</button>
                                <span aria-live="polite">@_qty[idx]</span>
                                <button type="button" @onclick="() => Step(idx, 1)" aria-label="Increase quantity">+</button>
                            </div>
                        </div>

                        <div class="nhp-actions">
                            <button type="button" class="nhp-add @(_added == idx ? "done" : "")" @onclick="() => AddAsync(idx)" aria-label="Add @p.Name to cart">
                                @if (_added == idx)
                                {
                                    <Icon Name="CheckCircle2" Size="18" /><span>Added to cart</span>
                                }
                                else
                                {
                                    <Icon Name="ShoppingBag" Size="18" /><span>Add to Cart</span>
                                }
                            </button>
                            <button type="button" class="nhp-details" @onclick="() => Nav.NavigateTo(p.DetailsUrl)">
                                <span>Details</span><Icon Name="ArrowRight" Size="15" />
                            </button>
                        </div>

                        <ul class="nhp-assure" aria-label="Purchase assurances">
                            <li><Icon Name="ShieldCheck" Size="14" /> Batch verified</li>
                            <li><Icon Name="Lock" Size="14" /> Secure checkout</li>
                            <li><Icon Name="Truck" Size="14" /> Tracked delivery</li>
                        </ul>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@code {
    private sealed record Product(string Id, string Name, string Category, string Desc, string[] Points, string Serving, decimal Price,
        string Image, string Theme, string Badge, string Pill, string PillIcon, string CartName, string CartServing, string DetailsUrl, string CartImage);

    // Presentation only (artwork, theme, pill). Names, prices, copy and highlights come from the database via CatalogState.
    private static readonly Product[] Defaults =
    {
        new("gut-365", "GUT 365", "Gut & Liver Enhancement",
            "Gut balance, digestive stimulant, natural energiser, antioxidant rich.",
            new[] { "Supports healthy digestion", "Natural daily energiser", "Antioxidant-rich botanicals" },
            "Daily powder · 30-day supply", 1299m,
            "_content/Nuraherbex.UI/images/product-1.png", "nhp-gut", "Bestseller", "100% natural", "Leaf",
            "GUT 365 — Gut & Liver Enhancement", "Daily powder · 30 days", "/catalog/gut-365", "_content/Nuraherbex.UI/images/product-1.png"),
        new("stamix-single", "STAMIX", "Built for Men Who Run on Empty",
            "Natural energy, stamina, focus and recovery.",
            new[] { "Sustained energy through the day", "Mental focus and clarity", "Support for recovery and resilience" },
            "500 g jar · 25-day ritual", 1299m,
            "_content/Nuraherbex.UI/images/product-2.png", "nhp-stamix", "For Men", "17 botanicals", "Zap",
            "STAMIX — Botanical Vitality Formula", "500 g · 25-day ritual", "/products/stamix", "_content/Nuraherbex.UI/images/product-2.png"),
    };

    private Product[] Products = Defaults;
    private int[] _qty = { 1, 1 };
    private int _added = -1;

    protected override async Task OnInitializedAsync()
    {
        var live = await Catalog.GetAsync();
        if (live.Count == 0) return;
        Products = Defaults.Select(d =>
        {
            var p = live.FirstOrDefault(x => x.Id == d.Id);
            if (p is null) return d;
            var points = p.HighlightList.Take(3).ToArray();
            return d with
            {
                Name = string.IsNullOrWhiteSpace(p.ShortName) ? d.Name : p.ShortName,
                Category = string.IsNullOrWhiteSpace(p.Category) ? d.Category : p.Category,
                Desc = string.IsNullOrWhiteSpace(p.Description) ? d.Desc : p.Description,
                Points = points.Length > 0 ? points : d.Points,
                Serving = string.IsNullOrWhiteSpace(p.ServingInfo) ? d.Serving : p.ServingInfo,
                Price = p.Price,
                Badge = string.IsNullOrWhiteSpace(p.Badge) ? d.Badge : p.Badge,
                CartName = p.Name,
                CartServing = string.IsNullOrWhiteSpace(p.ServingInfo) ? d.CartServing : p.ServingInfo,
                CartImage = string.IsNullOrWhiteSpace(p.ImageUrl) ? d.CartImage : p.ImageUrl,
            };
        }).ToArray();
    }

    private void Step(int i, int delta) => _qty[i] = Math.Clamp(_qty[i] + delta, 1, 10);

    private async Task AddAsync(int i)
    {
        var p = Products[i];
        await Cart.AddToCartAsync(new CartItem
        {
            Id = p.Id,
            Name = p.CartName,
            Price = p.Price,
            Image = p.CartImage,
            ServingsText = p.CartServing,
            Quantity = 1
        }, _qty[i]);

        _added = i;
        StateHasChanged();
        await Task.Delay(1800);
        if (_added == i) { _added = -1; StateHasChanged(); }
    }
}
