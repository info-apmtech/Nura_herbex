@inject NavigationManager Nav

<MobileSection Id="home.footer"><section class="nh-newsletter nhn" aria-label="Newsletter">
    <img src="_content/Nuraherbex.UI/images/newsletter-leaf-left.png" alt="" class="nh-newsletter-leaf-l" aria-hidden="true" />
    <img src="_content/Nuraherbex.UI/images/newsletter-leaf-right.png" alt="" class="nh-newsletter-leaf-r" aria-hidden="true" />

    <div class="nhn-card" data-nh-reveal>
        <div class="nhn-copy">
            <span class="nhn-eyebrow"><i></i> THE NURA HERBEX CIRCLE</span>
            <h2 class="nhn-title">Join our <em>wellness</em> community</h2>
            <p class="nhn-sub">Thoughtful botanical wellness, delivered occasionally. Be the first to hear about launches, member offers and practical daily-ritual guidance.</p>

            <ul class="nhn-perks">
                <li><span><Icon Name="Tag" Size="18" /></span><div><strong>Member offers</strong><small>Early access to launches &amp; savings</small></div></li>
                <li><span><Icon Name="Leaf" Size="18" /></span><div><strong>Wellness guidance</strong><small>Rituals, recipes &amp; botanical know-how</small></div></li>
                <li><span><Icon Name="ShieldCheck" Size="18" /></span><div><strong>Respect for your inbox</strong><small>No spam — unsubscribe anytime</small></div></li>
            </ul>
        </div>

        <div class="nhn-form-wrap">
            @if (_isSubscribed)
            {
                <div class="nhn-success" role="status">
                    <span><Icon Name="CheckCircle2" Size="30" /></span>
                    <h3>Welcome to the circle</h3>
                    <p>Thank you — you're subscribed to Nura Herbex updates.</p>
                </div>
            }
            else
            {
                <form @onsubmit="HandleSubscribe" @onsubmit:preventDefault class="nhn-form">
                    <h3>Stay in the loop</h3>
                    <p>Enter your email to subscribe.</p>
                    <label class="nhn-field">
                        <Icon Name="Mail" Size="18" />
                        <input type="email" required @bind="_email" placeholder="you@example.com" aria-label="Email address" autocomplete="email" />
                    </label>
                    <button type="submit" class="nhn-btn"><span>Subscribe</span> <Icon Name="ArrowRight" Size="16" /></button>
                    <small class="nhn-fine">By subscribing you agree to receive Nura Herbex emails. Read our <a href="/privacy">Privacy Policy</a>.</small>
                </form>
            }
        </div>
    </div>
</section></MobileSection>

<HomeFooter />

@code {
    [Inject] private ModalState Modal { get; set; } = default!;

    private string _email = "";
    private bool _isSubscribed;

    private void HandleSubscribe()
    {
        if (!string.IsNullOrWhiteSpace(_email) && _email.Contains('@'))
        {
            _isSubscribed = true;
        }
    }
}
