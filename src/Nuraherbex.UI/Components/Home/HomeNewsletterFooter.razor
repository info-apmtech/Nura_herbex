@inject NavigationManager Nav

<footer class="nh-newsletter">
    
    @* Decorative Leaf Accents on Left & Right Edges *@
    <img src="_content/Nuraherbex.UI/images/newsletter-leaf-left.png" alt="" class="nh-newsletter-leaf-l" aria-hidden="true" />
    <img src="_content/Nuraherbex.UI/images/newsletter-leaf-right.png" alt="" class="nh-newsletter-leaf-r" aria-hidden="true" />

    <div class="nh-newsletter-inner">
        
        <h2 class="nh-newsletter-title">Join Our Wellness Community</h2>

        <p class="nh-newsletter-sub">
            Get exclusive offers, wellness tips and new product updates.
        </p>

        @if (_isSubscribed)
        {
            <div class="nh-newsletter-success">
                <Icon Name="CheckCircle2" Size="18" />
                <span>Thank you! You're subscribed to Nura Herbex updates.</span>
            </div>
        }
        else
        {
            <form @onsubmit="HandleSubscribe" @onsubmit:preventDefault class="nh-newsletter-form">
                <div class="nh-newsletter-input-wrap">
                    <div class="nh-newsletter-input-icon">
                        <Icon Name="Mail" Size="18" />
                    </div>
                    <input type="email" required @bind="_email" placeholder="Enter your email" class="nh-newsletter-input" />
                    <button type="submit" class="nh-newsletter-btn">
                        <span>Subscribe</span>
                        <span style="font-weight: 800; font-size: 15px;">→</span>
                    </button>
                </div>
            </form>
        }

        <div class="nh-newsletter-legal">
            <p>Thoughtful botanical wellness, rooted in nature.</p>
        </div>

    </div>
    <div class="nh-footer-bar">
        <div class="nh-footer-brand"><strong>NURA <span>HERBEX</span></strong><small>Botanical wellness for everyday life</small></div>
        <nav aria-label="Footer navigation">
            <a href="/shop">Shop</a>
            <a href="/formulation">Our formulation</a>
            <a href="/verify">Verify a batch</a>
            <a href="/track">Track an order</a>
        </nav>
        <small class="nh-footer-copy">© 2026 Nura Herbex. All rights reserved.</small>
    </div>
</footer>

@code {
    private string _email = "";
    private bool _isSubscribed;

    private void HandleSubscribe()
    {
        if (!string.IsNullOrWhiteSpace(_email) && _email.Contains('@'))
        {
            _isSubscribed = true;
        }
    }
}
