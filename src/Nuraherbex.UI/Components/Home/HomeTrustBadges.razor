<section class="nh-trust">
    <div class="nh-trust-inner">
        
        <h3 class="nh-trust-title">Trusted Quality &amp; Care</h3>

        <div class="nh-trust-grid">
            
            @* Badge 1: GMP Certified Facility *@
            <div class="nh-trust-item">
                <div class="nh-trust-badge-icon">
                    <span>GMP</span>
                </div>
                <div class="nh-trust-text">
                    <span class="nh-trust-heading">GMP</span>
                    <span class="nh-trust-sub">Certified Facility</span>
                </div>
            </div>

            @* Badge 2: Premium Herbal Ingredients *@
            <div class="nh-trust-item">
                <div class="nh-trust-badge-icon" style="color:#2d7a46; border-color:#c7dfcc; background:#f4fbf5;">
                    <Icon Name="Leaf" Size="20" />
                </div>
                <div class="nh-trust-text">
                    <span class="nh-trust-heading">Premium</span>
                    <span class="nh-trust-sub">Herbal Ingredients</span>
                </div>
            </div>

            @* Badge 3: Third-Party Tested *@
            <div class="nh-trust-item">
                <div class="nh-trust-badge-icon" style="color:#732dbd; border-color:#dfcef2; background:#faf5fd;">
                    <Icon Name="FlaskConical" Size="20" />
                </div>
                <div class="nh-trust-text">
                    <span class="nh-trust-heading">Third-Party</span>
                    <span class="nh-trust-sub">Tested</span>
                </div>
            </div>

            @* Badge 4: Safe & Reliable *@
            <div class="nh-trust-item">
                <div class="nh-trust-badge-icon" style="color:#1e7b99; border-color:#cce4ea; background:#f3f9fb;">
                    <Icon Name="ShieldCheck" Size="20" />
                </div>
                <div class="nh-trust-text">
                    <span class="nh-trust-heading">Safe &amp;</span>
                    <span class="nh-trust-sub">Reliable</span>
                </div>
            </div>

        </div>

    </div>
</section>
