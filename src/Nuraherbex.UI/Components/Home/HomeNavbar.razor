@implements IDisposable
@inject NavigationManager Nav
@inject CartState Cart
@inject BrowserInterop Browser

<header class="nh-navbar">
    <div class="nh-nav-inner">
        
        @* Brand Logo *@
        <button @onclick="GoHome" class="nh-nav-brand" aria-label="Nura Herbex Home">
            <img src="_content/Nuraherbex.UI/images/logo-mark.png" alt="Nura Herbex Emblem" class="nh-nav-logo" />
            <div class="nh-nav-brand-text">
                <span class="nh-nav-brand-title">
                    NURA <span>HERBEX</span><sup>®</sup>
                </span>
                <span class="nh-nav-brand-sub">Ayurvedic Wellness</span>
            </div>
        </button>

        @* Right Actions: Search, Cart with purple badge, Hamburger Menu *@
        <div class="nh-nav-actions">
            
            @* Search Button *@
            <button @onclick="ToggleSearch" aria-label="Search Store" class="nh-nav-btn">
                <Icon Name="Search" Size="20" StrokeWidth="2" />
            </button>

            @* Cart Button with Purple Item Count Badge *@
            <button @onclick="OpenCart" aria-label="Shopping Cart" class="nh-nav-btn">
                <Icon Name="ShoppingBag" Size="20" StrokeWidth="2" />
                <span class="nh-cart-badge">
                    @(Cart.ItemCount > 0 ? Cart.ItemCount : 1)
                </span>
            </button>

            @* Hamburger Menu Button *@
            <button @onclick="ToggleMenu" aria-label="Open Navigation Menu" class="nh-nav-btn">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>

        </div>
    </div>

    @* Expandable Search Bar Overlay *@
    @if (_isSearchOpen)
    {
        <div style="background:#fdfbf8; border-top:1px solid #ebdff5; padding:12px 24px; box-shadow:inset 0 2px 6px rgba(0,0,0,0.03);">
            <div style="max-width:600px; margin:0 auto; display:flex; align-items:center; gap:12px;">
                <Icon Name="Search" Size="18" Class="text-purple-600" />
                <input @bind="_searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKey" placeholder="Search products (e.g. GUT 365, STAMIX)..." style="flex:1; border:none; outline:none; background:transparent; font-size:14px; padding:6px 0;" autofocus />
                <button @onclick="PerformSearch" style="background:#732dbd; color:#fff; border:none; border-radius:9999px; padding:6px 16px; font-weight:700; font-size:12px; cursor:pointer;">Search</button>
                <button @onclick="ToggleSearch" style="background:none; border:none; cursor:pointer; color:#888;">
                    <Icon Name="X" Size="16" />
                </button>
            </div>
        </div>
    }
</header>

@* Slide-over navigation drawer *@
@if (_isMenuOpen)
{
    <div class="nhd-backdrop" @onclick="CloseMenu"></div>

    <aside class="nhd" role="dialog" aria-modal="true" aria-label="Site navigation">
        <div class="nhd-top">
            <div class="nhd-brand">
                <img src="_content/Nuraherbex.UI/images/logo-mark.png" alt="" />
                <span><strong>NURA HERBEX</strong><small>Ayurvedic Wellness</small></span>
            </div>
            <button type="button" class="nhd-close" @onclick="CloseMenu" aria-label="Close menu"><Icon Name="X" Size="18" /></button>
        </div>

        <nav class="nhd-body" aria-label="Main">
            @foreach (var group in MenuGroups)
            {
                <span class="nhd-label">@group.Title</span>
                @foreach (var item in group.Items)
                {
                    var entry = item;
                    <button type="button" class="nhd-item @(IsActive(entry) ? "is-active" : "")" @onclick="() => Go(entry)">
                        <span class="nhd-ic"><Icon Name="@entry.Icon" Size="18" /></span>
                        <span class="nhd-tx"><strong>@entry.Title</strong><small>@entry.Text</small></span>
                        <Icon Name="ArrowRight" Size="15" Class="nhd-arrow" />
                    </button>
                }
            }
        </nav>

        <div class="nhd-foot">
            <button type="button" class="nhd-cart" @onclick='() => { CloseMenu(); Cart.SetOpen(true); }'>
                <Icon Name="ShoppingBag" Size="17" /> <span>View cart (@Cart.ItemCount)</span>
            </button>
            <p>Need help? <a href="mailto:@SiteConfig.ContactEmail">@SiteConfig.ContactEmail</a></p>
        </div>
    </aside>
}

@code {
    private bool _isSearchOpen;
    private bool _isMenuOpen;
    private string _searchQuery = "";

    protected override void OnInitialized()
    {
        Cart.Changed += OnCartChanged;
    }

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleSearch() => _isSearchOpen = !_isSearchOpen;
    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;
    private void CloseMenu() => _isMenuOpen = false;
    private void OpenCart() => Cart.SetOpen(true);

    private async Task GoHome()
    {
        CloseMenu();
        Nav.NavigateTo("/");
        await Browser.ScrollToTopAsync();
    }

    private async Task GoPage(string route)
    {
        CloseMenu();
        Nav.NavigateTo(route);
        await Browser.ScrollToTopAsync();
    }

    private async Task GoScroll(string id)
    {
        CloseMenu();
        await Browser.ScrollToIdAsync(id);
    }

    private sealed record MenuItem(string Icon, string Title, string Text, string Url);
    private sealed record MenuGroup(string Title, MenuItem[] Items);

    private static readonly MenuGroup[] MenuGroups =
    [
        new("Discover",
        [
            new("Sparkles", "Home", "Back to the front page", "/"),
            new("ShoppingBag", "Shop all products", "GUT 365 and STAMIX", "/shop"),
            new("Leaf", "Our story", "Ancient wisdom for modern living", "/our-story"),
            new("Clock", "Daily ritual", "How to take it, step by step", "/#stamina-power"),
        ]),
        new("Learn",
        [
            new("FlaskConical", "Ingredient matrix", "Every botanical and its amount", "/formulation#ingredient-matrix"),
            new("ShieldCheck", "Quality testing", "Batch lab reports and COA", "/quality-reports"),
            new("Star", "Customer reviews", "What our customers say", "/#reviews"),
            new("MessageSquare", "FAQs", "Quick answers", "/#faq"),
        ]),
        new("Your account",
        [
            new("Truck", "Track order", "Follow your parcel live", "/track"),
            new("User", "My account", "Orders, profile and reviews", "/account"),
        ]),
    ];

    private bool IsActive(MenuItem item)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var target = item.Url.Split('#')[0].TrimEnd('/').ToLowerInvariant();
        if (item.Url.Contains('#')) return false;
        return target.Length == 0 ? path.Length == 0 : path == target || path.StartsWith(target + "/", StringComparison.Ordinal);
    }

    private async Task Go(MenuItem item)
    {
        CloseMenu();
        Nav.NavigateTo(item.Url);
        if (!item.Url.Contains('#')) await Browser.ScrollToTopAsync();
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") PerformSearch();
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            _isSearchOpen = false;
            Nav.NavigateTo($"/shop?q={Uri.EscapeDataString(_searchQuery)}");
        }
    }

    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
    }
}
