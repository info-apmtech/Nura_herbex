<section class="nh-stats" aria-label="Nura Herbex at a glance">
    <div class="nh-stats-inner">
        <div class="nh-stat" data-nh-reveal style="--d:0ms">
            <CountUp Value="17" Class="nh-stat-num" Suffix="+" />
            <span class="nh-stat-label">Whole botanicals<br />in every scoop</span>
        </div>
        <div class="nh-stat" data-nh-reveal style="--d:100ms">
            <CountUp Value="25" Class="nh-stat-num" />
            <span class="nh-stat-label">Day daily ritual<br />per 500 g jar</span>
        </div>
        <div class="nh-stat" data-nh-reveal style="--d:200ms">
            <CountUp Value="100" Class="nh-stat-num" Suffix="%" />
            <span class="nh-stat-label">Natural,<br />plant-based formula</span>
        </div>
        <div class="nh-stat" data-nh-reveal style="--d:300ms">
            <CountUp Value="0" Class="nh-stat-num" />
            <span class="nh-stat-label">Added<br />preservatives</span>
        </div>
    </div>
</section>
