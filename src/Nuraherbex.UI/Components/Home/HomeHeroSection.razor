@implements IDisposable
@inject NavigationManager Nav
@inject CartState Cart

<section class="nh-hero" @onmouseenter="PauseAutoPlay" @onmouseleave="ResumeAutoPlay" aria-label="Hero Showcase Slider">
    <div class="nh-hero-slider-wrap">
        
        @* Slider Track with CSS Grid Stacking for seamless cross-fade *@
        <div class="nh-hero-slider-track">
            
            @* Slide 1: GUT 365 *@
            <div class="nh-hero-slide nh-hero-slide-1 @(currentSlide == 0 ? "active" : "")" 
                 role="tabpanel" 
                 aria-label="Slide 1 of 2: GUT 365"
                 aria-hidden="@(currentSlide != 0)">
                @* Decorative lid-opening / powder animation canvas (drawn by nura.js; purely visual) *@
                <canvas class="nh-hero-powder" aria-hidden="true"></canvas>
                <div class="nh-hero-content">
                    <span class="nh-hero-kicker">
                        NATURAL WELLNESS FOR A BRIGHTER YOU
                    </span>

                    <h1 class="nh-hero-title">
                        Better Digestion<br />
                        Brighter Living
                    </h1>

                    <p class="nh-hero-sub">
                        Gut health. More energy.<br />
                        A healthier, happier you.
                    </p>

                    <button @onclick="ShopGut365" class="nh-hero-btn" aria-label="Shop Gut 365">
                        <span>SHOP GUT 365</span>
                        <span style="font-size: 16px; font-weight: 800;">→</span>
                    </button>
                </div>

                @* Mobile-only visual fallback *@
                <div class="nh-hero-mobile-media">
                    <img src="_content/Nuraherbex.UI/images/hero-jar-rock.png" alt="GUT 365 Gut &amp; Liver Enhancement" class="nh-hero-mobile-img" />
                </div>
            </div>

            @* Slide 2: STAMIX *@
            <div class="nh-hero-slide nh-hero-slide-2 @(currentSlide == 1 ? "active" : "")" 
                 role="tabpanel" 
                 aria-label="Slide 2 of 2: STAMIX"
                 aria-hidden="@(currentSlide != 1)">
                @* Decorative lid-opening / powder animation canvas (drawn by nura.js; purely visual) *@
                <canvas class="nh-hero-powder" aria-hidden="true"></canvas>
                <div class="nh-hero-content">
                    <span class="nh-hero-kicker">
                        BUILT FOR MEN WHO RUN ON EMPTY
                    </span>

                    <h1 class="nh-hero-title">
                        Peak Stamina<br />
                        Natural Vitality
                    </h1>

                    <p class="nh-hero-sub">
                        Ancient Ashwagandha &amp; botanical blend.<br />
                        Sustained energy, mental focus &amp; recovery.
                    </p>

                    <button @onclick="ShopStamix" class="nh-hero-btn" aria-label="Shop STAMIX">
                        <span>SHOP STAMIX</span>
                        <span style="font-size: 16px; font-weight: 800;">→</span>
                    </button>
                </div>

                @* Mobile-only visual fallback *@
                <div class="nh-hero-mobile-media">
                    <img src="_content/Nuraherbex.UI/images/hero-stamix-rock.png" alt="STAMIX Botanical Vitality Formula" class="nh-hero-mobile-img" />
                </div>
            </div>

        </div>

        @* Navigation Arrows *@
        <button class="nh-hero-arrow nh-hero-arrow-prev" @onclick="PrevSlide" aria-label="Previous slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>
        <button class="nh-hero-arrow nh-hero-arrow-next" @onclick="NextSlide" aria-label="Next slide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>

        @* Pagination Dots *@
        <div class="nh-hero-dots" role="tablist" aria-label="Hero carousel pagination">
            <button class="nh-hero-dot @(currentSlide == 0 ? "active" : "")" 
                    @onclick="() => SetSlide(0)" 
                    role="tab" 
                    aria-selected="@(currentSlide == 0 ? "true" : "false")"
                    aria-label="Slide 1 - GUT 365"></button>
            <button class="nh-hero-dot @(currentSlide == 1 ? "active" : "")" 
                    @onclick="() => SetSlide(1)" 
                    role="tab" 
                    aria-selected="@(currentSlide == 1 ? "true" : "false")"
                    aria-label="Slide 2 - STAMIX"></button>
        </div>

    </div>
</section>

@code {
    private int currentSlide = 0;
    private const int TotalSlides = 2;
    private System.Threading.Timer? _timer;
    private bool _isPaused = false;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(OnTimerCallback, null, TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(6));
    }

    private void OnTimerCallback(object? state)
    {
        if (_isPaused) return;

        InvokeAsync(() =>
        {
            currentSlide = (currentSlide + 1) % TotalSlides;
            StateHasChanged();
        });
    }

    private void NextSlide()
    {
        currentSlide = (currentSlide + 1) % TotalSlides;
    }

    private void PrevSlide()
    {
        currentSlide = (currentSlide - 1 + TotalSlides) % TotalSlides;
    }

    private void SetSlide(int index)
    {
        if (index >= 0 && index < TotalSlides)
        {
            currentSlide = index;
        }
    }

    private void PauseAutoPlay()
    {
        _isPaused = true;
    }

    private void ResumeAutoPlay()
    {
        _isPaused = false;
    }

    private async Task ShopGut365()
    {
        await Cart.AddToCartAsync(new CartItem
        {
            Id = "gut-365",
            Name = "GUT 365 — Gut & Liver Enhancement",
            Price = 1299m,
            Image = "_content/Nuraherbex.UI/images/product-1.png",
            ServingsText = "60 capsules · 30 days",
            Quantity = 1
        });
    }

    private async Task ShopStamix()
    {
        await Cart.AddToCartAsync(new CartItem
        {
            Id = "stamix-single",
            Name = "STAMIX — Botanical Vitality Formula",
            Price = 1299m,
            Image = "_content/Nuraherbex.UI/images/product-2.png",
            ServingsText = "500 g · 25-day ritual",
            Quantity = 1
        });
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
