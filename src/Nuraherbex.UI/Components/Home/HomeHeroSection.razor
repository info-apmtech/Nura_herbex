@implements IDisposable

<section class="nhx-hero" aria-label="Featured products" aria-roledescription="carousel">
    <div class="nhx-track">

        @* Slide 1: GUT 365 *@
        <div class="nhx-slide nhx-gut @(currentSlide == 0 ? "active" : "")"
             data-powder="#dfe9b0,#b9d18a,#f1ecc9,#9fc183" data-base="0.8"
             style="--lxn:.239;--lyn:.202;--lwn:.502;--lhn:.173;--mlx:.246;--mty:.345;--mw:.514;--mh:.06;--p0:#dfe9b0;--p1:#b9d18a;--p2:#f1ecc9"
             role="group" aria-roledescription="slide" aria-label="Slide 1 of 2: GUT 365"
             aria-hidden="@(currentSlide != 0 ? "true" : "false")">
            <div class="nhx-bg" aria-hidden="true">
                <span class="nhx-orb o1"></span><span class="nhx-orb o2"></span><span class="nhx-orb o3"></span>
            </div>
            <canvas class="nhx-fx nhx-fx-back" aria-hidden="true"></canvas>

            <div class="nhx-grid">
                <div class="nhx-copy">
                    <span class="nhx-kicker">Natural wellness for a brighter you</span>
                    <h1 class="nhx-title">
                        <span class="nhx-line"><span>Better Digestion</span></span>
                        <span class="nhx-line"><span>Brighter <em>Living</em></span></span>
                    </h1>
                    <p class="nhx-sub">Gut &amp; liver enhancement made from time-honoured herbs — more balance, more energy, a healthier you.</p>
                    <ul class="nhx-chips">
                        <li><Icon Name="Leaf" Size="14" /> 100% natural</li>
                        <li><Icon Name="ShieldCheck" Size="14" /> Batch verified</li>
                        <li><Icon Name="Truck" Size="14" /> Free shipping ₹@SiteConfig.FreeShippingThreshold.ToString("N0")+</li>
                    </ul>
                </div>

                <div class="nhx-stage">
                    <span class="nhx-flash"></span>
                    <span class="nhx-halo"></span>
                    <div class="nhx-tilt"><div class="nhx-float"><div class="nhx-jarwrap"><div class="nhx-jarbody">
                        <img class="nhx-jar" src="_content/Nuraherbex.UI/images/product-1.png" alt="GUT 365 Gut and Liver Enhancement jar" />
                        <span class="nhx-mouth" aria-hidden="true"><span class="nhx-mouth-in"></span><span class="nhx-mouth-pow"></span></span>
                        <span class="nhx-heap" aria-hidden="true"></span>
                        <span class="nhx-lid" aria-hidden="true"><img src="_content/Nuraherbex.UI/images/product-1.png" alt="" /></span>
                    </div></div></div></div>
                    <span class="nhx-ground"></span>
                    <div class="nhx-glass g1"><Icon Name="Sparkles" Size="16" /><div><strong>Gut &amp; Liver</strong><span>Enhancement</span></div></div>
                    <div class="nhx-glass g2"><Icon Name="Leaf" Size="16" /><div><strong>60 capsules</strong><span>30-day supply</span></div></div>
                </div>
            </div>
            <canvas class="nhx-fx nhx-fx-front" aria-hidden="true"></canvas>
        </div>

        @* Slide 2: STAMIX *@
        <div class="nhx-slide nhx-stamix @(currentSlide == 1 ? "active" : "")"
             data-powder="#ecc98f,#d2a661,#f8e3b9,#c48c4a" data-base="0.8"
             style="--lxn:.264;--lyn:.236;--lwn:.484;--lhn:.156;--mlx:.271;--mty:.381;--mw:.494;--mh:.06;--p0:#ecc98f;--p1:#d2a661;--p2:#f8e3b9"
             role="group" aria-roledescription="slide" aria-label="Slide 2 of 2: STAMIX"
             aria-hidden="@(currentSlide != 1 ? "true" : "false")">
            <div class="nhx-bg" aria-hidden="true">
                <span class="nhx-orb o1"></span><span class="nhx-orb o2"></span><span class="nhx-orb o3"></span>
            </div>
            <canvas class="nhx-fx nhx-fx-back" aria-hidden="true"></canvas>

            <div class="nhx-grid">
                <div class="nhx-copy">
                    <span class="nhx-kicker">Built for men who run on empty</span>
                    <h1 class="nhx-title">
                        <span class="nhx-line"><span>Peak Stamina</span></span>
                        <span class="nhx-line"><span>Natural <em>Vitality</em></span></span>
                    </h1>
                    <p class="nhx-sub">Ashwagandha and a 17-botanical blend for sustained energy, mental focus and everyday recovery.</p>
                    <ul class="nhx-chips">
                        <li><Icon Name="Zap" Size="14" /> Sustained energy</li>
                        <li><Icon Name="Leaf" Size="14" /> No preservatives</li>
                        <li><Icon Name="ShieldCheck" Size="14" /> Batch verified</li>
                    </ul>
                </div>

                <div class="nhx-stage">
                    <span class="nhx-flash"></span>
                    <span class="nhx-halo"></span>
                    <div class="nhx-tilt"><div class="nhx-float"><div class="nhx-jarwrap"><div class="nhx-jarbody">
                        <img class="nhx-jar" src="_content/Nuraherbex.UI/images/product-2.png" alt="STAMIX Botanical Vitality Formula jar" />
                        <span class="nhx-mouth" aria-hidden="true"><span class="nhx-mouth-in"></span><span class="nhx-mouth-pow"></span></span>
                        <span class="nhx-heap" aria-hidden="true"></span>
                        <span class="nhx-lid" aria-hidden="true"><img src="_content/Nuraherbex.UI/images/product-2.png" alt="" /></span>
                    </div></div></div></div>
                    <span class="nhx-ground"></span>
                    <div class="nhx-glass g1"><Icon Name="Zap" Size="16" /><div><strong>17 botanicals</strong><span>Whole-herb blend</span></div></div>
                    <div class="nhx-glass g2"><Icon Name="Sparkles" Size="16" /><div><strong>500 g jar</strong><span>25-day ritual</span></div></div>
                </div>
            </div>
            <canvas class="nhx-fx nhx-fx-front" aria-hidden="true"></canvas>
        </div>
    </div>

    <button class="nhx-arrow nhx-arrow-prev" @onclick="PrevSlide" aria-label="Previous slide">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="nhx-arrow nhx-arrow-next" @onclick="NextSlide" aria-label="Next slide">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <div class="nhx-progress @(currentSlide == 1 ? "on-dark" : "")" role="tablist" aria-label="Choose slide">
        <button role="tab" class="nhx-tab @(currentSlide == 0 ? "active" : "")" aria-selected="@(currentSlide == 0 ? "true" : "false")" @onclick="() => SetSlide(0)">
            <span class="nhx-tab-no">01</span><span class="nhx-tab-name">GUT 365</span><span class="nhx-tab-bar"><i></i></span>
        </button>
        <button role="tab" class="nhx-tab @(currentSlide == 1 ? "active" : "")" aria-selected="@(currentSlide == 1 ? "true" : "false")" @onclick="() => SetSlide(1)">
            <span class="nhx-tab-no">02</span><span class="nhx-tab-name">STAMIX</span><span class="nhx-tab-bar"><i></i></span>
        </button>
    </div>
</section>

@code {
    private const int TotalSlides = 2;
    private static readonly TimeSpan SlideDuration = TimeSpan.FromSeconds(10);   // keep in sync with --nhx-ms in home-v3.css
    private int currentSlide;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized() => RestartTimer();

    private void RestartTimer() => (_timer ??= new System.Threading.Timer(OnTick)).Change(SlideDuration, SlideDuration);

    private void OnTick(object? state) => InvokeAsync(() =>
    {
        currentSlide = (currentSlide + 1) % TotalSlides;
        StateHasChanged();
    });

    private void NextSlide() { currentSlide = (currentSlide + 1) % TotalSlides; RestartTimer(); }
    private void PrevSlide() { currentSlide = (currentSlide - 1 + TotalSlides) % TotalSlides; RestartTimer(); }

    private void SetSlide(int index)
    {
        if (index < 0 || index >= TotalSlides) return;
        currentSlide = index;
        RestartTimer();
    }


    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
