@inject ContentState Content
@using Nuraherbex.UI.Components.Shop
@inject NavigationManager Nav

<section id="our-story" class="nh-story">
    <div class="nh-story-overlay"></div>
    @* Right Sky Floating Script Quote *@
    <div class="nh-story-script">
        <span>Healthier</span><br />
        <span>People</span><br />
        <span style="color:#732dbd; font-weight:600;">Brighter Tomorrows</span>
    </div>

    <div class="nh-story-inner">
        <div class="nh-story-box">
            <span class="nh-story-kicker">@Content.P("home.story.kicker")</span>
            
            <h2 class="nh-story-title">
                <span>@Content.P("home.story.title1")</span><br />
                @Content.P("home.story.title2")
            </h2>

            <p class="nh-story-text">
                @Content.P("home.story.text")
            </p>

            <button @onclick='() => Nav.NavigateTo("/our-story")' class="nh-story-btn" aria-label="Read our story">
                <span>@Content.P("home.story.button")</span>
                <span style="font-size: 15px; font-weight: 800;">→</span>
            </button>
        </div>
    </div>
</section>


<OurStoryDetail />
