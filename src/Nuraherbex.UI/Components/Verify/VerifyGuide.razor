<div class="space-y-8 animate-in fade-in duration-300">
    @* What You Can Verify *@
    <div class="space-y-3 text-left">
        <div>
            <h2 class="text-lg sm:text-xl font-bold text-white tracking-tight font-sans">What You Can Verify</h2>
            <p class="text-xs text-zinc-400 mt-0.5">Get complete information about your product, all in one place.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex items-center shadow-lg cursor-default">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-950/70 border border-purple-800/60 flex items-center justify-center text-purple-400 shrink-0">
                        <Icon Name="FileText" Size="18" />
                    </div>
                    <div class="space-y-0.5">
                        <div class="text-xs font-semibold text-zinc-100">Lab Test Reports</div>
                        <div class="text-[11px] text-zinc-400">Third-party report access</div>
                    </div>
                </div>
            </div>

            <div class="p-3.5 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex items-center shadow-lg cursor-default">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-950/70 border border-purple-800/60 flex items-center justify-center text-purple-400 shrink-0">
                        <Icon Name="Award" Size="18" />
                    </div>
                    <div class="space-y-0.5">
                        <div class="text-xs font-semibold text-zinc-100">Certifications</div>
                        <div class="text-[11px] text-zinc-400">View compliance documents</div>
                    </div>
                </div>
            </div>

            <div class="p-3.5 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex items-center shadow-lg cursor-default">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-950/70 border border-purple-800/60 flex items-center justify-center text-purple-400 shrink-0">
                        <Icon Name="Package" Size="18" />
                    </div>
                    <div class="space-y-0.5">
                        <div class="text-xs font-semibold text-zinc-100">Batch Details</div>
                        <div class="text-[11px] text-zinc-400">MFG date, expiry and status</div>
                    </div>
                </div>
            </div>

            <div class="p-3.5 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex items-center shadow-lg cursor-default">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-950/70 border border-purple-800/60 flex items-center justify-center text-purple-400 shrink-0">
                        <Icon Name="ShieldCheck" Size="18" />
                    </div>
                    <div class="space-y-0.5">
                        <div class="text-xs font-semibold text-zinc-100">Product Authenticity</div>
                        <div class="text-[11px] text-zinc-400">Match jar batch with our records</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* How It Works *@
    <div class="space-y-3 text-left">
        <div>
            <h2 class="text-lg sm:text-xl font-bold text-white tracking-tight font-sans">How It Works</h2>
            <p class="text-xs text-zinc-400 mt-0.5">Quick and simple verification in 3 steps.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 relative items-stretch">
            @* Step 1 *@
            <div class="p-4 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex flex-col justify-between space-y-4 shadow-lg">
                <div class="flex items-center justify-between">
                    <span class="w-6 h-6 rounded-full bg-purple-600 text-white font-bold text-xs flex items-center justify-center font-mono">1</span>
                    <div class="text-purple-400/60 hidden md:block">
                        <Icon Name="ArrowRight" Size="14" />
                    </div>
                </div>

                <div class="py-2 flex items-center justify-center text-purple-400">
                    <Icon Name="Scan" Size="34" StrokeWidth="1.75" />
                </div>

                <div class="space-y-1">
                    <div class="text-xs font-bold text-zinc-100">Enter Batch Number</div>
                    <p class="text-[11px] text-zinc-400 leading-relaxed">Type the batch number from your jar or scan the QR code.</p>
                </div>
            </div>

            @* Step 2 *@
            <div class="p-4 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex flex-col justify-between space-y-4 shadow-lg">
                <div class="flex items-center justify-between">
                    <span class="w-6 h-6 rounded-full bg-purple-600 text-white font-bold text-xs flex items-center justify-center font-mono">2</span>
                    <div class="text-purple-400/60 hidden md:block">
                        <Icon Name="ArrowRight" Size="14" />
                    </div>
                </div>

                <div class="py-2 flex items-center justify-center text-purple-400">
                    <Icon Name="FileText" Size="34" StrokeWidth="1.75" />
                </div>

                <div class="space-y-1">
                    <div class="text-xs font-bold text-zinc-100">View Reports &amp; Batch Details</div>
                    <p class="text-[11px] text-zinc-400 leading-relaxed">Access lab reports, certifications and product information.</p>
                </div>
            </div>

            @* Step 3 *@
            <div class="p-4 rounded-xl bg-[#0e0b16] border border-purple-900/30 flex flex-col justify-between space-y-4 shadow-lg">
                <div class="flex items-center justify-between">
                    <span class="w-6 h-6 rounded-full bg-purple-600 text-white font-bold text-xs flex items-center justify-center font-mono">3</span>
                </div>

                <div class="py-2 flex items-center justify-center text-purple-400">
                    <svg class="w-8 h-9 text-purple-400" viewBox="0 0 36 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="7" y="2" width="22" height="5" rx="1.5" stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.2" />
                        <rect x="4" y="7" width="28" height="32" rx="4" stroke="currentColor" stroke-width="2" fill="currentColor" fill-opacity="0.1" />
                        <rect x="8" y="15" width="20" height="12" rx="2" fill="currentColor" fill-opacity="0.3" />
                        <text x="18" y="23" fill="currentColor" font-size="5" font-weight="bold" font-family="sans-serif" text-anchor="middle">STAMIX</text>
                    </svg>
                </div>

                <div class="space-y-1">
                    <div class="text-xs font-bold text-zinc-100">Match With Your Jar</div>
                    <p class="text-[11px] text-zinc-400 leading-relaxed">Confirm the details match your product for complete peace of mind.</p>
                </div>
            </div>
        </div>
    </div>
</div>
