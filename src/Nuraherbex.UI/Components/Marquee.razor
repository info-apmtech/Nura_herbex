@inject ContentState ContentState
@implements IDisposable

<div class="relative w-full overflow-hidden bg-black border-y border-white/10 py-3.5 z-20">
  <div class="flex w-max animate-ticker">
    <div class="flex items-center gap-8 px-4 whitespace-nowrap">
      @foreach (var text in Items)
      {
        <div class="flex items-center gap-8">
          <span class="text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white/80">@text</span>
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_#c084fc]"></span>
        </div>
      }
    </div>

    <div class="flex items-center gap-8 px-4 whitespace-nowrap" aria-hidden="true">
      @foreach (var text in Items)
      {
        <div class="flex items-center gap-8">
          <span class="text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-white/80">@text</span>
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_#c084fc]"></span>
        </div>
      }
    </div>
  </div>
</div>

@code {
    private static readonly string[] Defaults =
    {
        "WHOLE ASHWAGANDHA ROOT", "SHATAVARI ROOT", "HIMALAYAN SHILAJIT", "SAFED MUSLI", "ZERO MALTODEXTRIN",
        "NO ARTIFICIAL SWEETENERS", "GMP CERTIFIED FACILITY", "FORMULATED BY A UNANI PHYSICIAN",
    };
    private IEnumerable<string> Items => ContentState.Content?.Marquee is { Count: > 0 } m ? m : Defaults;

    protected override void OnInitialized() => ContentState.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => ContentState.Changed -= OnChanged;
}
