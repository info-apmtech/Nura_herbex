@inject ApiClient Api
@inject AdminSession AdminAuth

<div class="fp">
    <div class="ld-card">
        <h4>How the 15-day journey works</h4>
        <p class="fp-intro">When an order is <strong>delivered</strong>, the customer is moved into this plan. Each step below becomes a task on the lead's owner, due at 10 AM on its day. The owner is reminded <strong>@(_s?.ReminderDays ?? 2) days before</strong> and again when it is due. Message steps can be sent with one click — or automatically, once you switch that on.</p>

        @if (_s is not null)
        {
            <ol class="fp-steps">
                @foreach (var s in _s.Steps)
                {
                    <li>
                        <span class="fp-day">Day @s.Day</span>
                        <div>
                            <strong>@s.Title.Substring(s.Title.IndexOf('·') + 1).Trim()</strong>
                            <span class="@($"fu-tag {(s.Type == FollowUpTypes.Call ? "warn" : "")}")">@(s.Type == FollowUpTypes.Call ? "Employee calls" : s.HasTemplate ? "Auto-send ready" : "Employee sends")</span>
                            <p>@s.Message</p>
                        </div>
                    </li>
                }
            </ol>
        }
    </div>

    @if (AdminAuth.Can("team", 2) && _s is not null)
    {
        <div class="ld-card">
            <h4>Settings</h4>
            @if (!string.IsNullOrEmpty(_msg)) { <div class="@($"fu-flash {(_ok ? "ok" : "bad")}")" role="status">@_msg</div> }

            <label class="fp-toggle">
                <input type="checkbox" checked="@_s.JourneyEnabled" disabled="@_busy" @onchange="OnJourney" />
                <span class="em-track"><span class="em-knob"></span></span>
                <span><strong>Start the 15-day journey for delivered orders</strong><small>Turn off to stop creating new journeys. Tasks already created stay.</small></span>
            </label>

            <label class="fp-toggle">
                <input type="checkbox" checked="@_s.AutoSend" disabled="@_busy" @onchange="OnAuto" />
                <span class="em-track"><span class="em-knob"></span></span>
                <span><strong>Send message steps automatically</strong>
                    <small>Needs a Meta-approved WhatsApp template for the step (@_s.Steps.Count(x => x.HasTemplate) of @_s.Steps.Count(x => x.Type != FollowUpTypes.Call) message steps have one) and the customer must be marked <em>opted in</em>. Sent between 9 AM and 8 PM only. Otherwise the step stays a task for the owner.</small></span>
            </label>

            <label class="fu-field fp-days">Remind owners
                <select value="@_s.ReminderDays" disabled="@_busy" @onchange="OnDays">
                    @foreach (var d in new[] { 0, 1, 2, 3, 5, 7 }) { <option value="@d">@(d == 0 ? "only when due" : d + " day" + (d == 1 ? "" : "s") + " before")</option> }
                </select>
            </label>
        </div>
    }

    <div class="ld-card">
        <h4>Other automatic follow-ups</h4>
        <ul class="fp-list">
            <li><strong>Order has no courier booking</strong> — a paid order still without a shipment after 2 hours.</li>
            <li><strong>Shipment not moving</strong> — no courier update for 3 days.</li>
            <li><strong>Returned to origin / cancelled</strong> — call the customer to rebook or refund.</li>
            <li><strong>Overdue escalation</strong> — a task a full day late alerts the administrators.</li>
        </ul>
        <p class="fu-hint">These appear in the To do list as "Order alert". Only orders placed after the feature went live create tasks.</p>
    </div>
</div>

@code {
    private FollowUpSettingsDto? _s;
    private string? _msg;
    private bool _ok, _busy;

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.AdminFollowUpSettingsAsync();
        if (res.Success) _s = res; else _msg = res.Message;
    }

    private Task OnJourney(ChangeEventArgs e) { _s!.JourneyEnabled = e.Value is true; return SaveAsync(); }
    private Task OnAuto(ChangeEventArgs e) { _s!.AutoSend = e.Value is true; return SaveAsync(); }
    private Task OnDays(ChangeEventArgs e) { _s!.ReminderDays = int.TryParse(e.Value?.ToString(), out var d) ? d : 2; return SaveAsync(); }

    private async Task SaveAsync()
    {
        if (_s is null) return;
        _busy = true;
        var res = await Api.AdminSaveFollowUpSettingsAsync(new FollowUpSettingsRequest { JourneyEnabled = _s.JourneyEnabled, AutoSend = _s.AutoSend, ReminderDays = _s.ReminderDays });
        _ok = res.Success; _msg = res.Message;
        _busy = false;
    }
}
