@inject ApiClient Api

<div class="ld em">
    <div class="em-head">
        <div><h3>Departments</h3><p>Group people and tasks by team, for example Sales, Support or Operations. A head can be named for each.</p></div>
        <div class="em-head-actions"><button type="button" class="ld-btn primary" @onclick="StartCreate"><Icon Name="Plus" Size="14" /> Add department</button></div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="@($"em-note {(_ok ? "ok" : "bad")}")" role="status"><Icon Name="@(_ok ? "CheckCircle2" : "AlertCircle")" Size="15" /><span>@_message</span><button type="button" class="em-x" aria-label="Dismiss" @onclick="() => _message = null"><Icon Name="X" Size="14" /></button></div>
    }

    @if (_form is not null)
    {
        <form class="ld-card em-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h4>@(_editingId is null ? "New department" : "Edit department")</h4>
            <div class="em-grid">
                <label>Name<input type="text" required maxlength="120" @bind="_form.Name" @bind:event="oninput" placeholder="e.g. Sales" /></label>
                <label>Head of department
                    <select @bind="_form.HeadEmployeeId">
                        <option value="@((long?)null)">Not set</option>
                        @foreach (var p in _people) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </label>
                <label class="org-wide">What this team does<input type="text" maxlength="400" @bind="_form.Description" @bind:event="oninput" placeholder="Optional" /></label>
                <label class="em-check"><input type="checkbox" @bind="_form.IsActive" /> <span>Active (can be picked for people and tasks)</span></label>
            </div>
            <div class="ld-actions">
                <button type="button" class="ld-btn" @onclick="() => _form = null">Cancel</button>
                <button type="submit" class="ld-btn primary" disabled="@_busy">@(_busy ? "Saving…" : "Save department")</button>
            </div>
        </form>
    }

    @if (_loading) { <div class="ld-card ld-empty">Loading…</div> }
    else if (_items.Count == 0) { <div class="ld-card ld-empty"><strong>No departments yet</strong>Add your first department, for example Sales or Operations.</div> }
    else
    {
        <div class="org-cards">
            @foreach (var d in _items)
            {
                var dep = d;
                <article class="org-card @(dep.IsActive ? "" : "is-off")" @key="dep.Id">
                    <header>
                        <span class="org-tile" style="background:@Tint(dep.Id)">@dep.Name[..1].ToUpperInvariant()</span>
                        <div><h4>@dep.Name</h4><p>@(string.IsNullOrWhiteSpace(dep.Description) ? "No description" : dep.Description)</p></div>
                        <span class="@($"ld-pill {(dep.IsActive ? "converted" : "not-interested")}")">@(dep.IsActive ? "Active" : "Inactive")</span>
                    </header>
                    <div class="org-head-row"><Icon Name="UserRound" Size="14" /><span>Head</span><strong>@(dep.HeadName ?? "Not assigned")</strong></div>
                    <dl class="org-stats">
                        <div><dd>@dep.EmployeeCount</dd><dt>People</dt></div>
                        <div><dd>@dep.DesignationCount</dd><dt>Designations</dt></div>
                        <div><dd>@dep.OpenTasks</dd><dt>Open tasks</dt></div>
                    </dl>
                    <footer>
                        @if (_removingId == dep.Id)
                        {
                            <span class="em-confirm">Delete @dep.Name?
                                <button type="button" class="ld-btn danger" disabled="@_busy" @onclick="() => RemoveAsync(dep)">Yes, delete</button>
                                <button type="button" class="ld-btn" @onclick="() => _removingId = null">Keep</button></span>
                        }
                        else
                        {
                            <button type="button" class="ld-btn" @onclick="() => StartEdit(dep)"><Icon Name="Edit3" Size="13" /> Edit</button>
                            <button type="button" class="ld-btn danger-outline" @onclick="() => _removingId = dep.Id"><Icon Name="Trash2" Size="13" /> Delete</button>
                        }
                    </footer>
                </article>
            }
        </div>
    }
</div>

@code {
    private static readonly string[] Tints = ["#235b40", "#2f6f8f", "#7a5aa6", "#b5792a", "#a24b5a", "#3f7d7a", "#5b6f2c"];
    private static string Tint(long id) => Tints[(int)(id % Tints.Length)];
    private List<DepartmentDto> _items = new();
    private List<EmployeeDto> _people = new();
    private DepartmentSaveRequest? _form;
    private long? _editingId, _removingId;
    private bool _loading = true, _busy, _ok;
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var res = await Api.AdminDepartmentsAsync();
        if (res.Success) _items = res.Departments; else Say(res.Message ?? "Could not load departments.", false);
        var team = await Api.AdminEmployeesAsync();
        if (team.Success) _people = team.Employees.Where(e => e.IsActive).ToList();
        _loading = false;
    }

    private void Say(string? text, bool ok) { _message = text; _ok = ok; }
    private void StartCreate() { _editingId = null; _removingId = null; _form = new(); }
    private void StartEdit(DepartmentDto d) { _editingId = d.Id; _removingId = null; _form = new() { Name = d.Name, Description = d.Description, HeadEmployeeId = d.HeadEmployeeId, IsActive = d.IsActive }; }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        _busy = true;
        var res = await Api.AdminSaveDepartmentAsync(_editingId, _form);
        Say(res.Message, res.Success);
        if (res.Success) { _form = null; await LoadAsync(); }
        _busy = false;
    }

    private async Task RemoveAsync(DepartmentDto d)
    {
        _busy = true;
        var res = await Api.AdminDeleteDepartmentAsync(d.Id);
        Say(res.Message, res.Success);
        _removingId = null;
        if (res.Success) await LoadAsync();
        _busy = false;
    }
}
