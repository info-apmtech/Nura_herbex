@inject ApiClient Api
@inject BrowserInterop Browser

<div class="space-y-4">

    <FilterPanel T="OrderDto" Items="Orders" Defs="_defs" Noun="orders" OnFiltered="OnFiltered" />

    <DataTable TItem="OrderDto" Items="_view" Columns="_cols" Loading="Loading" Title="Orders" FileName="nura-orders" PageSize="10"
               SearchPlaceholder="Search by customer, phone, order ID or AWB"
               EmptyText="No customer orders recorded yet. Live orders placed from the storefront or checkout will appear here.">
        <Toolbar>
            <button type="button" @onclick="OpenAddOrder"
                    class="px-3.5 py-1.5 rounded-md bg-white hover:bg-zinc-200 text-zinc-950 font-medium text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer shadow-sm">
                <Icon Name="Plus" Size="14" />
                <span>Create Test Order</span>
            </button>
        </Toolbar>
        <RowActions Context="order">
            <button @onclick="() => OpenOrder(order)"
                    class="px-2.5 py-1 rounded-md bg-zinc-800 hover:bg-zinc-700 border border-zinc-700/60 text-zinc-200 text-xs font-medium transition-colors cursor-pointer">
                Track Progress
            </button>
        </RowActions>
    </DataTable>

</div>

@* ======================================================================= *@
@* MODAL: SHIPROCKET ORDER DELIVERY TIMELINE (+ order actions)              *@
@* ======================================================================= *@
@if (_selected is not null)
{
    var o = _selected;
    var payText = o.PaymentStatus == "PAID"
        ? $"Paid{(string.IsNullOrEmpty(o.PaymentRef) ? "" : " · " + o.PaymentRef)}"
        : o.PaymentMethod == "COD" ? "COD · due on delivery" : "Unpaid · pending gateway";
    var payTone = o.PaymentStatus == "PAID" ? "is-ok" : o.PaymentMethod == "COD" ? "is-info" : "is-warn";
    <div @onclick="CloseOrder" class="ot-overlay">
        <div @onclick:stopPropagation class="ot-dialog" role="dialog" aria-modal="true" aria-label="@($"Order {o.Id}")">

            <header class="ot-head">
                <div class="ot-head-text">
                    <span class="ot-eyebrow">Order tracking</span>
                    <h3>Order @o.Id</h3>
                    <p>@o.CustomerName · @o.CustomerPhone</p>
                </div>
                <div class="ot-head-chips">
                    <span class="@($"ot-chip {payTone}")">@payText</span>
                    <span class="ot-chip">@(string.IsNullOrWhiteSpace(o.DeliveryStatus) ? o.FulfillmentStatus : o.DeliveryStatus)</span>
                </div>
                <button type="button" @onclick="CloseOrder" class="ot-x" aria-label="Close"><Icon Name="X" Size="16" /></button>
            </header>

            <div class="ot-body">
                @* ---------------- left: shipment details + milestones ---------------- *@
                <div class="ot-col">
                    <dl class="ot-facts">
                        <div><dt>Courier</dt><dd>@(string.IsNullOrEmpty(o.ShiprocketCourier) ? (o.Courier ?? "Pending assignment") : o.ShiprocketCourier)</dd></div>
                        <div>
                            <dt>AWB / tracking code</dt>
                            <dd>
                                <span>@(string.IsNullOrEmpty(o.ShiprocketAwb) ? "Not assigned yet" : o.ShiprocketAwb)</span>
                                @if (!string.IsNullOrEmpty(o.ShiprocketAwb))
                                {
                                    var awb = o.ShiprocketAwb!;
                                    <button type="button" @onclick="() => CopyAsync(awb)" class="ot-copy" title="Copy AWB" aria-label="Copy AWB">
                                        @if (_copiedText == awb) { <Icon Name="Check" Size="13" /> } else { <Icon Name="Copy" Size="13" /> }
                                    </button>
                                }
                            </dd>
                        </div>
                        <div><dt>Destination</dt><dd>@o.ShippingAddress?.City, @o.ShippingAddress?.State @o.ShippingAddress?.Pincode</dd></div>
                        <div><dt>Order total</dt><dd>₹@o.TotalAmount.ToString("N0")</dd></div>
                    </dl>

                    <section class="ot-timeline-box">
                        <h4>Logistics milestones</h4>
                        @if (o.DeliveryTrackingEvents.Count == 0)
                        {
                            <p class="ot-empty">No courier updates yet.</p>
                        }
                        else
                        {
                            <ol class="ot-timeline">
                                @foreach (var ev in o.DeliveryTrackingEvents)
                                {
                                    <li class="@($"{(ev.Active ? "is-active" : ev.Done ? "is-done" : "")}")">
                                        <span class="ot-dot"></span>
                                        <div class="ot-ev">@ev.Status</div>
                                        @if (!string.IsNullOrWhiteSpace(ev.Time)) { <div class="ot-time">@ev.Time</div> }
                                    </li>
                                }
                            </ol>
                        }
                    </section>
                </div>

                @* ---------------- right: actions ---------------- *@
                <div class="ot-col">
            @* Order actions, grouped by purpose: Shipping, Documents & messages, Status, Danger zone *@
            <div class="oa">
                <h4 class="oa-title">Order actions</h4>

                @if (!string.IsNullOrEmpty(_actionMessage))
                {
                    <div class="@($"oa-msg {(_actionOk ? "is-ok" : "is-bad")}")" role="status">
                        <Icon Name="@(_actionOk ? "CheckCircle2" : "AlertCircle")" Size="15" Class="shrink-0" />
                        <span>@_actionMessage</span>
                    </div>
                }

                @* ---- Shipping ---- *@
                @{
                    var canBook = string.IsNullOrEmpty(o.ShiprocketAwb) && o.FulfillmentStatus == "PENDING";
                    var shadowfaxLive = o.Courier == "Shadowfax" && !string.IsNullOrEmpty(o.ShiprocketAwb) && o.FulfillmentStatus is not ("CANCELLED" or "DELIVERED" or "RTO");
                    var canLabel = shadowfaxLive && o.FulfillmentStatus is not ("PICKED_UP" or "IN_TRANSIT" or "OUT_FOR_DELIVERY");
                }
                @if (canBook || canLabel || !string.IsNullOrWhiteSpace(_shippingLabelUrl))
                {
                    <section class="oa-group">
                        <h5>Shipping</h5>
                        @if (canBook)
                        {
                            @if (o.PaymentMethod == "COD" || o.PaymentStatus == "PAID")
                            {
                                @if (o.FulfillmentReadyAt is null)
                                {
                                    <p class="oa-hint">Step 1: enter the packed parcel size, then press Mark packed.</p>
                                    <div class="oa-fields">
                                        <label>Weight (kg)<input type="number" min="0.001" step="0.001" @bind="_parcelWeight" /></label>
                                        <label>Length (cm)<input type="number" min="0.01" step="0.01" @bind="_parcelLength" /></label>
                                        <label>Width (cm)<input type="number" min="0.01" step="0.01" @bind="_parcelBreadth" /></label>
                                        <label>Height (cm)<input type="number" min="0.01" step="0.01" @bind="_parcelHeight" /></label>
                                    </div>
                                }
                                else { <p class="oa-hint">Parcel is packed. Book the courier pickup.</p> }
                                <div class="oa-row">
                                    @if (o.FulfillmentReadyAt is null)
                                    {
                                        <button type="button" disabled="@_busy" @onclick="MarkReadyAsync" class="oa-btn oa-primary"><Icon Name="CheckCircle2" Size="14" /><span>Mark packed</span></button>
                                    }
                                    <button type="button" disabled="@(_busy || o.FulfillmentReadyAt is null)" @onclick="RetryShipmentAsync" class="oa-btn oa-primary"><Icon Name="Truck" Size="14" /><span>Book / retry pickup</span></button>
                                </div>
                            }
                            else
                            {
                                <p class="oa-hint is-warn">Verify the online payment before shipping this order.</p>
                            }
                        }
                        @if (canLabel || !string.IsNullOrWhiteSpace(_shippingLabelUrl))
                        {
                            <div class="oa-row">
                                @if (canLabel)
                                {
                                    <button type="button" disabled="@_busy" @onclick="GenerateShipmentLabelAsync" class="oa-btn oa-neutral"><Icon Name="FileText" Size="14" /><span>Generate PDF label</span></button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_shippingLabelUrl))
                                {
                                    <a href="@_shippingLabelUrl" target="_blank" rel="noopener noreferrer" class="oa-btn oa-neutral"><Icon Name="ExternalLink" Size="14" /><span>Open / print label</span></a>
                                }
                            </div>
                        }
                    </section>
                }

                @* ---- Documents & customer messages ---- *@
                <section class="oa-group">
                    <h5>Invoice &amp; customer messages</h5>
                    <div class="oa-row">
                        <button type="button" disabled="@_busy" @onclick="OpenInvoiceAsync" class="oa-btn oa-info" title="Opens the GST invoice (18% GST included in the price)"><Icon Name="FileText" Size="14" /><span>View GST invoice</span></button>
                        <button type="button" disabled="@_busy" @onclick="@(() => SendEmailAsync("confirmation"))" class="oa-btn oa-neutral"><Icon Name="Mail" Size="14" /><span>Email: order confirmation</span></button>
                        <button type="button" disabled="@_busy" @onclick="@(() => SendEmailAsync("delivered"))" class="oa-btn oa-neutral"><Icon Name="Mail" Size="14" /><span>Email: delivered</span></button>
                        <button type="button" disabled="@_busy" @onclick="SendWhatsAppUpdateAsync" class="oa-btn oa-success"><Icon Name="MessageCircle" Size="14" /><span>Send WhatsApp update</span></button>
                    </div>
                </section>

                @* ---- Status ---- *@
                @if (o.DeliveryStatus != "Delivered" || o.PaymentStatus == "REFUND_PENDING")
                {
                    <section class="oa-group">
                        <h5>Order status</h5>
                        <div class="oa-row">
                            @if (o.DeliveryStatus != "Delivered")
                            {
                                <button type="button" disabled="@_busy" @onclick="MarkDeliveredAsync" class="oa-btn oa-success"><Icon Name="CheckCircle2" Size="14" /><span>Mark as delivered</span></button>
                            }
                            @if (o.PaymentStatus == "REFUND_PENDING")
                            {
                                <button type="button" disabled="@_busy" @onclick="MarkRefundedAsync" class="oa-btn oa-warn" title="Press after you have returned the money to the customer"><Icon Name="CheckCircle2" Size="14" /><span>Mark as refunded</span></button>
                            }
                        </div>
                    </section>
                }

                @* ---- Danger zone: kept apart so it cannot be pressed by mistake ---- *@
                @{
                    var canCancelOrder = o.FulfillmentStatus is not ("CANCELLED" or "DELIVERED" or "RTO" or "OUT_FOR_DELIVERY");
                }
                @if (shadowfaxLive || canCancelOrder || CanDelete(o))
                {
                    <section class="oa-group oa-danger-zone">
                        <h5>Cancel or remove</h5>
                        <div class="oa-row">
                            @if (shadowfaxLive)
                            {
                                <button type="button" disabled="@_busy" @onclick="CancelShipmentAsync" class="oa-btn oa-danger"><Icon Name="AlertCircle" Size="14" /><span>Cancel shipment</span></button>
                            }
                            @if (canCancelOrder)
                            {
                                <button type="button" disabled="@_busy" @onclick="CancelOrderAsync" class="oa-btn oa-danger" title="Cancels the courier booking, restores stock and tells the customer"><Icon Name="X" Size="14" /><span>Cancel order</span></button>
                            }
                            @if (CanDelete(o))
                            {
                                <button type="button" disabled="@_busy" @onclick="DeleteOrderAsync" class="oa-btn oa-danger" title="Permanently removes this order"><Icon Name="Trash2" Size="14" /><span>Delete order</span></button>
                            }
                        </div>
                    </section>
                }
            </div>
                </div>
            </div>

            <footer class="ot-foot"><button type="button" @onclick="CloseOrder" class="oa-btn oa-neutral">Close</button></footer>
        </div>
    </div>
}

@* ======================================================================= *@
@* MODAL: CREATE MANUAL TEST ORDER                                          *@
@* ======================================================================= *@
@if (_showAdd)
{
    <div @onclick="CloseAddOrder"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm animate-in fade-in text-left">
        <div @onclick:stopPropagation
             class="relative w-full max-w-lg bg-[#121215] border border-zinc-800 rounded-xl p-6 shadow-2xl space-y-4">
            <button @onclick="CloseAddOrder"
                    class="absolute top-4 right-4 w-7 h-7 rounded-md bg-zinc-800/80 hover:bg-zinc-800 border border-zinc-700/60 flex items-center justify-center text-zinc-400 hover:text-zinc-200 cursor-pointer transition-colors">
                <Icon Name="X" Size="15" />
            </button>

            <div class="space-y-1">
                <h3 class="text-base font-semibold text-zinc-100">
                    Create Test Order
                </h3>
                <p class="text-xs text-zinc-500">
                    Simulate an order to verify database records &amp; courier tracking.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_addError))
            {
                <div class="p-2.5 rounded-lg bg-red-500/10 border border-red-500/20 text-xs text-red-400 flex items-center gap-2">
                    <Icon Name="AlertCircle" Size="14" Class="shrink-0 text-red-400" />
                    <span>@_addError</span>
                </div>
            }

            <form @onsubmit="CreateOrderAsync" @onsubmit:preventDefault class="space-y-3 text-xs">
                <div class="space-y-1">
                    <label class="text-zinc-300 font-medium block">Customer Full Name</label>
                    <input type="text" required placeholder="e.g. Siddharth Rao"
                           @bind="_new.CustomerName" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-zinc-300 font-medium block">Mobile Number</label>
                        <input type="tel" required placeholder="+91 98765 43210"
                               @bind="_new.CustomerPhone" @bind:event="oninput"
                               class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-zinc-300 font-medium block">Email</label>
                        <input type="email" required placeholder="siddharth@@example.com"
                               @bind="_new.CustomerEmail" @bind:event="oninput"
                               class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-zinc-300 font-medium block">Delivery Address</label>
                    <input type="text" required placeholder="Street, locality, landmark"
                           @bind="_new.Address.AddressLine1" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                </div>

                <div class="grid grid-cols-3 gap-2">
                    <input type="text" placeholder="City"
                           @bind="_new.Address.City" @bind:event="oninput"
                           class="px-3 py-1.5 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                    <input type="text" placeholder="State"
                           @bind="_new.Address.State" @bind:event="oninput"
                           class="px-3 py-1.5 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                    <input type="text" placeholder="Pincode"
                           @bind="_new.Address.Pincode" @bind:event="oninput"
                           class="px-3 py-1.5 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                </div>

                <div class="grid grid-cols-2 gap-3 pt-1">
                    <div class="space-y-1">
                        <label class="text-zinc-300 font-medium block">Product</label>
                        <select @bind="_new.ProductId"
                                class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500">
                            @foreach (var product in _catalog.Where(p => p.Status == "active" && p.StockQuantity > 0)) { <option value="@product.Id">@product.Name (₹@AdminFmt.Inr(product.Price))</option> }
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-zinc-300 font-medium block">Quantity</label>
                        <input type="number" min="1" max="10"
                               @bind="_new.Quantity" @bind:event="oninput"
                               class="w-full px-3 py-2 rounded-md bg-zinc-950 border border-zinc-800 text-zinc-200 outline-none focus:border-zinc-500" />
                    </div>
                </div>

                                <div class="admin-fields">
                    <label>Coupon code (optional)<input maxlength="64" @bind="_new.CouponCode" placeholder="e.g. WELCOME10" /></label>
                    <label>Payment method<select @bind="_new.PaymentMethod"><option value="COD">Cash on delivery</option><option value="ONLINE">Online / manual payment</option></select></label>
                    @if (_new.PaymentMethod == "ONLINE") { <label class="admin-span-2"><span><input type="checkbox" @bind="_new.MarkPaid" /> Payment already collected</span><small>Only select this after confirming receipt. This records payment; it does not charge the customer.</small></label> }
                </div><div class="pt-2 flex gap-2.5">
                    <button type="submit" disabled="@(_creating || string.IsNullOrEmpty(_new.ProductId))"
                            class="flex-1 py-2 px-3 rounded-md bg-white hover:bg-zinc-200 text-zinc-950 font-medium text-xs tracking-tight shadow-sm cursor-pointer transition-colors disabled:opacity-60">
                        @(_creating ? "Creating..." : "Create order")
                    </button>
                    <button type="button" @onclick="CloseAddOrder"
                            class="px-4 py-2 rounded-md bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-white font-medium text-xs cursor-pointer transition-colors">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public List<OrderDto> Orders { get; set; } = new();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnReload { get; set; }

    private string _copiedText = "";
    private IReadOnlyList<OrderDto> _view = Array.Empty<OrderDto>();
    private Task OnFiltered(IReadOnlyList<OrderDto> v) { _view = v; StateHasChanged(); return Task.CompletedTask; }

    private static string Courier(OrderDto o) => string.IsNullOrWhiteSpace(o.ShiprocketCourier) ? o.Courier ?? "" : o.ShiprocketCourier;
    private static string PaymentLabel(OrderDto o) => o.PaymentStatus == "PAID" ? "Online · paid" : o.PaymentMethod == "COD" ? "COD" : o.PaymentStatus == "FAILED" ? "Online · failed" : "Online · pending";
    private static string StatusTone(OrderDto o) => o.DeliveryStatus switch { "Delivered" => "good", "Payment Pending" => "warn", _ => "muted" };

    // Filters: every one reads its choices from the orders themselves, with counts.
    private readonly List<FilterDef<OrderDto>> _defs =
    [
        new() { Label = "Order ID / customer", Kind = FilterKind.Text, Value = o => $"{o.Id} {o.CustomerName}", Placeholder = "Order ID or customer name" },
        new() { Label = "Phone", Kind = FilterKind.Text, Value = o => o.CustomerPhone, Phone = true, Placeholder = "Mobile number" },
        new() { Label = "AWB", Kind = FilterKind.Text, Value = o => o.ShiprocketAwb, Placeholder = "Courier AWB" },
        new() { Label = "Delivery status", Kind = FilterKind.Chips, Value = o => o.DeliveryStatus },
        new() { Label = "Payment", Kind = FilterKind.Chips, Value = PaymentLabel },
        new() { Label = "Courier", Kind = FilterKind.Select, Value = Courier },
        new() { Label = "City", Kind = FilterKind.Select, Value = o => o.ShippingAddress?.City },
        new() { Label = "State", Kind = FilterKind.Select, Value = o => o.ShippingAddress?.State },
        new() { Label = "Order date", Kind = FilterKind.Date, Date = o => o.CreatedAt.ToLocalTime() },
        new() { Label = "Amount (Rs)", Kind = FilterKind.Range, Number = o => o.TotalAmount },
    ];

    private List<DataColumn<OrderDto>> _cols = [];

    protected override void OnInitialized()
    {
        _view = Orders;
        _cols =
        [
            new() { Header = "Order ID", Text = o => o.Id, SortKey = o => o.Id, Class = "font-mono" },
            new() { Header = "Date", Text = o => o.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"), SortKey = o => o.CreatedAt },
            new() { Header = "Customer", Text = o => o.CustomerName, Cell = o => b => { b.OpenElement(0, "div"); b.AddContent(1, o.CustomerName); b.CloseElement(); b.OpenElement(2, "small"); b.AddContent(3, o.ShippingAddress is null ? "" : $"{o.ShippingAddress.City}, {o.ShippingAddress.State}"); b.CloseElement(); } },
            new() { Header = "Phone", Text = o => o.CustomerPhone ?? "" },
            new() { Header = "Email", Text = o => o.CustomerEmail ?? "", Hidden = true },
            new() { Header = "City", Text = o => o.ShippingAddress?.City ?? "", Hidden = true },
            new() { Header = "State", Text = o => o.ShippingAddress?.State ?? "", Hidden = true },
            new() { Header = "Items", Text = o => string.Join("; ", o.Items.Select(i => $"{i.Name} x{i.Quantity}")), Sortable = false },
            new() { Header = "Subtotal (Rs)", Text = o => o.Subtotal.ToString("0.##"), SortKey = o => o.Subtotal, Align = "right", Hidden = true },
            new() { Header = "Discount (Rs)", Text = o => o.DiscountAmount.ToString("0.##"), SortKey = o => o.DiscountAmount, Align = "right", Hidden = true },
            new() { Header = "Shipping (Rs)", Text = o => o.ShippingFee.ToString("0.##"), SortKey = o => o.ShippingFee, Align = "right", Hidden = true },
            new() { Header = "Total (Rs)", Text = o => o.TotalAmount.ToString("0.##"), SortKey = o => o.TotalAmount, Align = "right", Cell = o => b => b.AddContent(0, "₹" + AdminFmt.Inr(o.TotalAmount)) },
            new() { Header = "Payment", Text = PaymentLabel, Tone = o => o.PaymentStatus == "PAID" ? "good" : o.PaymentStatus == "FAILED" ? "bad" : o.PaymentMethod == "COD" ? "muted" : "warn" },
            new() { Header = "Courier", Text = Courier },
            new() { Header = "AWB", Text = o => o.ShiprocketAwb ?? "", Cell = o => b =>
                {
                    var awb = o.ShiprocketAwb;
                    b.AddContent(0, string.IsNullOrEmpty(awb) ? "Pending AWB" : awb);
                    if (string.IsNullOrEmpty(awb)) return;
                    b.OpenElement(1, "button"); b.AddAttribute(2, "type", "button"); b.AddAttribute(3, "title", "Copy AWB"); b.AddAttribute(4, "style", "margin-left:6px;opacity:.6");
                    b.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => CopyAsync(awb)));
                    b.AddContent(6, _copiedText == awb ? "✓" : "⧉"); b.CloseElement();
                } },
            new() { Header = "Delivery status", Text = o => o.DeliveryStatus ?? "", Tone = StatusTone },
        ];
    }

    private OrderDto? _selected;
    private bool _busy;
    private decimal _parcelWeight, _parcelLength, _parcelBreadth, _parcelHeight;
    private string? _shippingLabelUrl;
    private string? _actionMessage;
    private bool _actionOk;

    private List<ProductDto> _catalog = new();
    private bool _showAdd;
    private bool _creating;
    private string? _addError;
    private AdminCreateOrderRequest _new = NewOrderForm();

    private static AdminCreateOrderRequest NewOrderForm() => new()
    {
        ProductId = "stamix-single",
        Quantity = 1,
        PaymentMethod = "COD",
        MarkPaid = false,
        Address = new AddressDto { Country = "India" },
    };

    private async Task CopyAsync(string text)
    {
        await Browser.CopyToClipboardAsync(text);
        _copiedText = text;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedText = "";
        StateHasChanged();
    }

    private void OpenOrder(OrderDto order)
    {
        _selected = order;
        _parcelWeight = order.ParcelWeightKg; _parcelLength = order.ParcelLengthCm;
        _parcelBreadth = order.ParcelBreadthCm; _parcelHeight = order.ParcelHeightCm;
        _shippingLabelUrl = order.ShippingLabelUrl;
        _actionMessage = null;
    }

    private void CloseOrder() { _selected = null; _shippingLabelUrl = null; _actionMessage = null; }

    private async Task OpenAddOrder() { _new = NewOrderForm(); _addError = null; _showAdd = true; var result = await Api.AdminProductsAsync(); _catalog = result.Products; _new.ProductId = _catalog.FirstOrDefault(p => p.Status == "active" && p.StockQuantity > 0)?.Id ?? ""; if (!result.Success || _new.ProductId == "") _addError = result.Message ?? "No active products with stock are available."; }
    private void CloseAddOrder() { _showAdd = false; }

    private async Task CreateOrderAsync()
    {
        _addError = null;
        _creating = true;
        _new.Address.Country = "India";
        _new.Quantity = Math.Clamp(_new.Quantity, 1, 10);
        var res = await Api.AdminCreateOrderAsync(_new);
        _creating = false;
        if (!res.Success)
        {
            _addError = res.Message ?? "Could not create the order.";
            return;
        }
        _showAdd = false;
        await OnReload.InvokeAsync();
    }

    private void ApplyUpdated(OrderDto? updated)
    {
        if (updated is not null) _selected = updated;
    }

    private async Task MarkReadyAsync()
    {
        if (_selected is null) return;
        _busy = true;
        var result = await Api.AdminMarkReadyAsync(_selected.Id, _parcelWeight, _parcelLength, _parcelBreadth, _parcelHeight);
        _actionOk = result.Success;
        _actionMessage = result.Success ? "Parcel marked packed. You can now book pickup." : result.Message;
        _busy = false;
        await ReloadSelectedAsync();
    }

    private async Task RetryShipmentAsync()
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminRetryShipmentAsync(_selected.Id);
        _actionOk = res.Success;
        var courier = string.IsNullOrWhiteSpace(res.Result?.Courier) ? "Courier" : res.Result.Courier;
        _actionMessage = res.Success
            ? (res.Result?.ShiprocketAwb is { Length: > 0 } awb ? $"{courier} shipment created. AWB: {awb}" : $"{courier} shipment created.")
            : (res.Message ?? "Shipment retry failed.");
        if (res.Success) _shippingLabelUrl = null;
        _busy = false;
        await ReloadSelectedAsync();
    }

    private async Task GenerateShipmentLabelAsync()
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminGenerateShipmentLabelAsync(_selected.Id);
        _actionOk = res.Success;
        _actionMessage = res.Success
            ? "Shadowfax PDF label is ready. Open it to print and attach it to the parcel."
            : (res.Message ?? "Could not generate the Shadowfax label.");
        if (res.Result?.ShippingLabelUrl is { Length: > 0 } labelUrl)
        {
            _shippingLabelUrl = labelUrl;
            _selected.ShippingLabelUrl = labelUrl;
        }
        _busy = false;
        await ReloadSelectedAsync();
    }

    /// <summary>Only cancelled or returned orders, and online orders that were never paid, can be deleted (and not while a refund is owed).</summary>
    private static bool CanDelete(OrderDto o) =>
        o.PaymentStatus != "REFUND_PENDING" && (o.FulfillmentStatus is "CANCELLED" or "RTO" || (o.PaymentMethod != "COD" && o.PaymentStatus != "PAID"));

    private async Task CancelOrderAsync()
    {
        if (_selected is null) return;
        var reason = await Browser.PromptAsync($"Cancel order {_selected.Id}? Enter a reason (optional), or press Cancel to keep the order.", "");
        if (reason is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminCancelOrderAsync(_selected.Id, reason);
        _actionOk = res.Success;
        _actionMessage = res.Message ?? (res.Success ? "Order cancelled." : "Could not cancel the order.");
        _busy = false;
        await OnReload.InvokeAsync();
        await ReloadSelectedAsync(false);
    }

    private async Task MarkRefundedAsync()
    {
        if (_selected is null) return;
        if (!await Browser.ConfirmAsync($"Confirm you have refunded Rs {_selected.TotalAmount:N0} to the customer for order {_selected.Id}?")) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminMarkRefundedAsync(_selected.Id);
        _actionOk = res.Success;
        _actionMessage = res.Message ?? (res.Success ? "Refund recorded." : "Could not record the refund.");
        _busy = false;
        await OnReload.InvokeAsync();
        await ReloadSelectedAsync(false);
    }

    private async Task DeleteOrderAsync()
    {
        if (_selected is null) return;
        if (!await Browser.ConfirmAsync($"Permanently delete order {_selected.Id}? This removes the order and its payment records and cannot be undone.")) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminDeleteOrderAsync(_selected.Id);
        _busy = false;
        if (res.Success) { CloseOrder(); await OnReload.InvokeAsync(); return; }
        _actionOk = false;
        _actionMessage = res.Message ?? "Could not delete the order.";
    }

    private async Task OpenInvoiceAsync()
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminInvoiceUrlAsync(_selected.Id);
        _busy = false;
        if (res.Success && !string.IsNullOrEmpty(res.Data)) await Browser.OpenUrlAsync(res.Data);
        else { _actionOk = false; _actionMessage = res.Message ?? "Could not open the invoice."; }
    }

    private async Task CancelShipmentAsync()
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminCancelShipmentAsync(_selected.Id);
        _actionOk = res.Success;
        _actionMessage = res.Message ?? (res.Success ? "Shipment cancelled." : "Could not cancel the shipment.");
        if (res.Success && res.Message?.Contains("queued", StringComparison.OrdinalIgnoreCase) != true)
            _shippingLabelUrl = null;
        _busy = false;
        await ReloadSelectedAsync();
    }

    private async Task MarkDeliveredAsync()
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminMarkDeliveredAsync(_selected.Id);
        _actionOk = res.Success;
        _actionMessage = res.Success ? "Order marked as delivered." : (res.Message ?? "Could not mark the order delivered.");
        if (res.Success) ApplyUpdated(res.Order);
        _busy = false;
        await OnReload.InvokeAsync();
        await ReloadSelectedAsync(false);
    }

    private async Task SendEmailAsync(string type)
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var res = await Api.AdminSendEmailAsync(_selected.Id, type);
        _actionOk = res.Success;
        _actionMessage = res.Message ?? (res.Success ? "Email sent." : "Email could not be sent.");
        _busy = false;
    }

    private async Task SendWhatsAppUpdateAsync()
    {
        if (_selected is null) return;
        _busy = true; _actionMessage = null;
        var o = _selected;
        var res = await Api.AdminWhatsAppSendAsync(new WhatsAppSendRequest
        {
            Phone = o.CustomerPhone,
            Text = $"Hi {o.CustomerName}, update on your order {o.Id}: {o.DeliveryStatus}",
            OrderId = o.Id,
        });
        _actionOk = res.Success;
        _actionMessage = res.Message ?? (res.Success ? "WhatsApp message sent." : "WhatsApp message could not be sent.");
        _busy = false;
    }

    /// <summary>Reloads the list and re-selects the currently open order so the drawer shows fresh data.</summary>
    private async Task ReloadSelectedAsync(bool reload = true)
    {
        var id = _selected?.Id;
        if (reload) await OnReload.InvokeAsync();
        if (id is null) return;
        var fresh = Orders.FirstOrDefault(x => x.Id == id);
        if (fresh is not null) _selected = fresh;
    }
}
