@inject ApiClient Api
<div class="admin-section-heading"><div><span class="admin-eyebrow">YOUR STORE, AT A GLANCE</span><h2>Welcome back <span class="admin-wave">✦</span></h2><p>Here’s what’s happening with your business.</p></div><button class="admin-btn admin-btn-primary" @onclick='() => OnNavigate.InvokeAsync("products")'><Icon Name="Plus" Size="17" /> Manage products</button></div>
@if (Loading || _loading) { <div role="status" class="admin-notice">Updating your store overview…</div> }
@if (_error is not null) { <div role="alert" class="admin-error">@_error <button class="admin-btn" @onclick="LoadAsync">Retry</button></div> }
<div class="admin-stat-grid">
    <div class="admin-stat"><span><Icon Name="CreditCard" Size="18" /> Collected revenue</span><strong>₹@AdminFmt.Inr(Paid.Sum(o => o.TotalAmount))</strong><small>Paid and COD-collected orders · all time</small></div>
    <div class="admin-stat"><span><Icon Name="ShoppingBag" Size="18" /> Total orders</span><strong>@Orders.Count</strong><small>@Orders.Count(o => o.FulfillmentStatus == "PENDING") awaiting fulfillment</small></div>
    <div class="admin-stat"><span><Icon Name="Users" Size="18" /> Customers</span><strong>@Customers.Count</strong><small>Registered customer accounts</small></div>
    <div class="admin-stat"><span><Icon Name="Package" Size="18" /> Active products</span><strong>@_products.Count(p => p.Status == "active")</strong><small>@_products.Count(p => p.Status == "draft") drafts in your catalog</small></div>
</div>
<div class="admin-dashboard-grid">
    <section class="admin-card"><div class="admin-card-heading"><div><h3>Sales overview</h3><p>Collected order value · last 7 days</p></div><span class="admin-badge active">INR</span></div><div class="admin-chart" role="img" aria-label="Collected revenue for each of the last seven days">@foreach (var date in Days) { var total = Paid.Where(o => o.CreatedAt.Date == date).Sum(o => o.TotalAmount); <div class="admin-chart-column"><small>₹@AdminFmt.Inr(total)</small><div class="admin-chart-track"><div class="admin-chart-bar" style="height:@((MaxDay > 0 ? total / MaxDay * 100 : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div></div><span>@date.ToString("ddd")</span></div> }</div><p class="admin-help">Grouped by order creation date (UTC). Refunded orders are excluded.</p></section>
    <section class="admin-card"><h3>Needs attention</h3><p class="admin-help">A few things to keep your store moving.</p><button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("orders")'><span class="admin-attention-icon"><Icon Name="ShoppingBag" Size="20" /></span><span><strong>Orders to fulfill</strong><small>Prepare the next customer deliveries</small></span><b>@Orders.Count(o => o.FulfillmentStatus == "PENDING")</b><Icon Name="ChevronRight" Size="16" /></button><button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("products")'><span class="admin-attention-icon amber"><Icon Name="Package" Size="20" /></span><span><strong>Low-stock products</strong><small>Active products with 10 units or fewer</small></span><b>@_products.Count(p => p.Status == "active" && p.StockQuantity <= 10)</b><Icon Name="ChevronRight" Size="16" /></button><button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("coupons")'><span class="admin-attention-icon violet"><Icon Name="Tag" Size="20" /></span><span><strong>Active offers</strong><small>Review and manage your coupons</small></span><b>@_coupons.Count(c => c.IsActive && (!c.ExpiresAt.HasValue || c.ExpiresAt > DateTime.UtcNow))</b><Icon Name="ChevronRight" Size="16" /></button><div class="admin-tip"><strong>A well-kept catalog builds trust.</strong><p>Clear images, accurate stock and a useful product description make shopping easier.</p></div></section>
</div>
<section class="admin-card admin-table-card"><div class="admin-card-heading"><div><h3>Recent orders</h3><p>Your latest customer activity</p></div><button class="admin-btn admin-btn-small" @onclick='() => OnNavigate.InvokeAsync("orders")'>View all orders <Icon Name="ArrowRight" Size="15" /></button></div><div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Payment</th><th>Delivery</th><th>Total</th></tr></thead><tbody>@if (!Orders.Any()) { <tr><td colspan="6" class="admin-empty">No orders yet. New orders will appear here.</td></tr> } @foreach (var order in Orders.OrderByDescending(o => o.CreatedAt).Take(5)) { <tr><td><button class="admin-text-link" @onclick='() => OnNavigate.InvokeAsync("orders")'>@order.Id</button></td><td><strong>@order.CustomerName</strong><small class="admin-cell-note">@order.CustomerEmail</small></td><td>@order.CreatedAt.ToString("dd MMM yyyy")</td><td><span class="admin-badge @(order.PaymentStatus is "PAID" or "COD_COLLECTED" ? "active" : "draft")">@order.PaymentStatus.Replace('_', ' ')</span></td><td>@order.DeliveryStatus</td><td>₹@AdminFmt.Inr(order.TotalAmount)</td></tr> }</tbody></table></div></section>
@code {
    [Parameter] public List<OrderDto> Orders { get; set; } = new();
    [Parameter] public List<AdminCustomerDto> Customers { get; set; } = new();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    private List<AdminProductDto> _products = new();
    private List<AdminCouponDto> _coupons = new();
    private string? _error;
    private bool _loading;
    private IEnumerable<OrderDto> Paid => Orders.Where(o => o.PaymentStatus is "PAID" or "COD_COLLECTED");
    private IEnumerable<DateTime> Days => Enumerable.Range(0, 7).Select(i => DateTime.UtcNow.Date.AddDays(i - 6));
    private decimal MaxDay => Days.Select(d => Paid.Where(o => o.CreatedAt.Date == d).Sum(o => o.TotalAmount)).DefaultIfEmpty().Max();
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; _error = null; var p = await Api.AdminCatalogAsync(); var c = await Api.AdminCouponsAsync(); if (p.Success) _products = p.Products; if (c.Success) _coupons = c.Coupons; if (!p.Success || !c.Success) _error = p.Message ?? c.Message; _loading = false; }
}
