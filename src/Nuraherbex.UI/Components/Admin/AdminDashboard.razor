@inject ApiClient Api

<section class="admin-overview">
    <div class="admin-overview-hero">
        <div class="admin-overview-intro">
            <span class="admin-eyebrow">NURA HERBEX <span class="admin-overview-separator">/</span> STORE OVERVIEW</span>
            <h2>Your store, in focus.</h2>
            <p>Sales, fulfillment and customer activity—ready for your next step.</p>
        </div>
        <div class="admin-overview-hero-meta">
            <div class="admin-action-total"><span>NEEDS ATTENTION</span><strong>@(_loading ? "…" : NeedsAttention)</strong><small>@(NeedsAttention == 1 ? "open action" : "open actions")</small></div>
            <div class="admin-dashboard-actions">
                <button class="admin-btn" @onclick='() => OnNavigate.InvokeAsync("orders")'><Icon Name="Package" Size="17" /> Review orders</button>
                <button class="admin-btn admin-btn-primary" @onclick='() => OnNavigate.InvokeAsync("products")'><Icon Name="Plus" Size="17" /> Manage products</button>
            </div>
        </div>
    </div>

    @if (Loading || _loading) { <div role="status" class="admin-notice">Updating your store overview…</div> }
    @if (_error is not null) { <div role="alert" class="admin-error">@_error <button class="admin-btn" @onclick="LoadAsync">Retry</button></div> }

    <div class="admin-stat-grid admin-overview-kpis">
        <div class="admin-stat admin-stat-featured"><div class="admin-kpi-top"><span class="admin-kpi-icon"><Icon Name="CreditCard" Size="18" /></span><span class="admin-kpi-label">Collected revenue</span></div><strong>₹@AdminFmt.Inr(Paid.Sum(o => o.TotalAmount))</strong><small>Paid and COD-collected orders · all time</small></div>
        <div class="admin-stat"><div class="admin-kpi-top"><span class="admin-kpi-icon"><Icon Name="ShoppingBag" Size="18" /></span><span class="admin-kpi-label">Total orders</span></div><strong>@Orders.Count</strong><small>@Orders.Count(o => o.FulfillmentStatus == "PENDING") awaiting fulfillment</small></div>
        <div class="admin-stat"><div class="admin-kpi-top"><span class="admin-kpi-icon"><Icon Name="Users" Size="18" /></span><span class="admin-kpi-label">Customers</span></div><strong>@Customers.Count</strong><small>Registered customer accounts</small></div>
        <div class="admin-stat"><div class="admin-kpi-top"><span class="admin-kpi-icon"><Icon Name="Package" Size="18" /></span><span class="admin-kpi-label">Active products</span></div><strong>@_products.Count(p => p.Status == "active")</strong><small>@LowStockProducts low on stock</small></div>
    </div>

    <div class="admin-dashboard-grid admin-overview-panels">
        <section class="admin-card admin-sales-panel">
            <div class="admin-card-heading"><div><span class="admin-panel-kicker">PERFORMANCE</span><h3>Sales overview</h3><p>Collected order value over the last seven days</p></div><span class="admin-badge active">INR</span></div>
            <div class="admin-chart" role="img" aria-label="Collected revenue for each of the last seven days">
                @foreach (var date in Days)
                {
                    var total = Paid.Where(o => o.CreatedAt.Date == date).Sum(o => o.TotalAmount);
                    <div class="admin-chart-column"><small>₹@AdminFmt.Inr(total)</small><div class="admin-chart-track"><div class="admin-chart-bar" style="height:@((MaxDay > 0 ? total / MaxDay * 100 : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div></div><span>@date.ToString("ddd")</span></div>
                }
            </div>
            <div class="admin-sales-footnote"><span><i></i> Collected revenue</span><small>Based on order creation date · UTC</small></div>
        </section>

        <section class="admin-card admin-action-panel">
            <div class="admin-card-heading"><div><span class="admin-panel-kicker">STORE OPERATIONS</span><h3>Action center</h3><p>Items that may need your attention</p></div><span class="admin-action-count">@NeedsAttention</span></div>
            <button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("orders")'><span class="admin-attention-icon"><Icon Name="ShoppingBag" Size="19" /></span><span><strong>Orders to fulfill</strong><small>Prepare customer deliveries</small></span><b>@PendingOrders</b><Icon Name="ChevronRight" Size="16" /></button>
            <button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("reviews")'><span class="admin-attention-icon amber"><Icon Name="MessageSquare" Size="19" /></span><span><strong>Reviews to approve</strong><small>Keep customer feedback moving</small></span><b>@_pendingReviews</b><Icon Name="ChevronRight" Size="16" /></button>
            <button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("products")'><span class="admin-attention-icon violet"><Icon Name="Package" Size="19" /></span><span><strong>Low-stock products</strong><small>Active products with 10 units or fewer</small></span><b>@LowStockProducts</b><Icon Name="ChevronRight" Size="16" /></button>
            <button class="admin-attention" @onclick='() => OnNavigate.InvokeAsync("coupons")'><span class="admin-attention-icon blue"><Icon Name="Tag" Size="19" /></span><span><strong>Active offers</strong><small>Review your customer promotions</small></span><b>@ActiveCoupons</b><Icon Name="ChevronRight" Size="16" /></button>
        </section>
    </div>

    <section class="admin-card admin-recent-card">
        <div class="admin-card-heading"><div><span class="admin-panel-kicker">CUSTOMER ACTIVITY</span><h3>Recent orders</h3><p>The latest activity from your store</p></div><button class="admin-btn admin-btn-small" @onclick='() => OnNavigate.InvokeAsync("orders")'>View all orders <Icon Name="ArrowRight" Size="15" /></button></div>
        @if (!Orders.Any())
        {
            <div class="admin-recent-empty"><span><Icon Name="ShoppingBag" Size="19" /></span><strong>No orders yet</strong><p>New customer orders will appear here.</p></div>
        }
        else
        {
            <div class="admin-recent-list" role="list" aria-label="Recent customer orders">
                @foreach (var order in Orders.OrderByDescending(o => o.CreatedAt).Take(5))
                {
                    <div class="admin-order-item" role="listitem">
                        <button class="admin-order-row" @onclick='() => OnNavigate.InvokeAsync("orders")'>
                            <span class="admin-order-primary"><small>ORDER</small><strong>@order.Id</strong></span>
                            <span class="admin-order-customer"><small>CUSTOMER</small><strong>@order.CustomerName</strong><span>@order.CustomerEmail</span></span>
                            <span class="admin-order-payment"><small>PAYMENT</small><span class="admin-badge @(order.PaymentStatus is "PAID" or "COD_COLLECTED" ? "active" : "draft")">@order.PaymentStatus.Replace('_', ' ')</span></span>
                            <span class="admin-order-delivery"><small>DELIVERY</small><strong>@order.DeliveryStatus</strong><span>@order.CreatedAt.ToString("dd MMM yyyy")</span></span>
                            <span class="admin-order-total"><small>TOTAL</small><strong>₹@AdminFmt.Inr(order.TotalAmount)</strong></span>
                            <Icon Name="ChevronRight" Size="17" />
                        </button>
                    </div>
                }
            </div>
        }
    </section>
</section>

@code {
    [Parameter] public List<OrderDto> Orders { get; set; } = new();
    [Parameter] public List<AdminCustomerDto> Customers { get; set; } = new();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    private List<AdminProductDto> _products = new();
    private List<AdminCouponDto> _coupons = new();
    private int _pendingReviews;
    private string? _error;
    private bool _loading;
    private int PendingOrders => Orders.Count(o => o.FulfillmentStatus == "PENDING");
    private int LowStockProducts => _products.Count(p => p.Status == "active" && p.StockQuantity <= 10);
    private int ActiveCoupons => _coupons.Count(c => c.IsActive && (!c.ExpiresAt.HasValue || c.ExpiresAt > DateTime.UtcNow));
    private int NeedsAttention => PendingOrders + LowStockProducts + _pendingReviews;
    private IEnumerable<OrderDto> Paid => Orders.Where(o => o.PaymentStatus is "PAID" or "COD_COLLECTED");
    private IEnumerable<DateTime> Days => Enumerable.Range(0, 7).Select(i => DateTime.UtcNow.Date.AddDays(i - 6));
    private decimal MaxDay => Days.Select(d => Paid.Where(o => o.CreatedAt.Date == d).Sum(o => o.TotalAmount)).DefaultIfEmpty().Max();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var catalogTask = Api.AdminCatalogAsync();
        var couponTask = Api.AdminCouponsAsync();
        var reviewTask = Api.AdminReviewsAsync();
        await Task.WhenAll(catalogTask, couponTask, reviewTask);
        var catalog = await catalogTask;
        var coupons = await couponTask;
        var reviews = await reviewTask;
        if (catalog.Success) _products = catalog.Products;
        if (coupons.Success) _coupons = coupons.Coupons;
        if (reviews.Success) _pendingReviews = reviews.Reviews.Count(r => !r.Approved);
        _error = !catalog.Success ? catalog.Message ?? "Could not load catalog data." : !coupons.Success ? coupons.Message ?? "Could not load coupon data." : !reviews.Success ? reviews.Message ?? "Could not load review data." : null;
        _loading = false;
    }
}
