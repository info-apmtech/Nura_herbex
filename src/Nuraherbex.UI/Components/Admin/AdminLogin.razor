@inject AdminSession Admin
@inject NavigationManager Nav
<div class="admin-login"><section class="admin-login-story"><a href="/shop" class="admin-brand"><img class="admin-brand-logo" src="/_content/Nuraherbex.UI/images/logo-mark.png" alt="" /><span>Nura Herbex<small>NATURALLY, BETTER.</small></span></a><div><span class="admin-eyebrow">THE BUSINESS BEHIND THE BOTANICALS</span><h1>A little care.<br />A thriving store.</h1><p>Your products, customers and everyday operations. Thoughtfully brought together.</p><div class="admin-login-decoration"><Icon Name="Leaf" Size="120" /></div></div><small>Nura Herbex · Store administration</small></section><section class="admin-login-form"><div class="admin-login-box"><span class="admin-attention-icon"><Icon Name="Lock" Size="24" /></span><h2>Welcome back</h2><p>Sign in to manage your Nura Herbex store.</p>@if (!string.IsNullOrEmpty(_authError)) { <div role="alert" class="admin-error">@_authError</div> }<form @onsubmit="HandleLogin" @onsubmit:preventDefault><label class="admin-label">Administrator email<input type="email" autocomplete="username" required @bind:event="oninput" @bind="_email" placeholder="Enter your email" /></label><label class="admin-label">Password<input type="password" autocomplete="current-password" required @bind:event="oninput" @bind="_password" placeholder="Enter your password" /></label><button class="admin-btn admin-btn-primary" disabled="@_loggingIn">@(_loggingIn ? "Signing in…" : "Sign in to your workspace") <Icon Name="ArrowRight" Size="17" /></button></form><a class="admin-back-link" href="/shop">← Back to the store</a><p class="admin-help">Authorized administrators only.</p></div></section></div>
@code {
    [Parameter] public EventCallback OnLoggedIn { get; set; }
    private string _email = "", _password = "", _authError = "";
    private bool _loggingIn;
    private async Task HandleLogin() { if (_loggingIn) return; _authError = ""; _loggingIn = true; try { var res = await Admin.LoginAsync(_email, _password); if (res.Success && !string.IsNullOrEmpty(res.Token)) { _password = ""; await OnLoggedIn.InvokeAsync(); } else _authError = res.Message ?? "Sign-in failed. Check your credentials."; } finally { _loggingIn = false; } }
}
