@inject ApiClient Api

@* Add customer dialog matching exact layout and fields of Create Test Order *@
<div @onclick="OnClose"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in text-left">
    <div @onclick:stopPropagation
         class="relative w-full max-w-lg bg-white border border-zinc-200 rounded-xl p-6 shadow-2xl space-y-4">
        <button type="button" @onclick="OnClose"
                class="absolute top-4 right-4 w-7 h-7 rounded-md bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 flex items-center justify-center text-zinc-500 hover:text-zinc-800 cursor-pointer transition-colors"
                aria-label="Close">
            <Icon Name="X" Size="15" />
        </button>

        <div class="space-y-1">
            <h3 class="text-base font-semibold text-zinc-900">
                Create Test Order
            </h3>
            <p class="text-xs text-zinc-500">
                Simulate an order to verify database records &amp; courier tracking.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_addError))
        {
            <div class="p-2.5 rounded-lg bg-red-50 border border-red-200 text-xs text-red-600 flex items-center gap-2">
                <Icon Name="AlertCircle" Size="14" Class="shrink-0 text-red-500" />
                <span>@_addError</span>
            </div>
        }

        <form @onsubmit="CreateOrderAsync" @onsubmit:preventDefault class="space-y-3 text-xs">
            <div class="space-y-1">
                <label class="text-zinc-700 font-medium block">Customer Full Name</label>
                <input type="text" required placeholder="e.g. Siddharth Rao"
                       @bind="_new.CustomerName" @bind:event="oninput"
                       class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Mobile Number</label>
                    <input type="tel" required placeholder="+91 98765 43210"
                           @bind="_new.CustomerPhone" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
                </div>
                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Email</label>
                    <input type="email" required placeholder="siddharth@example.com"
                           @bind="_new.CustomerEmail" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
                </div>
            </div>

            <div class="space-y-1">
                <label class="text-zinc-700 font-medium block">Delivery Address</label>
                <input type="text" required placeholder="Street, locality, landmark"
                       @bind="_new.Address.AddressLine1" @bind:event="oninput"
                       class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
            </div>

            <div class="grid grid-cols-3 gap-2">
                <input type="text" placeholder="City"
                       @bind="_new.Address.City" @bind:event="oninput"
                       class="px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
                <input type="text" placeholder="State"
                       @bind="_new.Address.State" @bind:event="oninput"
                       class="px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
                <input type="text" placeholder="Pincode"
                       @bind="_new.Address.Pincode" @bind:event="oninput"
                       class="px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
            </div>

            <div class="grid grid-cols-2 gap-3 pt-1">
                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Product</label>
                    <select @bind="_new.ProductId"
                            class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500">
                        @foreach (var product in _catalog.Where(p => p.Status == "active" && p.StockQuantity > 0))
                        {
                            <option value="@product.Id">@product.Name (₹@AdminFmt.Inr(product.Price))</option>
                        }
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Quantity</label>
                    <input type="number" min="1" max="10"
                           @bind="_new.Quantity" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Shipping mode</label>
                    <select @bind="_new.ShippingMode"
                            class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500">
                        <option value="@ShippingMode.Online">Online Shipping (Courier)</option>
                        <option value="@ShippingMode.Offline">Offline Shipping (Local / Chennai)</option>
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Coupon code (optional)</label>
                    <input type="text" maxlength="64" placeholder="e.g. WELCOME10"
                           @bind="_new.CouponCode" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
                </div>
            </div>

            <div class="space-y-1">
                <label class="text-zinc-700 font-medium block">Payment method</label>
                <select @bind="_new.PaymentMethod"
                        class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500">
                    <option value="COD">Cash on delivery</option>
                    <option value="ONLINE">Online / manual payment</option>
                </select>
            </div>

            @if (_new.ShippingMode == ShippingMode.Offline)
            {
                <div class="space-y-1">
                    <label class="text-zinc-700 font-medium block">Offline dispatch note</label>
                    <input type="text" maxlength="500" placeholder="e.g. Chennai local runner / hand delivery"
                           @bind="_new.OfflineDispatchNote" @bind:event="oninput"
                           class="w-full px-3 py-2 rounded-md bg-white border border-zinc-300 text-zinc-900 outline-none focus:border-zinc-500 placeholder-zinc-400" />
                </div>
            }

            @if (_new.PaymentMethod == "ONLINE")
            {
                <label class="flex items-center gap-2 text-zinc-700 cursor-pointer pt-1">
                    <input type="checkbox" @bind="_new.MarkPaid" class="rounded border-zinc-300" />
                    <span>Payment already collected</span>
                </label>
            }

            <div class="pt-2 flex gap-2.5">
                <button type="submit" disabled="@(_creating || string.IsNullOrEmpty(_new.ProductId))"
                        class="flex-1 py-2 px-3 rounded-md bg-white hover:bg-zinc-100 border border-zinc-300 text-zinc-900 font-medium text-xs tracking-tight shadow-sm cursor-pointer transition-colors disabled:opacity-60">
                    @(_creating ? "Creating..." : "Create order")
                </button>
                <button type="button" @onclick="OnClose"
                        class="px-4 py-2 rounded-md bg-white hover:bg-zinc-100 border border-zinc-300 text-zinc-700 font-medium text-xs cursor-pointer transition-colors">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public EventCallback<CustomerResponse?> OnCreated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private AdminCreateOrderRequest _new = new()
    {
        Quantity = 1,
        ShippingMode = ShippingMode.Online,
        PaymentMethod = "COD",
        Address = new AddressDto { Country = "India" }
    };
    private List<ProductDto> _catalog = new();
    private string? _addError;
    private bool _creating;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await Api.AdminProductsAsync();
            if (res.Success && res.Products is not null)
            {
                _catalog = res.Products;
                var first = _catalog.FirstOrDefault(p => p.Status == "active" && p.StockQuantity > 0) ?? _catalog.FirstOrDefault();
                if (first is not null)
                {
                    _new.ProductId = first.Id;
                }
            }
        }
        catch
        {
            // fallback
        }
    }

    private async Task CreateOrderAsync()
    {
        _addError = null;

        if (string.IsNullOrWhiteSpace(_new.CustomerName))
        {
            _addError = "Customer name is required.";
            return;
        }

        var digits = new string((_new.CustomerPhone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length is < 10 or > 15)
        {
            _addError = "Please enter a valid 10-15 digit mobile number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_new.CustomerEmail) || !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(_new.CustomerEmail.Trim()))
        {
            _addError = "Please enter a valid email address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_new.Address.AddressLine1))
        {
            _addError = "Delivery address is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_new.ProductId))
        {
            _addError = "Please select a product.";
            return;
        }

        _creating = true;
        _new.Address.Country = "India";
        _new.Quantity = Math.Clamp(_new.Quantity, 1, 10);

        var res = await Api.AdminCreateOrderAsync(_new);
        _creating = false;

        if (!res.Success)
        {
            _addError = res.Message ?? "Could not create order.";
            return;
        }

        await OnCreated.InvokeAsync(new CustomerResponse
        {
            Success = true,
            Message = $"Customer {_new.CustomerName} and order #{res.Order?.Id} created successfully."
        });
        await OnClose.InvokeAsync();
    }
}
