                </div>
                <button type="button" class="ld-btn-icon" style="background:none;border:none;cursor:pointer;color:#64748b;padding:6px;border-radius:6px;" @onclick="CloseDrillDown" title="Close">
                    <Icon Name="X" Size="18" />
                </button>
            </div>

            <!-- Toolbar: Search & Export -->
            <div style="padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid #f1f5f9;background:#fff;">
