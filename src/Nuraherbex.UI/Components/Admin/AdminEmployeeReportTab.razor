                            </tr>
                        </thead>
                        <tbody>
                            @{ var itemSn = 0; }
                            @foreach (var it in FilteredDrillDownItems)
                            {
                                <tr>
                                    <td class="sn">@(++itemSn)</td>
                                    <td>
                                        <strong>@it.LeadName</strong>
                                        @if (!string.IsNullOrEmpty(it.Source))
                                        {
                                            <span style="font-size:10px;padding:1px 6px;border-radius:8px;background:#f1f5f9;color:#64748b;margin-left:4px;">@it.Source</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <a href="@($"https://wa.me/{it.LeadPhone}")" target="_blank" style="color:#059669;display:inline-flex;align-items:center;gap:3px;font-weight:600;text-decoration:none;" title="Open WhatsApp chat">
                                                <Icon Name="MessageCircle" Size="12" />
                                                <span>@it.LeadPhone</span>
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                        <div><strong>@it.Date</strong></div>
                                        <div style="font-size:11px;color:#64748b;">@it.Time</div>
                                    </td>
                                    <td>
                                        <span style="font-weight:600;color:#334155;">@it.EmployeeName</span>
                                    </td>
                                    <td>
                                        <span style="display:inline-flex;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:600;@OutcomeBadgeStyle(_drillDownType, it.Outcome)">
                                            @it.Outcome
                                        </span>
                                    </td>
                                    @if (_drillDownType == "leads_won")
                                    {
                                        <td class="num font-bold" style="color:#059669;">
                                            @(it.OrderTotal is { } amt ? "₹" + amt.ToString("N0") : (string.IsNullOrEmpty(it.OrderId) ? "—" : it.OrderId))
                                        </td>
                                    }
                                    <td style="max-width:260px;font-size:11px;color:#475569;white-space:normal;word-break:break-word;">
                                        @(string.IsNullOrWhiteSpace(it.Notes) ? "—" : it.Notes)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <!-- Modal Footer -->
            <div style="border-top:1px solid #e2e8f0;padding:12px 20px;display:flex;align-items:center;justify-content:flex-end;background:#f8fafc;border-radius:0 0 12px 12px;">
                <button type="button" class="ld-btn primary" style="padding:6px 20px;font-size:12px;" @onclick="CloseDrillDown">
                    Close
                </button>
            </div>
        </div>
    </div>
}

