@inject ApiClient Api
@inject AdminSession AdminAuth
@inject ExportService Exporter

<div class="fr">
    <div class="fr-bar">
        <div>
            <span class="rp-eyebrow">STAFF ANALYTICS</span>
            <h3 style="margin:4px 0 2px;font-size:20px;font-weight:700;color:#1e1b4b;">@(IsManager ? "Employee Performance Report" : "My Performance Report")</h3>
            <p style="margin:0;font-size:12px;color:#6b7280;">Leads completed, follow-ups done, and no-answer follow-ups tracked date-wise. Click any number to see the full list.</p>
        </div>

        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            @if (IsManager && _employees.Count > 0)
            {
                <select class="ld-select" style="padding:6px 12px;border-radius:8px;border:1px solid #e2e8f0;font-size:12px;background:#fff;outline:none;"
                        value="@(_selectedEmployeeId?.ToString() ?? "")"
                        @onchange="OnEmployeeChangedAsync">
                    <option value="">All employees</option>
                    @foreach (var emp in _employees)
                    {
                        <option value="@emp.Id">@emp.Name (@emp.Role)</option>
                    }
                </select>
            }

            <!-- Status Format Filter Dropdown -->
            <select class="ld-select" style="padding:6px 12px;border-radius:8px;border:1px solid #cbd5e1;font-size:12px;background:#fff;font-weight:600;color:#1e293b;outline:none;cursor:pointer;"
                    value="@_selectedStatus"
                    @onchange="OnStatusFilterChanged">
                <option value="">Status: All (எல்லா நிலைகளும்)</option>
                <option value="orders_booked">Status: Orders Booked (புக் செய்தவை)</option>
                <option value="followups_done">Status: Follow-ups Done (பேசியவை)</option>
                <option value="interested">Status: Hot Leads (ஆர்வம்)</option>
                <option value="no_answer">Status: No Answer (அழைப்பு எடுக்காதவை)</option>
                <option value="not_interested">Status: Not Interested (விருப்பமில்லை)</option>
            </select>

            <DateRangeFilter
                SelectedDays="@_days"
                IsCustom="@_isCustom"
                FromDate="@_from"
                ToDate="@_to"
                RangeText="@RangeSummary"
                OnPresetSelected="OnPresetSelectedAsync"
                OnRangeSelected="OnRangeSelectedAsync" />

            <ExportButton Title="@($"Employee report ({RangeSummary})")"
                          FileName="@($"nura-employee-report-{_from}-{_to}")"
                          Columns="@ExportColumns"
                          Rows="ExportRows"
                          Disabled="@(_data is null || (_viewMode == "summary" ? _data.ByEmployee.Count == 0 : _data.DailyBreakdown.Count == 0))" />
        </div>
    </div>

    @if (_loading && _data is null)
    {
        <div class="ld-card ld-empty" style="text-align:center;padding:48px 24px;">
            <Icon Name="Loader2" Size="24" Class="animate-spin" />
            <p style="margin-top:10px;font-size:13px;color:#64748b;">Loading employee performance report…</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="em-note bad" role="alert">
            <Icon Name="AlertCircle" Size="16" />
            <span>@_error</span>
        </div>
    }
    else if (_data is { } r)
    {
        <!-- Summary KPI Cards (Clickable to view detailed list) -->
        <div class="fr-kpis" style="margin-bottom:20px;">
            <div class="fr-kpi em-kpi-clickable" style="@($"border-left:4px solid #10b981;cursor:pointer; {(_selectedStatus == "orders_booked" ? "border:2px solid #10b981;box-shadow:0 6px 16px rgba(16,185,129,0.25);background:#f0fdf4;" : "")}")"
                 title="Click to filter by Orders Booked"
                 @onclick='() => ToggleStatusFilter("orders_booked")'>
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="color:#059669;font-weight:600;"><Icon Name="ShoppingBag" Size="14" /> Orders Booked (புக் செய்தவை)</span>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:10px;padding:1px 7px;border-radius:12px;background:#d1fae5;color:#065f46;border:none;font-weight:700;cursor:pointer;"
                            @onclick:stopPropagation="true" @onclick='() => OpenDrillDown("orders_booked", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                        List ↗
                    </button>
                </div>
                <strong style="color:#065f46;">@r.TotalLeadsConverted</strong>
                <small>Customers placed order in this period @(_selectedStatus == "orders_booked" ? "(Active Filter)" : "")</small>
            </div>

            <div class="fr-kpi em-kpi-clickable" style="@($"border-left:4px solid #8b5cf6;cursor:pointer; {(_selectedStatus == "followups_done" ? "border:2px solid #8b5cf6;box-shadow:0 6px 16px rgba(139,92,246,0.25);background:#faf5ff;" : "")}")"
                 title="Click to filter by Follow-ups Done (Connected calls)"
                 @onclick='() => ToggleStatusFilter("followups_done")'>
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="color:#7c3aed;font-weight:600;"><Icon Name="CheckCircle2" Size="14" /> Follow-ups Done (பேசியவை)</span>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:10px;padding:1px 7px;border-radius:12px;background:#ede9fe;color:#5b21b6;border:none;font-weight:700;cursor:pointer;"
                            @onclick:stopPropagation="true" @onclick='() => OpenDrillDown("followups_done", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                        List ↗
                    </button>
                </div>
                <strong style="color:#5b21b6;">@r.TotalFollowUpsDone</strong>
                <small>Connected calls where customer responded @(_selectedStatus == "followups_done" ? "(Active Filter)" : "")</small>
            </div>

            <div class="fr-kpi em-kpi-clickable" style="@($"border-left:4px solid #ea580c;cursor:pointer; {(_selectedStatus == "interested" ? "border:2px solid #ea580c;box-shadow:0 6px 16px rgba(234,88,12,0.25);background:#fff7ed;" : "")}")"
                 title="Click to filter by Hot Leads / Interested"
                 @onclick='() => ToggleStatusFilter("interested")'>
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="color:#ea580c;font-weight:600;"><Icon Name="Flame" Size="14" /> Hot Leads (Interested)</span>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:10px;padding:1px 7px;border-radius:12px;background:#ffedd5;color:#9a3412;border:none;font-weight:700;cursor:pointer;"
                            @onclick:stopPropagation="true" @onclick='() => OpenDrillDown("interested", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                        List ↗
                    </button>
                </div>
                <strong style="color:#9a3412;">@r.TotalInterestedCount</strong>
                <small>Customers interested to buy @(_selectedStatus == "interested" ? "(Active Filter)" : "")</small>
            </div>

            <div class="fr-kpi em-kpi-clickable" style="@($"border-left:4px solid #f59e0b;cursor:pointer; {(_selectedStatus == "no_answer" ? "border:2px solid #f59e0b;box-shadow:0 6px 16px rgba(245,158,11,0.25);background:#fffbeb;" : "")}")"
                 title="Click to filter by No Answer Follow-ups"
                 @onclick='() => ToggleStatusFilter("no_answer")'>
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="color:#d97706;font-weight:600;"><Icon Name="PhoneMissed" Size="14" /> No Answer Follow-up</span>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:10px;padding:1px 7px;border-radius:12px;background:#fef3c7;color:#92400e;border:none;font-weight:700;cursor:pointer;"
                            @onclick:stopPropagation="true" @onclick='() => OpenDrillDown("no_answer", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                        List ↗
                    </button>
                </div>
                <strong style="color:#92400e;">@r.TotalNoAnswerCount</strong>
                <small>Calls or messages that got no answer @(_selectedStatus == "no_answer" ? "(Active Filter)" : "")</small>
            </div>

            <div class="fr-kpi em-kpi-clickable" style="@($"border-left:4px solid #ef4444;cursor:pointer; {(_selectedStatus == "not_interested" ? "border:2px solid #ef4444;box-shadow:0 6px 16px rgba(239,68,68,0.25);background:#fef2f2;" : "")}")"
                 title="Click to filter by Not Interested"
                 @onclick='() => ToggleStatusFilter("not_interested")'>
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <span style="color:#dc2626;font-weight:600;"><Icon Name="XCircle" Size="14" /> Not Interested (விருப்பமில்லை)</span>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:10px;padding:1px 7px;border-radius:12px;background:#fee2e2;color:#991b1b;border:none;font-weight:700;cursor:pointer;"
                            @onclick:stopPropagation="true" @onclick='() => OpenDrillDown("not_interested", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                        List ↗
                    </button>
                </div>
                <strong style="color:#991b1b;">@r.TotalNotInterestedCount</strong>
                <small>Leads closed not interested @(_selectedStatus == "not_interested" ? "(Active Filter)" : "")</small>
            </div>

            <div class="fr-kpi" style="border-left:4px solid #3b82f6;">
                <span style="color:#2563eb;font-weight:600;"><Icon Name="Users" Size="14" /> Active Staff</span>
                <strong style="color:#1e40af;">@r.ByEmployee.Count</strong>
                <small>Employees in this report period</small>
            </div>
        </div>

        <!-- View Switcher Tabs -->
        <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e2e8f0;margin-bottom:16px;">
            <div style="display:flex;gap:4px;">
                <button type="button"
                        class="@($"px-4 py-2 font-medium text-xs rounded-t-lg transition-colors cursor-pointer {(_viewMode == "summary" ? "bg-white border-t-2 border-purple-600 text-purple-700 font-semibold shadow-sm" : "text-gray-500 hover:text-gray-700")}")"
                        @onclick="@(() => _viewMode = "summary")">
                    <Icon Name="Users" Size="13" /> By Employee Summary
                </button>
                <button type="button"
                        class="@($"px-4 py-2 font-medium text-xs rounded-t-lg transition-colors cursor-pointer {(_viewMode == "daily" ? "bg-white border-t-2 border-purple-600 text-purple-700 font-semibold shadow-sm" : "text-gray-500 hover:text-gray-700")}")"
                        @onclick="@(() => _viewMode = "daily")">
                    <Icon Name="Calendar" Size="13" /> Date-wise Daily Breakdown
                </button>
            </div>
            <span style="font-size:11px;color:#64748b;padding-right:8px;">Period: <strong>@r.Period</strong></span>
        </div>

        @if (_viewMode == "summary")
        {
            @if (!string.IsNullOrEmpty(_selectedStatus))
            {
                <div style="margin-bottom:12px;padding:8px 14px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                    <div style="display:flex;align-items:center;gap:8px;font-size:12px;">
                        <span style="font-weight:600;color:#334155;">Filtered by:</span>
                        <span style="padding:2px 10px;border-radius:12px;font-weight:700;font-size:12px;@GetStatusBadgeStyle(_selectedStatus)">
                            @GetStatusLabel(_selectedStatus)
                        </span>
                        <span style="font-weight:700;color:#1e293b;font-size:13px;">
                            (Total Count: @GetTotalCountForStatus(r, _selectedStatus))
                        </span>
                        <span style="color:#64748b;font-size:11px;">Showing employees sorted by this count</span>
                    </div>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:11px;padding:3px 10px;border-radius:6px;background:#e2e8f0;color:#334155;border:none;cursor:pointer;font-weight:600;" @onclick='() => _selectedStatus = ""'>
                        ✕ Clear filter (Show all)
                    </button>
                </div>
            }

            <!-- Employee Summary Table -->
            <div class="ld-card em-table-card" style="margin-bottom:24px;">
                <div class="em-scroll">
                    <table class="em-table">
                        <thead>
                            <tr>
                                <th class="sn">S.No</th>
                                <th>Employee</th>
                                <th>Designation</th>
                                <th class="num">Total Leads</th>
                                <th class="num @(_selectedStatus == "orders_booked" ? "col-active-booked" : "")" style="color:#059669;">Orders Booked @(_selectedStatus == "orders_booked" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "followups_done" ? "col-active-done" : "")" style="color:#7c3aed;">Follow-ups Done @(_selectedStatus == "followups_done" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "no_answer" ? "col-active-na" : "")" style="color:#d97706;">No Answer Follow-up @(_selectedStatus == "no_answer" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "interested" ? "col-active-hot" : "")" style="color:#ea580c;">Hot Leads (Interested) @(_selectedStatus == "interested" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "not_interested" ? "col-active-notint" : "")" style="color:#dc2626;">Not Interested @(_selectedStatus == "not_interested" ? "✓" : "")</th>
                                <th class="num">Pending</th>
                                <th class="num" style="color:#dc2626;">Overdue</th>
                                <th class="num">Win Rate %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 0; }
                            @foreach (var emp in DisplayEmployees(r))
                            {
                                <tr>
                                    <td class="sn">@(++sn)</td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <span class="admin-avatar" style="width:28px;height:28px;font-size:11px;">@(string.IsNullOrEmpty(emp.Name) ? "E" : emp.Name[..1].ToUpperInvariant())</span>
                                            <strong>@emp.Name</strong>
                                        </div>
                                    </td>
                                    <td><span style="font-size:11px;padding:2px 8px;border-radius:12px;background:#f1f5f9;color:#475569;">@emp.Designation</span></td>
                                    <td class="num">@emp.TotalLeads</td>
                                    <td class="num font-bold @(_selectedStatus == "orders_booked" ? "col-active-booked" : "")">
                                        @if (emp.LeadsConverted > 0)
                                        {
                                            <span class="em-clickable-pill pill-won"
                                                  title="Click to view @emp.Name's Orders Booked"
                                                  @onclick='() => OpenDrillDown("orders_booked", emp.EmployeeId, emp.Name)'>
                                                @emp.LeadsConverted
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "followups_done" ? "col-active-done" : "")">
                                        @if (emp.FollowUpsDone > 0)
                                        {
                                            <span class="em-clickable-pill pill-fu"
                                                  title="Click to view @emp.Name's Follow-ups Done"
                                                  @onclick='() => OpenDrillDown("followups_done", emp.EmployeeId, emp.Name)'>
                                                @emp.FollowUpsDone
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "no_answer" ? "col-active-na" : "")">
                                        @if (emp.NoAnswerCount > 0)
                                        {
                                            <span class="em-clickable-pill pill-na"
                                                  title="Click to view @emp.Name's No Answer Follow-ups"
                                                  @onclick='() => OpenDrillDown("no_answer", emp.EmployeeId, emp.Name)'>
                                                @emp.NoAnswerCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "interested" ? "col-active-hot" : "")">
                                        @if (emp.InterestedCount > 0)
                                        {
                                            <span class="em-clickable-pill pill-hot"
                                                  title="Click to view @emp.Name's Hot Leads / Interested"
                                                  @onclick='() => OpenDrillDown("interested", emp.EmployeeId, emp.Name)'>
                                                @emp.InterestedCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "not_interested" ? "col-active-notint" : "")">
                                        @if (emp.NotInterestedCount > 0)
                                        {
                                            <span class="em-clickable-pill pill-rej"
                                                  title="Click to view @emp.Name's Not Interested leads"
                                                  @onclick='() => OpenDrillDown("not_interested", emp.EmployeeId, emp.Name)'>
                                                @emp.NotInterestedCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num">@emp.PendingFollowUps</td>
                                    <td class="num @(emp.OverdueFollowUps > 0 ? "ld-bad" : "")">@emp.OverdueFollowUps</td>
                                    <td class="num">
                                        <span style="font-weight:600;color:@(emp.WinRatePercent >= 20 ? "#059669" : emp.WinRatePercent > 0 ? "#4338ca" : "#64748b");">
                                            @emp.WinRatePercent%
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (r.ByEmployee.Count == 0)
                            {
                                <tr><td colspan="12" class="em-empty">No employee performance data recorded for this period.</td></tr>
                            }
                        </tbody>
                        @if (r.ByEmployee.Count > 0)
                        {
                            <tfoot>
                                <tr style="background:#f8fafc;font-weight:700;border-top:2px solid #cbd5e1;border-bottom:2px solid #cbd5e1;">
                                    <td class="sn" style="font-weight:700;color:#334155;">—</td>
                                    <td style="font-weight:700;color:#1e293b;">
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <Icon Name="Calculator" Size="14" />
                                            <span>TOTAL (மொத்தம்)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="font-size:11px;padding:2px 8px;border-radius:12px;background:#e2e8f0;color:#334155;font-weight:600;">
                                            @r.ByEmployee.Count Staff
                                        </span>
                                    </td>
                                    <td class="num font-bold" style="font-size:13px;color:#1e293b;">
                                        @r.ByEmployee.Sum(x => x.TotalLeads).ToString("N0")
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-won" style="font-size:13px;"
                                              title="Click to view all Orders Booked (@r.TotalLeadsConverted)"
                                              @onclick='() => OpenDrillDown("orders_booked", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.TotalLeadsConverted.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-fu" style="font-size:13px;"
                                              title="Click to view all Follow-ups Done (@r.TotalFollowUpsDone)"
                                              @onclick='() => OpenDrillDown("followups_done", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.TotalFollowUpsDone.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-na" style="font-size:13px;"
                                              title="Click to view all No Answer Follow-ups (@r.TotalNoAnswerCount)"
                                              @onclick='() => OpenDrillDown("no_answer", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.TotalNoAnswerCount.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-hot" style="font-size:13px;"
                                              title="Click to view all Hot Leads / Interested (@r.TotalInterestedCount)"
                                              @onclick='() => OpenDrillDown("interested", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.TotalInterestedCount.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-rej" style="font-size:13px;"
                                              title="Click to view all Not Interested leads (@r.TotalNotInterestedCount)"
                                              @onclick='() => OpenDrillDown("not_interested", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.TotalNotInterestedCount.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold" style="font-size:13px;color:#475569;">
                                        @r.ByEmployee.Sum(x => x.PendingFollowUps).ToString("N0")
                                    </td>
                                    <td class="num font-bold" style="font-size:13px;color:@(r.ByEmployee.Sum(x => x.OverdueFollowUps) > 0 ? "#dc2626" : "#475569");">
                                        @r.ByEmployee.Sum(x => x.OverdueFollowUps).ToString("N0")
                                    </td>
                                    <td class="num font-bold" style="font-size:13px;color:#4338ca;">
                                        @{
                                            var totLeads = r.ByEmployee.Sum(x => x.TotalLeads);
                                            var totWon = r.TotalLeadsConverted;
                                            var overallRate = totLeads > 0 ? Math.Round((decimal)totWon * 100m / totLeads, 1) : 0m;
                                        }
                                        @overallRate%
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_selectedStatus))
            {
                <div style="margin-bottom:12px;padding:8px 14px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                    <div style="display:flex;align-items:center;gap:8px;font-size:12px;">
                        <span style="font-weight:600;color:#334155;">Filtered by:</span>
                        <span style="padding:2px 10px;border-radius:12px;font-weight:700;font-size:12px;@GetStatusBadgeStyle(_selectedStatus)">
                            @GetStatusLabel(_selectedStatus)
                        </span>
                        <span style="font-weight:700;color:#1e293b;font-size:13px;">
                            (Total Count: @GetTotalCountForStatus(r, _selectedStatus))
                        </span>
                        <span style="color:#64748b;font-size:11px;">Showing dates with activity in this status</span>
                    </div>
                    <button type="button" class="admin-btn admin-btn-small" style="font-size:11px;padding:3px 10px;border-radius:6px;background:#e2e8f0;color:#334155;border:none;cursor:pointer;font-weight:600;" @onclick='() => _selectedStatus = ""'>
                        ✕ Clear filter (Show all)
                    </button>
                </div>
            }

            <!-- Date-wise Daily Breakdown Table -->
            <div class="ld-card em-table-card" style="margin-bottom:24px;">
                <div class="em-scroll">
                    <table class="em-table">
                        <thead>
                            <tr>
                                <th class="sn">S.No</th>
                                <th>Date (தேதி)</th>
                                <th>Employee</th>
                                <th class="num @(_selectedStatus == "orders_booked" ? "col-active-booked" : "")" style="color:#059669;">Orders Booked @(_selectedStatus == "orders_booked" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "followups_done" ? "col-active-done" : "")" style="color:#7c3aed;">Follow-ups Done @(_selectedStatus == "followups_done" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "no_answer" ? "col-active-na" : "")" style="color:#d97706;">No Answer Follow-up @(_selectedStatus == "no_answer" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "interested" ? "col-active-hot" : "")" style="color:#ea580c;">Hot Leads (Interested) @(_selectedStatus == "interested" ? "✓" : "")</th>
                                <th class="num @(_selectedStatus == "not_interested" ? "col-active-notint" : "")" style="color:#dc2626;">Not Interested @(_selectedStatus == "not_interested" ? "✓" : "")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var dsn = 0; }
                            @foreach (var day in DisplayDailyBreakdown(r))
                            {
                                <tr>
                                    <td class="sn">@(++dsn)</td>
                                    <td><strong>@day.Date</strong></td>
                                    <td>@day.EmployeeName</td>
                                    <td class="num font-bold @(_selectedStatus == "orders_booked" ? "col-active-booked" : "")">
                                        @if (day.LeadsConverted > 0)
                                        {
                                            <span class="em-clickable-pill pill-won"
                                                  title="Click to view @day.EmployeeName's Orders Booked on @day.Date"
                                                  @onclick='() => OpenDrillDown("orders_booked", day.EmployeeId, $"{day.EmployeeName} ({day.Date})", date: day.Date)'>
                                                @day.LeadsConverted
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "followups_done" ? "col-active-done" : "")">
                                        @if (day.FollowUpsDone > 0)
                                        {
                                            <span class="em-clickable-pill pill-fu"
                                                  title="Click to view @day.EmployeeName's Follow-ups Done on @day.Date"
                                                  @onclick='() => OpenDrillDown("followups_done", day.EmployeeId, $"{day.EmployeeName} ({day.Date})", date: day.Date)'>
                                                @day.FollowUpsDone
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "no_answer" ? "col-active-na" : "")">
                                        @if (day.NoAnswerCount > 0)
                                        {
                                            <span class="em-clickable-pill pill-na"
                                                  title="Click to view @day.EmployeeName's No Answer Follow-ups on @day.Date"
                                                  @onclick='() => OpenDrillDown("no_answer", day.EmployeeId, $"{day.EmployeeName} ({day.Date})", date: day.Date)'>
                                                @day.NoAnswerCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "interested" ? "col-active-hot" : "")">
                                        @if (day.InterestedCount > 0)
                                        {
                                            <span class="em-clickable-pill pill-hot"
                                                  title="Click to view @day.EmployeeName's Hot Leads on @day.Date"
                                                  @onclick='() => OpenDrillDown("interested", day.EmployeeId, $"{day.EmployeeName} ({day.Date})", date: day.Date)'>
                                                @day.InterestedCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                    <td class="num font-bold @(_selectedStatus == "not_interested" ? "col-active-notint" : "")">
                                        @if (day.NotInterestedCount > 0)
                                        {
                                            <span class="em-clickable-pill pill-rej"
                                                  title="Click to view @day.EmployeeName's Not Interested leads on @day.Date"
                                                  @onclick='() => OpenDrillDown("not_interested", day.EmployeeId, $"{day.EmployeeName} ({day.Date})", date: day.Date)'>
                                                @day.NotInterestedCount
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">0</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (r.DailyBreakdown.Count == 0)
                            {
                                <tr><td colspan="8" class="em-empty">No daily activity recorded for this period.</td></tr>
                            }
                        </tbody>
                        @if (r.DailyBreakdown.Count > 0)
                        {
                            <tfoot>
                                <tr style="background:#f8fafc;font-weight:700;border-top:2px solid #cbd5e1;border-bottom:2px solid #cbd5e1;">
                                    <td class="sn" style="font-weight:700;color:#334155;">—</td>
                                    <td style="font-weight:700;color:#1e293b;">TOTAL (மொத்தம்)</td>
                                    <td>
                                        <span style="font-size:11px;padding:2px 8px;border-radius:12px;background:#e2e8f0;color:#334155;font-weight:600;">
                                            @r.DailyBreakdown.Select(x => x.Date).Distinct().Count() Days
