                                        <span class="em-clickable-pill pill-fu" style="font-size:13px;"
                                              title="Click to view all Follow-ups Done"
                                              @onclick='() => OpenDrillDown("followups_done", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.DailyBreakdown.Sum(x => x.FollowUpsDone).ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-na" style="font-size:13px;"
                                              title="Click to view all No Answer Follow-ups"
                                              @onclick='() => OpenDrillDown("no_answer", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.DailyBreakdown.Sum(x => x.NoAnswerCount).ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-hot" style="font-size:13px;"
                                              title="Click to view all Hot Leads / Interested"
                                              @onclick='() => OpenDrillDown("interested", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.DailyBreakdown.Sum(x => x.InterestedCount).ToString("N0")
                                        </span>
                                    </td>
                                    <td class="num font-bold">
                                        <span class="em-clickable-pill pill-rej" style="font-size:13px;"
                                              title="Click to view all Not Interested leads"
                                              @onclick='() => OpenDrillDown("not_interested", _selectedEmployeeId, CurrentFilterEmployeeLabel)'>
                                            @r.DailyBreakdown.Sum(x => x.NotInterestedCount).ToString("N0")
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        }
    }
</div>

@* ---- DRILL DOWN LIST MODAL POPUP ---- *@
@if (_drillDownOpen)
{
    <div class="em-modal-backdrop" @onclick="CloseDrillDown">
        <div class="em-modal-card" @onclick:stopPropagation>
            <!-- Modal Header -->
            <div style="border-bottom:1px solid #e2e8f0;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;background:#f8fafc;border-radius:12px 12px 0 0;">
                <div>
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                        <span style="display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:700;@HeaderBadgeStyle(_drillDownType)">
                            <Icon Name="@HeaderIconName(_drillDownType)" Size="14" />
                            @_drillDownTitle
                        </span>
