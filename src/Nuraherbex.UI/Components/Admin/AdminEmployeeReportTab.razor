                    </span>
                    <button type="button" class="ld-btn outline" style="padding:4px 12px;font-size:11px;height:32px;display:inline-flex;align-items:center;gap:5px;"
                            @onclick="ExportDrillDownCsv" disabled="@(FilteredDrillDownItems.Count == 0)">
                        <Icon Name="Download" Size="13" /> Export CSV
                    </button>
                </div>
            </div>

            <!-- Table Body -->
            <div style="max-height:55vh;overflow-y:auto;padding:0 20px 20px;">
                @if (_drillDownLoading)
                {
                    <div style="text-align:center;padding:48px 0;color:#64748b;">
                        <Icon Name="Loader2" Size="26" Class="animate-spin" />
                        <p style="margin-top:10px;font-size:13px;font-weight:500;">Loading list details…</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_drillDownError))
                {
                    <div class="em-note bad" style="margin:20px 0;" role="alert">
                        <Icon Name="AlertCircle" Size="15" />
                        <span>@_drillDownError</span>
                    </div>
                }
                else if (FilteredDrillDownItems.Count == 0)
                {
                    <div style="text-align:center;padding:48px 0;color:#94a3b8;">
                        <Icon Name="Inbox" Size="28" />
                        <p style="margin-top:8px;font-size:13px;">No records match your criteria.</p>
                    </div>
                }
                else
                {
                    <table class="em-table" style="font-size:12px;margin-top:12px;">
                        <thead>
                            <tr style="position:sticky;top:0;background:#fff;z-index:2;box-shadow:0 1px 0 #e2e8f0;">
                                <th class="sn">S.No</th>
                                <th>Customer / Lead</th>
                                <th>Phone</th>
                                <th>Date & Time</th>
                                <th>Staff (Employee)</th>
                                <th>Status / Outcome</th>
                                @if (_drillDownType == "leads_won")
                                {
