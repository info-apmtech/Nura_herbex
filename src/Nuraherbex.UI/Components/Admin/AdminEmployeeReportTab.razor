@code {
    private bool IsManager => AdminAuth.CanAll("reports") || AdminAuth.CanAll("leads") || AdminAuth.CanAll("followups");

    private EmployeePerformanceReportResponse? _data;
    private List<EmployeeOption> _employees = new();
    private long? _selectedEmployeeId;
    private string _viewMode = "summary"; // "summary" | "daily"
    private bool _loading = true;
    private string? _error;

    // Status Format Filter
    private string _selectedStatus = "";

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        _selectedStatus = e.Value?.ToString() ?? "";
    }

    private void ToggleStatusFilter(string status)
    {
        _selectedStatus = _selectedStatus == status ? "" : status;
    }

    private IEnumerable<EmployeePerformanceDto> DisplayEmployees(EmployeePerformanceReportResponse r)
    {
        if (r.ByEmployee == null || r.ByEmployee.Count == 0) return Enumerable.Empty<EmployeePerformanceDto>();
        switch (_selectedStatus)
        {
            case "orders_booked":
                var wb = r.ByEmployee.Where(e => e.LeadsConverted > 0).OrderByDescending(e => e.LeadsConverted).ToList();
                return wb.Count > 0 ? wb : r.ByEmployee.OrderByDescending(e => e.LeadsConverted);
            case "followups_done":
                var fb = r.ByEmployee.Where(e => e.FollowUpsDone > 0).OrderByDescending(e => e.FollowUpsDone).ToList();
                return fb.Count > 0 ? fb : r.ByEmployee.OrderByDescending(e => e.FollowUpsDone);
            case "interested":
                var ib = r.ByEmployee.Where(e => e.InterestedCount > 0).OrderByDescending(e => e.InterestedCount).ToList();
                return ib.Count > 0 ? ib : r.ByEmployee.OrderByDescending(e => e.InterestedCount);
            case "no_answer":
                var nb = r.ByEmployee.Where(e => e.NoAnswerCount > 0).OrderByDescending(e => e.NoAnswerCount).ToList();
                return nb.Count > 0 ? nb : r.ByEmployee.OrderByDescending(e => e.NoAnswerCount);
            case "not_interested":
                var rb = r.ByEmployee.Where(e => e.NotInterestedCount > 0).OrderByDescending(e => e.NotInterestedCount).ToList();
                return rb.Count > 0 ? rb : r.ByEmployee.OrderByDescending(e => e.NotInterestedCount);
            default:
                return r.ByEmployee;
        }
    }

    private IEnumerable<EmployeeDailyPerformanceDto> DisplayDailyBreakdown(EmployeePerformanceReportResponse r)
    {
        if (r.DailyBreakdown == null || r.DailyBreakdown.Count == 0) return Enumerable.Empty<EmployeeDailyPerformanceDto>();
        switch (_selectedStatus)
        {
            case "orders_booked":
                var wb = r.DailyBreakdown.Where(d => d.LeadsConverted > 0).OrderByDescending(d => d.Date).ToList();
                return wb.Count > 0 ? wb : r.DailyBreakdown;
            case "followups_done":
                var fb = r.DailyBreakdown.Where(d => d.FollowUpsDone > 0).OrderByDescending(d => d.Date).ToList();
                return fb.Count > 0 ? fb : r.DailyBreakdown;
            case "interested":
                var ib = r.DailyBreakdown.Where(d => d.InterestedCount > 0).OrderByDescending(d => d.Date).ToList();
                return ib.Count > 0 ? ib : r.DailyBreakdown;
            case "no_answer":
                var nb = r.DailyBreakdown.Where(d => d.NoAnswerCount > 0).OrderByDescending(d => d.Date).ToList();
                return nb.Count > 0 ? nb : r.DailyBreakdown;
            case "not_interested":
                var rb = r.DailyBreakdown.Where(d => d.NotInterestedCount > 0).OrderByDescending(d => d.Date).ToList();
                return rb.Count > 0 ? rb : r.DailyBreakdown;
            default:
                return r.DailyBreakdown;
        }
    }

    private int GetTotalCountForStatus(EmployeePerformanceReportResponse r, string status) => status switch
    {
        "orders_booked" => r.TotalLeadsConverted,
        "followups_done" => r.TotalFollowUpsDone,
        "interested" => r.TotalInterestedCount,
        "no_answer" => r.TotalNoAnswerCount,
        "not_interested" => r.TotalNotInterestedCount,
        _ => 0
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "orders_booked" => "Orders Booked (புக் செய்தவை)",
        "followups_done" => "Follow-ups Done (பேசியவை)",
        "interested" => "Hot Leads / Interested (ஆர்வம்)",
        "no_answer" => "No Answer Follow-up (அழைப்பு எடுக்காதவை)",
        "not_interested" => "Not Interested (விருப்பமில்லை)",
        _ => "All"
    };

    private static string GetStatusBadgeStyle(string status) => status switch
    {
        "orders_booked" => "background:#d1fae5;color:#065f46;",
        "followups_done" => "background:#ede9fe;color:#5b21b6;",
        "interested" => "background:#ffedd5;color:#9a3412;",
        "no_answer" => "background:#fef3c7;color:#92400e;",
        "not_interested" => "background:#fee2e2;color:#991b1b;",
        _ => "background:#e2e8f0;color:#334155;"
    };

    private int _days = 30;
    private bool _isCustom;
    private string _from = "";
    private string _to = "";

    // Drill-Down Modal State
    private bool _drillDownOpen;
    private bool _drillDownLoading;
    private string? _drillDownError;
    private string _drillDownType = ""; // "leads_won" | "followups_done" | "no_answer"
    private string _drillDownTitle = "";
    private string? _drillDownEmployeeName;
    private string? _drillDownDate;
    private string _drillDownFilter = "";
    private EmployeePerformanceDetailResponse? _drillDownData;

    private sealed record EmployeeOption(long Id, string Name, string Role);

    private string CurrentFilterEmployeeLabel => _selectedEmployeeId is { } eid
        ? _employees.FirstOrDefault(e => e.Id == eid)?.Name ?? "Selected Employee"
        : "All Employees";

    private string RangeSummary => _isCustom
        ? $"{_from} to {_to}"
        : $"{_days} Days ({_from} to {_to})";

    private List<EmployeePerformanceDetailItemDto> FilteredDrillDownItems
    {
        get
        {
            if (_drillDownData is null || _drillDownData.Items.Count == 0) return new();
            if (string.IsNullOrWhiteSpace(_drillDownFilter)) return _drillDownData.Items;
            var term = _drillDownFilter.Trim().ToLowerInvariant();
            return _drillDownData.Items.Where(it =>
                it.LeadName.ToLowerInvariant().Contains(term) ||
                it.LeadPhone.Contains(term) ||
                it.EmployeeName.ToLowerInvariant().Contains(term) ||
                it.Outcome.ToLowerInvariant().Contains(term) ||
                it.Notes.ToLowerInvariant().Contains(term) ||
                (it.OrderId != null && it.OrderId.ToLowerInvariant().Contains(term))
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SetPresetDates(_days);
        if (IsManager)
        {
            await LoadEmployeesAsync();
        }
        await LoadReportAsync();
    }

    private void SetPresetDates(int days)
    {
        _days = days;
        _isCustom = false;
        var now = DateTime.UtcNow.AddHours(5.5); // IST
        _to = now.ToString("yyyy-MM-dd");
        _from = now.AddDays(-(days - 1)).ToString("yyyy-MM-dd");
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            var res = await Api.AdminEmployeesAsync();
            if (res.Success && res.Employees is not null)
            {
                _employees = res.Employees.Where(e => e.IsActive).Select(e => new EmployeeOption(e.Id, e.Name, e.Role ?? "")).ToList();
            }
        }
        catch
        {
            // fallback
        }
    }

    private async Task OnEmployeeChangedAsync(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedEmployeeId = long.TryParse(val, out var id) && id > 0 ? id : null;
        await LoadReportAsync();
    }

    private async Task OnPresetSelectedAsync(int days)
    {
        SetPresetDates(days);
        await LoadReportAsync();
    }

    private async Task OnRangeSelectedAsync((string From, string To) range)
    {
        _isCustom = true;
        _from = range.From;
        _to = range.To;
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var res = await Api.AdminEmployeePerformanceReportAsync(from: _from, to: _to, employeeId: _selectedEmployeeId);
            if (res.Success)
            {
                _data = res;
            }
            else
            {
                _error = res.Message ?? "Failed to load employee performance report.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDrillDown(string type, long? employeeId, string? employeeName, string? date = null)
    {
        _drillDownOpen = true;
        _drillDownLoading = true;
        _drillDownError = null;
        _drillDownFilter = "";
        _drillDownType = type;
        _drillDownEmployeeName = employeeName;
        _drillDownDate = date;

        _drillDownTitle = type switch
        {
            "leads_won" or "orders_booked" or "orders" => "Orders Booked (புக் செய்தவை)",
            "followups_done" => "Follow-ups Done (முடித்தவை)",
            "no_answer" => "No Answer Follow-up",
            "interested" or "hot" => "Hot Leads / Interested (ஆர்வம் காட்டியவை)",
            "not_interested" => "Not Interested (விருப்பமில்லை)",
            _ => "Details"
        };

        try
        {
            var res = await Api.AdminEmployeePerformanceDetailsAsync(type, from: _from, to: _to, employeeId: employeeId, date: date);
            if (res.Success)
            {
                _drillDownData = res;
            }
            else
            {
                _drillDownError = res.Message ?? "Failed to load details.";
            }
        }
        catch (Exception ex)
        {
            _drillDownError = ex.Message;
        }
        finally
        {
            _drillDownLoading = false;
        }
    }

    private void CloseDrillDown()
    {
        _drillDownOpen = false;
        _drillDownData = null;
    }

    private async Task ExportDrillDownCsv()
    {
        if (_drillDownData is null || FilteredDrillDownItems.Count == 0) return;
        var isOrders = _drillDownType is "leads_won" or "orders_booked" or "orders";
        var cols = isOrders
            ? new[] { "S.No", "Customer Name", "Phone", "Date", "Time", "Handled By", "Status", "Order Total (₹)", "Notes" }
            : new[] { "S.No", "Customer Name", "Phone", "Date", "Time", "Handled By", "Outcome", "Source / Type", "Notes" };

        var rows = FilteredDrillDownItems.Select((it, i) => (IReadOnlyList<string>)(isOrders
            ? new[]
            {
                (i + 1).ToString(),
                it.LeadName,
                it.LeadPhone,
                it.Date,
                it.Time,
                it.EmployeeName,
                it.Outcome,
                it.OrderTotal?.ToString("N0") ?? it.OrderId ?? "",
                it.Notes
            }
            : new[]
            {
                (i + 1).ToString(),
                it.LeadName,
                it.LeadPhone,
                it.Date,
                it.Time,
                it.EmployeeName,
                it.Outcome,
                it.Source ?? "",
                it.Notes
            })).ToList();

        var title = $"{_drillDownTitle} - {_drillDownEmployeeName ?? "All"}";
        var fileName = $"nura-{_drillDownType}-{_from}-{_to}";
        await Exporter.RunAsync("csv", fileName, title, cols, rows);
    }

    private static string HeaderBadgeStyle(string type) => type switch
    {
        "leads_won" or "orders_booked" or "orders" => "background:#d1fae5;color:#065f46;",
        "followups_done" => "background:#ede9fe;color:#5b21b6;",
        "no_answer" => "background:#fef3c7;color:#92400e;",
        "interested" or "hot" => "background:#ffedd5;color:#9a3412;",
        "not_interested" => "background:#fee2e2;color:#991b1b;",
        _ => "background:#e2e8f0;color:#334155;"
    };

    private static string HeaderIconName(string type) => type switch
    {
        "leads_won" or "orders_booked" or "orders" => "ShoppingBag",
        "followups_done" => "CheckCircle2",
        "no_answer" => "PhoneMissed",
        "interested" or "hot" => "Flame",
        "not_interested" => "XCircle",
        _ => "List"
    };

    private static string OutcomeBadgeStyle(string type, string outcome)
    {
        if (type is "leads_won" or "orders_booked" or "orders") return "background:#d1fae5;color:#065f46;";
        if (type == "no_answer") return "background:#fef3c7;color:#92400e;";
        if (type is "interested" or "hot") return "background:#ffedd5;color:#9a3412;";
        if (type is "not_interested") return "background:#fee2e2;color:#991b1b;";
        var norm = outcome.ToLowerInvariant();
        if (norm.Contains("order") || norm.Contains("convert") || norm.Contains("interested"))
            return "background:#d1fae5;color:#065f46;";
        if (norm.Contains("no answer") || norm.Contains("callback") || norm.Contains("busy"))
            return "background:#fef3c7;color:#92400e;";
        if (norm.Contains("cancel") || norm.Contains("lost") || norm.Contains("not interested"))
            return "background:#fee2e2;color:#991b1b;";
        return "background:#ede9fe;color:#5b21b6;";
    }

    private string[] ExportColumns => _viewMode == "summary"
        ? new[] { "Employee", "Designation", "Total Leads", "Orders Booked", "Follow-ups Done", "No Answer Follow-up", "Hot Leads (Interested)", "Not Interested", "Pending", "Overdue", "Win Rate %" }
        : new[] { "Date", "Employee", "Orders Booked", "Follow-ups Done", "No Answer Follow-up", "Hot Leads (Interested)", "Not Interested" };

    private IEnumerable<IReadOnlyList<string>> ExportRows()
    {
        if (_data is null) return Array.Empty<IReadOnlyList<string>>();

        if (_viewMode == "summary")
        {
            return _data.ByEmployee.Select(e => (IReadOnlyList<string>)new[]
            {
                e.Name,
                e.Designation,
                e.TotalLeads.ToString(),
                e.LeadsConverted.ToString(),
                e.FollowUpsDone.ToString(),
                e.NoAnswerCount.ToString(),
                e.InterestedCount.ToString(),
                e.NotInterestedCount.ToString(),
                e.PendingFollowUps.ToString(),
                e.OverdueFollowUps.ToString(),
                $"{e.WinRatePercent}%"
            });
        }
        else
        {
            return _data.DailyBreakdown.Select(d => (IReadOnlyList<string>)new[]
            {
                d.Date,
                d.EmployeeName,
                d.LeadsConverted.ToString(),
                d.FollowUpsDone.ToString(),
                d.NoAnswerCount.ToString(),
                d.InterestedCount.ToString(),
                d.NotInterestedCount.ToString()
            });
        }
    }
}
