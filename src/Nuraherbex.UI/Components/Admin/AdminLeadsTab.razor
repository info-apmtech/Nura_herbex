@implements IDisposable
@inject ApiClient Api
@inject AdminSession AdminAuth
@inject NavigationManager Nav
@inject BrowserInterop Browser

<div class="@($"ld ld-mode-{Mode} {(_v2 ? "ld-v2" : "")}")">

    @* Which panel you are in, with a switch to the others you may open, and the look toggle *@
    <div class="ld-topbar">
        <div class="ld-views" role="tablist" aria-label="Panels">
            @foreach (var v in LeadViews.All.Where(x => AdminAuth.Can(x)))
            {
                var view = v;
                <button type="button" role="tab" aria-selected="@(view == Mode)" class="@($"ld-view {(view == Mode ? "is-active" : "")}")" @onclick="() => GoTo(view)">
                    <Icon Name="@PanelIcon(view)" Size="15" /><span>@PanelName(view)</span>
                    @if (_viewCounts.TryGetValue(view, out var vc)) { <b>@vc</b> }
                </button>
            }
        </div>
        <button type="button" class="@($"ld-look {(_v2 ? "is-on" : "")}")" aria-pressed="@_v2" title="Switch between the classic and the new look. Your choice is remembered on this device." @onclick="ToggleLookAsync">
            <Icon Name="Sparkles" Size="14" /> @(_v2 ? "New look" : "Try the new look")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="ld-banner ld-notice" role="status"><Icon Name="CheckCircle2" Size="15" /><span>@_notice</span><button type="button" class="ld-x" aria-label="Dismiss" @onclick="() => _notice = null"><Icon Name="X" Size="14" /></button></div>
    }

    @* Summary — doubles as the filter *@
    <div class="ld-kpis">
        @if (Mode == LeadViews.Leads)
        {
            @if (Everyone)
            {
                <button type="button" class="@KpiClass("")" @onclick='() => SetStatusAsync("")'>
                    <i style="background:#235b40"></i><span>All leads</span><strong>@Total</strong><small>Not yet interested or ordered</small>
                </button>
            }
            @foreach (var s in KpiStatuses)
            {
                var status = s;
                <button type="button" class="@KpiClass(status)" @onclick="() => SetStatusAsync(status)">
                    <i style="background:@Accent(status)"></i><span>@Label(status)</span><strong>@_counts.GetValueOrDefault(status)</strong><small>@KpiHint(status)</small>
                </button>
            }
        }
        else
        {
            <button type="button" class="@QuickClass("")" @onclick='() => _quick = ""'>
                <i style="background:#235b40"></i><span>@(Mode == LeadViews.Care ? "Customers" : "Hot leads")</span><strong>@Total</strong><small>@(Mode == LeadViews.Care ? "Paid customers" : "Showed interest, not ordered yet")</small>
            </button>
            <button type="button" class="@QuickClass("unread")" @onclick='() => _quick = "unread"'>
                <i style="background:#2b6a98"></i><span>Unread</span><strong>@_unreadTotal</strong><small>Messages waiting for a reply</small>
            </button>
            @if (Mode == LeadViews.Care)
            {
                <button type="button" class="@QuickClass("open")" @onclick='() => _quick = "open"'>
                    <i style="background:#c8932e"></i><span>Order on the way</span><strong>@_leads.Count(x => x.OpenOrders > 0)</strong><small>Not delivered yet</small>
                </button>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ld-banner danger" style="border-radius:10px;border:1px solid #f6d2cd"><Icon Name="AlertCircle" Size="15" /><span>@_error</span></div>
    }

    <div class="@($"ld-work {(_selected?.Lead is not null ? "is-detail" : "")} {(_v2 ? "ld-board-mode" : "")}")">

        @if (_v2)
        {
            @* ───────── New look: pipeline board ───────── *@
            <section class="ld-board" aria-label="@PanelName(Mode) board">
                <div class="ld-board-bar">
                    <div class="ld-search">
                        <Icon Name="Search" Size="15" />
                        <input type="search" placeholder="Search name, phone or email" aria-label="Search" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
                    </div>
                    @if (Everyone)
                    {
                        <select class="ld-assignee" aria-label="Filter by owner" value="@_assignee" @onchange="OnAssigneeFilterChanged">
                            <option value="">@(Mode == LeadViews.Care ? "All care owners" : "All owners")</option>
                            <option value="unassigned">Unassigned (@_unassigned)</option>
                            @foreach (var t in _team) { <option value="@t.Id">@t.Name</option> }
                        </select>
                    }
                    <button type="button" class="@($"ld-chip2 {(_quick == "unread" ? "is-on" : "")}")" aria-pressed="@(_quick == "unread")" @onclick='() => _quick = _quick == "unread" ? "" : "unread"'><Icon Name="MessageCircle" Size="13" /> Unread <b>@_unreadTotal</b></button>
                    <span class="ld-board-total"><strong>@Total</strong> @(Mode == LeadViews.Care ? "customers" : Mode == LeadViews.Interested ? "hot leads" : "leads")</span>
                    <button type="button" class="ld-refresh" title="Refresh" aria-label="Refresh" @onclick="() => LoadAsync(true)"><Icon Name="RefreshCw" Size="14" Class="@(_loading ? "animate-spin" : "")" /></button>
                </div>

                @if (_loading && _leads.Count == 0) { <div class="ld-empty">Loading…</div> }
                else
                {
                    <div class="ld-cols">
                        @foreach (var col in BoardColumns())
                        {
                            <div class="ld-col" style="--col:@col.Color">
                                <header><span class="ld-col-dot"></span><strong>@col.Title</strong><b>@col.Items.Count</b><small>@col.Hint</small></header>
                                <div class="ld-col-body">
                                    @foreach (var l in col.Items)
                                    {
                                        var lead = l;
                                        <button type="button" @key="lead.Id" @onclick="() => OpenAsync(lead.Id)" class="@($"ld-bcard {(_selected?.Lead?.Id == lead.Id ? "is-selected" : "")} {(lead.UnreadCount > 0 ? "has-unread" : "")}")">
                                            <span class="ld-bcard-top">
                                                <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                                                <span class="ld-bcard-who"><strong>@lead.Name</strong><small>+@lead.Phone</small></span>
                                                <span class="ld-bcard-time">@ListTime(lead.LastContactAt)</span>
                                            </span>
                                            <span class="ld-bcard-msg">@(lead.LastMessageDirection == "outbound" ? "You: " : "")@(lead.LastMessage ?? lead.FirstMessage ?? "No messages yet")</span>
                                            @if (lead.IsCustomer) { <span class="ld-bcard-conv"><Icon Name="HeartPulse" Size="12" />Converted by <strong>@(lead.ConvertedByName ?? "website order")</strong></span> }
                                            <span class="ld-bcard-tags">
                                                @if (lead.UnreadCount > 0) { <span class="ld-unread">@lead.UnreadCount new</span> }
                                                @if (lead.OpenOrders > 0) { <span class="ld-pill ld-open"><Icon Name="Truck" Size="10" />On the way</span> }
                                                @if (lead.NextFollowUpAt is { } nf) { <span class="@($"ld-pill ld-fu {(nf < DateTime.UtcNow ? "late" : "")}")"><Icon Name="Clock" Size="10" />@FuFmt.Due(nf)</span> }
                                                @if (lead.OrderCount > 0) { <span class="ld-pill ld-cust">₹@AdminFmt.Inr(lead.LifetimeValue)</span> }
                                                @if (lead.ConsentStatus == "opted_out") { <span class="ld-pill ld-stop">Opted out</span> }
                                            </span>
                                            <span class="ld-bcard-foot">
                                                <span class="ld-src">@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                                                @if (lead.AssignedToEmployeeId is null && Everyone) { <span class="ld-pill ld-unowned">Unassigned</span> }
                                                else if (Everyone && !string.IsNullOrEmpty(lead.AssignedToName)) { <span class="ld-owner-chip" title="Owner">@lead.AssignedToName</span> }
                                            </span>
                                        </button>
                                    }
                                    @if (col.Items.Count == 0) { <p class="ld-col-empty">Nobody here</p> }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
            <button type="button" class="ld-backdrop" aria-label="Close details" tabindex="-1" @onclick="CloseDetail"></button>
        }
        else
        {
        @* ───────── Lead list ───────── *@
        <section class="ld-list" aria-label="Leads">
            <div class="ld-list-head">
                <div class="ld-search">
                    <Icon Name="Search" Size="15" />
                    <input type="search" placeholder="Search name, phone or email" aria-label="Search leads" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
                    <button type="button" class="ld-refresh" title="Refresh" aria-label="Refresh leads" @onclick="() => LoadAsync(true)">
                        <Icon Name="RefreshCw" Size="14" Class="@(_loading ? "animate-spin" : "")" />
                    </button>
                </div>
                @if (Everyone)
                {
                    <select class="ld-assignee" aria-label="Filter by owner" value="@_assignee" @onchange="OnAssigneeFilterChanged">
                        <option value="">@(Mode == LeadViews.Care ? "All care owners" : "All owners")</option>
                        <option value="unassigned">Unassigned (@_unassigned)</option>
                        @foreach (var t in _team) { <option value="@t.Id">@t.Name</option> }
                    </select>
                }
                <div class="ld-tabs" role="tablist">
                    @if (Mode == LeadViews.Leads)
                    {
                        @if (Everyone) { <button type="button" role="tab" class="@TabClass("")" @onclick='() => SetStatusAsync("")'>All <b>@Total</b></button> }
                        @foreach (var s in KpiStatuses)
                        {
                            var status = s;
                            <button type="button" role="tab" class="@TabClass(status)" @onclick="() => SetStatusAsync(status)">@Label(status) <b>@_counts.GetValueOrDefault(status)</b></button>
                        }
                    }
                    else
                    {
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "" ? "is-active" : "")}")" @onclick='() => _quick = ""'>All <b>@Total</b></button>
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "unread" ? "is-active" : "")}")" @onclick='() => _quick = "unread"'>Unread <b>@_unreadTotal</b></button>
                        @if (Mode == LeadViews.Care)
                        {
                            <button type="button" role="tab" class="@($"ld-tab {(_quick == "open" ? "is-active" : "")}")" @onclick='() => _quick = "open"'>Order on the way <b>@_leads.Count(x => x.OpenOrders > 0)</b></button>
                        }
                    }
                </div>
            </div>

            <div class="ld-rows">
                @if (_loading && _leads.Count == 0)
                {
                    <div class="ld-empty">Loading…</div>
                }
                else if (VisibleLeads.Count == 0)
                {
                    var plain = string.IsNullOrWhiteSpace(_query) && _statusFilter == "" && _quick == "";
                    <div class="ld-empty">
                        <strong>@(plain ? EmptyTitle : "Nobody matches")</strong>
                        @(plain ? EmptyHint : "Try a different search or filter.")
                    </div>
                }
                else
                {
                    LeadDto? prevLead = null;
                    @foreach (var l in VisibleLeads)
                    {
                        var lead = l;
                        @if (FollowUpHeads && (prevLead is null || prevLead.FollowUpToday != lead.FollowUpToday))
                        {
                            <div class="ld-group">@(lead.FollowUpToday ? "Follow-up due today" : "Other follow-ups, by next date")</div>
                        }
                        prevLead = lead;
                        <button type="button" @key="lead.Id" @onclick="() => OpenAsync(lead.Id)"
                                class="@($"ld-row {(_selected?.Lead?.Id == lead.Id ? "is-selected" : "")} {(lead.UnreadCount > 0 ? "has-unread" : "")}")">
                            <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                            <span class="ld-row-main">
                                <span class="ld-row-top">
                                    <span class="ld-row-name">@lead.Name</span>
                                    <span class="ld-row-time">@ListTime(lead.LastContactAt)</span>
                                </span>
                                <span class="ld-row-bottom">
                                    <span class="ld-row-preview">@(lead.LastMessageDirection == "outbound" ? "You: " : "")@(lead.LastMessage ?? lead.FirstMessage ?? "No messages yet")</span>
                                    @if (lead.UnreadCount > 0) { <span class="ld-unread">@lead.UnreadCount</span> }
                                </span>
                                @if (lead.IsCustomer)
                                {
                                    <span class="ld-conv-line"><Icon Name="HeartPulse" Size="11" />Converted by <strong>@(lead.ConvertedByName ?? "website order")</strong></span>
                                }
                                <span class="ld-row-meta">
                                    <span class="@($"ld-pill {CurrentStatus(lead)}")">@Label(CurrentStatus(lead))</span>
                                    @if (lead.OpenOrders > 0) { <span class="ld-pill ld-open" title="An order is not delivered yet"><Icon Name="Truck" Size="10" />On the way</span> }
                                    <span class="ld-src"><Icon Name="MessageCircle" Size="11" />@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                                    @if (lead.AssignedToEmployeeId is null && Everyone) { <span class="ld-pill ld-unowned">Unassigned</span> }
                                    else if (Everyone) { <span class="ld-src">· @(lead.IsCustomer ? "Care: " : "")@lead.AssignedToName</span> }
                                    @if (lead.OrderCount > 0) { <span class="ld-pill ld-cust" title="Lifetime value"><Icon Name="Package" Size="10" />@lead.OrderCount order@(lead.OrderCount == 1 ? "" : "s") · ₹@AdminFmt.Inr(lead.LifetimeValue)</span> }
                                    @if (lead.NextFollowUpAt is { } nf) { <span class="@($"ld-pill ld-fu {(nf < DateTime.UtcNow ? "late" : "")}")" title="Next follow-up"><Icon Name="Clock" Size="10" />@FuFmt.Due(nf)</span> }
                                    @if (lead.ConsentStatus == "opted_out") { <span class="ld-pill ld-stop">Opted out</span> }
                                </span>
                            </span>
                        </button>
                    }
                }
            </div>
        </section>
        }

        @* ───────── Lead detail (a slide-in panel in the new look) ───────── *@
        <section class="ld-detail" aria-label="Lead detail">
            @if (_selected?.Lead is null)
            {
                <div class="ld-none">
                    <div>
                        <Icon Name="MessageCircle" Size="44" />
                        <strong>@(Mode == LeadViews.Care ? "Select a customer" : "Select a lead")</strong>
                        @(Mode == LeadViews.Care ? "Open a conversation to follow up, share order updates and keep notes." : "Open a conversation to reply on WhatsApp, update the status and keep notes.")
                    </div>
                </div>
            }
            else
            {
                var lead = _selected.Lead;
                <header class="ld-dhead">
                    <button type="button" class="ld-back" aria-label="Back to leads" @onclick="CloseDetail"><Icon Name="ArrowLeft" Size="20" /></button>
                    <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                    <div class="ld-who">
                        <strong>@lead.Name</strong>
                        <span>+@lead.Phone · @SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                    </div>
                    @if (lead.IsCustomer)
                    {
                        <span class="ld-pill converted" title="A lead becomes a customer when a paid order is placed">Customer</span>
                    }
                    else
                    {
                        <span class="@($"ld-pill ld-hstatus {CurrentStatus(lead)}")" title="Change it from the Status buttons on the right">@Label(CurrentStatus(lead))</span>
                    }
                </header>

                @if (lead.IsCustomer)
                {
                    <div class="ld-conv-banner">
                        <Icon Name="HeartPulse" Size="16" />
                        <span>Converted to a customer by <strong>@(lead.ConvertedByName ?? "a website order")</strong>@(lead.CustomerSince is { } since ? " on " + AdminFmt.DateTimeShort(since) : "")</span>
                        @if (lead.OpenOrders > 0) { <span class="ld-pill ld-open"><Icon Name="Truck" Size="10" />@lead.OpenOrders order@(lead.OpenOrders == 1 ? "" : "s") on the way</span> }
                    </div>
                }

                <div class="ld-owner">
                    <span>@(Everyone ? (lead.IsCustomer ? "Care owner" : "Owner") : "Transfer to")</span>
                    <select aria-label="Lead owner" disabled="@_busy" @onchange="OnOwnerChanged">
                        @if (Everyone)
                        {
                            <option value="" selected="@(lead.AssignedToEmployeeId is null)">Unassigned</option>
                            @foreach (var t in _team) { <option value="@t.Id" selected="@(lead.AssignedToEmployeeId == t.Id)">@t.Name</option> }
                        }
                        else
                        {
                            <option value="" selected disabled>@(lead.AssignedToName ?? "Me") (you)</option>
                            @foreach (var t in _team.Where(t => t.Id != AdminAuth.EmployeeId)) { <option value="@t.Id">@t.Name</option> }
                        }
                    </select>
                    @if (lead.AssignedAt is { } at) { <small>since @AdminFmt.DateTimeShort(at)</small> }
                    <span class="ld-owner-gap"></span>
                    @if (lead.NextFollowUpAt is { } nfu) { <span class="@($"ld-pill ld-fu {(nfu < DateTime.UtcNow ? "late" : "")}")"><Icon Name="Clock" Size="11" />Next: @FuFmt.Due(nfu)</span> }
                    <button type="button" class="ld-btn" @onclick="() => _orderDialog = true"><Icon Name="Package" Size="13" /> Order</button>
                    <button type="button" class="ld-btn" @onclick="() => _composer = true"><Icon Name="Plus" Size="13" /> Follow-up</button>
                    @if (AdminAuth.Can("tasks")) { <button type="button" class="ld-btn" title="Create a task about this lead" @onclick="() => NewTaskFor(lead.Id)"><Icon Name="Check" Size="13" /> Task</button> }
                </div>

                <div class="ld-one">
                    <div class="ld-chat">
                        @if (lead.ConsentStatus == "opted_out")
                        {
                            <div class="ld-banner danger"><Icon Name="AlertCircle" Size="15" /><span>This customer opted out (STOP). Do not send further messages.</span></div>
                        }
                        else if (WindowOpen(lead))
                        {
                            <div class="ld-banner"><Icon Name="Clock" Size="15" /><span>Reply window open — closes in @WindowLeft(lead). Free-form replies are allowed until then.</span></div>
                        }
                        else
                        {
                            <div class="ld-banner warn"><Icon Name="Clock" Size="15" /><span>24-hour window closed. WhatsApp only lets you send an approved template now. When the customer replies, you can send messages, files and videos again.</span></div>
                        }

                        @if (lead.ConsentStatus != "opted_out" && !WindowOpen(lead))
                        {
                            <div class="ld-tplsend">
                                <div class="ld-tplsend-head"><strong><Icon Name="Send" Size="14" /> Send an approved template</strong><small>Pick one, check the preview, send.</small></div>
                                @if (ApprovedTemplates.Count == 0)
                                {
                                    <p class="fu-hint">No templates are approved yet. An administrator submits them to Meta from <em>Team &amp; organisation → Messages &amp; templates</em> and marks them approved there.</p>
                                }
                                else
                                {
                                    <div class="ld-tplsend-list">
                                        @foreach (var td in ApprovedTemplates)
                                        {
                                            var def = td;
                                            <button type="button" class="@($"ld-tplopt {(_pickedTpl?.Name == def.Name ? "is-picked" : "")}")" @onclick="() => PickTemplate(def, lead)">
                                                <strong>@def.Title</strong><small>@MessageStages.Label(def.Stage)</small>
                                            </button>
                                        }
                                    </div>
                                    @if (_pickedTpl is { } pt)
                                    {
                                        <div class="ld-tplsend-form">
                                            @for (var pi = 0; pi < pt.Params.Length; pi++)
                                            {
                                                var idx = pi; var prm = pt.Params[pi];
                                                if (prm.Kind == "text")
                                                {
                                                    <label>@prm.Label<input type="text" maxlength="120" value="@_tplValues[idx]" placeholder="@prm.Sample" @oninput="e => _tplValues[idx] = e.Value?.ToString() ?? string.Empty" /></label>
                                                }
                                            }
                                            <div class="ld-tplsend-preview" aria-label="Preview">@pt.Filled(PreviewValues(pt, lead))</div>
                                            <button type="button" class="ld-btn primary" disabled="@(_busy || !TemplateReady(pt))" @onclick="() => SendTemplateAsync(lead)"><Icon Name="Send" Size="13" /> Send template</button>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <div class="ld-scroll">
                            <div class="ld-msgs">
                                @if (_selected.Messages.Count == 0)
                                {
                                    <div class="ld-day">No messages yet</div>
                                }
                                @{ DateTime? prevDay = null; string? prevDir = null; }
                                @foreach (var m in _selected.Messages)
                                {
                                    var local = m.CreatedAt.ToLocalTime();
                                    var inbound = m.Direction == "inbound";
                                    var first = prevDir != m.Direction || prevDay != local.Date;
                                    @if (prevDay != local.Date)
                                    {
                                        <div class="ld-day">@DayLabel(local.Date)</div>
                                    }
                                    var isTemplate = m.Type == "template" && (m.Body ?? "").StartsWith("[template:");
                                    var isMedia = m.Type is "image" or "sticker" or "video" or "audio" or "document";
                                    <div @key="m.Id" class="@($"ld-bub {(inbound ? "in" : "out")} {(first ? "first gap" : "")} {(m.Type == "sticker" ? "is-sticker" : "")} {(m.Reaction is not null ? "has-reaction" : "")}")">
                                        @if (!inbound && !string.IsNullOrEmpty(m.SentBy)) { <span class="ld-by">@m.SentBy</span> }
                                        @if (isMedia)
                                        {
                                            @MediaView(m)
                                        }
                                        @if (isTemplate)
                                        {
                                            <span class="ld-tpl">Template message</span>
                                            <span class="ld-tpl-body">@TemplateText(m.Body)</span>
                                        }
                                        else if (!string.IsNullOrEmpty(m.Body))
                                        {
                                            @LinkedText(m.Body)
                                        }
                                        else if (!isMedia)
                                        {
                                            @($"[{m.Type}]")
                                        }
                                        <span class="@($"ld-meta {(m.Status == "failed" ? "failed" : "")}")">
                                            @if (m.Status == "failed") { <span title="@m.Error">Not delivered</span> }
                                            @local.ToString("hh:mm tt")
                                            @if (!inbound && m.Status != "failed") { @Ticks(m.Status) }
                                        </span>
                                        @if (m.Status == "failed" && !string.IsNullOrEmpty(m.Error)) { <span class="ld-fail-why" style="display:block;font-size:11px;color:#b42318;margin-top:2px">@m.Error</span> }
                                        @if (!string.IsNullOrEmpty(m.Reaction)) { <span class="ld-react" title="Customer reacted">@m.Reaction</span> }
                                    </div>
                                    prevDay = local.Date; prevDir = m.Direction;
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_toast)) { <div class="ld-toast">@_toast</div> }

                        <div class="cmp">
                            @if (CanReply(lead) && _pop != "")
                            {
                                <button type="button" class="cmp-scrim" tabindex="-1" aria-label="Close" @onclick="() => _pop = string.Empty"></button>
                                <div class="cmp-pop" role="dialog" aria-label="@PopTitle(lead)">
                                    <div class="cmp-pop-head">
                                        <div><strong>@PopTitle(lead)</strong><small>@PopHint(lead)</small></div>
                                        <button type="button" class="cmp-x" aria-label="Close" @onclick="() => _pop = string.Empty"><Icon Name="X" Size="16" /></button>
                                    </div>
                                    <div class="cmp-pop-body">
                                        @if (_pop == "ai")
                                        {
                                            <button type="button" class="cmp-primary" disabled="@(_busy || _drafting)" @onclick="() => SuggestAsync(null, true)">
                                                <Icon Name="Sparkles" Size="16" /> @(_drafting ? "Writing a reply…" : _draft is null ? "Write a reply for me" : "Write a new draft")
                                            </button>
                                            @if (_draft?.RespondingTo is { Length: > 0 } rq && !_drafting)
                                            {
                                                <div class="cmp-ctx">Replying to <em>“@rq”</em></div>
                                            }
                                            <div class="cmp-sub">Rewrite what is in the box</div>
                                            <div class="cmp-chips">
                                                @foreach (var t in Tweaks)
                                                {
                                                    var tweak = t;
                                                    <button type="button" class="cmp-chip" disabled="@(_busy || _drafting || string.IsNullOrWhiteSpace(_reply))" @onclick="() => SuggestAsync(tweak.Instruction, false)">@tweak.Label</button>
                                                }
                                            </div>
                                            @if (string.IsNullOrWhiteSpace(_reply)) { <small class="cmp-faint">Write or generate a reply first, then rewrite it here.</small> }
                                        }
                                        else if (_pop == "files")
                                        {
                                            @if (_library.Count == 0) { <p class="cmp-empty">No files yet. An administrator adds them in Team &amp; organisation → File library.</p> }
                                            @foreach (var lf in _library)
                                            {
                                                var file = lf;
                                                <div class="cmp-item">
                                                    <span class="cmp-ico">@AdminFileLibrary.KindEmoji(file.Kind)</span>
                                                    <div class="cmp-txt"><strong>@file.Title</strong><small>@LibraryKinds.Label(file.Kind) · @AdminFileLibrary.Size(file.Size)@(file.CanAttach ? "" : " · link only")</small></div>
                                                    <div class="cmp-acts">
                                                        <button type="button" class="cmp-btn primary" disabled="@(_busy || !file.CanAttach)" title="@(file.CanAttach ? "Send the file itself on WhatsApp" : "Too large to send as an attachment")" @onclick="() => SendFileAsync(file, false)">Send file</button>
                                                        <button type="button" class="cmp-btn" disabled="@_busy" title="Send a message with the file's link" @onclick="() => SendFileAsync(file, true)">Send link</button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else if (_pop == "tpl")
                                        {
                                            @if (!TemplatesFor(lead).Any()) { <p class="cmp-empty">No ready-made replies for this stage yet.</p> }
                                            @foreach (var t in TemplatesFor(lead))
                                            {
                                                var tpl = t;
                                                <button type="button" class="cmp-item cmp-click" @onclick="() => UseTemplate(tpl)">
                                                    <span class="cmp-ico"><Icon Name="MessageSquare" Size="16" /></span>
                                                    <div class="cmp-txt"><strong>@tpl.Title</strong><small class="cmp-clamp">@MessageDefaults.Fill(tpl.Body, lead.Name, AdminAuth.Name, _selected.Orders.FirstOrDefault()?.Id)</small></div>
                                                    <span class="cmp-use">Use</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (CanReply(lead) && _draft is { NeedsReview: true } && !string.IsNullOrWhiteSpace(_reply))
                            {
                                <div class="cmp-note"><Icon Name="AlertCircle" Size="14" /><span><strong>Check before sending.</strong> @(_draft.ReviewNote ?? "This reply needs a careful read.")</span></div>
                            }

                            <form class="ld-composer" @onsubmit="ReplyAsync" @onsubmit:preventDefault>
                                <textarea rows="@ReplyRows" aria-label="Type a message" disabled="@(_busy || !CanReply(lead))" maxlength="1500"
                                          placeholder="@(lead.ConsentStatus == "opted_out" ? "Customer opted out" : WindowOpen(lead) ? "Type a message, or use the tools below" : "24-hour window closed")"
                                          @bind="_reply" @bind:event="oninput" @onkeydown="OnReplyKey"></textarea>
                                <button type="submit" class="ld-send" aria-label="Send message" title="Send (Ctrl+Enter)" disabled="@(_busy || _drafting || !CanReply(lead) || string.IsNullOrWhiteSpace(_reply))"><Icon Name="Send" Size="18" /></button>
                            </form>

                            @if (CanReply(lead))
                            {
                                <div class="cmp-bar">
                                    @if (_assistantOn)
                                    {
                                        <button type="button" class="@($"cmp-tool {(_pop == "ai" ? "is-on" : "")}")" aria-expanded="@(_pop == "ai")" @onclick="() => OpenPopAsync(PopAi)">
                                            <Icon Name="Sparkles" Size="15" /> @(_drafting ? "Writing…" : "Reply assistant")
                                            @if (!_drafting && _draft is not null) { <span class="cmp-dot" title="@(_draft.Source == "ai" ? "AI draft" : "Standard reply")"></span> }
                                        </button>
                                    }
                                    <button type="button" class="@($"cmp-tool {(_pop == "files" ? "is-on" : "")}")" aria-expanded="@(_pop == "files")" @onclick="() => OpenPopAsync(PopFiles)"><Icon Name="FileText" Size="15" /> Files &amp; videos</button>
                                    @if (_templates.Count > 0)
                                    {
                                        <button type="button" class="@($"cmp-tool {(_pop == "tpl" ? "is-on" : "")}")" aria-expanded="@(_pop == "tpl")" @onclick="() => OpenPopAsync(PopTpl)"><Icon Name="MessageSquare" Size="15" /> Ready-made replies</button>
                                    }
                                    <span class="cmp-gap"></span>
                                    <small class="cmp-hint">Ctrl + Enter to send</small>
                                </div>
                            }
                        </div>
                    </div>
                    <aside class="ld-side" aria-label="About this lead">
                        <section class="ld-sec">
                            <h4>Status</h4>
                            @if (lead.IsCustomer)
                            {
                                <span class="ld-pill converted">Customer</span>
                            }
                            else
                            {
                                <div class="ld-quick" role="group" aria-label="Set status">
                                    @foreach (var s in QuickStatuses)
                                    {
                                        var st = s;
                                        <button type="button" class="@($"ld-q q-{st} {(CurrentStatus(lead) == st ? "is-on" : "")}")" aria-pressed="@(CurrentStatus(lead) == st)" disabled="@_busy" @onclick="() => SetQuickAsync(st)">@Label(st)</button>
                                    }
                                </div>
                                <small class="ld-muted">No answer books a retry for tomorrow 10 am.</small>
                            }
                        </section>

                        <section class="ld-sec">
                            <h4>Follow-ups <button type="button" class="ld-link" @onclick="() => _composer = true">+ Schedule</button></h4>
                            @{
                                var pendingFu = _selected.FollowUps.Where(f => f.Status == "pending").ToList();
                                var closedFu = _selected.FollowUps.Where(f => f.Status != "pending").ToList();
                                var shownFu = pendingFu.Concat(_showAllFu ? closedFu : closedFu.Take(2)).ToList();
                            }
                            @if (shownFu.Count == 0)
                            {
                                <p class="fu-hint">Nothing scheduled. Add a call or message so this lead is not forgotten.</p>
                            }
                            <div class="fu-list tight">
                                @foreach (var fu in shownFu)
                                {
                                    <FollowUpCard @key="fu.Id" Item="fu" ShowLead="false" IsAdmin="Everyone" Team="_team" OnChanged="OnFollowUpChanged" />
                                }
                            </div>
                            @if (closedFu.Count > 2) { <button type="button" class="ld-link" @onclick="() => _showAllFu = !_showAllFu">@(_showAllFu ? "Show fewer" : $"Show all {closedFu.Count} finished")</button> }
                        </section>

                        <section class="ld-sec">
                            <h4>Notes</h4>
                            <textarea placeholder="Interest, objections, preferred call time…" aria-label="Internal notes" @bind="_notes" @bind:event="oninput"></textarea>
                            <div class="ld-actions">
                                @if (!string.IsNullOrEmpty(_toast)) { <small>@_toast</small> }
                                <button type="button" class="ld-btn primary" disabled="@_busy" @onclick="SaveNotesAsync">Save notes</button>
                            </div>
                        </section>

                        <section class="ld-sec">
                            <h4>Contact</h4>
                            <dl class="ld-dl">
                                <dt>Name</dt><dd>@lead.Name</dd>
                                <dt>Phone</dt><dd>+@lead.Phone</dd>
                                @if (!string.IsNullOrEmpty(lead.Email)) { <dt>Email</dt><dd>@lead.Email</dd> }
                                <dt>Source</dt><dd>@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</dd>
                                <dt>Came in</dt><dd>@AdminFmt.DateTimeShort(lead.CreatedAt)</dd>
                                <dt>Last contact</dt><dd>@AdminFmt.DateTimeShort(lead.LastContactAt)</dd>
                                @if (lead.IsCustomer)
                                {
                                    <dt>Converted by</dt><dd>@(lead.ConvertedByName ?? "A website order")</dd>
                                    <dt>Customer since</dt><dd>@(lead.CustomerSince is { } cs ? AdminFmt.DateTimeShort(cs) : "—")</dd>
                                }
                            </dl>
                            @if (!string.IsNullOrEmpty(lead.FirstMessage)) { <p class="ld-quote">“@lead.FirstMessage”</p> }
                        </section>

                        <section class="ld-sec">
                            <h4>Orders <button type="button" class="ld-link" @onclick="() => _orderDialog = true">+ Create order</button></h4>
                            @if (_selected.Orders.Count == 0)
                            {
                                <p class="fu-hint">No orders yet. When the customer agrees to buy, use <strong>Create order</strong>.</p>
                            }
                            else
                            {
                                <div class="lo-stats">
                                    <div><span>Orders</span><strong>@lead.OrderCount</strong></div>
                                    <div><span>Lifetime</span><strong>₹@AdminFmt.Inr(lead.LifetimeValue)</strong></div>
                                    <div><span>Last order</span><strong>@(lead.LastOrderAt is { } lo ? AdminFmt.DateTimeShort(lo) : "—")</strong></div>
                                </div>
                                <div class="lo-orders">
                                    @foreach (var o in _selected.Orders)
                                    {
                                        <div class="lo-order">
                                            <div>
                                                <strong>@o.Id</strong>
                                                <small>@o.Items</small>
                                                <small>@AdminFmt.DateTimeShort(o.CreatedAt) · @(o.PaymentMethod == "COD" ? "Cash on delivery" : "Paid") @(string.IsNullOrEmpty(o.Awb) ? "" : "· " + o.Courier + " " + o.Awb)</small>
                                            </div>
                                            <div class="lo-order-end">
                                                <b>₹@AdminFmt.Inr(o.TotalAmount)</b>
                                                <span class="@($"ld-pill {OrderTone(o.FulfillmentStatus)}")">@o.DeliveryStatus</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <details class="ld-more">
                            <summary>History, owner changes &amp; WhatsApp consent</summary>
                            <div class="ld-more-body">
                                <h5>WhatsApp consent</h5>
                                <dl class="ld-dl">
                                    <dt>Marketing</dt>
                                    <dd class="@(lead.ConsentStatus == "opted_in" ? "ld-ok" : lead.ConsentStatus == "opted_out" ? "ld-bad" : "ld-warn")">@ConsentLabel(lead.ConsentStatus)</dd>
                                    <dt>Reply window</dt>
                                    <dd class="@(WindowOpen(lead) ? "ld-ok" : "ld-warn")">@(WindowOpen(lead) ? "Open · " + WindowLeft(lead) + " left" : "Closed — templates only")</dd>
                                </dl>
                                @if (lead.ConsentStatus != "opted_out")
                                {
                                    <div class="ld-actions">
                                        <small>Opt-in lets follow-up messages be sent automatically. Only record it after the customer agreed.</small>
                                        @if (lead.ConsentStatus == "opted_in")
                                        {
                                            <button type="button" class="ld-btn" disabled="@_busy" @onclick='() => SetConsentAsync("unknown")'>Clear</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ld-btn" disabled="@_busy" @onclick='() => SetConsentAsync("opted_in")'>Customer agreed</button>
                                        }
                                    </div>
                                }

                                <h5>Owner changes</h5>
                                @if (_selected.Assignments.Count == 0) { <p class="ld-muted">No owner changes yet.</p> }
                                else
                                {
                                    <ul class="ld-tl">
                                        @foreach (var a in _selected.Assignments)
                                        {
                                            <li>@(a.FromName is null ? "Assigned" : a.FromName + " →") <strong>@(a.ToName ?? "Unassigned")</strong>
                                                <small>@AdminFmt.DateTimeShort(a.CreatedAt) · @a.ChangedBy@(string.IsNullOrEmpty(a.Reason) ? "" : " · " + a.Reason)</small></li>
                                        }
                                    </ul>
                                }

                                <h5>Everything that changed</h5>
                                @if (_selected.Audit.Count == 0) { <p class="ld-muted">No changes recorded yet.</p> }
                                else
                                {
                                    <ul class="ld-tl">
                                        @foreach (var a in _selected.Audit)
                                        {
                                            <li>
                                                <strong>@a.Summary</strong>
                                                <small>@AdminFmt.DateTimeShort(a.CreatedAt) · @(a.Automatic ? "system (" + a.Actor + ")" : a.Actor)@(string.IsNullOrEmpty(a.Detail) ? "" : " · " + a.Detail)</small>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </details>
                    </aside>
                </div>
            }
        </section>
    </div>
</div>

@if (_orderDialog && _selected?.Lead is { } ol)
{
    <LeadOrderDialog LeadId="ol.Id" LeadName="@ol.Name" LeadEmail="@ol.Email" OnClose="() => _orderDialog = false" OnCreated="OnOrderCreated" />
}

@if (_composer && _selected?.Lead is { } cl)
{
    <FollowUpComposer LeadId="cl.Id" LeadName="@cl.Name" LeadPhone="@cl.Phone" IsAdmin="Everyone" Team="_team" OnClose="() => _composer = false" OnCreated="OnFollowUpCreated" />
}

@code {
    private void NewTaskFor(long leadId) => Nav.NavigateTo("/admin/tasks?lead=" + leadId);
    /// <summary>Which panel this is: leads (new and follow-up), interested (hot leads) or care (paid customers).</summary>
    [Parameter] public string Mode { get; set; } = LeadViews.Leads;

    /// <summary>May see and manage everyone's people in this panel, not just their own.</summary>
    private bool Everyone => AdminAuth.CanAll(Mode);
    /// <summary>Tabs of the Leads panel: new today, older and still unopened, follow-up, no answer, not interested.</summary>
    private static readonly string[] KpiStatuses = LeadBuckets.All;
    /// <summary>A lead becomes a customer only through a paid order, so "Converted" is not a choice here.</summary>
    private static readonly string[] EditableStatuses = [LeadStatuses.New, LeadStatuses.Interested, LeadStatuses.FollowUp, LeadStatuses.NotInterested];
    private static readonly string[] Palette = ["#235b40", "#2f6f8f", "#7a5aa6", "#b5792a", "#a24b5a", "#3f7d7a", "#5b6f2c"];

    private readonly CancellationTokenSource _cts = new();
    private List<LeadDto> _leads = new();
    private Dictionary<string, int> _counts = new();
    private LeadDetailResponse? _selected;
    private string _statusFilter = "";
    private string _query = "";
    private string _reply = "";
    private string _notes = "";
    private string _tab = "chat";
    private bool _composer;
    private bool _orderDialog;
    private string _assignee = "";
    private int _unassigned;
    private List<EmployeeDto> _team = new();
    private string? _error;
    private string? _toast;
    private bool _loading = true;
    private bool _busy;
    private bool _v2;
    private string? _notice;
    private string _quick = ""; // "", "unread" or "open" (hot leads and customers)
    private Dictionary<string, int> _viewCounts = new();
    private int _unreadTotal;
    private List<MessageTemplateDto> _templates = new();

    // Files from the library, and approved WhatsApp templates for when the 24-hour window is closed
    private List<string> _approved = new();
    private List<LibraryFileDto> _library = new();
    private MetaTemplateDef? _pickedTpl;
    private List<string> _tplValues = new();

    private List<MetaTemplateDef> ApprovedTemplates =>
        MetaTemplates.All.Where(t => _approved.Contains(t.Name)).OrderBy(t => _selected?.Lead is { } l && t.Stage == StageOf(l) ? 0 : 1).ToList();

    private static string TemplateText(string? body)
    {
        var text = body ?? "";
        var i = text.IndexOf("] ", StringComparison.Ordinal);
        return text.StartsWith("[template:") && i > 0 ? text[(i + 2)..] : text;
    }

    private void PickTemplate(MetaTemplateDef def, LeadDto lead)
    {
        _pickedTpl = def;
        _tplValues = def.Params.Select(_ => "").ToList();
    }

    private string? LatestOrderId => _selected?.Orders.FirstOrDefault()?.Id;

    private List<string> PreviewValues(MetaTemplateDef def, LeadDto lead) =>
        def.Params.Select((p, i) => p.Kind switch
        {
            "name" => MessageDefaults.Fill("{name}", lead.Name),
            "agent" => string.IsNullOrWhiteSpace(AdminAuth.Name) ? "our team" : AdminAuth.Name,
            "order" => LatestOrderId ?? "…",
            _ => string.IsNullOrWhiteSpace(_tplValues.ElementAtOrDefault(i)) ? "…" : _tplValues[i].Trim(),
        }).ToList();

    private bool TemplateReady(MetaTemplateDef def) =>
        def.Params.Select((p, i) => p.Kind switch { "order" => LatestOrderId is not null, "text" => !string.IsNullOrWhiteSpace(_tplValues.ElementAtOrDefault(i)), _ => true }).All(x => x);

    private async Task SendTemplateAsync(LeadDto lead)
    {
        if (_pickedTpl is not { } def) return;
        _busy = true;
        var res = await Api.AdminLeadSendTemplateAsync(lead.Id, new SendTemplateRequest { Name = def.Name, Params = def.Params.Select((p, i) => p.Kind == "text" ? _tplValues.ElementAtOrDefault(i) ?? "" : "").ToList() });
        _toast = res.Message;
        if (res.Success) { _pickedTpl = null; _notice = res.Message; }
        await RefreshDetailAsync(lead.Id, keepNotes: true);
        await LoadAsync(false);
        _busy = false;
    }

    // ---- Composer tools: one panel at a time opens above the text box ----
    private const string PopAi = "ai", PopFiles = "files", PopTpl = "tpl";
    private string _pop = string.Empty;

    private async Task OpenPopAsync(string which)
    {
        _pop = _pop == which ? string.Empty : which;
        if (_pop == PopFiles && _library.Count == 0)
        {
            var res = await Api.AdminLibraryAsync();
            if (res.Success) _library = res.Files; else _toast = res.Message;
        }
    }

    private string PopTitle(LeadDto lead) => _pop switch
    {
        PopAi => "Reply assistant",
        PopFiles => "Files & videos",
        PopTpl => "Ready-made replies",
        _ => "",
    };

    private string PopHint(LeadDto lead) => _pop switch
    {
        PopAi => "Let the assistant write the reply, or rewrite yours.",
        PopFiles => "Send a brochure, PDF or video from your library.",
        PopTpl => $"For {MessageStages.Label(StageOf(lead)).ToLowerInvariant()}. Pick one and it fills the box so you can edit it.",
        _ => "",
    };

    private async Task SendFileAsync(LibraryFileDto file, bool asLink)
    {
        if (_selected?.Lead is not { } lead) return;
        _busy = true;
        var res = await Api.AdminLeadSendFileAsync(lead.Id, new SendFileRequest { FileId = file.Id, Mode = asLink ? "link" : "attachment" });
        _toast = res.Success ? null : res.Message;
        if (res.Success) { _pop = string.Empty; _notice = $"{(asLink ? "Link to" : "File")} “{file.Title}” sent to {lead.Name}."; }
        await RefreshDetailAsync(lead.Id, keepNotes: true);
        await LoadAsync(false);
        _busy = false;
    }

    private int Total => _counts.Values.Sum();

    private const string LookKey = "nura.leads.newlook";

    private async Task ToggleLookAsync()
    {
        _v2 = !_v2;
        await Browser.SetLocalAsync(LookKey, _v2 ? "1" : "0");
    }

    private void GoTo(string view) { if (view != Mode) Nav.NavigateTo("/admin/" + view); }

    private static string PanelName(string view) => view switch { LeadViews.Interested => "Hot leads", LeadViews.Care => "Customer care", _ => "Leads" };
    private static string PanelIcon(string view) => view switch { LeadViews.Interested => "Flame", LeadViews.Care => "HeartPulse", _ => "Phone" };

    /// <summary>The panel a person belongs in right now.</summary>
    private static string ViewOf(LeadDto l) => l.IsCustomer ? LeadViews.Care : l.Status == LeadStatuses.Interested ? LeadViews.Interested : LeadViews.Leads;
    private static string StageOf(LeadDto l) => MessageStages.Of(l.Status, l.IsCustomer);

    /// <summary>The Follow-up and No answer tabs are ordered by due date (today first) and get section headings.</summary>
    private bool FollowUpHeads => Mode == LeadViews.Leads && _statusFilter is LeadBuckets.FollowUp or LeadBuckets.NoAnswer;

    private List<LeadDto> VisibleLeads => _quick switch
    {
        "unread" => _leads.Where(l => l.UnreadCount > 0).ToList(),
        "open" => _leads.Where(l => l.OpenOrders > 0).ToList(),
        _ => _leads,
    };

    private sealed record BoardColumn(string Title, string Hint, string Color, List<LeadDto> Items);

    /// <summary>The pipeline board: leads by status, hot leads by whose turn it is, customers by what needs doing.</summary>
    private List<BoardColumn> BoardColumns()
    {
        var all = VisibleLeads;
        static bool NeedsUs(LeadDto l) => l.UnreadCount > 0 || l.LastMessageDirection == "inbound";
        switch (Mode)
        {
            case LeadViews.Care:
                return
                [
                    new("Needs a reply", "Customer wrote last", "#d97706", all.Where(NeedsUs).ToList()),
                    new("Order on the way", "Not delivered yet", "#2563eb", all.Where(l => !NeedsUs(l) && l.OpenOrders > 0).ToList()),
                    new("All good", "Delivered, nothing waiting", "#16a34a", all.Where(l => !NeedsUs(l) && l.OpenOrders == 0).ToList()),
                ];
            case LeadViews.Interested:
                return
                [
                    new("Needs a reply", "Lead wrote last", "#d97706", all.Where(NeedsUs).ToList()),
                    new("Follow-up booked", "A call or message is scheduled", "#2563eb", all.Where(l => !NeedsUs(l) && l.NextFollowUpAt is not null).ToList()),
                    new("Waiting on them", "We replied, nothing booked", "#64748b", all.Where(l => !NeedsUs(l) && l.NextFollowUpAt is null).ToList()),
                ];
            default:
                return
                [
                    new("New", "Arrived today, awaiting a first reply", Accent(LeadStatuses.New), all.Where(l => BucketOf(l) == LeadBuckets.New).ToList()),
                    new("Older, not opened", "Arrived on an earlier day, nobody started", Accent(LeadBuckets.Older), all.Where(l => BucketOf(l) == LeadBuckets.Older).ToList()),
                    new("Follow-up", "Needs a callback", Accent(LeadStatuses.FollowUp), all.Where(l => BucketOf(l) == LeadBuckets.FollowUp).ToList()),
                    new("No answer", "Last call or message unanswered", Accent(LeadBuckets.NoAnswer), all.Where(l => BucketOf(l) == LeadBuckets.NoAnswer).ToList()),
                    new("Not interested", "Closed for now", "#94a3b8", all.Where(l => BucketOf(l) == LeadBuckets.NotInterested).ToList()),
                ];
        }
    }

    /// <summary>Same rule as the server: today is the Indian calendar day.</summary>
    private static DateTime TodayStartUtc => DateTime.UtcNow.AddHours(5.5).Date.AddHours(-5.5);

    private static string BucketOf(LeadDto l)
    {
        if (l.Status == LeadStatuses.NotInterested) return LeadBuckets.NotInterested;
        if (l.NoAnswer && l.Status is LeadStatuses.New or LeadStatuses.FollowUp) return LeadBuckets.NoAnswer;
        if (l.Status == LeadStatuses.FollowUp) return LeadBuckets.FollowUp;
        if (l.Status == LeadStatuses.New) return DateTime.SpecifyKind(l.CreatedAt, DateTimeKind.Utc) >= TodayStartUtc ? LeadBuckets.New : LeadBuckets.Older;
        return l.Status;
    }

    private string QuickClass(string quick) => $"ld-kpi {(_quick == quick ? "is-active" : "")}";

    private string EmptyTitle => Mode switch { LeadViews.Care => "No customers yet", LeadViews.Interested => "No hot leads yet", _ => "No leads yet" };
    private string EmptyHint => Mode switch
    {
        LeadViews.Care => "A lead appears here as soon as their first paid order is placed, including website orders.",
        LeadViews.Interested => "Leads you mark as Interested appear here, ready for follow-up and an order.",
        _ => "New enquiries appear here automatically as soon as someone messages your WhatsApp Business number.",
    };

    /// <summary>Ready-made replies that fit this person's stage first, then the rest.</summary>
    private IEnumerable<MessageTemplateDto> TemplatesFor(LeadDto l)
    {
        var stage = StageOf(l);
        return _templates.Where(t => t.Group == "reply" && t.Stage == stage);
    }

    private void UseTemplate(MessageTemplateDto t)
    {
        if (_selected?.Lead is not { } lead) return;
        _reply = MessageDefaults.Fill(t.Body, lead.Name, AdminAuth.Name, _selected.Orders.FirstOrDefault()?.Id);
        _pop = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        _v2 = await Browser.GetLocalAsync(LookKey) == "1";
        if (Mode == LeadViews.Leads) _statusFilter = LeadStatuses.New; // open on the new leads first; "All" is one click away
        var tpl = await Api.AdminMessageTemplatesAsync();
        if (tpl.Success) { _templates = tpl.Settings.Items; _approved = tpl.Settings.ApprovedMetaTemplates; }
        await Task.WhenAll(LoadAsync(true), LoadTeamAsync(), LoadAssistantSettingsAsync());
        // Arrived from a follow-up or notification: open that lead straight away.
        var q = Nav.ToAbsoluteUri(Nav.Uri).Query;
        var m = System.Text.RegularExpressions.Regex.Match(q, @"[?&]open=(\d+)");
        if (m.Success && long.TryParse(m.Groups[1].Value, out var openId)) await OpenAsync(openId);
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(async () =>
                {
                    if (_busy) return;
                    await LoadAsync(false, keepOrder: true);
                    if (_selected?.Lead is { } l) await RefreshDetailAsync(l.Id, keepNotes: true);
                });
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    /// <param name="keepOrder">Background refresh: rows already on screen keep their place (only their details update) and brand-new leads are added at the bottom,
    /// so the list never jumps while someone is typing to a customer. The Refresh button and any action re-sort normally.</param>
    private async Task LoadAsync(bool spinner, bool keepOrder = false)
    {
        if (spinner) { _loading = true; StateHasChanged(); }
        var res = await Api.AdminLeadsAsync(_statusFilter, null, _query, _assignee, 100, Mode);
        if (_cts.IsCancellationRequested) return;
        if (res.Success && keepOrder && _leads.Count > 0 && !FollowUpHeads) // the due-date lists are re-ordered by the server each time
        {
            var fresh = res.Leads.ToDictionary(x => x.Id);
            var known = _leads.Select(x => x.Id).ToHashSet();
            res.Leads = _leads.Where(x => fresh.ContainsKey(x.Id)).Select(x => fresh[x.Id]).Concat(res.Leads.Where(x => !known.Contains(x.Id))).ToList();
        }
        if (res.Success) { _leads = res.Leads; _counts = res.StatusCounts; _unassigned = res.UnassignedCount; _viewCounts = res.ViewCounts; _unreadTotal = res.UnreadTotal; _error = null; }
        else _error = res.Message ?? "Could not load leads.";
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadTeamAsync()
    {
        var res = await Api.AdminTeamAsync(Mode);
        if (res.Success) _team = res.Employees;
    }

    private Task OnAssigneeFilterChanged(ChangeEventArgs e) { _assignee = e.Value?.ToString() ?? ""; return LoadAsync(true); }

    /// <summary>Admin: assign / unassign. Sales: hand the lead to a colleague (it then leaves their list).</summary>
    private async Task OnOwnerChanged(ChangeEventArgs e)
    {
        if (_selected?.Lead is not { } lead) return;
        var raw = e.Value?.ToString() ?? "";
        long? target = long.TryParse(raw, out var id) ? id : null;
        if (target is null && !Everyone) return; // placeholder option
        if (target == lead.AssignedToEmployeeId) return;
        _busy = true;
        var res = await Api.AdminLeadAssignAsync(lead.Id, new LeadAssignRequest { EmployeeId = target });
        _toast = res.Message;
        if (res.Success && !Everyone) { _selected = null; } // no longer theirs
        else await RefreshDetailAsync(lead.Id, keepNotes: true);
        await LoadAsync(false);
        _busy = false;
    }

    private Task SetStatusAsync(string status) { _statusFilter = status; return LoadAsync(true); }
    private Task SearchAsync() => LoadAsync(false);

    private async Task OpenAsync(long id)
    {
        _toast = null; _tab = "chat"; _reply = ""; _draft = null; _draftForMessage = 0; _pop = string.Empty;
        await RefreshDetailAsync(id, keepNotes: false);
        await LoadAsync(false); // the unread badge clears once the conversation is opened
    }

    private void CloseDetail() => _selected = null;

    private async Task RefreshDetailAsync(long id, bool keepNotes)
    {
        var res = await Api.AdminLeadDetailAsync(id);
        if (_cts.IsCancellationRequested) return;
        if (!res.Success || res.Lead is null) { _toast = res.Message ?? "Could not load lead."; return; }
        var sameLead = _selected?.Lead?.Id == id;

        // The person now belongs in another panel (marked interested, or placed a paid order).
        var home = ViewOf(res.Lead);
        if (home != Mode)
        {
            if (!sameLead && AdminAuth.Can(home)) { Nav.NavigateTo($"/admin/{home}?open={id}"); return; } // opened from a link: follow them
            _selected = null;
            _notice = AdminAuth.Can(home)
                ? $"{res.Lead.Name} is now in {PanelName(home)}."
                : $"{res.Lead.Name} moved to {PanelName(home)}, which your designation cannot open.";
            StateHasChanged();
            return;
        }
        var prevNotes = _notes;
        _selected = res;
        _notes = keepNotes && sameLead ? prevNotes : res.Lead.Notes ?? "";
        StateHasChanged();
        await MaybeDraftAsync();
    }

