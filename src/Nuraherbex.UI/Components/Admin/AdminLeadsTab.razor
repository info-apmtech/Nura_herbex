@implements IDisposable
@inject ApiClient Api

<div class="ld">

    @* Pipeline summary — doubles as the status filter *@
    <div class="ld-kpis">
        <button type="button" class="@KpiClass("")" @onclick='() => SetStatusAsync("")'>
            <i style="background:#235b40"></i><span>All leads</span><strong>@Total</strong><small>@ConversionText</small>
        </button>
        @foreach (var s in KpiStatuses)
        {
            var status = s;
            <button type="button" class="@KpiClass(status)" @onclick="() => SetStatusAsync(status)">
                <i style="background:@Accent(status)"></i><span>@Label(status)</span><strong>@_counts.GetValueOrDefault(status)</strong><small>@KpiHint(status)</small>
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ld-banner danger" style="border-radius:10px;border:1px solid #f6d2cd"><Icon Name="AlertCircle" Size="15" /><span>@_error</span></div>
    }

    <div class="@($"ld-work {(_selected?.Lead is not null ? "is-detail" : "")}")">

        @* ───────── Lead list ───────── *@
        <section class="ld-list" aria-label="Leads">
            <div class="ld-list-head">
                <div class="ld-search">
                    <Icon Name="Search" Size="15" />
                    <input type="search" placeholder="Search name, phone or email" aria-label="Search leads" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
                    <button type="button" class="ld-refresh" title="Refresh" aria-label="Refresh leads" @onclick="() => LoadAsync(true)">
                        <Icon Name="RefreshCw" Size="14" Class="@(_loading ? "animate-spin" : "")" />
                    </button>
                </div>
                <div class="ld-tabs" role="tablist">
                    <button type="button" role="tab" class="@TabClass("")" @onclick='() => SetStatusAsync("")'>All <b>@Total</b></button>
                    @foreach (var s in LeadStatuses.All)
                    {
                        var status = s;
                        <button type="button" role="tab" class="@TabClass(status)" @onclick="() => SetStatusAsync(status)">@Label(status) <b>@_counts.GetValueOrDefault(status)</b></button>
                    }
                </div>
            </div>

            <div class="ld-rows">
                @if (_loading && _leads.Count == 0)
                {
                    <div class="ld-empty">Loading leads…</div>
                }
                else if (_leads.Count == 0)
                {
                    <div class="ld-empty">
                        <strong>@(string.IsNullOrWhiteSpace(_query) && _statusFilter == "" ? "No leads yet" : "No matching leads")</strong>
                        @(string.IsNullOrWhiteSpace(_query) && _statusFilter == "" ? "New enquiries appear here automatically as soon as someone messages your WhatsApp Business number." : "Try a different search or status filter.")
                    </div>
                }
                else
                {
                    @foreach (var l in _leads)
                    {
                        var lead = l;
                        <button type="button" @key="lead.Id" @onclick="() => OpenAsync(lead.Id)"
                                class="@($"ld-row {(_selected?.Lead?.Id == lead.Id ? "is-selected" : "")} {(lead.UnreadCount > 0 ? "has-unread" : "")}")">
                            <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                            <span class="ld-row-main">
                                <span class="ld-row-top">
                                    <span class="ld-row-name">@lead.Name</span>
                                    <span class="ld-row-time">@ListTime(lead.LastContactAt)</span>
                                </span>
                                <span class="ld-row-bottom">
                                    <span class="ld-row-preview">@(lead.LastMessageDirection == "outbound" ? "You: " : "")@(lead.LastMessage ?? lead.FirstMessage ?? "No messages yet")</span>
                                    @if (lead.UnreadCount > 0) { <span class="ld-unread">@lead.UnreadCount</span> }
                                </span>
                                <span class="ld-row-meta">
                                    <span class="@($"ld-pill {lead.Status}")">@Label(lead.Status)</span>
                                    <span class="ld-src"><Icon Name="MessageCircle" Size="11" />@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                                    @if (lead.ConsentStatus == "opted_out") { <span class="ld-pill ld-stop">Opted out</span> }
                                </span>
                            </span>
                        </button>
                    }
                }
            </div>
        </section>

        @* ───────── Lead detail ───────── *@
        <section class="ld-detail" aria-label="Lead detail">
            @if (_selected?.Lead is null)
            {
                <div class="ld-none">
                    <div>
                        <Icon Name="MessageCircle" Size="44" />
                        <strong>Select a lead</strong>
                        Open a conversation to reply on WhatsApp, update the status and keep notes.
                    </div>
                </div>
            }
            else
            {
                var lead = _selected.Lead;
                <header class="ld-dhead">
                    <button type="button" class="ld-back" aria-label="Back to leads" @onclick="CloseDetail"><Icon Name="ArrowLeft" Size="20" /></button>
                    <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                    <div class="ld-who">
                        <strong>@lead.Name</strong>
                        <span>+@lead.Phone · @SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                    </div>
                    <select class="ld-status-select" aria-label="Lead status" disabled="@_busy" value="@lead.Status" @onchange="OnStatusChanged">
                        @foreach (var s in LeadStatuses.All) { <option value="@s" selected="@(s == lead.Status)">@Label(s)</option> }
                    </select>
                </header>

                <nav class="ld-dtabs" role="tablist">
                    <button type="button" role="tab" class="@($"ld-dtab {(_tab == "chat" ? "is-active" : "")}")" @onclick='() => _tab = "chat"'>Conversation</button>
                    <button type="button" role="tab" class="@($"ld-dtab {(_tab == "info" ? "is-active" : "")}")" @onclick='() => _tab = "info"'>Details &amp; notes</button>
                </nav>

                @if (_tab == "chat")
                {
                    <div class="ld-chat">
                        @if (lead.ConsentStatus == "opted_out")
                        {
                            <div class="ld-banner danger"><Icon Name="AlertCircle" Size="15" /><span>This customer opted out (STOP). Do not send further messages.</span></div>
                        }
                        else if (WindowOpen(lead))
                        {
                            <div class="ld-banner"><Icon Name="Clock" Size="15" /><span>Reply window open — closes in @WindowLeft(lead). Free-form replies are allowed until then.</span></div>
                        }
                        else
                        {
                            <div class="ld-banner warn"><Icon Name="Clock" Size="15" /><span>24-hour window closed. Only approved templates can be sent until the customer messages again.</span></div>
                        }

                        <div class="ld-scroll">
                            <div class="ld-msgs">
                                @if (_selected.Messages.Count == 0)
                                {
                                    <div class="ld-day">No messages yet</div>
                                }
                                @{ DateTime? prevDay = null; string? prevDir = null; }
                                @foreach (var m in _selected.Messages)
                                {
                                    var local = m.CreatedAt.ToLocalTime();
                                    var inbound = m.Direction == "inbound";
                                    var first = prevDir != m.Direction || prevDay != local.Date;
                                    @if (prevDay != local.Date)
                                    {
                                        <div class="ld-day">@DayLabel(local.Date)</div>
                                    }
                                    var isTemplate = m.Type == "template" && (m.Body ?? "").StartsWith("[template:");
                                    <div @key="m.Id" class="@($"ld-bub {(inbound ? "in" : "out")} {(first ? "first gap" : "")}")">
                                        @if (isTemplate)
                                        {
                                            <span class="ld-tpl">Template message</span>
                                            <span class="ld-tpl-body">@m.Body</span>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrEmpty(m.Body) ? $"[{m.Type}]" : m.Body)
                                        }
                                        <span class="@($"ld-meta {(m.Status == "failed" ? "failed" : "")}")">
                                            @if (m.Status == "failed") { <span>Not delivered</span> }
                                            @local.ToString("hh:mm tt")
                                            @if (!inbound && m.Status != "failed") { @Ticks(m.Status) }
                                        </span>
                                    </div>
                                    prevDay = local.Date; prevDir = m.Direction;
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_toast)) { <div class="ld-toast">@_toast</div> }
                        <form class="ld-composer" @onsubmit="ReplyAsync" @onsubmit:preventDefault>
                            <input type="text" autocomplete="off" aria-label="Type a message" disabled="@(_busy || !CanReply(lead))"
                                   placeholder="@(lead.ConsentStatus == "opted_out" ? "Customer opted out" : WindowOpen(lead) ? "Type a message" : "24-hour window closed")"
                                   @bind="_reply" @bind:event="oninput" />
                            <button type="submit" class="ld-send" aria-label="Send message" disabled="@(_busy || !CanReply(lead) || string.IsNullOrWhiteSpace(_reply))"><Icon Name="Send" Size="18" /></button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="ld-info">
                        <div class="ld-card">
                            <h4>Contact</h4>
                            <dl class="ld-dl">
                                <dt>Name</dt><dd>@lead.Name</dd>
                                <dt>Phone</dt><dd>+@lead.Phone</dd>
                                <dt>Email</dt><dd>@(string.IsNullOrEmpty(lead.Email) ? "—" : lead.Email)</dd>
                                <dt>Customer</dt><dd>@(string.IsNullOrEmpty(lead.CustomerId) ? "Not a customer yet" : lead.CustomerId)</dd>
                            </dl>
                        </div>
                        <div class="ld-card">
                            <h4>Lead</h4>
                            <dl class="ld-dl">
                                <dt>Status</dt><dd><span class="@($"ld-pill {lead.Status}")">@Label(lead.Status)</span></dd>
                                <dt>Source</dt><dd>@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</dd>
                                <dt>Created</dt><dd>@AdminFmt.DateTimeShort(lead.CreatedAt)</dd>
                                <dt>Last contact</dt><dd>@AdminFmt.DateTimeShort(lead.LastContactAt)</dd>
                                @if (lead.ConvertedAt is { } cv) { <dt>Converted</dt><dd>@AdminFmt.DateTimeShort(cv)</dd> }
                            </dl>
                        </div>
                        <div class="ld-card">
                            <h4>WhatsApp consent</h4>
                            <dl class="ld-dl">
                                <dt>Marketing</dt>
                                <dd class="@(lead.ConsentStatus == "opted_in" ? "ld-ok" : lead.ConsentStatus == "opted_out" ? "ld-bad" : "ld-warn")">@ConsentLabel(lead.ConsentStatus)</dd>
                                <dt>Reply window</dt>
                                <dd class="@(WindowOpen(lead) ? "ld-ok" : "ld-warn")">@(WindowOpen(lead) ? "Open · " + WindowLeft(lead) + " left" : "Closed — templates only")</dd>
                            </dl>
                        </div>
                        <div class="ld-card">
                            <h4>First message</h4>
                            <p class="ld-quote">@(string.IsNullOrEmpty(lead.FirstMessage) ? "—" : lead.FirstMessage)</p>
                        </div>
                        <div class="ld-card wide">
                            <h4>Internal notes</h4>
                            <textarea placeholder="Interest, objections, preferred call time…" aria-label="Internal notes" @bind="_notes" @bind:event="oninput"></textarea>
                            <div class="ld-actions">
                                @if (!string.IsNullOrEmpty(_toast)) { <small>@_toast</small> }
                                <button type="button" class="ld-btn primary" disabled="@_busy" @onclick="SaveNotesAsync">Save notes</button>
                            </div>
                        </div>
                        <div class="ld-card wide">
                            <h4>Status history</h4>
                            <ul class="ld-tl">
                                @foreach (var h in _selected.History)
                                {
                                    <li>
                                        <span class="@($"ld-pill {h.ToStatus}")">@Label(h.ToStatus)</span>@(h.FromStatus is null ? "" : " from " + Label(h.FromStatus))
                                        <small>@AdminFmt.DateTimeShort(h.CreatedAt) · @h.ChangedBy@(string.IsNullOrEmpty(h.Note) ? "" : " · " + h.Note)</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    private static readonly string[] KpiStatuses = [LeadStatuses.New, LeadStatuses.Interested, LeadStatuses.FollowUp, LeadStatuses.Converted];
    private static readonly string[] Palette = ["#235b40", "#2f6f8f", "#7a5aa6", "#b5792a", "#a24b5a", "#3f7d7a", "#5b6f2c"];

    private readonly CancellationTokenSource _cts = new();
    private List<LeadDto> _leads = new();
    private Dictionary<string, int> _counts = new();
    private LeadDetailResponse? _selected;
    private string _statusFilter = "";
    private string _query = "";
    private string _reply = "";
    private string _notes = "";
    private string _tab = "chat";
    private string? _error;
    private string? _toast;
    private bool _loading = true;
    private bool _busy;

    private int Total => _counts.Values.Sum();
    private string ConversionText => Total == 0 ? "No leads yet" : $"{Math.Round(100.0 * _counts.GetValueOrDefault(LeadStatuses.Converted) / Total)}% converted";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(true);
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(async () =>
                {
                    if (_busy) return;
                    await LoadAsync(false);
                    if (_selected?.Lead is { } l) await RefreshDetailAsync(l.Id, keepNotes: true);
                });
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task LoadAsync(bool spinner)
    {
        if (spinner) { _loading = true; StateHasChanged(); }
        var res = await Api.AdminLeadsAsync(_statusFilter, null, _query);
        if (_cts.IsCancellationRequested) return;
        if (res.Success) { _leads = res.Leads; _counts = res.StatusCounts; _error = null; }
        else _error = res.Message ?? "Could not load leads.";
        _loading = false;
        StateHasChanged();
    }

    private Task SetStatusAsync(string status) { _statusFilter = status; return LoadAsync(true); }
    private Task SearchAsync() => LoadAsync(false);

    private async Task OpenAsync(long id)
    {
        _toast = null; _tab = "chat"; _reply = "";
        await RefreshDetailAsync(id, keepNotes: false);
        await LoadAsync(false); // the unread badge clears once the conversation is opened
    }

    private void CloseDetail() => _selected = null;

    private async Task RefreshDetailAsync(long id, bool keepNotes)
    {
        var res = await Api.AdminLeadDetailAsync(id);
        if (_cts.IsCancellationRequested) return;
        if (!res.Success || res.Lead is null) { _toast = res.Message ?? "Could not load lead."; return; }
        var sameLead = _selected?.Lead?.Id == id;
        var prevNotes = _notes;
        _selected = res;
        _notes = keepNotes && sameLead ? prevNotes : res.Lead.Notes ?? "";
        StateHasChanged();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        if (_selected?.Lead is not { } lead || e.Value?.ToString() is not { Length: > 0 } status || status == lead.Status) return;
        _busy = true;
        var res = await Api.AdminLeadStatusAsync(lead.Id, new LeadStatusRequest { Status = status });
        _toast = res.Message;
        await RefreshDetailAsync(lead.Id, keepNotes: true);
        await LoadAsync(false);
        _busy = false;
    }

    private async Task SaveNotesAsync()
    {
        if (_selected?.Lead is not { } lead) return;
        _busy = true;
        var res = await Api.AdminLeadNotesAsync(lead.Id, new LeadNotesRequest { Notes = _notes });
        _toast = res.Message;
        _busy = false;
    }

    private async Task ReplyAsync()
    {
        if (_selected?.Lead is not { } lead || string.IsNullOrWhiteSpace(_reply) || !CanReply(lead)) return;
        _busy = true;
        var res = await Api.AdminWhatsAppSendAsync(new WhatsAppSendRequest { Phone = lead.Phone, Text = _reply.Trim() });
        _toast = res.Success ? null : res.Message;
        if (res.Success) _reply = "";
        await RefreshDetailAsync(lead.Id, keepNotes: true);
        await LoadAsync(false);
        _busy = false;
    }

    // ---- presentation helpers ----

    private static bool WindowOpen(LeadDto l) => l.ServiceWindowExpiresAt is { } e && e > DateTime.UtcNow;
    private static bool CanReply(LeadDto l) => l.ConsentStatus != "opted_out" && WindowOpen(l);

    private static string WindowLeft(LeadDto l)
    {
        var left = (l.ServiceWindowExpiresAt ?? DateTime.UtcNow) - DateTime.UtcNow;
        return left.TotalHours >= 1 ? $"{(int)left.TotalHours}h {left.Minutes}m" : $"{Math.Max(left.Minutes, 1)}m";
    }

    private string KpiClass(string status) => $"ld-kpi {(_statusFilter == status ? "is-active" : "")}";
    private string TabClass(string status) => $"ld-tab {(_statusFilter == status ? "is-active" : "")}";

    private static string Accent(string status) => status switch
    {
        LeadStatuses.New => "#2b6a98",
        LeadStatuses.Interested => "#68499f",
        LeadStatuses.FollowUp => "#c8932e",
        LeadStatuses.Converted => "#235b40",
        _ => "#9aa59e",
    };

    private static string KpiHint(string status) => status switch
    {
        LeadStatuses.New => "Awaiting first reply",
        LeadStatuses.Interested => "Showing buying intent",
        LeadStatuses.FollowUp => "Needs a callback",
        LeadStatuses.Converted => "Became customers",
        _ => "",
    };

    private static string Label(string status) => status switch
    {
        LeadStatuses.New => "New",
        LeadStatuses.Interested => "Interested",
        LeadStatuses.FollowUp => "Follow-up",
        LeadStatuses.Converted => "Converted",
        LeadStatuses.NotInterested => "Not interested",
        _ => status,
    };

    private static string SourceLabel(string source) => source switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "website" => "Website",
        "manual" => "Manual",
        _ => source,
    };

    private static string ConsentLabel(string consent) => consent switch
    {
        "opted_in" => "Opted in",
        "opted_out" => "Opted out (STOP)",
        _ => "Not recorded",
    };

    private static string Initials(LeadDto l)
    {
        var parts = l.Name.Replace("[Sample]", "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0 || char.IsDigit(parts[0][0])) return "#";
        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string AvatarColor(LeadDto l) => Palette[(int)(l.Id % Palette.Length)];

    private static string ListTime(DateTime utc)
    {
        var local = utc.ToLocalTime();
        var today = DateTime.Now.Date;
        return local.Date == today ? local.ToString("hh:mm tt")
            : local.Date == today.AddDays(-1) ? "Yesterday"
            : local.ToString("dd MMM");
    }

    private static string DayLabel(DateTime day)
    {
        var today = DateTime.Now.Date;
        return day == today ? "Today" : day == today.AddDays(-1) ? "Yesterday" : day.ToString("dd MMMM yyyy");
    }

    private static RenderFragment Ticks(string status) => builder =>
    {
        var read = status == "read";
        var double_ = status is "delivered" or "read";
        builder.AddMarkupContent(0, $"<svg class=\"ld-tick{(read ? " read" : "")}\" width=\"16\" height=\"11\" viewBox=\"0 0 16 11\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-label=\"{status}\"><path d=\"M1 5.8 4.2 9 10.5 1.8\"/>{(double_ ? "<path d=\"M6 8.6 6.6 9.2 13 1.8\"/>" : "")}</svg>");
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
