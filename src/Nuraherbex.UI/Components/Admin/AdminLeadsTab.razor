    private static string GetRemainingHoursText(DateTime requestedAt)
    {
        var expiresAt = requestedAt.AddHours(24);
        var diff = expiresAt - DateTime.UtcNow;
        if (diff.TotalMinutes <= 0) return "Auto-returning now";
        if (diff.TotalHours < 1) return $"Auto-returns in {(int)diff.TotalMinutes}m";
        var hours = (int)diff.TotalHours;
        var mins = diff.Minutes;
        return mins > 0 ? $"Auto-returns in {hours}h {mins}m" : $"Auto-returns in {hours}h";
    }

