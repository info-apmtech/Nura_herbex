    private async Task ExecuteBulkTransferAsync()
    {
        if (_selectedLeadIds.Count == 0 || _bulkTargetEmployeeId <= 0) return;
        _bulkBusy = true;
        var reason = string.IsNullOrWhiteSpace(_bulkTransferReason) ? $"Bulk transfer by {AdminAuth.Name}" : _bulkTransferReason.Trim();

        var req = new LeadBulkTransferRequest
        {
            LeadIds = _selectedLeadIds.ToList(),
            EmployeeId = _bulkTargetEmployeeId,
            Reason = reason
        };

        var res = await Api.AdminBulkTransferLeadsAsync(req);
        _bulkBusy = false;
        _toast = res.Message;
        if (res.Success)
        {
            _notice = res.Message;
            ClearSelection();
            await LoadAsync(false);
        }
        else
        {
            _error = res.Message ?? "Failed to transfer selected leads.";
        }
    }

