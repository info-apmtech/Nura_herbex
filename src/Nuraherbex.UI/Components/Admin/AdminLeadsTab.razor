    // ---- Reply assistant: a drafted reply the employee edits before sending ----

    private sealed record Tweak(string Label, string Instruction);
    private static readonly Tweak[] Tweaks =
    [
        new("Shorter", "make it shorter"),
        new("Friendlier", "make it warmer and friendlier"),
        new("More formal", "make it more formal and professional"),
        new("Tamil", "translate it into natural Tamil"),
        new("Hindi", "translate it into natural Hindi"),
    ];

    private ReplySuggestionResponse? _draft;
    private bool _drafting;
    private bool _assistantOn = true;
    private long _draftForMessage;

    private int ReplyRows => Math.Clamp((_reply ?? "").Split('\n').Length + (_reply?.Length ?? 0) / 70, 2, 8);

    private async Task OnReplyKey(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter") await ReplyAsync();
    }

    /// <summary>When a customer message is waiting and the box is empty, draft the reply into it.</summary>
    private async Task MaybeDraftAsync()
    {
        if (!_assistantOn || _drafting || _tab != "chat" || _selected?.Lead is not { } lead || !CanReply(lead)) return;
        var last = _selected.Messages.LastOrDefault();
        if (last is null || last.Direction != "inbound" || last.Id == _draftForMessage || !string.IsNullOrWhiteSpace(_reply)) return;
        await SuggestAsync(null, false);
    }

    private async Task SuggestAsync(string? instruction, bool fresh)
    {
        if (_selected?.Lead is not { } lead) return;
        var lastInbound = _selected.Messages.LastOrDefault(m => m.Direction == "inbound");
        _drafting = true; _toast = null; StateHasChanged();
        var res = await Api.AdminSuggestReplyAsync(lead.Id, new ReplySuggestRequest { Fresh = fresh, Instruction = instruction, CurrentDraft = string.IsNullOrWhiteSpace(_reply) ? null : _reply });
        _drafting = false;
        if (_selected?.Lead?.Id != lead.Id) return; // moved on to another lead meanwhile
        if (res.Success)
        {
            _draft = res; _reply = res.Reply; _draftForMessage = lastInbound?.Id ?? 0;
            if (instruction is not null && res.Source != "ai") _toast = res.ReviewNote;
        }
        else
        {
            if (res.Message?.Contains("switched off") == true) _assistantOn = false;
            _toast = res.Message ?? "Could not write a reply.";
        }
    }

    private async Task LoadAssistantSettingsAsync()
    {
        var s = await Api.AdminReplySettingsAsync();
        if (s.Success) _assistantOn = s.Enabled;
    }

    private async Task ReplyAsync()
    {
        if (_selected?.Lead is not { } lead || string.IsNullOrWhiteSpace(_reply) || !CanReply(lead)) return;
        _busy = true;
        var res = await Api.AdminLeadReplyAsync(lead.Id, _reply.Trim());
        _toast = res.Success ? null : res.Message;
        if (res.Success) { _reply = ""; _draft = null; }
        await RefreshDetailAsync(lead.Id, keepNotes: true);
        await LoadAsync(false);
        _busy = false;
    }

    // ---- presentation helpers ----

    private static bool WindowOpen(LeadDto l) => l.ServiceWindowExpiresAt is { } e && e > DateTime.UtcNow;
    private static bool CanReply(LeadDto l) => l.ConsentStatus != "opted_out" && WindowOpen(l);

    private static string WindowLeft(LeadDto l)
    {
        var left = (l.ServiceWindowExpiresAt ?? DateTime.UtcNow) - DateTime.UtcNow;
        return left.TotalHours >= 1 ? $"{(int)left.TotalHours}h {left.Minutes}m" : $"{Math.Max(left.Minutes, 1)}m";
    }

