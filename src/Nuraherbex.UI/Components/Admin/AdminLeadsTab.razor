    protected override async Task OnInitializedAsync()
    {
        _v2 = await Browser.GetLocalAsync(LookKey) == "1";
        var q = Nav.ToAbsoluteUri(Nav.Uri).Query;
        var ms = System.Text.RegularExpressions.Regex.Match(q, @"[?&]status=([^&]+)");
        if (ms.Success) _statusFilter = Uri.UnescapeDataString(ms.Groups[1].Value);
        else if (Mode == "no_answer") _statusFilter = LeadBuckets.NoAnswer;
        else if (Mode == LeadViews.Leads) _statusFilter = LeadStatuses.New; // open on the new leads first; "All" is one click away
        _currentMode = Mode;
        var tpl = await Api.AdminMessageTemplatesAsync();
        if (tpl.Success) { _templates = tpl.Settings.Items; _approved = tpl.Settings.ApprovedMetaTemplates; }
        await Task.WhenAll(LoadAsync(true), LoadTeamAsync(), LoadAssistantSettingsAsync());
        // Arrived from a follow-up or notification: open that lead straight away.
        var m = System.Text.RegularExpressions.Regex.Match(q, @"[?&]open=(\d+)");
        if (m.Success && long.TryParse(m.Groups[1].Value, out var openId)) await OpenAsync(openId);
        _ = PollAsync();
    }

    private string? _currentMode;
    protected override async Task OnParametersSetAsync()
    {
        var q = Nav.ToAbsoluteUri(Nav.Uri).Query;
        var ms = System.Text.RegularExpressions.Regex.Match(q, @"[?&]status=([^&]+)");
        var queryStatus = ms.Success ? Uri.UnescapeDataString(ms.Groups[1].Value) : null;

        var m = System.Text.RegularExpressions.Regex.Match(q, @"[?&]open=(\d+)");
        var openId = m.Success && long.TryParse(m.Groups[1].Value, out var oid) ? (long?)oid : null;

        if (_currentMode != Mode || (queryStatus != null && _statusFilter != queryStatus))
        {
            var prev = _currentMode;
            _currentMode = Mode;
            if (queryStatus != null) _statusFilter = queryStatus;
            else if (Mode == "no_answer") _statusFilter = LeadBuckets.NoAnswer;
            else if (Mode == LeadViews.Leads && _statusFilter == LeadBuckets.NoAnswer) _statusFilter = LeadStatuses.New;
            if (prev is not null)
            {
                _selected = null;
                _quick = "";
                await Task.WhenAll(LoadAsync(true), LoadTeamAsync());
                if (openId is { } id) await OpenAsync(id);
            }
        }
        else if (openId is { } id && _selected?.Lead?.Id != id)
        {
            await OpenAsync(id);
        }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(async () =>
                {
                    if (_busy) return;
                    await LoadAsync(false, keepOrder: true);
                    if (_selected?.Lead is { } l) await RefreshDetailAsync(l.Id, keepNotes: true);
                });
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    /// <param name="keepOrder">Background refresh: rows already on screen keep their place (only their details update) and brand-new leads are added at the bottom,
    /// so the list never jumps while someone is typing to a customer. The Refresh button and any action re-sort normally.</param>
    private async Task LoadAsync(bool spinner, bool keepOrder = false)
    {
        if (spinner) { _loading = true; StateHasChanged(); }
        var apiView = Mode == "no_answer" ? LeadViews.Leads : Mode;
        var res = await Api.AdminLeadsAsync(_statusFilter, null, _query, _assignee, 100, apiView, _dateFrom, _dateTo, _datePreset);
        if (_cts.IsCancellationRequested) return;
        if (res.Success && keepOrder && _leads.Count > 0 && !FollowUpHeads) // the due-date lists are re-ordered by the server each time
        {
            var fresh = res.Leads.ToDictionary(x => x.Id);
            var known = _leads.Select(x => x.Id).ToHashSet();
            res.Leads = _leads.Where(x => fresh.ContainsKey(x.Id)).Select(x => fresh[x.Id]).Concat(res.Leads.Where(x => !known.Contains(x.Id))).ToList();
        }
        if (res.Success) { _leads = res.Leads; _counts = res.StatusCounts; _unassigned = res.UnassignedCount; _pendingTransfersCount = res.PendingTransfersCount; _viewCounts = res.ViewCounts; _viewUnread = res.ViewUnread; _unreadTotal = res.UnreadTotal; _error = null; }
        else _error = res.Message ?? "Could not load leads.";
        _loading = false;
        StateHasChanged();
    }

