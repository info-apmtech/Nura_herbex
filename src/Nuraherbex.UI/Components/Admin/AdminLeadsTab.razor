@implements IDisposable
@inject ApiClient Api
@inject AdminSession AdminAuth
@inject NavigationManager Nav
@inject BrowserInterop Browser
@inject ProjectState Project

<div class="@($"ld ld-mode-{Mode} {(_v2 ? "ld-v2" : "")}")">

    @* Which panel you are in, with a switch to the others you may open, and the look toggle *@
    <div class="ld-topbar">
        <div class="ld-views" role="tablist" aria-label="Panels">
            @foreach (var v in ViewTabs.Where(x => AdminAuth.Can(x) || (x is "no_answer" or "transfers" && (AdminAuth.Can("no_answer") || AdminAuth.Can("leads")))))
            {
                var view = v;
                var badgeCount = view switch
                {
                    LeadViews.Leads => _viewCounts.GetValueOrDefault(LeadViews.Leads) > 0 ? _viewCounts[LeadViews.Leads] : _counts.GetValueOrDefault(LeadBuckets.New),
                    "transfers" => _pendingTransfersCount,
                    "no_answer" => _viewCounts.GetValueOrDefault("no_answer", _counts.GetValueOrDefault(LeadBuckets.NoAnswer)),
                    LeadViews.Care => _viewCounts.GetValueOrDefault(LeadViews.Care),
                    LeadViews.Interested => _viewCounts.GetValueOrDefault(LeadViews.Interested),
                    _ => (view == Mode ? _unreadTotal : _viewUnread.GetValueOrDefault(view)),
                };
                <button type="button" role="tab" aria-selected="@(view == Mode)" class="@($"ld-view {(view == Mode ? "is-active" : "")}")" @onclick="() => GoTo(view)">
                    <Icon Name="@PanelIcon(view)" Size="15" /><span>@PanelName(view)</span>
                    @if (badgeCount > 0) { <b>@badgeCount</b> }
                </button>
            }
        </div>
        <button type="button" class="@($"ld-look {(_v2 ? "is-on" : "")}")" aria-pressed="@_v2" title="Switch between the classic and the new look. Your choice is remembered on this device." @onclick="ToggleLookAsync">
            <Icon Name="Sparkles" Size="14" /> @(_v2 ? "New look" : "Try the new look")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="ld-banner ld-notice" role="status"><Icon Name="CheckCircle2" Size="15" /><span>@_notice</span><button type="button" class="ld-x" aria-label="Dismiss" @onclick="() => _notice = null"><Icon Name="X" Size="14" /></button></div>
    }

    @* Summary — doubles as the filter *@
    <div class="ld-kpis">
        @if (Mode == "transfers")
        {
            <button type="button" class="@QuickClass("")" @onclick='() => _quick = ""'>
                <i style="background:#7c3aed"></i><span>Pending Transfers</span><strong>@Total</strong><small>Awaiting your acceptance</small>
            </button>
            <button type="button" class="@QuickClass("unread")" @onclick='() => _quick = "unread"'>
                <i style="background:#2b6a98"></i><span>Unread Messages</span><strong>@_unreadTotal</strong><small>Messages waiting for a reply</small>
            </button>
        }
        else if (Mode == "no_answer")
        {
            <button type="button" class="@QuickClass("")" @onclick='() => _quick = ""'>
                <i style="background:#7c3aed"></i><span>All No Answer</span><strong>@_counts.GetValueOrDefault(LeadBuckets.NoAnswer)</strong><small>Pending retry follow-ups</small>
            </button>
            <button type="button" class="@QuickClass("due_today")" @onclick='() => _quick = "due_today"'>
                <i style="background:#2563eb"></i><span>Due Today</span><strong>@_leads.Count(x => x.FollowUpToday)</strong><small>Scheduled for today</small>
            </button>
            <button type="button" class="@QuickClass("unread")" @onclick='() => _quick = "unread"'>
                <i style="background:#2b6a98"></i><span>Unread</span><strong>@_unreadTotal</strong><small>Messages waiting for a reply</small>
            </button>
        }
        else if (Mode == LeadViews.Leads)
        {
            @if (Everyone)
            {
                <button type="button" class="@KpiClass("")" @onclick='() => SetStatusAsync("")'>
                    <i style="background:#235b40"></i><span>All leads</span><strong>@Total</strong><small>Not yet interested or ordered</small>
                </button>
            }
            @foreach (var s in KpiStatuses)
            {
                var status = s;
                <button type="button" class="@KpiClass(status)" @onclick="() => SetStatusAsync(status)">
                    <i style="background:@Accent(status)"></i><span>@Label(status)</span><strong>@_counts.GetValueOrDefault(status)</strong><small>@KpiHint(status)</small>
                </button>
            }
        }
        else
        {
            <button type="button" class="@QuickClass("")" @onclick='() => _quick = ""'>
                <i style="background:#235b40"></i><span>@(Mode == LeadViews.Care ? "Customers" : "Hot leads")</span><strong>@Total</strong><small>@(Mode == LeadViews.Care ? "Paid customers" : "Showed interest, not ordered yet")</small>
            </button>
            <button type="button" class="@QuickClass("unread")" @onclick='() => _quick = "unread"'>
                <i style="background:#2b6a98"></i><span>Unread</span><strong>@_unreadTotal</strong><small>Messages waiting for a reply</small>
            </button>
            @if (Mode == LeadViews.Care)
            {
                <button type="button" class="@QuickClass("open")" @onclick='() => _quick = "open"'>
                    <i style="background:#c8932e"></i><span>Order on the way</span><strong>@_leads.Count(x => x.OpenOrders > 0)</strong><small>Not delivered yet</small>
                </button>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="ld-banner danger" style="border-radius:10px;border:1px solid #f6d2cd"><Icon Name="AlertCircle" Size="15" /><span>@_error</span></div>
    }

    <div class="@($"ld-work {(_selected?.Lead is not null ? "is-detail ld-fullscreen" : "")} {(_v2 ? "ld-board-mode" : "")}")">

        @if (_v2)
        {
            @* ───────── New look: pipeline board ───────── *@
            <section class="ld-board" aria-label="@PanelName(Mode) board">
                <div class="ld-board-bar">
                    <div class="ld-search">
                        <Icon Name="Search" Size="15" />
                        <input type="search" placeholder="Search name, phone or email" aria-label="Search" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
                    </div>
                    @if (Everyone)
                    {
                        <select class="ld-assignee" aria-label="Filter by owner" value="@_assignee" @onchange="OnAssigneeFilterChanged">
                            <option value="">@(Mode == LeadViews.Care ? "All care owners" : "All owners")</option>
                            <option value="unassigned">Unassigned (@_unassigned)</option>
                            @foreach (var t in _team) { <option value="@t.Id">@t.Name</option> }
                        </select>
                    }
                    <button type="button" class="@($"ld-chip2 {(_quick == "unread" ? "is-on" : "")}")" aria-pressed="@(_quick == "unread")" @onclick='() => _quick = _quick == "unread" ? "" : "unread"'><Icon Name="MessageCircle" Size="13" /> Unread <b>@_unreadTotal</b></button>

                    @* Date presets *@
                    <div class="ld-date-presets" style="display:inline-flex;align-items:center;gap:3px;background:#f1f5f9;padding:2px;border-radius:8px;">
                        <button type="button" style="@(_datePreset == "" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("")'>All</button>
                        <button type="button" style="@(_datePreset == "today" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("today")'>Today</button>
                        <button type="button" style="@(_datePreset == "yesterday" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("yesterday")'>Yesterday</button>
                        <button type="button" style="@(_datePreset == "7d" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("7d")'>7D</button>
                    </div>

                    @* Date input range picker *@
                    <input type="date" value="@_dateFrom" @onchange="OnFromDateChanged" style="padding:4px 6px;font-size:11px;border:1px solid #cbd5e1;border-radius:6px;color:#334155;background:#fff;max-width:115px;" title="Filter leads from date" />
                    <input type="date" value="@_dateTo" @onchange="OnToDateChanged" style="padding:4px 6px;font-size:11px;border:1px solid #cbd5e1;border-radius:6px;color:#334155;background:#fff;max-width:115px;" title="Filter leads to date" />
                    @if (!string.IsNullOrEmpty(_datePreset) || !string.IsNullOrEmpty(_dateFrom))
                    {
                        <button type="button" title="Clear date filter" @onclick="ClearDateFilterAsync" style="border:none;background:#fee2e2;color:#991b1b;border-radius:6px;padding:4px 7px;font-size:11px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:3px;">
                            <Icon Name="X" Size="11" />
                        </button>
                    }

                    <span class="ld-board-total"><strong>@Total</strong> @(Mode == LeadViews.Care ? "customers" : Mode == LeadViews.Interested ? "hot leads" : Mode == "no_answer" ? "no-answer leads" : "leads")</span>
                    <button type="button" class="ld-refresh" title="Refresh" aria-label="Refresh" @onclick="() => LoadAsync(true)"><Icon Name="RefreshCw" Size="14" Class="@(_loading ? "animate-spin" : "")" /></button>

                    @* Add Lead button *@
                    @if (Mode == LeadViews.Leads)
                    {
                        <button type="button" style="background:#235b40;color:#fff;border-radius:8px;padding:6px 12px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:5px;cursor:pointer;white-space:nowrap;border:none;box-shadow:0 1px 2px rgba(35,91,64,0.2);" @onclick="OpenNewLeadModal">
                            <Icon Name="Plus" Size="14" /> Add lead
                        </button>
                    }
                </div>

                @if (_loading && _leads.Count == 0) { <div class="ld-empty">Loading…</div> }
                else
                {
                    @if (_selectedLeadIds.Count > 0)
                    {
                        <div class="ld-bulk-bar">
                            <div class="ld-bulk-bar-left">
                                <span class="ld-bulk-count-badge">@_selectedLeadIds.Count</span>
                                <strong>lead@(_selectedLeadIds.Count > 1 ? "s" : "") selected</strong>
                            </div>
                            <div class="ld-bulk-bar-actions">
                                <label class="ld-bulk-dest-label">Transfer to:</label>
                                <select class="ld-bulk-dest-select" @bind="_bulkTargetEmployeeId" disabled="@_bulkBusy">
                                    <option value="0">Choose team member...</option>
                                    @foreach (var t in _team.Where(x => x.IsActive && (Everyone || x.Role == EmployeeRoles.Sales) && x.Id != AdminAuth.EmployeeId))
                                    {
                                        <option value="@t.Id">@t.Name @(t.IsOnline ? "🟢" : "")</option>
                                    }
                                </select>
                                <button type="button" class="ld-bulk-btn ld-bulk-btn-transfer" disabled="@(_bulkBusy || _bulkTargetEmployeeId <= 0)" @onclick="ExecuteBulkTransferAsync">
                                    <Icon Name="ArrowRightLeft" Size="14" /> Transfer Selected
                                </button>
                                <button type="button" class="ld-bulk-btn ld-bulk-btn-cancel" @onclick="ClearSelection">Cancel</button>
                            </div>
                        </div>
                    }
                    <div class="ld-cols">
                        @foreach (var col in BoardColumns())
                        {
                            <div class="ld-col" style="--col:@col.Color">
                                <header><span class="ld-col-dot"></span><strong>@col.Title</strong><b>@col.Items.Count</b><small>@col.Hint</small></header>
                                <div class="ld-col-body">
                                    @foreach (var l in col.Items)
                                    {
                                        var lead = l;
                                        <button type="button" @key="lead.Id" @onclick="() => OpenAsync(lead.Id)" class="@($"ld-bcard {(_selected?.Lead?.Id == lead.Id ? "is-selected" : "")} {(lead.UnreadCount > 0 ? "has-unread" : "")} {(_selectedLeadIds.Contains(lead.Id) ? "is-checked" : "")}")">
                                            <span class="ld-bcard-check" @onclick:stopPropagation="true">
                                                <input type="checkbox" class="ld-lead-checkbox" checked="@_selectedLeadIds.Contains(lead.Id)" @onchange="() => ToggleLeadSelection(lead.Id)" aria-label="Select lead" />
                                            </span>
                                            <span class="ld-bcard-top">
                                                <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                                                <span class="ld-bcard-who"><strong>@lead.Name</strong><small>+@lead.Phone</small></span>
                                                <span class="ld-bcard-time">@ListTime(lead.LastContactAt)</span>
                                            </span>
                                            <span class="ld-bcard-msg">@(lead.LastMessageDirection == "outbound" ? "You: " : "")@(lead.LastMessage ?? lead.FirstMessage ?? "No messages yet")</span>
                                            @if (lead.IsCustomer) { <span class="ld-bcard-conv"><Icon Name="HeartPulse" Size="12" />Converted by <strong>@(lead.ConvertedByName ?? "website order")</strong></span> }
                                            <span class="ld-bcard-tags">
                                                @if (lead.IsPendingTransfer)
                                                {
                                                    <span class="ld-pill ld-transfer"><Icon Name="ArrowRightLeft" Size="10" /> Transfer</span>
                                                    @if (lead.PendingTransferRequestedAt is { } bReq)
                                                    {
                                                        <span class="ld-transfer-chip">@GetRemainingHoursText(bReq)</span>
                                                    }
                                                }
                                                @if (lead.Priority == LeadPriorities.High) { <span class="ld-pill ld-prio-high">High priority</span> }
                                                @if (lead.UnreadCount > 0) { <span class="ld-unread">@lead.UnreadCount new</span> }
                                                @if (lead.NoAnswerAttempts > 0 && CurrentStatus(lead) == LeadBuckets.NoAnswer) { <span class="ld-pill no-answer">Attempt @lead.NoAnswerAttempts/7</span> }
                                                @if (lead.OpenOrders > 0) { <span class="ld-pill ld-open"><Icon Name="Truck" Size="10" />On the way</span> }
                                                @if (lead.NextFollowUpAt is { } nf) { <span class="@($"ld-pill ld-fu {(nf < DateTime.UtcNow ? "late" : "")}")"><Icon Name="Clock" Size="10" />@FuFmt.Due(nf)</span> }
                                                @if (lead.OrderCount > 0) { <span class="ld-pill ld-cust">₹@AdminFmt.Inr(lead.LifetimeValue)</span> }
                                                @if (lead.ConsentStatus == "opted_out") { <span class="ld-pill ld-stop">Opted out</span> }
                                            </span>
                                            <span class="ld-bcard-foot">
                                                <span class="ld-src">@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                                                @if (lead.IsPendingTransfer)
                                                {
                                                    <span class="ld-src">From: @(lead.PendingTransferFromName ?? "Colleague")</span>
                                                }
                                                else if (lead.AssignedToEmployeeId is null && Everyone) { <span class="ld-pill ld-unowned">Unassigned</span> }
                                                else if (Everyone && !string.IsNullOrEmpty(lead.AssignedToName)) { <span class="ld-owner-chip" title="Owner">@lead.AssignedToName</span> }
                                            </span>
                                        </button>
                                    }
                                    @if (col.Items.Count == 0) { <p class="ld-col-empty">Nobody here</p> }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
            <button type="button" class="ld-backdrop" aria-label="Close details" tabindex="-1" @onclick="CloseDetail"></button>
        }
        else
        {
        @* ───────── Lead list ───────── *@
        <section class="ld-list" aria-label="Leads">
            <div class="ld-list-head">
                <div class="ld-search">
                    <Icon Name="Search" Size="15" />
                    <input type="search" placeholder="Search name, phone or email" aria-label="Search leads" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync" />
                    <button type="button" class="ld-refresh" title="Refresh" aria-label="Refresh leads" @onclick="() => LoadAsync(true)">
                        <Icon Name="RefreshCw" Size="14" Class="@(_loading ? "animate-spin" : "")" />
                    </button>
                </div>
                @if (Mode == LeadViews.Leads)
                {
                    <button type="button" style="background:#235b40;color:#fff;border-radius:8px;padding:6px 12px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:5px;cursor:pointer;white-space:nowrap;border:none;margin-right:8px;box-shadow:0 1px 2px rgba(35,91,64,0.2);" @onclick="OpenNewLeadModal">
                        <Icon Name="Plus" Size="14" /> Add lead
                    </button>
                }
                <div class="ld-date-presets" style="display:inline-flex;align-items:center;gap:3px;background:#f1f5f9;padding:2px;border-radius:8px;margin-right:6px;">
                    <button type="button" style="@(_datePreset == "" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("")'>All</button>
                    <button type="button" style="@(_datePreset == "today" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("today")'>Today</button>
                    <button type="button" style="@(_datePreset == "yesterday" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("yesterday")'>Yesterday</button>
                    <button type="button" style="@(_datePreset == "7d" ? "background:#fff;font-weight:600;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,0.06);" : "background:transparent;color:#64748b;") padding:4px 8px;border-radius:6px;border:none;font-size:11px;cursor:pointer;" @onclick='() => SelectDatePresetAsync("7d")'>7D</button>
                </div>
                <div style="display:inline-flex;align-items:center;gap:4px;margin-right:8px;">
                    <input type="date" value="@_dateFrom" @onchange="OnFromDateChanged" style="padding:4px 6px;font-size:11px;border:1px solid #cbd5e1;border-radius:6px;color:#334155;background:#fff;max-width:115px;" title="From date" />
                    <span style="font-size:11px;color:#94a3b8;">-</span>
                    <input type="date" value="@_dateTo" @onchange="OnToDateChanged" style="padding:4px 6px;font-size:11px;border:1px solid #cbd5e1;border-radius:6px;color:#334155;background:#fff;max-width:115px;" title="To date" />
                    @if (!string.IsNullOrEmpty(_datePreset) || !string.IsNullOrEmpty(_dateFrom))
                    {
                        <button type="button" title="Clear date filter" @onclick="ClearDateFilterAsync" style="border:none;background:#fee2e2;color:#991b1b;border-radius:6px;padding:4px 7px;font-size:11px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:3px;">
                            <Icon Name="X" Size="11" />
                        </button>
                    }
                </div>
                @if (Everyone)
                {
                    <select class="ld-assignee" aria-label="Filter by owner" value="@_assignee" @onchange="OnAssigneeFilterChanged">
                        <option value="">@(Mode == LeadViews.Care ? "All care owners" : "All owners")</option>
                        <option value="unassigned">Unassigned (@_unassigned)</option>
                        @foreach (var t in _team) { <option value="@t.Id">@t.Name</option> }
                    </select>
                }
                <div class="ld-tabs" role="tablist">
                    @if (Mode == "no_answer")
                    {
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "" ? "is-active" : "")}")" @onclick='() => _quick = ""'>All No Answer <b>@_counts.GetValueOrDefault(LeadBuckets.NoAnswer)</b></button>
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "due_today" ? "is-active" : "")}")" @onclick='() => _quick = "due_today"'>Due Today <b>@_leads.Count(x => x.FollowUpToday)</b></button>
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "unread" ? "is-active" : "")}")" @onclick='() => _quick = "unread"'>Unread <b>@_unreadTotal</b></button>
                    }
                    else if (Mode == LeadViews.Leads)
                    {
                        @if (Everyone) { <button type="button" role="tab" class="@TabClass("")" @onclick='() => SetStatusAsync("")'>All <b>@Total</b></button> }
                        @foreach (var s in KpiStatuses)
                        {
                            var status = s;
                            <button type="button" role="tab" class="@TabClass(status)" @onclick="() => SetStatusAsync(status)">@Label(status) <b>@_counts.GetValueOrDefault(status)</b></button>
                        }
                    }
                    else
                    {
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "" ? "is-active" : "")}")" @onclick='() => _quick = ""'>All <b>@Total</b></button>
                        <button type="button" role="tab" class="@($"ld-tab {(_quick == "unread" ? "is-active" : "")}")" @onclick='() => _quick = "unread"'>Unread <b>@_unreadTotal</b></button>
                        @if (Mode == LeadViews.Care)
                        {
                            <button type="button" role="tab" class="@($"ld-tab {(_quick == "open" ? "is-active" : "")}")" @onclick='() => _quick = "open"'>Order on the way <b>@_leads.Count(x => x.OpenOrders > 0)</b></button>
                        }
                    }
                </div>
            </div>

            @if (_selectedLeadIds.Count > 0)
            {
                @if (Mode == "transfers")
                {
                    <div class="ld-bulk-bar">
                        <div class="ld-bulk-bar-left">
                            <span class="ld-bulk-count-badge">@_selectedLeadIds.Count</span>
                            <strong>transfer(s) selected</strong>
                        </div>
                        <div class="ld-bulk-bar-actions">
                            <button type="button" class="ld-bulk-btn ld-bulk-btn-accept" disabled="@_bulkBusy" @onclick="ExecuteBulkAcceptAsync">
                                <Icon Name="Check" Size="14" /> Accept Selected
                            </button>
                            <button type="button" class="ld-bulk-btn ld-bulk-btn-reject" disabled="@_bulkBusy" @onclick="ExecuteBulkRejectAsync">
                                <Icon Name="X" Size="14" /> Reject Selected
                            </button>
                            <button type="button" class="ld-bulk-btn ld-bulk-btn-cancel" @onclick="ClearSelection">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ld-bulk-bar">
                        <div class="ld-bulk-bar-left">
                            <span class="ld-bulk-count-badge">@_selectedLeadIds.Count</span>
                            <strong>lead@(_selectedLeadIds.Count > 1 ? "s" : "") selected</strong>
                        </div>
                        <div class="ld-bulk-bar-actions">
                            <label class="ld-bulk-dest-label">Transfer to:</label>
                            <select class="ld-bulk-dest-select" @bind="_bulkTargetEmployeeId" disabled="@_bulkBusy">
                                <option value="0">Choose team member...</option>
                                @foreach (var t in _team.Where(x => x.IsActive && (Everyone || x.Role == EmployeeRoles.Sales) && x.Id != AdminAuth.EmployeeId))
                                {
                                    <option value="@t.Id">@t.Name @(t.IsOnline ? "🟢" : "")</option>
                                }
                            </select>
                            <button type="button" class="ld-bulk-btn ld-bulk-btn-transfer" disabled="@(_bulkBusy || _bulkTargetEmployeeId <= 0)" @onclick="ExecuteBulkTransferAsync">
                                <Icon Name="ArrowRightLeft" Size="14" /> Transfer Selected
                            </button>
                            <button type="button" class="ld-bulk-btn ld-bulk-btn-cancel" @onclick="ClearSelection">Cancel</button>
                        </div>
                    </div>
                }
            }
            else if (VisibleLeads.Count > 0)
            {
                <div class="ld-select-all-row">
                    <label class="ld-check-all-label">
                        <input type="checkbox" class="ld-lead-checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                        <span>Select all visible (@VisibleLeads.Count)</span>
                    </label>
                </div>
            }

            <div class="ld-rows">
                @if (_loading && _leads.Count == 0)
                {
                    <div class="ld-empty">Loading…</div>
                }
                else if (VisibleLeads.Count == 0)
                {
                    var plain = string.IsNullOrWhiteSpace(_query) && _statusFilter == "" && _quick == "";
                    <div class="ld-empty">
                        <strong>@(plain ? EmptyTitle : "Nobody matches")</strong>
                        @(plain ? EmptyHint : "Try a different search or filter.")
                    </div>
                }
                else
                {
                    LeadDto? prevLead = null;
                    @foreach (var l in VisibleLeads)
                    {
                        var lead = l;
                        @if (FollowUpHeads && (prevLead is null || prevLead.FollowUpToday != lead.FollowUpToday))
                        {
                            <div class="ld-group">@(lead.FollowUpToday ? "Follow-up due today" : "Other follow-ups, by next date")</div>
                        }
                        prevLead = lead;
                        <button type="button" @key="lead.Id" @onclick="() => OpenAsync(lead.Id)"
                                class="@($"ld-row {(_selected?.Lead?.Id == lead.Id ? "is-selected" : "")} {(lead.UnreadCount > 0 ? "has-unread" : "")} {(_selectedLeadIds.Contains(lead.Id) ? "is-checked" : "")}")">
                            <span class="ld-check-col" @onclick:stopPropagation="true">
                                <input type="checkbox" class="ld-lead-checkbox" checked="@_selectedLeadIds.Contains(lead.Id)" @onchange="() => ToggleLeadSelection(lead.Id)" aria-label="Select lead" />
                            </span>
                            <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                            <span class="ld-row-main">
                                <span class="ld-row-top">
                                    <span class="ld-row-name">@lead.Name</span>
                                    <span class="ld-row-time">@ListTime(lead.LastContactAt)</span>
                                </span>
                                <span class="ld-row-bottom">
                                    <span class="ld-row-preview">@(lead.LastMessageDirection == "outbound" ? "You: " : "")@(lead.LastMessage ?? lead.FirstMessage ?? "No messages yet")</span>
                                    @if (lead.UnreadCount > 0) { <span class="ld-unread">@lead.UnreadCount</span> }
                                </span>
                                @if (lead.IsCustomer)
                                {
                                    <span class="ld-conv-line"><Icon Name="HeartPulse" Size="11" />Converted by <strong>@(lead.ConvertedByName ?? "website order")</strong></span>
                                }
                                <span class="ld-row-meta">
                                    @if (lead.IsPendingTransfer)
                                    {
                                        <span class="ld-pill ld-transfer"><Icon Name="ArrowRightLeft" Size="10" /> Transfer from @(lead.PendingTransferFromName ?? "Colleague")</span>
                                        @if (lead.PendingTransferRequestedAt is { } rqAt)
                                        {
                                            <span class="ld-transfer-chip" title="Auto-expires in 24 hours">@GetRemainingHoursText(rqAt)</span>
                                        }
                                        @if (lead.PendingTransferToEmployeeId == AdminAuth.EmployeeId || Everyone)
                                        {
                                            <span class="ld-row-transfer-acts" @onclick:stopPropagation="true">
                                                <button type="button" class="ld-btn-accept-sm" disabled="@_busy" @onclick="() => AcceptTransferAsync(lead.Id)"><Icon Name="Check" Size="11" /> Accept</button>
                                                <button type="button" class="ld-btn-reject-sm" disabled="@_busy" @onclick="() => RejectTransferAsync(lead.Id)"><Icon Name="X" Size="11" /> Reject</button>
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="@($"ld-pill {CurrentStatus(lead)}")">@Label(CurrentStatus(lead))</span>
                                    }
                                    @if (lead.Priority == LeadPriorities.High) { <span class="ld-pill ld-prio-high">High</span> }
                                    @if (lead.NoAnswerAttempts > 0) { <span class="ld-pill no-answer">Attempt @lead.NoAnswerAttempts/7</span> }
                                    @if (lead.OpenOrders > 0) { <span class="ld-pill ld-open" title="An order is not delivered yet"><Icon Name="Truck" Size="10" />On the way</span> }
                                    <span class="ld-src"><Icon Name="MessageCircle" Size="11" />@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                                    @if (lead.AssignedToEmployeeId is null && Everyone) { <span class="ld-pill ld-unowned">Unassigned</span> }
                                    else if (Everyone) { <span class="ld-src">· @(lead.IsCustomer ? "Care: " : "")@lead.AssignedToName</span> }
                                    @if (lead.OrderCount > 0) { <span class="ld-pill ld-cust" title="Lifetime value"><Icon Name="Package" Size="10" />@lead.OrderCount order@(lead.OrderCount == 1 ? "" : "s") · ₹@AdminFmt.Inr(lead.LifetimeValue)</span> }
                                    @if (lead.NextFollowUpAt is { } nf) { <span class="@($"ld-pill ld-fu {(nf < DateTime.UtcNow ? "late" : "")}")" title="Next follow-up"><Icon Name="Clock" Size="10" />@FuFmt.Due(nf)</span> }
                                    @if (lead.ConsentStatus == "opted_out") { <span class="ld-pill ld-stop">Opted out</span> }
                                </span>
                            </span>
                        </button>
                    }
                }
            </div>
        </section>
        }

        @* ───────── Lead detail (a slide-in panel in the new look) ───────── *@
        <section class="ld-detail" aria-label="Lead detail">
            @if (_selected?.Lead is null)
            {
                <div class="ld-none">
                    <div>
                        <Icon Name="MessageCircle" Size="44" />
                        <strong>@(Mode == LeadViews.Care ? "Select a customer" : "Select a lead")</strong>
                        @(Mode == LeadViews.Care ? "Open a conversation to follow up, share order updates and keep notes." : "Open a conversation to reply on WhatsApp, update the status and keep notes.")
                    </div>
                </div>
            }
            else
            {
                var lead = _selected.Lead;
                <header class="ld-dhead">
                    <button type="button" class="ld-back is-always" title="Back to list" aria-label="Back to leads" @onclick="CloseDetailAsync"><Icon Name="ArrowLeft" Size="20" /></button>
                    <span class="ld-avatar" style="background:@AvatarColor(lead)">@Initials(lead)</span>
                    <div class="ld-who">
                        <strong>@lead.Name</strong>
                        <span>+@lead.Phone · @SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</span>
                    </div>
                    @if (lead.Priority == LeadPriorities.High)
                    {
                        <span class="ld-pill ld-prio-high">High priority</span>
                    }
                    @if (lead.NoAnswerAttempts > 0)
                    {
                        <span class="ld-pill no-answer">Attempt @lead.NoAnswerAttempts/7</span>
                    }
                    @if (lead.IsCustomer)
                    {
                        <span class="ld-pill converted" title="A lead becomes a customer when a paid order is placed">Customer</span>
                    }
                </header>

                @if (lead.IsPendingTransfer)
                {
                    <div class="ld-transfer-banner">
                        <div class="ld-tb-left">
                            <div class="ld-tb-icon"><Icon Name="ArrowRightLeft" Size="20" /></div>
                            <div class="ld-tb-text">
                                <div class="ld-tb-head">
                                    <strong>Transfer request from @(lead.PendingTransferFromName ?? "Colleague")</strong>
                                    @if (lead.PendingTransferRequestedAt is { } reqAt)
                                    {
                                        <span class="ld-tb-time">Requested @AdminFmt.DateTimeShort(reqAt)</span>
                                        <span class="ld-tb-countdown"><Icon Name="Clock" Size="11" /> @GetRemainingHoursText(reqAt)</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(lead.PendingTransferReason))
                                {
                                    <div class="ld-tb-note">Reason: <em>@lead.PendingTransferReason</em></div>
                                }
                                <div class="ld-tb-sub">
                                    Accept this transfer to add this lead to your active leads list. Rejecting or leaving it unhandled for 24 hours will automatically return it to @(lead.PendingTransferFromName ?? "the sender").
                                </div>
                            </div>
                        </div>
                        @if (lead.PendingTransferToEmployeeId == AdminAuth.EmployeeId || Everyone)
                        {
                            <div class="ld-tb-buttons">
                                <button type="button" class="ld-btn-accept" disabled="@_busy" @onclick="() => AcceptTransferAsync(lead.Id)">
                                    <Icon Name="Check" Size="14" /> Accept
                                </button>
                                <button type="button" class="ld-btn-reject" disabled="@_busy" @onclick="() => RejectTransferAsync(lead.Id)">
                                    <Icon Name="X" Size="14" /> Reject
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (lead.IsCustomer)
                {
                    <div class="ld-conv-banner">
                        <Icon Name="HeartPulse" Size="16" />
                        <span>Converted to a customer by <strong>@(lead.ConvertedByName ?? "a website order")</strong>@(lead.CustomerSince is { } since ? " on " + AdminFmt.DateTimeShort(since) : "")</span>
                        @if (lead.OpenOrders > 0) { <span class="ld-pill ld-open"><Icon Name="Truck" Size="10" />@lead.OpenOrders order@(lead.OpenOrders == 1 ? "" : "s") on the way</span> }
                    </div>
                }

                <div class="ld-owner">
                    @if (lead.IsPendingTransfer)
                    {
                        <span>Pending Transfer</span>
                        <strong style="color:#7c3aed;font-weight:600">To: @(lead.PendingTransferToName ?? "Colleague")</strong>
                        <small>(Awaiting acceptance)</small>
                    }
                    else
                    {
                        <span>@(Everyone ? (lead.IsCustomer ? "Care owner" : "Owner") : "Transfer to")</span>
                        <select aria-label="Lead owner" disabled="@_busy" @onchange="OnOwnerChanged">
                            @if (Everyone)
                            {
                                <option value="" selected="@(lead.AssignedToEmployeeId is null)">Unassigned</option>
                                @foreach (var t in _team) { <option value="@t.Id" selected="@(lead.AssignedToEmployeeId == t.Id)">@t.Name</option> }
                            }
                            else
                            {
                                <option value="" selected disabled>@(lead.AssignedToName ?? "Me") (you)</option>
                                @foreach (var t in _team.Where(t => t.Id != AdminAuth.EmployeeId)) { <option value="@t.Id">@t.Name</option> }
                            }
                        </select>
                        @if (lead.AssignedAt is { } at) { <small>since @AdminFmt.DateTimeShort(at)</small> }
                    }
                    <span class="ld-owner-gap"></span>
                    @if (lead.NextFollowUpAt is { } nfu) { <span class="@($"ld-pill ld-fu {(nfu < DateTime.UtcNow ? "late" : "")}")"><Icon Name="Clock" Size="11" />Next: @FuFmt.Due(nfu)</span> }
                    @if (!Project.IsMidFit)
                    {
                        <button type="button" class="ld-btn" @onclick="() => _orderDialog = true"><Icon Name="Package" Size="13" /> Order</button>
                    }
                    @if (lead.Status == LeadStatuses.Interested)
                    {
                        @if (Project.IsMidFit)
                        {
                            <button type="button" class="ld-btn" style="background:#dcfce7;border-color:#86efac;color:#166534;font-weight:600;" @onclick="() => _showPaymentDialog = true"><Icon Name="CreditCard" Size="13" /> Convert (Paid)</button>
                            <button type="button" class="ld-btn" style="background:#ffedd5;border-color:#ea580c;color:#c2410c;font-weight:600;" @onclick="() => _showConsultationDialog = true"><Icon Name="Calendar" Size="13" /> Book Free Doctor Consultation</button>
                        }
                        <button type="button" class="ld-btn" style="background:#fef3c7;border-color:#f59e0b;color:#b45309;font-weight:600;" @onclick="() => _composer = true"><Icon Name="Flame" Size="13" /> Hot Leads Follow-up</button>
                    }
                    else if (lead.Status == LeadStatuses.NoAnswer)
                    {
                        <button type="button" class="ld-btn" style="background:#fee2e2;border-color:#f87171;color:#b91c1c;font-weight:600;" @onclick="() => _composer = true"><Icon Name="PhoneMissed" Size="13" /> No Answer Follow-up</button>
                    }
                    else if (lead.Status != LeadStatuses.New)
                    {
                        <button type="button" class="ld-btn" @onclick="() => _composer = true"><Icon Name="Clock" Size="13" /> Schedule Follow-up</button>
                    }
                    else
                    {
                        <button type="button" class="ld-btn" disabled title="Mark this New lead as Interested first before scheduling a follow-up"><Icon Name="Clock" Size="13" /> Follow-up</button>
                    }
                    @if (AdminAuth.Can("tasks")) { <button type="button" class="ld-btn" title="Create a task about this lead" @onclick="() => NewTaskFor(lead.Id)"><Icon Name="Check" Size="13" /> Task</button> }
                </div>

                <div class="ld-one">
                    <div class="ld-chat">
                        @if (lead.ConsentStatus == "opted_out")
                        {
                            <div class="ld-banner danger"><Icon Name="AlertCircle" Size="15" /><span>This customer opted out (STOP). Do not send further messages.</span></div>
                        }
                        else if (WindowOpen(lead))
                        {
                            <div class="ld-banner"><Icon Name="Clock" Size="15" /><span>Reply window open — closes in @WindowLeft(lead). Free-form replies are allowed until then.</span></div>
                        }
                        else
                        {
                            <div class="ld-banner warn"><Icon Name="Clock" Size="15" /><span>24-hour window closed. WhatsApp only lets you send an approved template now. When the customer replies, you can send messages, files and videos again.</span></div>
                        }

                        @if (lead.ConsentStatus != "opted_out" && !WindowOpen(lead))
                        {
                            <div class="ld-tplsend">
                                <div class="ld-tplsend-head"><strong><Icon Name="Send" Size="14" /> Send an approved template</strong><small>Pick one, check the preview, send.</small></div>
                                @if (ApprovedTemplates.Count == 0)
                                {
                                    <p class="fu-hint">No templates are approved yet. An administrator submits them to Meta from <em>Team &amp; organisation → Messages &amp; templates</em> and marks them approved there.</p>
                                }
                                else
                                {
                                    <div class="ld-tplsend-list">
                                        @foreach (var td in ApprovedTemplates)
                                        {
                                            var def = td;
                                            <button type="button" class="@($"ld-tplopt {(_pickedTpl?.Name == def.Name ? "is-picked" : "")}")" @onclick="() => PickTemplate(def, lead)">
                                                <strong>@def.Title</strong><small>@MessageStages.Label(def.Stage)</small>
                                            </button>
                                        }
                                    </div>
                                    @if (_pickedTpl is { } pt)
                                    {
                                        <div class="ld-tplsend-form">
                                            @for (var pi = 0; pi < pt.Params.Length; pi++)
                                            {
                                                var idx = pi; var prm = pt.Params[pi];
                                                if (prm.Kind == "text")
                                                {
                                                    <label>@prm.Label<input type="text" maxlength="120" value="@_tplValues[idx]" placeholder="@prm.Sample" @oninput="e => _tplValues[idx] = e.Value?.ToString() ?? string.Empty" /></label>
                                                }
                                            }
                                            <div class="ld-tplsend-preview" aria-label="Preview">@pt.Filled(PreviewValues(pt, lead))</div>
                                            <button type="button" class="ld-btn primary" disabled="@(_busy || !TemplateReady(pt))" @onclick="() => SendTemplateAsync(lead)"><Icon Name="Send" Size="13" /> Send template</button>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <div class="ld-scroll">
                            <div class="ld-msgs">
                                @if (_selected.Messages.Count == 0)
                                {
                                    <div class="ld-day">No messages yet</div>
                                }
                                @{ DateTime? prevDay = null; string? prevDir = null; }
                                @foreach (var m in _selected.Messages)
                                {
                                    var local = m.CreatedAt.ToLocalTime();
                                    var inbound = m.Direction == "inbound";
                                    var first = prevDir != m.Direction || prevDay != local.Date;
                                    @if (prevDay != local.Date)
                                    {
                                        <div class="ld-day">@DayLabel(local.Date)</div>
                                    }
                                    var isTemplate = m.Type == "template" && (m.Body ?? "").StartsWith("[template:");
                                    var isMedia = m.Type is "image" or "sticker" or "video" or "audio" or "document";
                                    <div @key="m.Id" class="@($"ld-bub {(inbound ? "in" : "out")} {(first ? "first gap" : "")} {(m.Type == "sticker" ? "is-sticker" : "")} {(m.Reaction is not null ? "has-reaction" : "")}")">
                                        @if (!inbound && !string.IsNullOrEmpty(m.SentBy)) { <span class="ld-by">@m.SentBy</span> }
                                        @if (isMedia)
                                        {
                                            @MediaView(m)
                                        }
                                        @if (isTemplate)
                                        {
                                            <span class="ld-tpl">Template message</span>
                                            <span class="ld-tpl-body">@TemplateText(m.Body)</span>
                                        }
                                        else if (!string.IsNullOrEmpty(m.Body))
                                        {
                                            @LinkedText(m.Body)
                                        }
                                        else if (!isMedia)
                                        {
                                            @($"[{m.Type}]")
                                        }
                                        <span class="@($"ld-meta {(m.Status == "failed" ? "failed" : "")}")">
                                            @if (m.Status == "failed") { <span title="@m.Error">Not delivered</span> }
                                            @local.ToString("hh:mm tt")
                                            @if (!inbound && m.Status != "failed") { @Ticks(m.Status) }
                                        </span>
                                        @if (m.Status == "failed" && !string.IsNullOrEmpty(m.Error)) { <span class="ld-fail-why" style="display:block;font-size:11px;color:#b42318;margin-top:2px">@m.Error</span> }
                                        @if (!string.IsNullOrEmpty(m.Reaction)) { <span class="ld-react" title="Customer reacted">@m.Reaction</span> }
                                    </div>
                                    prevDay = local.Date; prevDir = m.Direction;
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_toast)) { <div class="ld-toast">@_toast</div> }

                        <div class="cmp">
                            @if (CanReply(lead) && _pop != "")
                            {
                                <button type="button" class="cmp-scrim" tabindex="-1" aria-label="Close" @onclick="() => _pop = string.Empty"></button>
                                <div class="cmp-pop" role="dialog" aria-label="@PopTitle(lead)">
                                    <div class="cmp-pop-head">
                                        <div><strong>@PopTitle(lead)</strong><small>@PopHint(lead)</small></div>
                                        <button type="button" class="cmp-x" aria-label="Close" @onclick="() => _pop = string.Empty"><Icon Name="X" Size="16" /></button>
                                    </div>
                                    <div class="cmp-pop-body">
                                        @if (_pop == "ai")
                                        {
                                            <button type="button" class="cmp-primary" disabled="@(_busy || _drafting)" @onclick="() => SuggestAsync(null, true)">
                                                <Icon Name="Sparkles" Size="16" /> @(_drafting ? "Writing a reply…" : _draft is null ? "Write a reply for me" : "Write a new draft")
                                            </button>
                                            @if (_draft?.RespondingTo is { Length: > 0 } rq && !_drafting)
                                            {
                                                <div class="cmp-ctx">Replying to <em>“@rq”</em></div>
                                            }
                                            <div class="cmp-sub">Rewrite what is in the box</div>
                                            <div class="cmp-chips">
                                                @foreach (var t in Tweaks)
                                                {
                                                    var tweak = t;
                                                    <button type="button" class="cmp-chip" disabled="@(_busy || _drafting || string.IsNullOrWhiteSpace(_reply))" @onclick="() => SuggestAsync(tweak.Instruction, false)">@tweak.Label</button>
                                                }
                                            </div>
                                            @if (string.IsNullOrWhiteSpace(_reply)) { <small class="cmp-faint">Write or generate a reply first, then rewrite it here.</small> }
                                        }
                                        else if (_pop == "files")
                                        {
                                            @if (AdminAuth.Can("drive_files"))
                                            {
                                                <div class="cmp-subtabs">
                                                    <button type="button" class="@($"cmp-subtab {(_filesTab == "library" ? "is-on" : "")}")" @onclick='() => _filesTab = "library"'>File library</button>
                                                    <button type="button" class="@($"cmp-subtab {(_filesTab == "drive" ? "is-on" : "")}")" @onclick="OpenDriveTabAsync">Google Drive</button>
                                                </div>
                                            }
                                            @if (_filesTab == "drive" && AdminAuth.Can("drive_files"))
                                            {
                                                @if (_driveLoading) { <p class="cmp-empty">Loading Google Drive files…</p> }
                                                else if (!string.IsNullOrEmpty(_driveError)) { <p class="cmp-empty">@_driveError</p> }
                                                else if (_driveFiles.Count == 0) { <p class="cmp-empty">No files found in the configured Google Drive folder.</p> }
                                                @foreach (var df in _driveFiles)
                                                {
                                                    var dfile = df;
                                                    <div class="cmp-item">
                                                        <span class="cmp-ico">@AdminFileLibrary.KindEmoji(dfile.Kind)</span>
                                                        <div class="cmp-txt"><strong>@dfile.Name</strong><small>@LibraryKinds.Label(dfile.Kind)@(dfile.Size > 0 ? " · " + AdminFileLibrary.Size(dfile.Size) : "")</small></div>
                                                        <div class="cmp-acts">
                                                            <button type="button" class="cmp-btn primary" disabled="@_busy" @onclick="() => SendDriveFileAsync(dfile)">Share link</button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                @if (_library.Count == 0) { <p class="cmp-empty">No files yet. An administrator adds them in Team &amp; organisation → File library.</p> }
                                                @foreach (var lf in _library)
                                                {
                                                    var file = lf;
                                                    <div class="cmp-item">
                                                        <span class="cmp-ico">@AdminFileLibrary.KindEmoji(file.Kind)</span>
                                                        <div class="cmp-txt"><strong>@file.Title</strong><small>@LibraryKinds.Label(file.Kind) · @AdminFileLibrary.Size(file.Size)@(file.CanAttach ? "" : " · link only")</small></div>
                                                        <div class="cmp-acts">
                                                            <button type="button" class="cmp-btn primary" disabled="@(_busy || !file.CanAttach)" title="@(file.CanAttach ? "Send the file itself on WhatsApp" : "Too large to send as an attachment")" @onclick="() => SendFileAsync(file, false)">Send file</button>
                                                            <button type="button" class="cmp-btn" disabled="@_busy" title="Send a message with the file's link" @onclick="() => SendFileAsync(file, true)">Send link</button>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        }
                                        else if (_pop == "tpl")
                                        {
                                            @if (!TemplatesFor(lead).Any()) { <p class="cmp-empty">No ready-made replies for this stage yet.</p> }
                                            @foreach (var t in TemplatesFor(lead))
                                            {
                                                var tpl = t;
                                                <button type="button" class="cmp-item cmp-click" @onclick="() => UseTemplate(tpl)">
                                                    <span class="cmp-ico"><Icon Name="MessageSquare" Size="16" /></span>
                                                    <div class="cmp-txt"><strong>@tpl.Title</strong><small class="cmp-clamp">@MessageDefaults.Fill(tpl.Body, lead.Name, AdminAuth.Name, _selected.Orders.FirstOrDefault()?.Id)</small></div>
                                                    <span class="cmp-use">Use</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (CanReply(lead) && _draft is { NeedsReview: true } && !string.IsNullOrWhiteSpace(_reply))
                            {
                                <div class="cmp-note"><Icon Name="AlertCircle" Size="14" /><span><strong>Check before sending.</strong> @(_draft.ReviewNote ?? "This reply needs a careful read.")</span></div>
                            }

                            <form class="ld-composer" @onsubmit="ReplyAsync" @onsubmit:preventDefault>
                                <textarea rows="@ReplyRows" aria-label="Type a message" disabled="@(_busy || lead.ConsentStatus == "opted_out")" maxlength="1500"
                                          placeholder="@(lead.ConsentStatus == "opted_out" ? "Customer opted out" : WindowOpen(lead) ? "Type a message, or use the tools below" : "24-hour window closed · Send template or type a message")"
                                          @bind="_reply" @bind:event="oninput" @onkeydown="OnReplyKey"></textarea>
                                <button type="submit" class="ld-send" aria-label="Send message" title="Send (Ctrl+Enter)" disabled="@(_busy || _drafting || lead.ConsentStatus == "opted_out" || string.IsNullOrWhiteSpace(_reply))"><Icon Name="Send" Size="18" /></button>
                            </form>

                            @if (lead.ConsentStatus != "opted_out")
                            {
                                <div class="cmp-bar">
                                    @if (_assistantOn)
                                    {
                                        <button type="button" class="@($"cmp-tool {(_pop == "ai" ? "is-on" : "")}")" aria-expanded="@(_pop == "ai")" @onclick="() => OpenPopAsync(PopAi)">
                                            <Icon Name="Sparkles" Size="15" /> @(_drafting ? "Writing…" : "Reply assistant")
                                            @if (!_drafting && _draft is not null) { <span class="cmp-dot" title="@(_draft.Source == "ai" ? "AI draft" : "Standard reply")"></span> }
                                        </button>
                                    }
                                    <button type="button" class="@($"cmp-tool {(_pop == "files" ? "is-on" : "")}")" aria-expanded="@(_pop == "files")" @onclick="() => OpenPopAsync(PopFiles)"><Icon Name="FileText" Size="15" /> Files &amp; videos</button>
                                    @if (_templates.Count > 0)
                                    {
                                        <button type="button" class="@($"cmp-tool {(_pop == "tpl" ? "is-on" : "")}")" aria-expanded="@(_pop == "tpl")" @onclick="() => OpenPopAsync(PopTpl)"><Icon Name="MessageSquare" Size="15" /> Ready-made replies</button>
                                    }
                                    <span class="cmp-gap"></span>
                                    <small class="cmp-hint">Ctrl + Enter to send</small>
                                </div>
                            }
                        </div>
                    </div>
                    <aside class="ld-side" aria-label="About this lead">
                        @{
                            var notesLocked = lead.Status == LeadStatuses.New && !lead.HasAssessment;
                        }
                        <section class="ld-sec ld-details-sec">
                            <h4>
                                <span>Details &amp; Notes</span>
                                @if (!_editingDetails)
                                {
                                    <button type="button" class="ld-link" @onclick="() => StartDetailsEdit(lead)"><Icon Name="Edit3" Size="12" /> Edit</button>
                                }
                            </h4>
                            @if (_editingDetails)
                            {
                                <div class="ld-edit-fields">
                                    <label>Name
                                        <input type="text" maxlength="200" @bind="_editName" @bind:event="oninput" />
                                    </label>
                                    <label>Email
                                        <input type="email" maxlength="200" placeholder="Optional email" @bind="_editEmail" @bind:event="oninput" />
                                    </label>
                                    <label>Notes
                                        <textarea placeholder="@(notesLocked ? "Locked: save the Assessment Form first…" : "Interest, objections, preferred call time…")"
                                                  aria-label="Internal notes" disabled="@notesLocked" @bind="_notes" @bind:event="oninput"></textarea>
                                    </label>
                                </div>
                                @if (notesLocked)
                                {
                                    <p class="ld-lock-hint"><Icon Name="Lock" Size="12" /> Complete and save the Assessment Form below to unlock Notes for this New lead.</p>
                                }
                                <div class="ld-actions">
                                    @if (!string.IsNullOrEmpty(_toast)) { <small>@_toast</small> }
                                    <button type="button" class="ld-btn" disabled="@_busy" @onclick="() => CancelDetailsEdit(lead)">Cancel</button>
                                    <button type="button" class="ld-btn primary" disabled="@_busy" @onclick="UpdateDetailsAsync">@(_busy ? "Updating…" : "Update")</button>
                                </div>
                            }
                            else
                            {
                                <dl class="ld-dl">
                                    <dt>Name</dt><dd>@lead.Name</dd>
                                    <dt>Phone</dt><dd>+@lead.Phone</dd>
                                    @if (!string.IsNullOrEmpty(lead.Email)) { <dt>Email</dt><dd>@lead.Email</dd> }
                                    <dt>Source</dt><dd>@SourceLabel(lead.Source)@(string.IsNullOrEmpty(lead.SourceDetail) ? "" : " · " + lead.SourceDetail)</dd>
                                    <dt>Came in</dt><dd>@AdminFmt.DateTimeShort(lead.CreatedAt)</dd>
                                    <dt>Last contact</dt><dd>@AdminFmt.DateTimeShort(lead.LastContactAt)</dd>
                                    @if (lead.IsCustomer)
                                    {
                                        <dt>Converted by</dt><dd>@(lead.ConvertedByName ?? "A website order")</dd>
                                        <dt>Customer since</dt><dd>@(lead.CustomerSince is { } cs ? AdminFmt.DateTimeShort(cs) : "—")</dd>
                                    }
                                </dl>
                                <div class="ld-notes-box">
                                    <span class="ld-notes-lbl">Notes</span>
                                    @if (notesLocked)
                                    {
                                        <p class="ld-lock-hint"><Icon Name="Lock" Size="12" /> Notes locked for this New lead until the Assessment Form is saved.</p>
                                    }
                                    else if (string.IsNullOrWhiteSpace(lead.Notes))
                                    {
                                        <p class="ld-muted">No notes yet. Click <strong>Edit</strong> above to add notes.</p>
                                    }
                                    else
                                    {
                                        <p class="ld-notes-val">@lead.Notes</p>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(lead.FirstMessage)) { <p class="ld-quote">“@lead.FirstMessage”</p> }
                            }
                        </section>

                        <LeadAssessmentCard Lead="lead" OnSaved="OnAssessmentSavedAsync" />

                        <section class="ld-sec">
                            <h4>Status</h4>
                            @if (lead.IsCustomer)
                            {
                                <span class="ld-pill converted">Customer</span>
                            }
                            else
                            {
                                <div class="ld-quick" role="group" aria-label="Set status">
                                    @foreach (var s in VisibleQuickStatuses(lead))
                                    {
                                        var st = s;
                                        <button type="button" class="@($"ld-q q-{st} {(CurrentStatus(lead) == st ? "is-on" : "")}")" aria-pressed="@(CurrentStatus(lead) == st)" disabled="@_busy" @onclick="() => SetQuickAsync(st)">@Label(st)</button>
                                    }
                                </div>
                                @if (lead.Status == LeadStatuses.New)
                                {
                                    <small class="ld-muted">Mark as <strong>Interested</strong> before scheduling a follow-up. No answer books a retry for tomorrow 10 am.</small>
                                }
                                else if (CurrentStatus(lead) == LeadBuckets.NoAnswer)
                                {
                                    <small class="ld-muted">No answer attempt <strong>@(Math.Max(1, lead.NoAnswerAttempts)) of 7</strong>. After 7 attempts with no reply, the lead moves to Not Interested.</small>
                                }
                                else
                                {
                                    <small class="ld-muted">No answer logs an attempt and books a retry for tomorrow 10 am.</small>
                                }

                                @if (lead.Status == LeadStatuses.Interested)
                                {
                                    <div class="ld-prio-row">
                                        <span>Hot lead priority:</span>
                                        <button type="button" class="@($"ld-q {(lead.Priority == LeadPriorities.High ? "is-on q-high" : "")}")" disabled="@_busy" @onclick="() => SetPriorityAsync(LeadPriorities.High)">High</button>
                                        <button type="button" class="@($"ld-q {(lead.Priority != LeadPriorities.High ? "is-on" : "")}")" disabled="@_busy" @onclick="() => SetPriorityAsync(LeadPriorities.Normal)">Normal</button>
                                    </div>
                                }
                            }
                        </section>

                        <section class="ld-sec">
                            <h4>
                                <span>No Answer Follow-up</span>
                                @if (lead.Status != LeadStatuses.New)
                                {
                                    <button type="button" class="ld-link" @onclick="() => _composer = true">+ Schedule</button>
                                }
                            </h4>
                            @{
                                var pendingFu = _selected.FollowUps.Where(f => f.Status == "pending").ToList();
                                var closedFu = _selected.FollowUps.Where(f => f.Status != "pending").ToList();
                                var shownFu = pendingFu.Concat(_showAllFu ? closedFu : closedFu.Take(2)).ToList();
                            }
                            @if (shownFu.Count == 0)
                            {
                                <p class="fu-hint">@(lead.Status == LeadStatuses.New ? "Mark this lead Interested first to schedule follow-ups." : "Nothing scheduled. Add a call or message so this lead is not forgotten.")</p>
                            }
                            <div class="fu-list tight">
                                @foreach (var fu in shownFu)
                                {
                                    <FollowUpCard @key="fu.Id" Item="fu" ShowLead="false" IsAdmin="Everyone" Team="_team" OnChanged="OnFollowUpChanged" />
                                }
                            </div>
                            @if (closedFu.Count > 2) { <button type="button" class="ld-link" @onclick="() => _showAllFu = !_showAllFu">@(_showAllFu ? "Show fewer" : $"Show all {closedFu.Count} finished")</button> }
                        </section>

                        <section class="ld-sec">
                            <h4>Orders <button type="button" class="ld-link" @onclick="() => _orderDialog = true">+ Create order</button></h4>
                            @if (_selected.Orders.Count == 0)
                            {
                                <p class="fu-hint">No orders yet. When the customer agrees to buy, use <strong>Create order</strong>.</p>
                            }
                            else
                            {
                                <div class="lo-stats">
                                    <div><span>Orders</span><strong>@lead.OrderCount</strong></div>
                                    <div><span>Lifetime</span><strong>₹@AdminFmt.Inr(lead.LifetimeValue)</strong></div>
                                    <div><span>Last order</span><strong>@(lead.LastOrderAt is { } lo ? AdminFmt.DateTimeShort(lo) : "—")</strong></div>
                                </div>
                                <div class="lo-orders">
                                    @foreach (var o in _selected.Orders)
                                    {
                                        <div class="lo-order">
                                            <div>
                                                <strong>@o.Id</strong>
                                                <small>@o.Items</small>
                                                <small>
                                                    @AdminFmt.DateTimeShort(o.CreatedAt) ·
                                                    @(o.PaymentStatus == "COD_COLLECTED" ? "COD collected" : o.PaymentMethod == "COD" ? "Cash on delivery" : "Paid") ·
                                                    @(o.ShippingMode == ShippingMode.Offline ? "Offline" : "Online")
                                                    @(string.IsNullOrEmpty(o.Awb) ? "" : " · " + o.Courier + " " + o.Awb)
                                                </small>
                                                @if (!string.IsNullOrWhiteSpace(o.OfflineDispatchNote))
                                                {
                                                    <small>Note: @o.OfflineDispatchNote</small>
                                                }
                                                <div class="lo-inv-links">
                                                    <button type="button" class="ld-link" @onclick="() => OpenOrderInvoiceAsync(o.Id)">View Invoice</button>
                                                    <span>·</span>
                                                    <button type="button" class="ld-link" @onclick="() => DownloadOrderInvoiceAsync(o.Id)">Download PDF</button>
                                                </div>
                                            </div>
                                            <div class="lo-order-end">
                                                <b>₹@AdminFmt.Inr(o.TotalAmount)</b>
                                                <span class="@($"ld-pill {OrderTone(o.FulfillmentStatus)}")">@o.DeliveryStatus</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <details class="ld-more">
                            <summary>History, owner changes &amp; WhatsApp consent</summary>
                            <div class="ld-more-body">
                                <h5>WhatsApp consent</h5>
                                <dl class="ld-dl">
                                    <dt>Marketing</dt>
                                    <dd class="@(lead.ConsentStatus == "opted_in" ? "ld-ok" : lead.ConsentStatus == "opted_out" ? "ld-bad" : "ld-warn")">@ConsentLabel(lead.ConsentStatus)</dd>
                                    <dt>Reply window</dt>
                                    <dd class="@(WindowOpen(lead) ? "ld-ok" : "ld-warn")">@(WindowOpen(lead) ? "Open · " + WindowLeft(lead) + " left" : "Closed — templates only")</dd>
                                </dl>
                                @if (lead.ConsentStatus != "opted_out")
                                {
                                    <div class="ld-actions">
                                        <small>Opt-in lets follow-up messages be sent automatically. Only record it after the customer agreed.</small>
                                        @if (lead.ConsentStatus == "opted_in")
                                        {
                                            <button type="button" class="ld-btn" disabled="@_busy" @onclick='() => SetConsentAsync("unknown")'>Clear</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ld-btn" disabled="@_busy" @onclick='() => SetConsentAsync("opted_in")'>Customer agreed</button>
                                        }
                                    </div>
                                }

                                <h5>Owner changes</h5>
                                @if (_selected.Assignments.Count == 0) { <p class="ld-muted">No owner changes yet.</p> }
                                else
                                {
                                    <ul class="ld-tl">
                                        @foreach (var a in _selected.Assignments)
                                        {
                                            <li>@(a.FromName is null ? "Assigned" : a.FromName + " →") <strong>@(a.ToName ?? "Unassigned")</strong>
                                                <small>@AdminFmt.DateTimeShort(a.CreatedAt) · @a.ChangedBy@(string.IsNullOrEmpty(a.Reason) ? "" : " · " + a.Reason)</small></li>
                                        }
                                    </ul>
                                }

                                <h5>Everything that changed</h5>
                                @if (_selected.Audit.Count == 0) { <p class="ld-muted">No changes recorded yet.</p> }
                                else
                                {
                                    <ul class="ld-tl">
                                        @foreach (var a in _selected.Audit)
                                        {
                                            <li>
                                                <strong>@a.Summary</strong>
                                                <small>@AdminFmt.DateTimeShort(a.CreatedAt) · @(a.Automatic ? "system (" + a.Actor + ")" : a.Actor)@(string.IsNullOrEmpty(a.Detail) ? "" : " · " + a.Detail)</small>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </details>
                    </aside>
                </div>
            }
        </section>
    </div>
</div>

@if (_orderDialog && _selected?.Lead is { } ol)
{
    <LeadOrderDialog LeadId="ol.Id" LeadName="@ol.Name" LeadEmail="@ol.Email" OnClose="() => _orderDialog = false" OnCreated="OnOrderCreated" />
}

@if (_showConsultationDialog && _selected?.Lead is { } bookLead)
{
    <ConsultationSlotDialog LeadId="bookLead.Id"
                            LeadName="@bookLead.Name"
                            LeadPhone="@bookLead.Phone"
                            Type="ConsultationType.FreeInitial"
                            OnClose="() => _showConsultationDialog = false"
                            OnBooked="OnConsultationBookedAsync" />
}

@if (_showPaymentDialog && _selected?.Lead is { } payLead)
{
    <PaymentLinkDialog LeadId="payLead.Id"
                       LeadName="@payLead.Name"
                       LeadPhone="@payLead.Phone"
                       OnClose="() => _showPaymentDialog = false"
                       OnPaymentVerified="OnLeadPaymentVerifiedAsync" />
}

@if (_showOnboardingDialog && _selected?.Lead is { } onbLead)
{
    <ConsultationSlotDialog LeadId="onbLead.Id"
                            LeadName="@onbLead.Name"
                            LeadPhone="@onbLead.Phone"
                            Type="ConsultationType.PaidOnboarding"
                            OnClose="() => _showOnboardingDialog = false"
                            OnBooked="OnOnboardingBookedAsync" />
}

@if (_composer && _selected?.Lead is { } cl)
{
    <FollowUpComposer LeadId="cl.Id" LeadName="@cl.Name" LeadPhone="@cl.Phone" LeadStatus="@cl.Status" IsAdmin="Everyone" Team="_team" OnClose="() => _composer = false" OnCreated="OnFollowUpCreated" />
}

@if (_showNewLeadModal)
{
    <div class="ld-modal-overlay" @onclick="CloseNewLeadModal" style="position:fixed;inset:0;background:rgba(15,23,42,0.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(4px);">
        <div class="ld-modal-card" @onclick:stopPropagation="true" style="background:#fff;border-radius:16px;max-width:540px;width:100%;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1),0 8px 10px -6px rgba(0,0,0,0.1);overflow:hidden;display:flex;flex-direction:column;max-height:90vh;">
            
            <div style="padding:18px 24px;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;background:#f8fafc;">
                <div>
                    <h3 style="margin:0;font-size:17px;font-weight:700;color:#0f172a;display:flex;align-items:center;gap:8px;">
                        <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:#dcfce7;color:#166534;"><Icon Name="Plus" Size="16" /></span>
                        Create Manual Lead
                    </h3>
                    <p style="margin:4px 0 0;font-size:12px;color:#64748b;">For organic calls, walk-ins, or direct WhatsApp enquiries.</p>
                </div>
                <button type="button" @onclick="CloseNewLeadModal" style="border:none;background:transparent;cursor:pointer;color:#94a3b8;padding:4px;border-radius:6px;" aria-label="Close">
                    <Icon Name="X" Size="18" />
                </button>
            </div>

            <form @onsubmit="SaveNewLeadAsync" @onsubmit:preventDefault style="padding:20px 24px;overflow-y:auto;display:flex;flex-direction:column;gap:14px;">
                @if (!string.IsNullOrEmpty(_newLeadError))
                {
                    <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:10px 14px;border-radius:8px;font-size:13px;display:flex;align-items:center;gap:8px;">
                        <Icon Name="AlertCircle" Size="16" />
                        <span>@_newLeadError</span>
                    </div>
                }

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px;">Full Name *</label>
                        <input type="text" required placeholder="e.g. Ramesh Kumar" @bind="_newLeadForm.FullName" @bind:event="oninput"
                               style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;box-sizing:border-box;" />
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px;">Mobile / WhatsApp *</label>
                        <input type="tel" required placeholder="e.g. 9876543210" @bind="_newLeadForm.Phone" @bind:event="oninput"
                               style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;box-sizing:border-box;" />
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px;">Enquiry Source</label>
                        <select @bind="_newLeadForm.Source" style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;box-sizing:border-box;background:#fff;">
                            <option value="manual">Direct Phone Call</option>
                            <option value="whatsapp">Direct WhatsApp</option>
                            <option value="website">Referral / Organic</option>
                            <option value="instagram">Instagram Direct</option>
                            <option value="facebook">Facebook Direct</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px;">Product Interest</label>
                        <input type="text" placeholder="e.g. STAMIX Vitality Mix" @bind="_newLeadForm.ProductInterest" @bind:event="oninput"
                               style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;box-sizing:border-box;" />
                    </div>
                </div>

                @if (Everyone)
                {
                    <div>
                        <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px;">Assign Lead To</label>
                        <select @bind="_newLeadForm.AssignedToEmployeeId" style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;box-sizing:border-box;background:#fff;">
                            <option value="@((long?)null)">Assign to Me (@(string.IsNullOrWhiteSpace(AdminAuth.Name) ? "Current User" : AdminAuth.Name))</option>
                            @foreach (var t in _team)
                            {
                                <option value="@t.Id">@t.Name (@t.Role)</option>
                            }
                        </select>
                    </div>
                }

                <div>
                    <label style="display:block;font-size:12px;font-weight:600;color:#334155;margin-bottom:5px;">Initial Notes / Customer Query</label>
                    <textarea rows="2" placeholder="e.g. Called asking about dosage, pricing and delivery time..." @bind="_newLeadForm.Notes" @bind:event="oninput"
                              style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;box-sizing:border-box;resize:vertical;"></textarea>
                </div>

                <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px;">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin:0 0 6px;font-size:13px;font-weight:600;color:#166534;">
                        <input type="checkbox" @bind="_newLeadForm.SendWhatsAppPush" style="accent-color:#16a34a;width:16px;height:16px;cursor:pointer;" />
                        <span>Send WhatsApp Introduction Message Immediately 🌿</span>
                    </label>
                    <p style="margin:0 0 6px 24px;font-size:11px;color:#15803d;">
                        Pushes a welcome greeting to the customer's WhatsApp so they enter your WhatsApp flow and can chat directly with your team.
                    </p>
                    @if (_newLeadForm.SendWhatsAppPush)
                    {
                        <div style="margin-left:24px;background:#fff;border:1px solid #86efac;border-radius:8px;padding:8px 12px;font-size:12px;color:#14532d;line-height:1.4;">
                            <em>"Hello @(string.IsNullOrWhiteSpace(_newLeadForm.FullName) ? "{CustomerName}" : _newLeadForm.FullName.Trim())! 🌿 Thank you for reaching out to Nura Herbex regarding @(string.IsNullOrWhiteSpace(_newLeadForm.ProductInterest) ? "our herbal wellness products" : _newLeadForm.ProductInterest.Trim()). Our wellness advisor is here to help you. How can we assist you today?"</em>
                        </div>
                    }
                </div>

                <div style="display:flex;align-items:center;justify-content:flex-end;gap:12px;margin-top:4px;padding-top:12px;border-top:1px solid #e2e8f0;">
                    <button type="button" @onclick="CloseNewLeadModal" disabled="@_newLeadSaving"
                            style="padding:8px 16px;border-radius:8px;border:1px solid #cbd5e1;background:#fff;color:#475569;font-size:13px;font-weight:600;cursor:pointer;">
                        Cancel
                    </button>
                    <button type="submit" disabled="@_newLeadSaving"
                            style="padding:8px 20px;border-radius:8px;border:none;background:#235b40;color:#fff;font-size:13px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px;box-shadow:0 2px 4px rgba(35,91,64,0.2);">
                        @if (_newLeadSaving)
                        {
                            <Icon Name="RefreshCw" Size="14" Class="animate-spin" />
                            <span>Creating lead…</span>
                        }
                        else
                        {
                            <Icon Name="Check" Size="14" />
                            <span>Save & Push Lead</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private void NewTaskFor(long leadId) => Nav.NavigateTo("/admin/tasks?lead=" + leadId);
    /// <summary>Which panel this is: leads (new and follow-up), interested (hot leads) or care (paid customers).</summary>
    [Parameter] public string Mode { get; set; } = LeadViews.Leads;

    /// <summary>May see and manage everyone's people in this panel, not just their own.</summary>
    private bool Everyone => Mode == "no_answer" ? (AdminAuth.CanAll("no_answer") || AdminAuth.CanAll("leads")) : AdminAuth.CanAll(Mode);
    private static readonly string[] ViewTabs = [LeadViews.Leads, "transfers", "no_answer", LeadViews.Interested, LeadViews.Care];
    /// <summary>Tabs of the Leads panel: new (today and yesterday), older and still unopened, follow-up, no answer, not interested.</summary>
    private static readonly string[] KpiStatuses = LeadBuckets.All;
    /// <summary>A lead becomes a customer only through a paid order, so "Converted" is not a choice here.</summary>
    private static readonly string[] EditableStatuses = [LeadStatuses.New, LeadStatuses.Interested, LeadStatuses.FollowUp, LeadStatuses.NotInterested];
    private static readonly string[] Palette = ["#235b40", "#2f6f8f", "#7a5aa6", "#b5792a", "#a24b5a", "#3f7d7a", "#5b6f2c"];

    private readonly CancellationTokenSource _cts = new();
    private List<LeadDto> _leads = new();
    private Dictionary<string, int> _counts = new();
    private LeadDetailResponse? _selected;
    private string _statusFilter = "";
    private string _query = "";
    private string _reply = "";
    private string _notes = "";
    private string _tab = "chat";
    private bool _composer;
    private bool _orderDialog;
    private string _assignee = "";
    private int _unassigned;
    private int _pendingTransfersCount;
    private List<EmployeeDto> _team = new();
    private string? _error;
    private string? _toast;
    private bool _loading = true;
    private bool _busy;
    private bool _v2;
    private string? _notice;
    private string _quick = ""; // "", "unread" or "open" (hot leads and customers)
    private Dictionary<string, int> _viewCounts = new();
    private Dictionary<string, int> _viewUnread = new();
    private int _unreadTotal;
    private readonly HashSet<long> _selectedLeadIds = new();
    private long _bulkTargetEmployeeId;
    private string _bulkTransferReason = "";
    private bool _bulkBusy;

    private string _datePreset = ""; // "", "today", "yesterday", "7d", "custom"
    private string? _dateFrom;
    private string? _dateTo;

