        ApiResult res;
        if (!Everyone && target is { } tId)
        {
            res = await Api.AdminLeadTransferAsync(lead.Id, new LeadTransferRequest { EmployeeId = tId, Reason = $"Transferred by {AdminAuth.Name}" });
        }
        else
        {
            res = await Api.AdminLeadAssignAsync(lead.Id, new LeadAssignRequest { EmployeeId = target });
