    private static string Initials(LeadDto l)
    {
        var parts = l.Name.Replace("[Sample]", "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0 || char.IsDigit(parts[0][0])) return "#";
        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string AvatarColor(LeadDto l) => Palette[(int)(l.Id % Palette.Length)];

    private static string ListTime(DateTime utc)
    {
        var local = utc.ToLocalTime();
        var today = DateTime.Now.Date;
        return local.Date == today ? local.ToString("hh:mm tt")
            : local.Date == today.AddDays(-1) ? "Yesterday"
            : local.ToString("dd MMM");
    }

    private static string DayLabel(DateTime day)
    {
        var today = DateTime.Now.Date;
        return day == today ? "Today" : day == today.AddDays(-1) ? "Yesterday" : day.ToString("dd MMMM yyyy");
    }

    /// <summary>Photo, sticker, video, voice note or document the customer sent. Shows a plain note if the file can no longer be fetched.</summary>
    private RenderFragment MediaView(WhatsAppMessageDto m) => builder =>
    {
        var url = m.MediaUrl is null ? null : Api.Url(m.MediaUrl);
        var label = m.Type switch { "image" => "photo", "sticker" => "sticker", "video" => "video", "audio" => "voice message", _ => "document" };
        if (url is null)
        {
            builder.AddMarkupContent(0, $"<span class=\"ld-nomedia\">{(m.Type == "sticker" ? "Sticker" : "A " + label)} was sent, but the file is not available.</span>");
            return;
        }
        var safeUrl = System.Net.WebUtility.HtmlEncode(url);
        var fallback = $"<span class=\"ld-nomedia\" hidden>The {label} could not be loaded. Ask the customer to send it again.</span>";
        switch (m.Type)
        {
            case "image":
                builder.AddMarkupContent(1, $"<a href=\"{safeUrl}\" target=\"_blank\" rel=\"noopener\"><img class=\"ld-media\" loading=\"lazy\" alt=\"Photo from the customer\" src=\"{safeUrl}\" onerror=\"this.hidden=true;this.parentElement.nextElementSibling.hidden=false\" /></a>{fallback}");
                break;
            case "sticker":
                builder.AddMarkupContent(1, $"<img class=\"ld-sticker\" loading=\"lazy\" alt=\"Sticker from the customer\" src=\"{safeUrl}\" onerror=\"this.hidden=true;this.nextElementSibling.hidden=false\" />{fallback}");
                break;
            case "video":
                builder.AddMarkupContent(1, $"<video class=\"ld-media\" controls preload=\"metadata\" src=\"{safeUrl}\" onerror=\"this.hidden=true;this.nextElementSibling.hidden=false\"></video>{fallback}");
                break;
            case "audio":
                builder.AddMarkupContent(1, $"<audio class=\"ld-audio\" controls preload=\"none\" src=\"{safeUrl}\" onerror=\"this.hidden=true;this.nextElementSibling.hidden=false\"></audio>{fallback}");
                break;
            default:
                var name = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(m.MediaName) ? "Document" : m.MediaName);
                builder.AddMarkupContent(1, $"<a class=\"ld-doc\" href=\"{safeUrl}\" target=\"_blank\" rel=\"noopener\"><span>📄</span><strong>{name}</strong><small>Open</small></a>");
                break;
        }
    };

    /// <summary>Message text with web links (such as a shared location) made clickable. Everything else is plain text.</summary>
    private static RenderFragment LinkedText(string text) => builder =>
    {
        var parts = System.Text.RegularExpressions.Regex.Split(text, @"(https?://\S+)");
        var seq = 0;
        foreach (var p in parts)
        {
            if (p.StartsWith("http://") || p.StartsWith("https://"))
            {
                builder.OpenElement(seq++, "a");
                builder.AddAttribute(seq++, "href", p);
                builder.AddAttribute(seq++, "target", "_blank");
                builder.AddAttribute(seq++, "rel", "noopener");
                builder.AddContent(seq++, p);
                builder.CloseElement();
            }
            else builder.AddContent(seq++, p);
        }
    };

    private static RenderFragment Ticks(string status) => builder =>
    {
        var read = status == "read";
        var double_ = status is "delivered" or "read";
        builder.AddMarkupContent(0, $"<svg class=\"ld-tick{(read ? " read" : "")}\" width=\"16\" height=\"11\" viewBox=\"0 0 16 11\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-label=\"{status}\"><path d=\"M1 5.8 4.2 9 10.5 1.8\"/>{(double_ ? "<path d=\"M6 8.6 6.6 9.2 13 1.8\"/>" : "")}</svg>");
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
