@inject ApiClient Api

@* Sell to a lead: pick products, confirm the delivery address, choose how it is paid. Creates a normal store order. *@
<div class="fu-modal-backdrop" @onclick="OnClose">
    <div class="fu-modal lo" role="dialog" aria-modal="true" aria-label="Create an order" @onclick:stopPropagation="true">
        <header>
            <h3>Create an order for @LeadName</h3>
            <button type="button" class="em-x" aria-label="Close" @onclick="OnClose"><Icon Name="X" Size="16" /></button>
        </header>

        <div class="fu-form">
            <div class="fu-step"><span>1</span> What are they buying?</div>
            @if (_products is null)
            {
                <p class="fu-hint">Loading products…</p>
            }
            else
            {
                <div class="lo-products">
                    @foreach (var p in _products)
                    {
                        var prod = p;
                        <div class="@($"lo-product {(Qty(prod.Id) > 0 ? "is-picked" : "")}")">
                            <div><strong>@prod.Name</strong><small>₹@AdminFmt.Inr(prod.Price)@(prod.StockQuantity <= 0 ? " · out of stock" : prod.StockQuantity < 10 ? $" · only {prod.StockQuantity} left" : "")</small></div>
                            <div class="lo-qty" role="group" aria-label="@($"Quantity of {prod.Name}")">
                                <button type="button" aria-label="Less" disabled="@(Qty(prod.Id) == 0)" @onclick="() => Change(prod.Id, -1)">−</button>
                                <span>@Qty(prod.Id)</span>
                                <button type="button" aria-label="More" disabled="@(prod.StockQuantity <= Qty(prod.Id))" @onclick="() => Change(prod.Id, 1)">+</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="lo-coupon">
                    <input type="text" class="fu-input" placeholder="Coupon code (optional)" maxlength="40" @bind="_coupon" @bind:event="oninput" @bind:after="PriceAsync" />
                </div>

                @if (_totals is not null && _lines.Count > 0)
                {
                    <dl class="lo-totals">
                        <dt>Items</dt><dd>₹@AdminFmt.Inr(_totals.Subtotal)</dd>
                        @if (_totals.DiscountAmount > 0) { <dt>Discount @(_totals.CouponCode)</dt><dd>− ₹@AdminFmt.Inr(_totals.DiscountAmount)</dd> }
                        <dt>Delivery</dt><dd>@(_totals.ShippingFee == 0 ? "Free" : "₹" + AdminFmt.Inr(_totals.ShippingFee))</dd>
                        <dt class="grand">Total</dt><dd class="grand">₹@AdminFmt.Inr(_totals.FinalTotal)</dd>
                    </dl>
                }
                else if (!string.IsNullOrEmpty(_priceError)) { <div class="fu-flash bad" role="alert">@_priceError</div> }
            }

            <div class="fu-step"><span>2</span> Where should it go?</div>
            <div class="lo-grid">
                @Field("name", "Name", null, "text", 200, null, _name, v => _name = v)
                @Field("email", "Email", "(optional)", "email", 200, "name@example.com", _email, v => _email = v)
                @if (_needsPhone)
                {
                    @Field("phone", "Phone", "(required)", "tel", 20, "10-digit mobile number", _phone, v => _phone = v, true)
                }
                @Field("address", "Address", null, "text", 200, "House / street", _a.AddressLine1, v => _a.AddressLine1 = v, true)
                @Field("area", "Area", "(optional)", "text", 200, null, _a.AddressLine2 ?? "", v => _a.AddressLine2 = v, true)
                @Field("city", "City", null, "text", 100, null, _a.City, v => _a.City = v)
                @Field("state", "State", null, "text", 100, null, _a.State, v => _a.State = v)
                @Field("pincode", "Pincode", "(6 digits)", "text", 6, null, _a.Pincode, v => _a.Pincode = v)
            </div>

            <div class="fu-step"><span>3</span> How is it paid?</div>
            <div class="fu-types two">
                <button type="button" class="@($"fu-type {(!_paid ? "is-picked" : "")}")" @onclick="() => _paid = false">Cash on delivery</button>
                <button type="button" class="@($"fu-type {(_paid ? "is-picked" : "")}")" @onclick="() => _paid = true">Already paid (UPI / bank)</button>
            </div>
            @if (_paid)
            {
                <input type="text" class="fu-input" maxlength="80" placeholder="Payment reference, e.g. UPI transaction id" aria-invalid="@(_errors.ContainsKey("ref") ? "true" : "false")" @bind="_ref" @bind:event="oninput" @bind:after="ClearRefError" />
                @if (_errors.TryGetValue("ref", out var refErr)) { <em class="lo-err">@refErr</em> }
                <p class="fu-hint"><Icon Name="Info" Size="12" /> Only choose this once the money is in your account. The order is marked paid and goes straight to shipping.</p>
            }
            else
            {
                <p class="fu-hint"><Icon Name="Info" Size="12" /> The customer pays the courier on delivery.</p>
            }

        </div>

        @if (!string.IsNullOrEmpty(_error)) { <div class="fu-flash bad lo-error" role="alert"><Icon Name="AlertCircle" Size="14" /> @_error</div> }

        <footer>
            <button type="button" class="ld-btn" @onclick="OnClose">Cancel</button>
            <button type="button" class="ld-btn primary" disabled="@(_busy || _lines.Count == 0)" @onclick="SaveAsync">@(_busy ? "Creating…" : _totals is null ? "Create order" : $"Create order · ₹{AdminFmt.Inr(_totals.FinalTotal)}")</button>
        </footer>
    </div>
</div>

@code {
    private readonly Dictionary<string, string> _errors = new();
    private void ClearRefError() => _errors.Remove("ref");

    private RenderFragment Field(string key, string label, string? hint, string type, int max, string? placeholder, string value, Action<string> set, bool wide = false) => b =>
    {
        var err = _errors.GetValueOrDefault(key);
        b.OpenElement(0, "label"); b.AddAttribute(1, "class", $"fu-field{(wide ? " wide" : "")}{(err is null ? "" : " has-error")}");
        b.OpenElement(2, "span"); b.AddAttribute(3, "class", "lo-lbl"); b.AddContent(4, label);
        if (hint is not null) { b.OpenElement(5, "small"); b.AddContent(6, hint); b.CloseElement(); }
        b.CloseElement();
        b.OpenElement(7, "input"); b.AddAttribute(8, "type", type); b.AddAttribute(9, "maxlength", max);
        if (placeholder is not null) b.AddAttribute(10, "placeholder", placeholder);
        if (key == "pincode") b.AddAttribute(11, "inputmode", "numeric");
        else if (key == "phone") b.AddAttribute(11, "inputmode", "tel");
        b.AddAttribute(12, "aria-invalid", err is null ? "false" : "true");
        b.AddAttribute(13, "value", value);
        b.AddAttribute(14, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => { set(e.Value?.ToString() ?? ""); _errors.Remove(key); }));
        b.CloseElement();
        if (err is not null) { b.OpenElement(15, "em"); b.AddAttribute(16, "class", "lo-err"); b.AddContent(17, err); b.CloseElement(); }
        b.CloseElement();
    };

    private static string Digits(string? s) => new((s ?? "").Where(char.IsDigit).ToArray());

    private bool Validate()
    {
        _errors.Clear();
        if (_lines.Count == 0) { _error = "Choose at least one product."; return false; }
        if (string.IsNullOrWhiteSpace(_name)) _errors["name"] = "Enter the customer's name.";
        if (!string.IsNullOrWhiteSpace(_email) && !System.Text.RegularExpressions.Regex.IsMatch(_email.Trim(), @"^[^\s@]+@[^\s@]+\.[^\s@]+$")) _errors["email"] = "Enter a valid email, like name@example.com.";
        if (_needsPhone && Digits(_phone).Length is < 10 or > 15) _errors["phone"] = "Enter a valid phone number (10–15 digits).";
        if (string.IsNullOrWhiteSpace(_a.AddressLine1)) _errors["address"] = "Enter the house / street address.";
        if (string.IsNullOrWhiteSpace(_a.City)) _errors["city"] = "Enter the city.";
        if (string.IsNullOrWhiteSpace(_a.State)) _errors["state"] = "Enter the state.";
        if (!System.Text.RegularExpressions.Regex.IsMatch((_a.Pincode ?? "").Trim(), @"^[1-9][0-9]{5}$")) _errors["pincode"] = "Enter a valid 6-digit pincode.";
        if (_paid && string.IsNullOrWhiteSpace(_ref)) _errors["ref"] = "Enter the payment reference.";
        _error = _errors.Count > 0 ? "Please fix the highlighted fields." : null;
        return _errors.Count == 0;
    }

    [Parameter] public long? LeadId { get; set; }
    [Parameter] public string? CustomerId { get; set; }
    [Parameter] public string LeadName { get; set; } = "";
    [Parameter] public string? LeadEmail { get; set; }
    [Parameter] public string? CustomerPhone { get; set; }
    [Parameter] public AddressDto? InitialAddress { get; set; }
    [Parameter] public EventCallback<string?> OnCreated { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsCustomerMode => !string.IsNullOrWhiteSpace(CustomerId);
    private List<ProductDto>? _products;
    private readonly Dictionary<string, int> _lines = new();
    private OrderTotalsDto? _totals;
    private readonly AddressDto _a = new();
    private string _name = "", _email = "", _phone = "", _coupon = "", _ref = "";
    private string? _error, _priceError;
    private bool _paid, _busy, _needsPhone;

    protected override async Task OnInitializedAsync()
    {
        _name = LeadName;
        _email = LeadEmail ?? "";
        _phone = CustomerPhone ?? "";
        _needsPhone = IsCustomerMode && Digits(_phone).Length < 10;
        if (InitialAddress is { } init)
        {
            _a.AddressLine1 = init.AddressLine1 ?? "";
            _a.AddressLine2 = init.AddressLine2 ?? "";
            _a.City = init.City ?? "";
            _a.State = init.State ?? "";
            _a.Pincode = init.Pincode ?? "";
            _a.Country = string.IsNullOrWhiteSpace(init.Country) ? "India" : init.Country;
        }
        _products = await Api.GetProductsAsync();
    }

    private int Qty(string id) => _lines.GetValueOrDefault(id);

    private async Task Change(string id, int delta)
    {
        var q = Math.Clamp(Qty(id) + delta, 0, 20);
        if (q == 0) _lines.Remove(id); else _lines[id] = q;
        await PriceAsync();
    }

    private async Task PriceAsync()
    {
        _priceError = null;
        if (_lines.Count == 0) { _totals = null; return; }
        var res = await Api.ValidateCartAsync(new ValidateCartRequest
        {
            Items = _lines.Select(kv => new CartLineDto { Id = kv.Key, Quantity = kv.Value }).ToList(),
            CouponCode = string.IsNullOrWhiteSpace(_coupon) ? null : _coupon.Trim(),
        });
        if (res.Success || res.Items.Count > 0) _totals = res;
        else { _totals = null; _priceError = res.Message ?? "Could not price this basket."; }
    }

    private async Task SaveAsync()
    {
        if (!Validate()) return;
        _error = null; _busy = true;
        var req = new LeadOrderRequest
        {
            Items = _lines.Select(kv => new LeadOrderLineRequest { ProductId = kv.Key, Quantity = kv.Value }).ToList(),
            CouponCode = string.IsNullOrWhiteSpace(_coupon) ? null : _coupon.Trim(),
            CustomerName = _name,
            Email = _email,
            Phone = IsCustomerMode && !string.IsNullOrWhiteSpace(_phone) ? _phone : null,
            Address = _a,
            AlreadyPaid = _paid,
            PaymentReference = _paid ? _ref : null,
        };
        LeadOrderResponse res;
        if (IsCustomerMode)
            res = await Api.AdminCustomerOrderAsync(CustomerId!, req);
        else if (LeadId is { } lid)
            res = await Api.AdminLeadOrderAsync(lid, req);
        else
            res = new LeadOrderResponse { Success = false, Message = "No lead or customer selected." };
        _busy = false;
        if (res.Success) await OnCreated.InvokeAsync(res.Message);
        else _error = res.Message ?? "Could not create the order.";
    }
}
