@inject ApiClient Api
@inject AdminSession AdminAuth

<div class="ld em">

    <div class="em-head">
        <div>
            <h3>People</h3>
            <p>Each employee signs in at <strong>/admin</strong> with their own email and password. What each person can open is decided by their <strong>designation</strong> (see Designations &amp; rights).</p>
        </div>
        <div class="em-head-actions">
            <ExportButton Title="Employees" FileName="nura-employees" Columns="@(new[] { "Name", "Email", "Phone", "Role", "Designation", "Department", "Status", "Open leads", "Open tasks", "Last sign-in", "Created" })" Rows="ExportRows" Disabled="@(_employees.Count == 0)" />
            <label class="em-switch" title="When on, every new lead goes to the next active sales executive in turn.">
                <input type="checkbox" checked="@_autoAssign" disabled="@_busy" @onchange="OnAutoAssignChanged" />
                <span class="em-track"><span class="em-knob"></span></span>
                <span class="em-switch-label">Auto-assign new leads</span>
            </label>
            <button type="button" class="ld-btn primary" @onclick="StartCreate"><Icon Name="Plus" Size="14" /> Add employee</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="@($"em-note {(_messageOk ? "ok" : "bad")}")" role="status">
            <Icon Name="@(_messageOk ? "CheckCircle2" : "AlertCircle")" Size="15" /><span>@_message</span>
            <button type="button" class="em-x" aria-label="Dismiss" @onclick="() => _message = null"><Icon Name="X" Size="14" /></button>
        </div>
    }


    @if (_form is not null)
    {
        <form class="ld-card em-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h4>@(_editingId is null ? "New employee" : "Edit employee")</h4>
            <div class="em-grid">
                <label>Full name<input type="text" required maxlength="200" @bind="_form.Name" @bind:event="oninput" placeholder="e.g. Priya Raman" /></label>
                <label>Work email (login)<input type="email" required maxlength="200" @bind="_form.Email" @bind:event="oninput" placeholder="name@nuraherbex.com" autocomplete="off" /></label>
                <label>Phone<input type="tel" maxlength="32" @bind="_form.Phone" @bind:event="oninput" placeholder="+91 98765 43210" /></label>
                <label>Designation <small class="em-hint">decides which pages they can open</small>
                    <select @bind="_form.DesignationId">
                        <option value="@((long?)null)">No designation (basic sales access)</option>
                        @foreach (var d in _designations.Where(x => x.IsActive || x.Id == _form.DesignationId)) { <option value="@d.Id">@d.Name@(d.DepartmentName is { } dn ? " · " + dn : "")</option> }
                    </select>
                </label>
                <label>Department
                    <select @bind="_form.DepartmentId">
                        <option value="@((long?)null)">No department</option>
                        @foreach (var d in _departments.Where(x => x.IsActive || x.Id == _form.DepartmentId)) { <option value="@d.Id">@d.Name</option> }
                    </select>
                </label>
                @if (AdminAuth.IsAdmin)
                {
                    <label>Account type
                        <select @bind="_form.Role">
                            <option value="sales">Staff — pages come from the designation</option>
                            <option value="admin">Administrator — every page</option>
                        </select>
                    </label>
                }
                <label>@(_editingId is null ? "Password" : "New password")
                    <input type="password" minlength="8" required="@(_editingId is null)" @bind="_form.Password" @bind:event="oninput" autocomplete="new-password"
                           placeholder="@(_editingId is null ? "At least 8 characters" : "Leave empty to keep the current one")" />
                </label>
                <label class="em-check">
                    <input type="checkbox" @bind="_form.IsActive" /> <span>Active (can sign in and receive leads)</span>
                </label>
            </div>
            <div class="ld-actions">
                <button type="button" class="ld-btn" @onclick="Cancel">Cancel</button>
                <button type="submit" class="ld-btn primary" disabled="@_busy">@(_busy ? "Saving…" : _editingId is null ? "Create employee" : "Save changes")</button>
            </div>
        </form>
    }

    <div class="ld-card em-table-card">
        <div class="em-scroll">
            <table class="em-table">
                <thead>
                    <tr><th class="sn">S.No</th><th>Employee</th><th>Designation</th><th>Department</th><th>Status</th><th class="num">Open leads</th><th class="num">Open tasks</th><th>WhatsApp</th><th>Last sign-in</th><th></th></tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="10" class="em-empty">Loading team…</td></tr>
                    }
                    else if (_employees.Count == 0)
                    {
                        <tr><td colspan="10" class="em-empty"><strong>No employees yet</strong>Add your first sales executive so new leads can be assigned and followed up.</td></tr>
                    }
                    @{ var sn = (_page - 1) * _size; }
                    @foreach (var e in _employees.Skip((_page - 1) * _size).Take(_size))
                    {
                        var emp = e;
                        <tr @key="emp.Id" class="@(emp.IsActive ? "" : "is-off")">
                            <td class="sn">@(++sn)</td>
                            <td>
                                <div class="em-person">
                                    <span class="ld-avatar" style="background:@Palette[(int)(emp.Id % Palette.Length)]">@emp.Name[..1].ToUpperInvariant()</span>
                                    <span><strong>@emp.Name</strong><small>@emp.Email@(string.IsNullOrEmpty(emp.Phone) ? "" : " · " + emp.Phone)</small></span>
                                </div>
                            </td>
                            <td><span class="@($"ld-pill {(emp.Role == "admin" ? "interested" : "new")}")">@(emp.Role == "admin" ? (emp.DesignationName ?? "Administrator") : (emp.DesignationName ?? "No designation"))</span></td><td>@(emp.DepartmentName ?? "—")</td>
                            <td><span class="@($"ld-pill {(emp.IsActive ? "converted" : "not-interested")}")">@(emp.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="num">@emp.OpenLeads</td>
                            <td class="num">@emp.OpenTasks</td>
                            <td>
                                @if (emp.IsActive && emp.Role == "sales")
                                {
                                    <button type="button" class="@($"wa-toggle {(emp.WhatsAppActive ? "is-on" : "")}")" role="switch" aria-checked="@emp.WhatsAppActive" disabled="@(_waBusy == emp.Id)"
                                            title="@(emp.WhatsAppActive ? "Receives new WhatsApp leads. Click to switch off and move their pending leads." : emp.IsOnline ? "Click to let this person receive new WhatsApp leads." : "Not signed in: they can switch it on after signing in.")" @onclick="() => ToggleWhatsAppAsync(emp)">
                                        <span class="wa-toggle-track"><i></i></span><span class="wa-toggle-label">@(emp.WhatsAppActive ? "Active" : "Off")</span>
                                    </button>
                                }
                                else { <span class="fu-hint">â€”</span> }
                            </td>
                            <td><i class="@($"tk-dot {(emp.IsOnline ? "on" : "")}")"></i>@(emp.IsOnline ? "Online · " : "")@(emp.LastLoginAt is { } t ? AdminFmt.DateTimeShort(t) : "Never")</td>
                            <td class="em-actions">
                                @if (AdminAuth.IsAdmin || emp.Role != "admin") { <button type="button" class="ld-btn" @onclick="() => StartEdit(emp)">Edit</button> }
                                @if (emp.IsActive && (AdminAuth.IsAdmin || emp.Role != "admin") && emp.Id != AdminAuth.EmployeeId)
                                {
                                    <button type="button" class="ld-btn danger-outline" title="Deactivate this login and hand over their leads and follow-ups" @onclick="() => OpenRemoveAsync(emp)">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    <Pager Total="@_employees.Count" @bind-Page="_page" @bind-PageSize="_size" Label="employees" />
    </div>
    <AdminReplyAssistantCard />

    @if (_removing is { } rm)
    {
        var holds = _preview is { } pv && (pv.OpenLeads + pv.Customers + pv.PendingFollowUps) > 0;
        <div class="fu-modal-backdrop" @onclick="CloseRemove">
            <div class="fu-modal" role="dialog" aria-modal="true" aria-label="Hand over work" @onclick:stopPropagation="true">
                <header>
                    <h3>Remove @rm.Name</h3>
                    <button type="button" class="em-x" aria-label="Close" @onclick="CloseRemove"><Icon Name="X" Size="16" /></button>
                </header>
                <div class="fu-form">
                    @if (_preview is null)
                    {
                        <p class="fu-hint">Checking what @rm.Name is holding…</p>
                    }
                    else if (!holds)
                    {
                        <p>@rm.Name has no open leads, customers or follow-ups. Their login will be switched off; their history stays.</p>
                    }
                    else
                    {
                        <p><strong>@rm.Name</strong> holds <strong>@_preview.OpenLeads</strong> open lead(s), <strong>@_preview.Customers</strong> customer(s) and <strong>@_preview.PendingFollowUps</strong> pending follow-up(s). Who should get them? Each follow-up goes with its lead.</p>

                        <label class="em-check"><input type="radio" name="handover" checked="@(_mode == "equal")" @onchange='() => _mode = "equal"' disabled="@(_preview.Candidates.Count == 0)" />
                            <span><strong>Split equally</strong> across @_preview.Candidates.Count active team member(s): each lead goes to whoever holds the fewest, so everyone ends up level.</span></label>
                        <label class="em-check"><input type="radio" name="handover" checked="@(_mode == "person")" @onchange='() => _mode = "person"' disabled="@(_preview.Candidates.Count == 0)" />
                            <span><strong>One specific person</strong> takes everything</span></label>
                        @if (_mode == "person")
                        {
                            <select class="fu-input" @bind="_target" aria-label="Person who takes over">
                                <option value="">Choose a person…</option>
                                @foreach (var c in _preview.Candidates) { <option value="@c.Id">@c.Name · @c.OpenLeads lead(s), @c.PendingFollowUps follow-up(s)@(c.IsOnline ? " · online" : "")</option> }
                            </select>
                        }
                        <label class="em-check"><input type="radio" name="handover" checked="@(_mode == "unassigned")" @onchange='() => _mode = "unassigned"' />
                            <span><strong>Admin queue</strong>: leave them unassigned for now</span></label>

                        @if (_mode == "equal" && _preview.Candidates.Count > 0)
                        {
                            <ul class="fu-hint" style="margin:6px 0 0 18px">
                                @foreach (var c in _preview.Candidates) { <li>@c.Name currently has @c.OpenLeads open lead(s)</li> }
                            </ul>
                        }
                    }
                </div>
                <div class="ld-actions">
                    <button type="button" class="ld-btn" @onclick="CloseRemove">Keep @rm.Name</button>
                    <button type="button" class="ld-btn danger" disabled="@(_busy || _preview is null || (holds && _mode == "person" && string.IsNullOrEmpty(_target)))" @onclick="ConfirmRemoveAsync">@(_busy ? "Removing…" : "Remove")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int _page = 1, _size = 10;
    private IEnumerable<IReadOnlyList<string>> ExportRows() => _employees.Select(e => (IReadOnlyList<string>)new[] { e.Name, e.Email, e.Phone, e.Role, e.DesignationName ?? "", e.DepartmentName ?? "", e.IsActive ? "Active" : "Inactive", e.OpenLeads.ToString(), e.OpenTasks.ToString(), e.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never", e.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd") });

    private static readonly string[] Palette = ["#235b40", "#2f6f8f", "#7a5aa6", "#b5792a", "#a24b5a", "#3f7d7a", "#5b6f2c"];

    private List<EmployeeDto> _employees = new();
    private List<DepartmentDto> _departments = new();
    private List<DesignationDto> _designations = new();
    private EmployeeSaveRequest? _form;
    private long? _editingId;
    private long? _removingId;
    private long? _waBusy;

    /// <summary>Switches a person's WhatsApp lead intake. Switching off moves their not-yet-started leads to other active people.</summary>
    private async Task ToggleWhatsAppAsync(EmployeeDto emp)
    {
        _waBusy = emp.Id;
        var res = await Api.AdminSetEmployeeWhatsAppAsync(emp.Id, !emp.WhatsAppActive);
        Say(res.Message, res.Success);
        await LoadAsync();
        _waBusy = null;
    }
    private bool _autoAssign = true;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private bool _messageOk;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var (dr, gr) = (await Api.AdminDepartmentsAsync(), await Api.AdminDesignationsAsync());
        if (dr.Success) _departments = dr.Departments;
        if (gr.Success) _designations = gr.Designations;
        var res = await Api.AdminEmployeesAsync();
        if (res.Success) { _employees = res.Employees; _autoAssign = res.AutoAssign; }
        else Say(res.Message ?? "Could not load the team.", false);
        _loading = false;
    }

    private void Say(string? text, bool ok) { _message = text; _messageOk = ok; }

    private void StartCreate() { _editingId = null; _removingId = null; _form = new EmployeeSaveRequest { Role = EmployeeRoles.Sales, IsActive = true }; }

    private void StartEdit(EmployeeDto e)
    {
        _editingId = e.Id; _removingId = null;
        _form = new EmployeeSaveRequest { Name = e.Name, Email = e.Email, Phone = e.Phone, Role = e.Role, IsActive = e.IsActive, DepartmentId = e.DepartmentId, DesignationId = e.DesignationId };
    }

    private void Cancel() { _form = null; _editingId = null; }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        _busy = true;
        var res = _editingId is { } id ? await Api.AdminUpdateEmployeeAsync(id, _form) : await Api.AdminCreateEmployeeAsync(_form);
        Say(res.Message, res.Success);
        if (res.Success) { _form = null; _editingId = null; await LoadAsync(); }
        _busy = false;
    }

    private EmployeeDto? _removing;
    private HandoverPreviewResponse? _preview;
    private string _mode = "equal", _target = "";

    /// <summary>Opens the popup: shows what the person holds and asks who should get their leads and follow-ups.</summary>
    private async Task OpenRemoveAsync(EmployeeDto e)
    {
        _removing = e; _preview = null; _mode = "equal"; _target = ""; _form = null;
        var res = await Api.AdminHandoverPreviewAsync(e.Id);
        if (_removing?.Id != e.Id) return;
        if (!res.Success) { Say(res.Message ?? "Could not check this person's work.", false); _removing = null; return; }
        _preview = res;
        if (res.Candidates.Count == 0) _mode = "unassigned"; // nobody to hand it to
    }

    private void CloseRemove() { _removing = null; _preview = null; }

    private async Task ConfirmRemoveAsync()
    {
        if (_removing is not { } e) return;
        var holds = _preview is { } pv && (pv.OpenLeads + pv.Customers + pv.PendingFollowUps) > 0;
        var choice = !holds ? "unassigned" : _mode == "person" ? _target : _mode;
        if (string.IsNullOrEmpty(choice)) return;
        _busy = true;
        var res = await Api.AdminRemoveEmployeeAsync(e.Id, choice);
        Say(res.Message, res.Success);
        if (res.Success) { CloseRemove(); await LoadAsync(); }
        _busy = false;
    }

    private async Task OnAutoAssignChanged(ChangeEventArgs e)
    {
        var on = e.Value is true;
        _busy = true;
        var res = await Api.AdminLeadSettingsAsync(on);
        if (res.Success) _autoAssign = on;
        Say(res.Message, res.Success);
        _busy = false;
    }
}
