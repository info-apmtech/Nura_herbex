@using System.Globalization
@inject ApiClient Api
@inject AdminSession AdminAuth
@inject NavigationManager Nav

<div class="ld sd">
    <header class="sd-head">
        <div>
            <span class="sd-eyebrow">@(AdminAuth.CanAll("crm") ? "Sales performance" : "My performance")</span>
            <h3>Sales dashboard</h3>
            <p>@(AdminAuth.CanAll("crm") ? "How leads turn into customers, how fast the team replies, and what needs a person right now." : "Your leads, your replies and your sales.")</p>
        </div>
        <div class="sd-period" role="group" aria-label="Period">
            @foreach (var d in new[] { 7, 30, 90 })
            {
                var days = d;
                <button type="button" class="@(_days == days ? "is-on" : "")" aria-pressed="@(_days == days)" @onclick="() => LoadAsync(days)">@(days)D</button>
            }
            @if (_r is not null) { <span class="sd-range">@_r.From.ToLocalTime().ToString("d MMM", CultureInfo.InvariantCulture) – @DateTime.Now.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span> }
        </div>
    </header>

    @if (_r is null)
    {
        <div class="ld-card ld-empty">@(_error ?? "Loading dashboard…")</div>
    }
    else
    {
        @* Headline numbers *@
        <section class="sd-kpis" aria-label="Headline numbers">
            <article class="sd-kpi">
                <span class="sd-kpi-ico blue"><Icon Name="Users" Size="18" /></span>
                <div><span>New leads</span><strong>@_r.NewLeads.ToString("N0")</strong><small>@_r.ConvertedLeads.ToString("N0") became customers</small></div>
            </article>
            <article class="sd-kpi">
                <span class="sd-kpi-ico green"><Icon Name="TrendingUp" Size="18" /></span>
                <div><span>Conversion rate</span><strong>@_r.ConversionRate%</strong><div class="sd-meter"><i style="width:@_r.ConversionRate%"></i></div></div>
            </article>
            <article class="sd-kpi">
                <span class="sd-kpi-ico gold"><Icon Name="ShoppingBag" Size="18" /></span>
                <div><span>Sales from leads</span><strong>₹@AdminFmt.Inr(_r.Revenue)</strong><small>@_r.Orders order@(_r.Orders == 1 ? "" : "s")@(_r.Orders > 0 ? $" · average ₹{AdminFmt.Inr(_r.AverageOrderValue)}" : "")</small></div>
            </article>
            <article class="@($"sd-kpi {(_r.AwaitingFirstReply > 0 ? "alert" : "")}")">
                <span class="sd-kpi-ico @(_r.AwaitingFirstReply > 0 ? "red" : "violet")"><Icon Name="Clock" Size="18" /></span>
                <div><span>Median first reply</span><strong>@(_r.MedianFirstReplyMinutes is { } m ? Mins(m) : "—")</strong><small>@_r.RepliedWithinHourPercent% answered within an hour@(_r.AwaitingFirstReply > 0 ? $" · {_r.AwaitingFirstReply} waiting over an hour" : "")</small></div>
            </article>
        </section>

        @* Work in progress *@
        <section class="sd-tiles" aria-label="Work in progress">
            <div class="sd-tile"><b>@_r.OpenLeads.ToString("N0")</b><span>Open leads</span><small>still being worked</small></div>
            @if (AdminAuth.CanAll("crm"))
            {
                <div class="@($"sd-tile {(_r.Unassigned > 0 ? "warn" : "")}")"><b>@_r.Unassigned.ToString("N0")</b><span>Unassigned</span><small>nobody owns these yet</small></div>
            }
            <button type="button" class="@($"sd-tile sd-link {(_r.FollowUpsOverdue > 0 ? "bad" : "")}")" @onclick='() => Nav.NavigateTo("/admin/followups")'><b>@_r.FollowUpsOverdue.ToString("N0")</b><span>Follow-ups overdue</span><small>open follow-ups →</small></button>
            <button type="button" class="sd-tile sd-link" @onclick='() => Nav.NavigateTo("/admin/followups")'><b>@_r.FollowUpsToday.ToString("N0")</b><span>Due today</span><small>calls and messages to do</small></button>
        </section>

        @if (_r.NeedsAttention.Count > 0)
        {
            <section class="sd-card sd-attn" aria-label="Needs attention">
                <header><h4><Icon Name="AlertCircle" Size="16" /> Needs attention now <span class="sd-count">@_r.NeedsAttention.Count</span></h4></header>
                <ul>
                    @foreach (var a in _r.NeedsAttention)
                    {
                        var row = a;
                        <li>
                            <i class="sd-av">@Initial(row.Name)</i>
                            <div><b>@row.Name</b><small>@(row.Owner is null ? "Unassigned" : row.Owner) · since @FuFmt.Due(row.Since)</small></div>
                            <span class="sd-reason">@row.Reason</span>
                            <button type="button" class="ld-btn" @onclick='() => Nav.NavigateTo("/admin/leads?open=" + row.LeadId)'>Open lead</button>
                        </li>
                    }
                </ul>
            </section>
        }

        <div class="sd-two">
            <section class="sd-card" aria-label="Lead funnel">
                <header><h4>Lead funnel</h4><span>Where this period's leads are now</span></header>
                @{ var max = Math.Max(1, _r.Funnel.Max(f => f.Count)); var total = Math.Max(1, _r.Funnel.Sum(f => f.Count)); }
                <div class="sd-funnel">
                    @foreach (var f in _r.Funnel)
                    {
                        <div class="sd-frow">
                            <span>@StatusLabel(f.Status)</span>
                            <div><i class="@($"s-{f.Status}")" style="width:@((100.0 * f.Count / max).ToString("0.#", CultureInfo.InvariantCulture))%"></i></div>
                            <b>@f.Count.ToString("N0")</b><small>@((100.0 * f.Count / total).ToString("0", CultureInfo.InvariantCulture))%</small>
                        </div>
                    }
                </div>
            </section>

            <section class="sd-card" aria-label="Lead trend">
                <header><h4>Leads per day</h4><span class="sd-legend"><i class="a"></i> New <i class="b"></i> Became customers</span></header>
                @if (_r.Trend.All(t => t.NewLeads == 0 && t.Converted == 0))
                {
                    <p class="sd-empty">No new leads in this period yet.</p>
                }
                else
                {
                    var tmax = Math.Max(1, _r.Trend.Max(t => Math.Max(t.NewLeads, t.Converted)));
                    <div class="sd-chart" role="img" aria-label="New leads and conversions per day">
                        <div class="sd-grid"><span>@tmax</span><span>@(tmax / 2)</span><span>0</span></div>
                        <div class="sd-cols">
                            @foreach (var t in _r.Trend)
                            {
                                <div class="sd-col" title="@t.Day: @t.NewLeads new, @t.Converted converted">
                                    <div class="sd-bars"><span class="a" style="height:@((100.0 * t.NewLeads / tmax).ToString("0.#", CultureInfo.InvariantCulture))%"></span><span class="b" style="height:@((100.0 * t.Converted / tmax).ToString("0.#", CultureInfo.InvariantCulture))%"></span></div>
                                    <small>@(_r.Trend.Count <= 14 || _r.Trend.IndexOf(t) % 4 == 0 ? t.Day : "")</small>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>

        <section class="sd-card sd-table" aria-label="Lead sources">
            <header><h4>Where leads come from</h4><span>Sorted by volume. Click a heading to re-sort, or export the table.</span></header>
            <DataTable TItem="CrmSourceRow" Items="_r.BySource" Columns="_sourceCols" Searchable="false" PageSize="10" Title="Lead sources" FileName="nura-lead-sources" EmptyText="No leads in this period yet." />
        </section>

        @if (AdminAuth.CanAll("crm"))
        {
            <section class="sd-card sd-table" aria-label="Team performance">
                <header><h4>Team performance</h4><span>Leads owned, customers won, sales and reply speed per person.</span></header>
                <DataTable TItem="CrmEmployeeRow" Items="_r.ByEmployee" Columns="_teamCols" Searchable="false" PageSize="10" Title="Team performance" FileName="nura-team-performance" EmptyText="No employees yet. Add your sales team in the Team tab." />
            </section>
        }
    }
</div>

@code {
    private CrmDashboardResponse? _r;
    private int _days = 30;
    private string? _error;
    private List<DataColumn<CrmSourceRow>> _sourceCols = [];
    private List<DataColumn<CrmEmployeeRow>> _teamCols = [];

    protected override async Task OnInitializedAsync()
    {
        _sourceCols =
        [
            new() { Header = "Source", Text = s => SourceLabel(s.Source), Cell = s => b => { b.OpenElement(0, "strong"); b.AddContent(1, SourceLabel(s.Source)); b.CloseElement(); } },
            new() { Header = "Leads", Text = s => s.Leads.ToString(), SortKey = s => s.Leads, Align = "right" },
            new() { Header = "Customers", Text = s => s.Converted.ToString(), SortKey = s => s.Converted, Align = "right" },
            new() { Header = "Conversion", Text = s => s.Leads == 0 ? "—" : s.ConversionPercent + "%", SortKey = s => s.ConversionPercent, Align = "right" },
            new() { Header = "Sales (Rs)", Text = s => s.Revenue.ToString("N0", CultureInfo.InvariantCulture), SortKey = s => s.Revenue, Align = "right",
                    Cell = s => b => b.AddContent(0, "₹" + s.Revenue.ToString("N0", CultureInfo.InvariantCulture)) },
        ];
        _teamCols =
        [
            new() { Header = "Employee", Text = e => e.Name, Cell = e => b => { b.OpenElement(0, "span"); b.AddAttribute(1, "class", "sd-person"); b.OpenElement(2, "i"); b.AddContent(3, Initial(e.Name)); b.CloseElement(); b.OpenElement(4, "b"); b.AddContent(5, e.Name); b.CloseElement(); b.CloseElement(); } },
            new() { Header = "New leads", Text = e => e.Leads.ToString(), SortKey = e => e.Leads, Align = "right" },
            new() { Header = "Customers", Text = e => e.Converted.ToString(), SortKey = e => e.Converted, Align = "right" },
            new() { Header = "Sales (Rs)", Text = e => e.Revenue.ToString("N0", CultureInfo.InvariantCulture), SortKey = e => e.Revenue, Align = "right",
                    Cell = e => b => b.AddContent(0, "₹" + e.Revenue.ToString("N0", CultureInfo.InvariantCulture)) },
            new() { Header = "First reply", Text = e => e.MedianFirstReplyMinutes is { } m ? Mins(m) : "—", SortKey = e => e.MedianFirstReplyMinutes ?? int.MaxValue, Align = "right" },
            new() { Header = "Open leads", Text = e => e.OpenLeads.ToString(), SortKey = e => e.OpenLeads, Align = "right" },
            new() { Header = "Overdue follow-ups", Text = e => e.OverdueFollowUps.ToString(), SortKey = e => e.OverdueFollowUps, Align = "right", Tone = e => e.OverdueFollowUps > 0 ? "bad" : "good" },
        ];
        await LoadAsync(30);
    }

    private async Task LoadAsync(int days)
    {
        _days = days;
        var res = await Api.AdminCrmDashboardAsync(days);
        if (res.Success) { _r = res; _error = null; }
        else _error = res.Message ?? "Could not load the dashboard.";
    }

    private static string Initial(string? n) => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim()[..1].ToUpperInvariant();

    private static string Mins(int m) => m < 1 ? "under a minute" : m < 60 ? $"{m} min" : m < 1440 ? $"{m / 60} h {m % 60} m" : $"{m / 1440} d {m % 1440 / 60} h";

    private static string StatusLabel(string s) => s switch
    {
        LeadStatuses.New => "New",
        LeadStatuses.Interested => "Interested",
        LeadStatuses.FollowUp => "Follow-up",
        LeadStatuses.Converted => "Customer",
        LeadStatuses.NotInterested => "Not interested",
        _ => s,
    };

    private static string SourceLabel(string s) => s switch
    {
        "whatsapp" => "WhatsApp",
        "instagram" => "Instagram",
        "facebook" => "Facebook",
        "website" => "Website / orders",
        "manual" => "Added by hand",
        _ => s,
    };
}
