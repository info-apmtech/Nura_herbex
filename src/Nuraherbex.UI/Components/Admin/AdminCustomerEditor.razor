@inject ApiClient Api
@if (!_editing)
{
    <button class="admin-btn" @onclick="Edit"><Icon Name="FileText" Size="16" /> Edit customer details</button>
    @if (_message is not null) { <p role="status" class="admin-notice">@_message</p> }
}
else
{
    <form class="admin-card" @onsubmit="SaveAsync" @onsubmit:preventDefault><h3>Edit customer</h3><p class="admin-help">Update their contact details and default shipping address. Existing orders keep their original details.</p><div class="admin-fields"><label>Full name<input required maxlength="200" @bind:event="oninput" @bind="_draft.FullName" /></label><label>Phone<input required type="tel" maxlength="20" @bind:event="oninput" @bind="_draft.Phone" /></label><label class="admin-span-2">Address line 1<input required maxlength="500" @bind:event="oninput" @bind="_draft.ShippingAddress!.AddressLine1" /></label><label class="admin-span-2">Address line 2<input maxlength="500" @bind:event="oninput" @bind="_draft.ShippingAddress!.AddressLine2" /></label><label>City<input required maxlength="100" @bind:event="oninput" @bind="_draft.ShippingAddress!.City" /></label><label>State<input required maxlength="100" @bind:event="oninput" @bind="_draft.ShippingAddress!.State" /></label><label>Pincode<input required pattern="[1-9][0-9]{5}" maxlength="6" @bind:event="oninput" @bind="_draft.ShippingAddress!.Pincode" /></label></div>@if (_error is not null) { <p class="admin-error" role="alert">@_error</p> }<div class="admin-form-footer"><button type="button" class="admin-btn" disabled="@_saving" @onclick="() => _editing = false">Cancel</button><button class="admin-btn admin-btn-primary" disabled="@_saving">@(_saving ? "Saving…" : "Save customer")</button></div></form>
}
@code {
    [Parameter, EditorRequired] public AdminCustomerDto Customer { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    private bool _editing, _saving;
    private string? _error, _message;
    private UpdateProfileRequest _draft = new();
    private void Edit() { _error = null; _message = null; _draft = new() { FullName = Customer.FullName, Phone = Customer.Phone, ShippingAddress = System.Text.Json.JsonSerializer.Deserialize<AddressDto>(System.Text.Json.JsonSerializer.Serialize(Customer.ShippingAddress)) ?? new() }; _editing = true; }
    private async Task SaveAsync() { if (_saving) return; _saving = true; var r = await Api.AdminUpdateCustomerAsync(Customer.Id, _draft); _saving = false; if (!r.Success) { _error = r.Message; return; } if (r.Customer is { } c) { Customer.FullName = c.FullName; Customer.Phone = c.Phone; Customer.ShippingAddress = c.ShippingAddress; } _editing = false; _message = r.Message; await OnSaved.InvokeAsync(); }
}

