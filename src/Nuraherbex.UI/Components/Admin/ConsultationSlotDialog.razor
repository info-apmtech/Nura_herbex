@inject ApiClient Api
@inject AdminSession AdminAuth

<div class="fu-modal-backdrop" @onclick="Close" style="position:fixed;inset:0;background:rgba(15,23,42,0.65);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;">
    <div class="fu-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true" style="max-width:580px;width:100%;background:#fff;border-radius:20px;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);overflow:hidden;padding:24px;border:1px solid #f1f5f9;max-height:90vh;display:flex;flex-direction:column;">
        
        <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid #f1f5f9;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;border-radius:10px;background:#ffedd5;color:#ea580c;display:flex;align-items:center;justify-content:center;">
                    <Icon Name="Calendar" Size="20" />
                </div>
                <div>
                    <h3 style="margin:0;font-size:17px;font-weight:700;color:#0f172a;">@(Type == ConsultationType.PaidOnboarding ? "Book Onboarding Doctor Consultation" : "Book Free Doctor Consultation")</h3>
                    <p style="margin:2px 0 0;font-size:12px;color:#64748b;">Lead: <strong>@LeadName</strong> (@LeadPhone)</p>
                </div>
            </div>
            <button type="button" class="admin-icon-btn" @onclick="Close"><Icon Name="X" Size="18" /></button>
        </div>

        <div style="overflow-y:auto;padding:16px 0;flex:1;display:flex;flex-direction:column;gap:16px;">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div style="background:#fef2f2;border:1px solid #fee2e2;color:#dc2626;padding:10px 14px;border-radius:8px;font-size:12px;">
                    @_error
                </div>
            }

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:#334155;">
                    <span>Consultation Date (IST)</span>
                    <input type="date" value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" style="padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;" />
                </label>

                <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:#334155;">
                    <span>Slot Duration</span>
                    <div style="padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;background:#f8fafc;font-size:13px;color:#475569;font-weight:500;">
                        ⏱️ 20 Minutes (10 AM - 7 PM)
                    </div>
                </label>
            </div>

            <div>
                <span style="display:block;margin-bottom:8px;font-size:12px;font-weight:600;color:#334155;">Select Available 20-Min Slot:</span>
                @if (_loadingSlots)
                {
                    <div style="padding:24px;text-align:center;color:#64748b;font-size:13px;">
                        <Icon Name="RefreshCw" Size="18" Class="animate-spin" />
                        <span style="margin-left:8px;">Checking slot availability…</span>
                    </div>
                }
                else if (_slots.Count == 0)
                {
                    <div style="padding:20px;text-align:center;color:#94a3b8;font-size:13px;border:1px dashed #e2e8f0;border-radius:10px;">
                        No slots available for this date.
                    </div>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:8px;max-height:220px;overflow-y:auto;padding-right:4px;">
                        @foreach (var slot in _slots)
                        {
                            var isSelected = _selectedSlot == slot.SlotTimeUtc;
                            <button type="button"
                                    disabled="@(!slot.IsAvailable)"
                                    @onclick="() => _selectedSlot = slot.SlotTimeUtc"
                                    style="padding:8px 6px;border-radius:8px;font-size:11px;font-weight:600;border:1px solid;cursor:@(slot.IsAvailable ? "pointer" : "not-allowed");transition:all .15s;text-align:center;
                                           background:@(isSelected ? "#ea580c" : (slot.IsAvailable ? "#fff" : "#f1f5f9"));
                                           color:@(isSelected ? "#fff" : (slot.IsAvailable ? "#334155" : "#94a3b8"));
                                           border-color:@(isSelected ? "#ea580c" : (slot.IsAvailable ? "#cbd5e1" : "#e2e8f0"));">
                                @slot.FormattedTime
                            </button>
                        }
                    </div>
                }
            </div>

            <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:#334155;">
                <span>Notes for Doctor (Optional)</span>
                <textarea @bind="_notes" rows="2" placeholder="Specific symptoms, preferences or goals to note..." style="padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:12px;resize:none;"></textarea>
            </label>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:10px;padding-top:14px;border-top:1px solid #f1f5f9;">
            <button type="button" class="admin-btn" @onclick="Close" disabled="@_saving">Cancel</button>
            <button type="button" class="admin-btn admin-btn-primary" style="background:#ea580c !important;border-color:#ea580c !important;color:#ffffff !important;" @onclick="ConfirmBookingAsync" disabled="@(_saving || _selectedSlot == null)">
                @if (_saving)
                {
                    <Icon Name="RefreshCw" Size="14" Class="animate-spin" />
                    <span>Booking Slot…</span>
                }
                else
                {
                    <Icon Name="Check" Size="14" />
                    <span>Confirm Doctor Booking</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public long LeadId { get; set; }
    [Parameter] public string LeadName { get; set; } = "";
    [Parameter] public string LeadPhone { get; set; } = "";
    [Parameter] public ConsultationType Type { get; set; } = ConsultationType.FreeInitial;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnBooked { get; set; }

    private DateTime _selectedDate = DateTime.Now.Date;
    private DateTime? _selectedSlot;
    private List<ConsultationSlotDto> _slots = new();
    private bool _loadingSlots;
    private bool _saving;
    private string? _error;
    private string _notes = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSlotsAsync();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _selectedDate = dt.Date;
            _selectedSlot = null;
            await LoadSlotsAsync();
        }
    }

    private async Task LoadSlotsAsync()
    {
        _loadingSlots = true;
        _error = null;
        StateHasChanged();
        try
        {
            var res = await Api.AdminConsultationSlotsAsync(_selectedDate.ToString("yyyy-MM-dd"));
            if (res.Success)
            {
                _slots = res.Slots;
            }
            else
            {
                _error = res.Message ?? "Failed to load consultation slots.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingSlots = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmBookingAsync()
    {
        if (_selectedSlot == null || _saving) return;
        _saving = true;
        _error = null;
        StateHasChanged();
        try
        {
            var req = new BookConsultationRequest
            {
                LeadId = LeadId,
                ScheduledAtUtc = _selectedSlot.Value,
                DurationMinutes = 20,
                Type = Type,
                Notes = _notes
            };
            var res = await Api.AdminBookConsultationAsync(req);
            if (res.Success)
            {
                await OnBooked.InvokeAsync();
                await Close();
            }
            else
            {
                _error = res.Message ?? "Failed to book consultation slot.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
