@inject ApiClient Api
@inject AdminSession AdminAuth
@inject NavigationManager Nav

<div class="ld tk">
    <div class="em-head">
        <div>
            <h3>Tasks</h3>
            <p>@(AdminAuth.CanAll("tasks") ? "Every task across the team: who owns it, what is late and what is done." : "Your tasks.")</p>
        </div>
        <div class="em-head-actions"><ExportButton Title="Tasks" FileName="nura-tasks" Columns="@(new[] { "Task", "Department", "Assigned to", "Created by", "Priority", "Status", "Due", "Late", "Created", "Completed", "Repeat", "Latest comment" })" Rows="ExportRows" Disabled="@(_items.Count == 0)" /><button type="button" class="ld-btn primary" @onclick="StartCreate"><Icon Name="Plus" Size="14" /> New task</button></div>
    </div>

    <details class="tk-help">
        <summary><Icon Name="Sparkles" Size="14" /> How tasks work</summary>
        <ol>
            <li><b>Create</b> a task: say what must be done, who does it, by when and how important it is.</li>
            <li><b>Assign</b> it to one person, or tick several people (or a whole department). Each person gets their <em>own copy</em> and is notified.</li>
            <li><b>Work on it</b>: <span class="tk-st todo">To do</span> → <span class="tk-st in_progress">In progress</span>. Use <span class="tk-st blocked">Blocked</span> when you are waiting on someone. Tick the checklist steps as you go.</li>
            <li>Press <b>Mark done</b> when finished. The person who created it is told. A repeating task creates the next one by itself.</li>
        </ol>
        <p>Late tasks turn red and the assignee is reminded a day before and when overdue. Comments on a task are visible to everyone involved.</p>
    </details>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="@($"em-note {(_ok ? "ok" : "bad")}")" role="status"><Icon Name="@(_ok ? "CheckCircle2" : "AlertCircle")" Size="15" /><span>@_message</span><button type="button" class="em-x" aria-label="Dismiss" @onclick="() => _message = null"><Icon Name="X" Size="14" /></button></div>
    }

    <div class="tk-tabs" role="tablist" aria-label="Task status">
        <button type="button" role="tab" aria-selected="@(_scope != "done")" class="tk-tab @(_scope != "done" ? "is-on" : "")" @onclick='() => SetView("open", "")'>Pending <b>@_counts.Open</b></button>
        <button type="button" role="tab" aria-selected="@(_scope == "done")" class="tk-tab @(_scope == "done" ? "is-on" : "")" @onclick='() => SetView("done", "")'>Completed <b>@_counts.Done</b></button>
    </div>
    @if (_scope != "done")
    {
        <div class="fu-chips tk-chips">
            <button type="button" class="@Chip("open", "")" @onclick='() => SetView("open", "")'><b>@_counts.Open</b><span>All pending</span></button>
            <button type="button" class="@Chip("overdue", "late")" @onclick='() => SetView("overdue", "")'><b>@_counts.Overdue</b><span>Overdue</span></button>
            <button type="button" class="@Chip("today", "today")" @onclick='() => SetView("today", "")'><b>@_counts.DueToday</b><span>Due today</span></button>
        </div>
        @if (_counts.Upcoming > 0)
        {
            <button type="button" class="@Chip("upcoming", "")" @onclick='() => SetView("upcoming", "")'><b>@_counts.Upcoming</b><span>Upcoming</span></button>
        }
    }

    <div class="tk-bar">
        <div class="ld-search"><Icon Name="Search" Size="15" /><input type="search" placeholder="Search tasks" aria-label="Search tasks" @bind="_q" @bind:event="oninput" @bind:after="LoadAsync" /></div>
        @if (AdminAuth.CanAll("tasks"))
        {
        <select aria-label="Person" @bind="_assignee" @bind:after="LoadAsync">
            <option value="">Everyone</option>
            <option value="me">My tasks (@_counts.Mine)</option>
            <option value="unassigned">Unassigned (@_counts.Unassigned)</option>
            @foreach (var p in _team) { <option value="@p.Id">@p.Name</option> }
        </select>
        }
        <button type="button" class="tk-more @(_more ? "is-on" : "")" aria-expanded="@_more" @onclick="() => _more = !_more"><Icon Name="SlidersHorizontal" Size="14" /> More filters@(_department != "" || _priority != "" ? " (on)" : "")</button>
        @if (_more || _department != "" || _priority != "")
        {
        <select aria-label="Department" @bind="_department" @bind:after="LoadAsync">
            <option value="">All departments</option>
            @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
        </select>
        <select aria-label="Priority" @bind="_priority" @bind:after="LoadAsync">
            <option value="">Any priority</option>
            @foreach (var p in TaskPriorities.All) { <option value="@p">@Cap(p)</option> }
        </select>
        }
        @if (_leadFilter is not null) { <button type="button" class="ld-tab is-active" title="Show all tasks" @onclick="ClearLead">Lead #@_leadFilter <Icon Name="X" Size="12" /></button> }
        <div class="tk-view" role="group" aria-label="View">
            <button type="button" class="@(_board ? "" : "is-on")" @onclick="() => SetBoard(false)">List</button>
            <button type="button" class="@(_board ? "is-on" : "")" @onclick="() => SetBoard(true)">Board</button>
        </div>
    </div>

    @if (_loading) { <div class="ld-card ld-empty">Loading tasks…</div> }
    else if (_board)
    {
        <div class="tk-board">
            @foreach (var st in TaskStatuses.All.Where(s => (s == "done") == (_scope == "done")))
            {
                var status = st;
                var col = _items.Where(t => t.Status == status).ToList();
                <section class="tk-col @(_dropOn == status ? "is-over" : "")" @ondragover:preventDefault @ondragenter="() => _dropOn = status" @ondrop="() => DropAsync(status)" aria-label="@TaskStatuses.Label(status)">
                    <header><span>@TaskStatuses.Label(status)</span><b>@col.Count</b></header>
                    @foreach (var t in col)
                    {
                        var task = t;
                        <article class="tk-card @PriClass(task)" draggable="true" @key="task.Id" @ondragstart="() => _dragId = task.Id" @ondragend="() => { _dragId = null; _dropOn = null; }" @onclick="() => OpenAsync(task.Id)">
                            <strong>@task.Title</strong>
                            <div class="tk-meta">
                                <span class="@($"tk-pri {task.Priority}")">@Cap(task.Priority)</span>
                                @if (task.DueAt is { } du) { <span class="@($"tk-due {(task.IsOverdue ? "late" : "")}")"><Icon Name="Clock" Size="11" /> @AdminFmt.DateTimeShort(du)</span> }
                                @if (task.ChecklistTotal > 0) { <span><Icon Name="Check" Size="11" /> @task.ChecklistDone/@task.ChecklistTotal</span> }
                                @if (task.CommentCount > 0) { <span><Icon Name="MessageSquare" Size="11" /> @task.CommentCount</span> }
                            </div>
                            @if (task.LastComment is not null) { <small class="tk-r-note"><b>@task.LastCommentBy</b>: @task.LastComment</small> }
                            <div class="tk-foot"><span>@(task.AssignedToName ?? "Unassigned")</span>@if (task.DepartmentName is { } dn) { <small>@dn</small> }</div>
                            @if (task.CanEdit && task.Status != "done") { <button type="button" class="ld-btn tk-donebtn" @onclick="() => ToggleDoneAsync(task)" @onclick:stopPropagation="true"><Icon Name="Check" Size="13" /> Mark done</button> }
                        </article>
                    }
                    @if (col.Count == 0) { <p class="tk-none">Nothing here</p> }
                </section>
            }
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="ld-card ld-empty"><strong>No tasks here</strong>@(_scope == "open" && _q == "" ? "Create a task to give someone work with a due date." : "Nothing matches these filters.")</div>
    }
    else
    {
        <div class="tk-rows">
            @foreach (var t in _items.Skip((_page - 1) * _size).Take(_size))
            {
                var task = t;
                var due = DueInfo(task);
                var isDone = task.Status == "done";
                <article class="@($"tk-r p-{task.Priority} {(isDone ? "is-done" : "")}")" @key="task.Id">
                    @if (isDone) { <button type="button" class="tk-tick on" disabled="@(!task.CanEdit)" title="Marked done by mistake? Click to undo" aria-label="Undo done" @onclick="() => ToggleDoneAsync(task)"><Icon Name="Check" Size="14" /></button> }
                    else { <button type="button" class="tk-tick" disabled="@(!task.CanEdit)" title="@(!task.CanEdit ? "You can only view this task" : "Mark as done")" aria-label="Mark task as done" @onclick="() => ToggleDoneAsync(task)"><Icon Name="Check" Size="14" /></button> }
                    <button type="button" class="tk-r-main" @onclick="() => OpenAsync(task.Id)">
                        <strong>@task.Title</strong>
                        <small>@string.Join(" · ", new[] { task.DepartmentName, task.LeadName is { } ln ? "Lead: " + ln : null, task.Repeat != "none" ? "Repeats " + task.Repeat : null, task.StartAt is { } sa && !isDone && sa.ToLocalTime().Date >= DateTime.Today ? "Starts " + sa.ToLocalTime().ToString("ddd, dd MMM") : null }.Where(x => x is not null))</small>
                        @if (task.LastComment is not null) { <small class="tk-r-note" title="@task.LastComment"><Icon Name="MessageSquare" Size="11" /> <b>@task.LastCommentBy</b>: @task.LastComment</small> }
                    </button>
                    <div class="tk-r-tags">
                        <span class="@($"tk-pill pri-{task.Priority}")">@Cap(task.Priority)</span>
                        <span class="@($"tk-pill st-{task.Status}")">@TaskStatuses.Label(task.Status)</span>
                        @if (task.ChecklistTotal > 0)
                        {
                            <button type="button" class="@($"tk-prog {(_listOpen == task.Id ? "is-open" : "")}")" title="@task.ChecklistDone of @task.ChecklistTotal steps done. Click to tick steps here" aria-expanded="@(_listOpen == task.Id)" @onclick="() => ToggleListAsync(task)"><i style="width:@(100 * task.ChecklistDone / task.ChecklistTotal)%"></i><em>@task.ChecklistDone/@task.ChecklistTotal</em></button>
                        }
                    </div>
                    <span class="@($"tk-due2 {due.Tone}")"><Icon Name="Clock" Size="13" /> @due.Text</span>
                    <span class="tk-person"><i>@Initial(task.AssignedToName)</i><span>@(task.AssignedToName ?? "Unassigned")</span></span>
                    @if (_listOpen == task.Id)
                    {
                        <div class="tk-r-check">
                            <strong>Checklist <small>tick each step as it is finished</small></strong>
                            @foreach (var ci in _listItems)
                            {
                                var step = ci;
                                <div class="@($"tk-lc {(step.Done ? "done" : "")}")">
                                    <label><input type="checkbox" checked="@step.Done" disabled="@(!task.CanEdit)" @onchange="e => TickInlineAsync(task, step, e.Value is true)" /> <span>@step.Text</span></label>
                                    @if (step.Done && step.DoneAt is { } sdt) { <small class="tk-meta-done"><Icon Name="CheckCircle" Size="12" /> @(step.DoneByName ?? "Someone") · @AdminFmt.DateTimeShort(sdt)</small> }
                                    @if (task.CanEdit && step.Done) { <button type="button" class="tk-undo" @onclick="() => TickInlineAsync(task, step, false)"><Icon Name="RotateCcw" Size="12" /> Undo</button> }
                                </div>
                            }
                            @if (_listItems.Count == 0) { <small>Loading…</small> }
                        </div>
                    }
                </article>
            }
        </div>
        <Pager Total="@_items.Count" @bind-Page="_page" @bind-PageSize="_size" Label="tasks" />
    }
</div>

@if (_form is not null)
{
    <div class="fu-modal-backdrop" @onclick="() => _form = null">
        <div class="fu-modal lo" role="dialog" aria-modal="true" aria-label="@(_editingId is null ? "New task" : "Edit task")" @onclick:stopPropagation="true">
            <header><h3>@(_editingId is null ? "New task" : "Edit task")</h3><button type="button" class="em-x" aria-label="Close" @onclick="() => _form = null"><Icon Name="X" Size="16" /></button></header>
            <form class="fu-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                @if (_editingId is null)
                {
                    <div class="tk-tpl">
                        <div class="tk-tpl-head">
                            <span><Icon Name="Sparkles" Size="14" /> Start from a ready-made task</span>
                            <select aria-label="Team role" @bind="_tplRole">
                                @foreach (var r in TaskTemplates.Roles) { <option value="@r">@r</option> }
                            </select>
                        </div>
                        <div class="tk-tpl-list">
                            @foreach (var t in TaskTemplates.For(_tplRole))
                            {
                                var tpl = t;
                                <button type="button" class="tk-tpl-chip @(_tplKey == tpl.Key ? "is-on" : "")" title="@tpl.Description" @onclick="() => ApplyTemplate(tpl)">@tpl.Title</button>
                            }
                        </div>
                    </div>
                }
                <label class="fu-field">What needs to be done<input class="fu-input" type="text" required maxlength="200" @bind="_form.Title" @bind:event="oninput" placeholder="e.g. Call back the Chennai bulk enquiry" /></label>
                <label class="fu-field">Details<textarea class="fu-input tk-text" maxlength="4000" rows="3" @bind="_form.Description" @bind:event="oninput" placeholder="Optional"></textarea></label>
                <div class="tk-two">
                    <label class="fu-field">Department
                        <select value="@(_form.DepartmentId?.ToString() ?? "")" @onchange="OnDepartmentChanged">
                            <option value="">All / none</option>
                            @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
                        </select>
                    </label>
                    <div class="fu-field tk-wide">
                        <span>Assign to @if (_editingId is null) { <small>tick one or more people — each gets their own copy of the task</small> }</span>
                        @if (_editingId is not null)
                        {
                            <select value="@(_form.AssignedToEmployeeId?.ToString() ?? "")" @onchange="OnSingleAssignee">
                                <option value="">Unassigned</option>
                                @foreach (var p in _team) { <option value="@p.Id">@p.Name@(DeptOf(p) is { } dn ? " · " + dn : "")@(p.Id == AdminAuth.EmployeeId ? " (me)" : "")</option> }
                            </select>
                        }
                        else
                        {
                            <label class="tk-auto"><input type="checkbox" @bind="_form.AutoAssign" /> <span><strong>Auto-assign</strong> to the least busy person who is signed in now@(_form.DepartmentId is not null ? " (in this department)" : "")</span></label>
                            @if (!_form.AutoAssign)
                            {
                            <div class="tk-people tk-cards">
                                <div class="tk-people-tools">
                                    @if (_form.DepartmentId is not null) { <button type="button" class="ld-tab" @onclick="PickWholeDepartment">Select everyone in this department (@PeopleShown.Count)</button> }
                                    @if (_picked.Count > 0) { <button type="button" class="ld-tab" @onclick="ClearPicked">Clear (@_picked.Count)</button> }
                                </div>
                                @foreach (var p in PeopleShown)
                                {
                                    var person = p;
                                    <label class="tk-person @(_picked.Contains(person.Id) ? "is-on" : "")">
                                        <input type="checkbox" checked="@_picked.Contains(person.Id)" @onchange="e => TogglePerson(person, e.Value is true)" />
                                        <span class="ld-avatar">@person.Name[..1].ToUpperInvariant()</span>
                                        <span><strong><i class="@($"tk-dot {(person.IsOnline ? "on" : "")}")" title="@(person.IsOnline ? "Signed in now" : "Not signed in")"></i>@person.Name@(person.Id == AdminAuth.EmployeeId ? " (me)" : "")</strong><small>@(DeptOf(person) ?? "No department") · @(person.IsOnline ? "online" : "offline")</small></span>
                                    </label>
                                }
                                @if (PeopleShown.Count == 0) { <p class="fu-hint">Nobody in this department yet. Leave it unassigned, or choose another department.</p> }
                            </div>
                            }
                        }
                    </div>
                    <label class="fu-field">Priority
                        <select @bind="_form.Priority">@foreach (var p in TaskPriorities.All) { <option value="@p">@Cap(p)</option> }</select>
                    </label>
                    <label class="fu-field">Start date
                        <input class="fu-input" type="datetime-local" @bind="_start" />
                    </label>
                    <label class="fu-field">End date (due)
                        <input class="fu-input" type="datetime-local" @bind="_due" />
                    </label>
                    <label class="fu-field">Repeat
                        <select @bind="_form.Repeat">
                            <option value="none">Does not repeat</option>
                            <option value="daily">Every day</option>
                            <option value="weekly">Every week</option>
                            <option value="monthly">Every month</option>
                        </select>
                    </label>
                    @if (_form.LeadId is not null) { <div class="fu-field">About<div class="tk-lead">Lead #@_form.LeadId <button type="button" class="fu-link" @onclick="() => _form.LeadId = null">Remove</button></div></div> }
                </div>
                @if (_form.Repeat != "none" && _due is null) { <p class="fu-hint">A repeating task needs a due date.</p> }
                @if (_editingId is null)
                {
                    <label class="fu-field">Checklist <small>one step per line</small><textarea class="fu-input tk-text" rows="3" @bind="_checklistText" @bind:event="oninput" placeholder="e.g. Print labels (then press Enter for the next step)"></textarea></label>
                }
                <footer>
                    <button type="button" class="ld-btn" @onclick="() => _form = null">Cancel</button>
                    <button type="submit" class="ld-btn primary" disabled="@_busy">@(_busy ? "Saving…" : _editingId is null ? "Create task" : "Save changes")</button>
                </footer>
            </form>
        </div>
    </div>
}

@if (_confirm is not null)
{
    <div class="fu-modal-backdrop" @onclick="() => _confirm = null">
        <div class="fu-modal lo" role="dialog" aria-modal="true" aria-label="Confirm task completion" @onclick:stopPropagation="true">
            <header><h3>Confirm before marking done</h3><button type="button" class="em-x" aria-label="Close" @onclick="() => _confirm = null"><Icon Name="X" Size="16" /></button></header>
            <form class="fu-form" @onsubmit="ConfirmDoneAsync" @onsubmit:preventDefault>
                <p><b>@_confirm.Title</b></p>
                @if (_confirm.Items.Count == 0) { <p class="fu-hint">This task has no checklist. Press Mark done to complete it.</p> }
                else
                {
                    <p class="fu-hint">Check every step. Anything not done needs a reason.</p>
                    @foreach (var it in _confirm.Items)
                    {
                        var item = it;
                        <div class="tk-check @(item.Done ? "done" : "")">
                            <label><input type="checkbox" checked="@item.Done" @onchange="e => item.Done = e.Value is true" /> <span>@item.Text</span></label>
                            @if (!item.Done) { <input class="fu-input" maxlength="300" placeholder="Why was this not done? (required)" aria-label="Reason for @item.Text" value="@item.Reason" @oninput="e => item.Reason = e.Value?.ToString() ?? string.Empty" /> }
                        </div>
                    }
                }
                @if (_confirmError is not null) { <p class="fu-hint" role="alert" style="color:#b3261e">@_confirmError</p> }
                <footer>
                    <button type="button" class="ld-btn" @onclick="() => _confirm = null">Cancel</button>
                    <button type="submit" class="ld-btn primary" disabled="@_busy">@(_busy ? "Saving…" : "Mark done")</button>
                </footer>
            </form>
        </div>
    </div>
}

@if (_detail is { Task: { } dt })
{
    <div class="fu-modal-backdrop tk-drawer-bg" @onclick="CloseDetail">
        <aside class="tk-drawer" role="dialog" aria-modal="true" aria-label="Task details" @onclick:stopPropagation="true">
            <header>
                <div><span class="@($"tk-pri {dt.Priority}")">@Cap(dt.Priority)</span> @if (dt.IsOverdue) { <span class="tk-due late">Overdue</span> }<h3>@dt.Title</h3></div>
                <button type="button" class="em-x" aria-label="Close" @onclick="CloseDetail"><Icon Name="X" Size="16" /></button>
            </header>
            <div class="tk-body">
                <div class="tk-facts">
                    <div><small>Status</small>
                        @if (dt.CanEdit) { <select value="@dt.Status" @onchange="OnDetailStatus">@foreach (var s in TaskStatuses.All) { <option value="@s">@TaskStatuses.Label(s)</option> }</select> }
                        else { <b>@TaskStatuses.Label(dt.Status)</b> }
                    </div>
                    <div><small>Assigned to</small><b>@(dt.AssignedToName ?? "Unassigned")</b></div>
                    <div><small>Start</small><b>@(dt.StartAt is { } sd ? AdminFmt.DateTimeShort(sd) : "Not set")</b></div>
                    <div><small>End (due)</small><b class="@(dt.IsOverdue ? "late" : "")">@(dt.DueAt is { } d ? AdminFmt.DateTimeShort(d) : "No due date")</b></div>
                    <div><small>Department</small><b>@(dt.DepartmentName ?? "—")</b></div>
                    <div><small>Created by</small><b>@dt.CreatedByName</b></div>
                    @if (dt.Repeat != "none") { <div><small>Repeats</small><b>@Cap(dt.Repeat)</b></div> }
                </div>
                @if (!string.IsNullOrWhiteSpace(dt.Description)) { <p class="tk-desc">@dt.Description</p> }
                @if (dt.LeadId is { } lid) { <p><button type="button" class="fu-link" @onclick="() => OpenLead(lid)">Open lead @(dt.LeadName ?? "#" + lid)</button></p> }

                <h4>Checklist @if (_detail.Checklist.Count > 0) { <small>@_detail.Checklist.Count(c => c.Done)/@_detail.Checklist.Count</small> }</h4>
                @foreach (var c in _detail.Checklist)
                {
                    var item = c;
                    <div class="tk-check @(item.Done ? "done" : "")">
                        <label><input type="checkbox" checked="@item.Done" disabled="@(!dt.CanEdit)" @onchange="e => TickAsync(item, e.Value is true)" /> <span>@item.Text</span></label>
                        @if (dt.CanEdit && item.Done) { <button type="button" class="tk-undo" title="Ticked by mistake? Put this step back to not done" @onclick="() => TickAsync(item, false)"><Icon Name="RotateCcw" Size="12" /> Undo</button> }
                        @if (dt.CanEdit) { <button type="button" class="em-x" aria-label="Remove step" @onclick="() => RemoveItemAsync(item)"><Icon Name="X" Size="13" /></button> }
                        <div class="tk-meta">
                            @if (item.Done && item.DoneAt is { } dat) { <span class="tk-meta-done"><Icon Name="CheckCircle" Size="12" /> Completed@(item.DoneByName is { } dn ? " by " + dn : "") on @AdminFmt.DateTimeShort(dat)</span> }
                            @if (item.AddedAt is { } aat) { <span>Added@(item.AddedByName is { } an ? " by " + an : "") on @AdminFmt.DateTimeShort(aat)</span> }
                        </div>
                    </div>
                }
                @if (dt.CanEdit)
                {
                    <form class="tk-add" @onsubmit="AddItemAsync" @onsubmit:preventDefault><input class="fu-input" maxlength="300" placeholder="Add a step" aria-label="Add a step" @bind="_newItem" @bind:event="oninput" /><button class="ld-btn" type="submit" disabled="@string.IsNullOrWhiteSpace(_newItem)">Add</button></form>
                }

                <h4>Comments</h4>
                @foreach (var c in _detail.Comments)
                {
                    <div class="tk-comment"><b>@c.Author</b> <small>@AdminFmt.DateTimeShort(c.CreatedAt)</small><p>@c.Body</p></div>
                }
                @if (_detail.Comments.Count == 0) { <p class="tk-none">No comments yet.</p> }
                <form class="tk-add" @onsubmit="CommentAsync" @onsubmit:preventDefault><input class="fu-input" maxlength="2000" placeholder="Write a comment" aria-label="Write a comment" @bind="_comment" @bind:event="oninput" /><button class="ld-btn primary" type="submit" disabled="@string.IsNullOrWhiteSpace(_comment)">Send</button></form>

                <details class="tk-activity" open><summary>Audit trail (@_detail.Activity.Count)</summary>
                    @foreach (var a in _detail.Activity) { <div><small>@AdminFmt.DateTimeShort(a.CreatedAt)</small> <b>@a.Actor</b> @a.Text</div> }
                </details>
            </div>
            @if (dt.CanEdit)
            {
                <footer>
                    @if (_confirmDelete) { <span class="em-confirm">Delete this task? <button class="ld-btn danger" disabled="@_busy" @onclick="DeleteAsync">Yes, delete</button> <button class="ld-btn" @onclick="() => _confirmDelete = false">Keep</button></span> }
                    else { <button type="button" class="ld-btn danger-outline" @onclick="() => _confirmDelete = true">Delete</button> }
                    <button type="button" class="ld-btn primary" @onclick="StartEdit">Edit task</button>
                </footer>
            }
        </aside>
    </div>
}

