@inject ApiClient Api
@inject BrowserInterop Browser

<div class="afm">
    @* Page header & primary actions *@
    <div class="afm-card afm-head">
        <div class="afm-head-main">
            <span class="afm-head-icon"><Icon Name="FlaskConical" Size="24" /></span>
            <div>
                <h3 class="afm-title">
                    <span>STAMIX™ Formulation</span>
                    <span class="afm-live">Live on website</span>
                </h3>
                <p class="afm-sub">
                    Manage the ingredients, amount per 20g daily serving and clinical purpose shown to customers on <code>/formulation</code>.
                </p>
            </div>
        </div>

        <div class="afm-actions">
            <button type="button" class="afm-btn" @onclick="ResetIngredientsAsync" title="Reset to the 17 standard clinical botanicals">
                <Icon Name="RotateCcw" Size="15" />
                <span>Reset Defaults</span>
            </button>
            <button type="button" class="afm-btn" @onclick="OpenEditMetrics" title="Edit the 4 highlight cards">
                <Icon Name="Edit3" Size="15" />
                <span>Edit Highlights</span>
            </button>
            <button type="button" class="afm-btn afm-btn-primary" @onclick="OpenAddIngredient" disabled="@(_products.Count == 0)">
                <Icon Name="Plus" Size="15" />
                <span>Add Ingredient</span>
            </button>
        </div>
    </div>

    @* Product selector: each product has its own formulation *@
    <div class="afm-card afm-products">
        <span class="afm-label">Product</span>
        @if (_products.Count == 0)
        {
            <p class="afm-empty-note">@(_productsLoading ? "Loading products..." : "No products found. Add a product in the catalog first.")</p>
        }
        else
        {
            <div class="afm-tabs">
                @foreach (var p in _products)
                {
                    var prod = p;
                    var on = prod.Id == _productId;
                    <button type="button" @key="prod.Id" @onclick="() => SelectProduct(prod.Id)" class="afm-tab @(on ? "is-on" : "")">
                        <span>@prod.Name</span>
                        <span class="afm-tab-count">@IngredientCount(prod.Id)</span>
                    </button>
                }
            </div>
        }
    </div>

    @* Notification feedback banner *@
    @if (!string.IsNullOrEmpty(_feedback))
    {
        var isError = _feedback.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
        <div class="afm-notice @(isError ? "is-error" : "")" role="status">
            <Icon Name="@(isError ? "AlertCircle" : "CheckCircle2")" Size="17" />
            <span>@_feedback</span>
        </div>
    }

    @* Highlights *@
    <div class="afm-section">
        <div>
            <h4>Formulation Highlights</h4>
            <p>Headline figures shown at the top of the public formulation page. Click a card to edit.</p>
        </div>
    </div>

    <div class="afm-metrics">
        <button type="button" class="afm-metric" style="--accent:#1b1233" @onclick="OpenEditMetrics" title="Click to edit">
            <span class="afm-metric-top">
                <span class="afm-metric-label">@Or(Metrics.TotalIngredients.Label, "Total Ingredients")</span>
                <span class="afm-metric-edit"><Icon Name="Edit3" Size="14" /></span>
            </span>
            <span class="afm-metric-value">
                @(Metrics.TotalIngredients.UseAutoCount
                    ? $"{ProductIngredients.Count} Botanicals"
                    : Or(Metrics.TotalIngredients.Value, $"{ProductIngredients.Count} Botanicals"))
            </span>
        </button>

        <button type="button" class="afm-metric" style="--accent:#b45309" @onclick="OpenEditMetrics" title="Click to edit">
            <span class="afm-metric-top">
                <span class="afm-metric-label">@Or(Metrics.DailyServing.Label, "Daily Serving Base")</span>
                <span class="afm-metric-edit"><Icon Name="Edit3" Size="14" /></span>
            </span>
            <span class="afm-metric-value">@Or(Metrics.DailyServing.Value, "20,000 mg (20g)")</span>
        </button>

        <button type="button" class="afm-metric" style="--accent:#15803d" @onclick="OpenEditMetrics" title="Click to edit">
            <span class="afm-metric-top">
                <span class="afm-metric-label">@Or(Metrics.Bioavailability.Label, "Bioavailability Catalyst")</span>
                <span class="afm-metric-edit"><Icon Name="Edit3" Size="14" /></span>
            </span>
            <span class="afm-metric-value">@Or(Metrics.Bioavailability.Value, "BioPerine® +2000%")</span>
        </button>

        <button type="button" class="afm-metric" style="--accent:#5e209e" @onclick="OpenEditMetrics" title="Click to edit">
            <span class="afm-metric-top">
                <span class="afm-metric-label">@Or(Metrics.Transparency.Label, "Public Transparency")</span>
                <span class="afm-metric-edit"><Icon Name="Edit3" Size="14" /></span>
            </span>
            <span class="afm-metric-value">@Or(Metrics.Transparency.Value, "100% Unmasked")</span>
        </button>
    </div>

    @* Ingredients *@
    <div class="afm-section">
        <div>
            <h4>Ingredients</h4>
            <p>@(_products.FirstOrDefault(p => p.Id == _productId)?.Name ?? "Selected product")</p>
        </div>
    </div>

    <div class="afm-card afm-table-card">
        <div class="afm-toolbar">
            <div class="afm-search">
                <Icon Name="Search" Size="16" />
                <input type="text" class="afm-input" placeholder="Search by ingredient, botanical name or benefit"
                       @bind="_search" @bind:event="oninput" />
            </div>

            <div class="afm-select-wrap">
                <select class="afm-select" @bind="_categoryFilter">
                    <option value="All">All Categories</option>
                    <option value="Adaptogens & Vigor">Adaptogens &amp; Vigor</option>
                    <option value="Nitric Oxide Boosters">Nitric Oxide Boosters</option>
                    <option value="Vitality & Stamina">Vitality &amp; Stamina</option>
                    <option value="Absorption & Bioavailability">Absorption &amp; Bioavailability</option>
                    <option value="Nutrient Base">Nutrient Base</option>
                    <option value="Botanical">Botanical</option>
                </select>
                <ExportButton Title="Formulation ingredients" FileName="nura-formulation" Columns="@(new[] { "Ingredient", "Botanical name", "Category", "Amount", "Standardized extract", "Active compound", "Purpose" })" Rows="IngredientRows" Disabled="@(!FilteredIngredients.Any())" />
            </div>
        </div>

        <div class="afm-scroll">
            <table class="afm-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ingredient</th>
                        <th>Category</th>
                        <th class="afm-th-right">Amount</th>
                        <th>Standardized Extract</th>
                        <th>Purpose</th>
                        <th class="afm-th-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idx = 0; }
                    @foreach (var item in FilteredIngredients)
                    {
                        idx++;
                        var row = item;
                        <tr @key="@(string.IsNullOrEmpty(item.Id) ? item.Name : item.Id)">
                            <td class="afm-num">@idx</td>
                            <td>
                                <div class="afm-ing-name">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.BotanicalName))
                                {
                                    <div class="afm-latin">@item.BotanicalName</div>
                                }
                                @if (!string.IsNullOrEmpty(item.ActiveCompound))
                                {
                                    <div class="afm-active"><b>Active:</b> @item.ActiveCompound</div>
                                }
                            </td>
                            <td><span class="afm-chip">@(string.IsNullOrEmpty(item.Category) ? "Botanical" : item.Category)</span></td>
                            <td class="afm-td-right"><span class="afm-amount">@item.Amount</span></td>
                            <td class="afm-extract">@(string.IsNullOrEmpty(item.ExtractRatio) ? "—" : item.ExtractRatio)</td>
                            <td class="afm-purpose">@(string.IsNullOrEmpty(item.Purpose) ? item.Benefit : item.Purpose)</td>
                            <td class="afm-td-right">
                                <div class="afm-row-actions">
                                    <button type="button" class="afm-icon-btn" @onclick="() => OpenEditIngredient(row)" title="Edit ingredient" aria-label="Edit @item.Name">
                                        <Icon Name="Edit3" Size="16" />
                                    </button>
                                    <button type="button" class="afm-icon-btn is-danger" @onclick="() => DeleteIngredientAsync(row)" title="Delete ingredient" aria-label="Delete @item.Name">
                                        <Icon Name="Trash2" Size="16" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!FilteredIngredients.Any())
                    {
                        <tr>
                            <td colspan="7" class="afm-empty">
                                <strong>No ingredients found</strong>
                                <span>@(ProductIngredients.Count == 0 ? "Use “Add Ingredient” to build this product's formulation." : "Try a different search or category.")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="afm-foot">Showing @FilteredIngredients.Count() of @ProductIngredients.Count ingredients</div>
    </div>
</div>

@* ======================================================================= *@
@* MODAL: ADD / EDIT INGREDIENT                                             *@
@* ======================================================================= *@
@if (_showIngredientModal)
{
    <div class="afm afm-overlay" @onclick="@(() => _showIngredientModal = false)">
        <div class="afm-modal" @onclick:stopPropagation role="dialog" aria-modal="true">
            <button type="button" class="afm-close" @onclick="@(() => _showIngredientModal = false)" aria-label="Close">
                <Icon Name="X" Size="16" />
            </button>

            <div class="afm-modal-head">
                <div class="afm-eyebrow">
                    <Icon Name="FlaskConical" Size="13" />
                    <span>@(_editingId is not null ? "Edit ingredient" : "New ingredient")</span>
                </div>
                <h3>@(_editingId is not null ? (string.IsNullOrEmpty(_form.Name) ? "Edit Ingredient" : _form.Name) : "Add Formulation Ingredient")</h3>
                <p>Name, botanical name, amount per daily serving and clinical benefit.</p>
            </div>

            <form @onsubmit="SaveIngredientAsync" @onsubmit:preventDefault>
                <div class="afm-modal-body">
                    <div class="afm-group"><span class="afm-step">1</span><span>Basic details</span></div>
                    <div class="afm-field">
                        <label>Product <span class="afm-req">*</span></label>
                        <select class="afm-select" @bind="_form.ProductId" required>
                            @foreach (var p in _products)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>

                    <div class="afm-field">
                        <label>Ingredient name <span class="afm-req">*</span></label>
                        <input type="text" class="afm-input" required placeholder="e.g. KSM-66® Ashwagandha Extract"
                               @bind="_form.Name" @bind:event="oninput" />
                    </div>

                    <div class="afm-grid2">
                        <div class="afm-field">
                            <label>Amount added <span class="afm-req">*</span></label>
                            <input type="text" class="afm-input" required placeholder="e.g. 600 mg"
                                   @bind="_form.Amount" @bind:event="oninput" />
                        </div>
                        <div class="afm-field">
                            <label>Category</label>
                            <select class="afm-select" @bind="_form.Category">
                                <option value="Adaptogens & Vigor">Adaptogens &amp; Vigor</option>
                                <option value="Nitric Oxide Boosters">Nitric Oxide Boosters</option>
                                <option value="Vitality & Stamina">Vitality &amp; Stamina</option>
                                <option value="Absorption & Bioavailability">Absorption &amp; Bioavailability</option>
                                <option value="Nutrient Base">Nutrient Base</option>
                                <option value="Botanical">Botanical</option>
                            </select>
                        </div>
                    </div>

                    <div class="afm-group"><span class="afm-step">2</span><span>Botanical details</span></div>
                    <div class="afm-grid2">
                        <div class="afm-field">
                            <label>Botanical (Latin) name</label>
                            <input type="text" class="afm-input afm-italic" placeholder="e.g. Withania somnifera"
                                   @bind="_form.BotanicalName" @bind:event="oninput" />
                        </div>
                        <div class="afm-field">
                            <label>Standardization / extract</label>
                            <input type="text" class="afm-input" placeholder="e.g. 10:1 Extract, >5% Withanolides"
                                   @bind="_form.ExtractRatio" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="afm-field">
                        <label>Active compound</label>
                        <input type="text" class="afm-input" placeholder="e.g. Withanolides & Withaferin A"
                               @bind="_form.ActiveCompound" @bind:event="oninput" />
                    </div>

                    <div class="afm-group"><span class="afm-step">3</span><span>Clinical benefit</span></div>
                    <div class="afm-field">
                        <label>Clinical mechanism &amp; purpose</label>
                        <textarea class="afm-textarea" rows="3" placeholder="e.g. Helps lower cortisol, supports testosterone and promotes restorative sleep."
                                  @bind="_form.Purpose" @bind:event="oninput"></textarea>
                    </div>

                    <div class="afm-entry-preview" aria-live="polite">
                        <span class="afm-label">How it will look</span>
                        <div class="afm-entry-row">
                            <div>
                                <div class="afm-ing-name">@(string.IsNullOrWhiteSpace(_form.Name) ? "Ingredient name" : _form.Name)</div>
                                <div class="afm-latin">@(string.IsNullOrWhiteSpace(_form.BotanicalName) ? "Botanical name" : _form.BotanicalName)</div>
                            </div>
                            <span class="afm-amount">@(string.IsNullOrWhiteSpace(_form.Amount) ? "Amount" : _form.Amount)</span>
                        </div>
                        <p class="afm-purpose">@(string.IsNullOrWhiteSpace(_form.Purpose) ? "The clinical purpose appears here." : _form.Purpose)</p>
                    </div>
                </div>

                <div class="afm-modal-foot">
                    <button type="button" class="afm-btn" @onclick="@(() => _showIngredientModal = false)">Cancel</button>
                    <button type="submit" class="afm-btn afm-btn-primary">@(_editingId is not null ? "Save Changes" : "Add to Formulation")</button>
                </div>
            </form>
        </div>
    </div>
}

@* ======================================================================= *@
@* MODAL: EDIT FORMULATION HIGHLIGHT CARDS                                  *@
@* ======================================================================= *@
@if (_showMetricsModal)
{
    <div class="afm afm-overlay" @onclick="@(() => { if (!_savingMetrics) _showMetricsModal = false; })">
        <div class="afm-modal is-wide" @onclick:stopPropagation role="dialog" aria-modal="true">
            <button type="button" class="afm-close" disabled="@_savingMetrics" @onclick="@(() => _showMetricsModal = false)" aria-label="Close">
                <Icon Name="X" Size="16" />
            </button>

            <div class="afm-modal-head">
                <div class="afm-eyebrow">
                    <Icon Name="SlidersHorizontal" Size="13" />
                    <span>Highlights</span>
                </div>
                <h3>Edit Highlight Cards</h3>
                <p>These four figures appear at the top of the public formulation page.</p>
            </div>

            <form @onsubmit="SaveMetricsAsync" @onsubmit:preventDefault>
                <div class="afm-modal-body">
                    <div class="afm-preview">
                        <span class="afm-label">Preview</span>
                        <div class="afm-metrics">
                            <div class="afm-metric" style="--accent:#1b1233">
                                <span class="afm-metric-label">@Or(_mf.TotalIngredients.Label, "Total Ingredients")</span>
                                <span class="afm-metric-value">
                                    @(_mf.TotalIngredients.UseAutoCount
                                        ? $"{ProductIngredients.Count} Botanicals"
                                        : Or(_mf.TotalIngredients.Value, $"{ProductIngredients.Count} Botanicals"))
                                </span>
                            </div>
                            <div class="afm-metric" style="--accent:#b45309">
                                <span class="afm-metric-label">@Or(_mf.DailyServing.Label, "Daily Serving Base")</span>
                                <span class="afm-metric-value">@Or(_mf.DailyServing.Value, "20,000 mg (20g)")</span>
                            </div>
                            <div class="afm-metric" style="--accent:#15803d">
                                <span class="afm-metric-label">@Or(_mf.Bioavailability.Label, "Bioavailability Catalyst")</span>
                                <span class="afm-metric-value">@Or(_mf.Bioavailability.Value, "BioPerine® +2000%")</span>
                            </div>
                            <div class="afm-metric" style="--accent:#5e209e">
                                <span class="afm-metric-label">@Or(_mf.Transparency.Label, "Public Transparency")</span>
                                <span class="afm-metric-value">@Or(_mf.Transparency.Value, "100% Unmasked")</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_metricsError))
                    {
                        <div class="afm-notice is-error">
                            <Icon Name="AlertCircle" Size="16" />
                            <span>@_metricsError</span>
                        </div>
                    }

                    <div class="afm-grid2">
                        <div class="afm-card-edit" style="--accent:#1b1233">
                            <h4>Card 1 · Total Ingredients</h4>
                            <div class="afm-field">
                                <label>Label</label>
                                <input type="text" class="afm-input" placeholder="e.g. Total Ingredients"
                                       @bind="_mf.TotalIngredients.Label" @bind:event="oninput" />
                            </div>
                            <div class="afm-field">
                                <label>Value</label>
                                <input type="text" class="afm-input" disabled="@_mf.TotalIngredients.UseAutoCount" placeholder="e.g. 17 Botanicals"
                                       @bind="_mf.TotalIngredients.Value" @bind:event="oninput" />
                            </div>
                            <label class="afm-check">
                                <input type="checkbox" checked="@_mf.TotalIngredients.UseAutoCount" @onchange="OnAutoCountChanged" />
                                <span>Count automatically from the table (@ProductIngredients.Count botanicals)</span>
                            </label>
                        </div>

                        <div class="afm-card-edit" style="--accent:#b45309">
                            <h4>Card 2 · Daily Serving</h4>
                            <div class="afm-field">
                                <label>Label</label>
                                <input type="text" class="afm-input" placeholder="e.g. Daily Serving Base"
                                       @bind="_mf.DailyServing.Label" @bind:event="oninput" />
                            </div>
                            <div class="afm-field">
                                <label>Value</label>
                                <input type="text" class="afm-input" placeholder="e.g. 20,000 mg (20g)"
                                       @bind="_mf.DailyServing.Value" @bind:event="oninput" />
                                <span class="afm-hint">Use mg and grams, e.g. 20,000 mg (20g).</span>
                            </div>
                        </div>

                        <div class="afm-card-edit" style="--accent:#15803d">
                            <h4>Card 3 · Bioavailability</h4>
                            <div class="afm-field">
                                <label>Label</label>
                                <input type="text" class="afm-input" placeholder="e.g. Bioavailability Catalyst"
                                       @bind="_mf.Bioavailability.Label" @bind:event="oninput" />
                            </div>
                            <div class="afm-field">
                                <label>Value</label>
                                <input type="text" class="afm-input" placeholder="e.g. BioPerine® +2000%"
                                       @bind="_mf.Bioavailability.Value" @bind:event="oninput" />
                                <span class="afm-hint">Highlights the key absorption enhancer.</span>
                            </div>
                        </div>

                        <div class="afm-card-edit" style="--accent:#5e209e">
                            <h4>Card 4 · Transparency</h4>
                            <div class="afm-field">
                                <label>Label</label>
                                <input type="text" class="afm-input" placeholder="e.g. Public Transparency"
                                       @bind="_mf.Transparency.Label" @bind:event="oninput" />
                            </div>
                            <div class="afm-field">
                                <label>Value</label>
                                <input type="text" class="afm-input" placeholder="e.g. 100% Unmasked"
                                       @bind="_mf.Transparency.Value" @bind:event="oninput" />
                                <span class="afm-hint">Shows there are no proprietary blends.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="afm-modal-foot">
                    <button type="button" class="afm-btn afm-spacer" disabled="@_savingMetrics" @onclick="ResetMetricsAsync" title="Reset to the 4 default cards">
                        <Icon Name="RotateCcw" Size="15" />
                        <span>Restore Defaults</span>
                    </button>
                    <button type="button" class="afm-btn" disabled="@_savingMetrics" @onclick="@(() => _showMetricsModal = false)">Cancel</button>
                    <button type="submit" class="afm-btn afm-btn-primary" disabled="@_savingMetrics">
                        @if (_savingMetrics)
                        {
                            <Icon Name="RefreshCw" Size="15" Class="animate-spin" />
                            <span>Saving...</span>
                        }
                        else
                        {
                            <Icon Name="Save" Size="15" />
                            <span>Save Highlights</span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public List<FormulationIngredientDto> Ingredients { get; set; } = new();
    [Parameter] public FormulationMetricsDto Metrics { get; set; } = new();
    [Parameter] public EventCallback<List<FormulationIngredientDto>> IngredientsChanged { get; set; }
    [Parameter] public EventCallback<FormulationMetricsDto> MetricsChanged { get; set; }

    private string _search = "";
    private string _categoryFilter = "All";
    private string _feedback = "";
    private int _feedbackToken;

    private bool _showIngredientModal;
    private string? _editingId;
    private FormulationIngredientDto _form = new() { Category = "Adaptogens & Vigor" };

    private bool _showMetricsModal;
    private bool _savingMetrics;
    private string? _metricsError;
    private FormulationMetricsDto _mf = new();

    private static string Or(string? v, string fallback) => string.IsNullOrEmpty(v) ? fallback : v;

    private List<ProductDto> _products = new();
    private bool _productsLoading = true;
    private string _productId = "";

    private string? DefaultProductId => (_products.FirstOrDefault(p => p.Status == "active") ?? _products.FirstOrDefault())?.Id;
    private List<FormulationIngredientDto> ProductIngredients => Ingredients.Where(i => FormulationScope.Belongs(i, _productId, DefaultProductId)).ToList();
    private int IngredientCount(string productId) => Ingredients.Count(i => FormulationScope.Belongs(i, productId, DefaultProductId));

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.AdminProductsAsync();
        _products = res.Success ? res.Products.OrderBy(p => p.Price).ToList() : new();
        _productsLoading = false;
        _productId = DefaultProductId ?? "";
        // Legacy rows have no product: pin them to the default product so they stay with it when more products are added.
        foreach (var i in Ingredients.Where(i => string.IsNullOrEmpty(i.ProductId))) i.ProductId = DefaultProductId;
    }

    private void SelectProduct(string id) { _productId = id; _categoryFilter = "All"; _search = ""; }

    private FormulationIngredientDto NewIngredient() => new() { Category = "Adaptogens & Vigor", ProductId = _productId };

    private static FormulationIngredientDto CloneIngredient(FormulationIngredientDto s) => new()
    {
        Id = s.Id, ProductId = s.ProductId, Name = s.Name, BotanicalName = s.BotanicalName, Amount = s.Amount, Category = s.Category,
        Benefit = s.Benefit, ExtractRatio = s.ExtractRatio, Purpose = s.Purpose, ActiveCompound = s.ActiveCompound,
    };

    private static FormulationMetricDto CloneMetric(FormulationMetricDto m) => new() { Label = m.Label, Value = m.Value, UseAutoCount = m.UseAutoCount };

    private IEnumerable<IReadOnlyList<string>> IngredientRows() => FilteredIngredients.Select(i => (IReadOnlyList<string>)new[] { i.Name, i.BotanicalName, string.IsNullOrEmpty(i.Category) ? "Botanical" : i.Category, i.Amount, i.ExtractRatio ?? "", i.ActiveCompound ?? "", i.Purpose ?? i.Benefit });
    private IEnumerable<FormulationIngredientDto> FilteredIngredients => ProductIngredients.Where(item =>
    {
        var matchesCategory = _categoryFilter == "All" || item.Category == _categoryFilter;
        var matchesSearch = string.IsNullOrWhiteSpace(_search) ||
            AdminFmt.Has(item.Name, _search) || AdminFmt.Has(item.BotanicalName, _search) ||
            AdminFmt.Has(item.Purpose, _search) || AdminFmt.Has(item.Category, _search);
        return matchesCategory && matchesSearch;
    });

    private async Task ShowFeedbackAsync(string message, int ms)
    {
        _feedback = message;
        var token = ++_feedbackToken;
        StateHasChanged();
        await Task.Delay(ms);
        if (token == _feedbackToken) { _feedback = ""; StateHasChanged(); }
    }

    // ---------------------------------------------------------------- ingredients
    private void OpenAddIngredient()
    {
        _editingId = null;
        _form = NewIngredient();
        _showIngredientModal = true;
    }

    private void OpenEditIngredient(FormulationIngredientDto item)
    {
        _editingId = string.IsNullOrEmpty(item.Id) ? item.Name : item.Id;
        _form = CloneIngredient(item);
        if (string.IsNullOrEmpty(_form.Category)) _form.Category = "Adaptogens & Vigor";
        _showIngredientModal = true;
    }

    private async Task SaveIngredientAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Amount))
        {
            _ = ShowFeedbackAsync("Error: Ingredient Name and Amount Added are required.", 3000);
            return;
        }

        List<FormulationIngredientDto> updated;
        if (_editingId is not null)
        {
            updated = Ingredients.Select(ing =>
                (!string.IsNullOrEmpty(ing.Id) && ing.Id == _editingId) || ing.Name == _editingId
                    ? new FormulationIngredientDto
                    {
                        Id = ing.Id, ProductId = _form.ProductId, Name = _form.Name, BotanicalName = _form.BotanicalName, Amount = _form.Amount, Category = _form.Category,
                        Benefit = ing.Benefit, ExtractRatio = _form.ExtractRatio, Purpose = _form.Purpose, ActiveCompound = _form.ActiveCompound,
                    }
                    : ing).ToList();
        }
        else
        {
            var added = CloneIngredient(_form);
            added.Id = $"ing-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            updated = Ingredients.Append(added).ToList();
        }

        _showIngredientModal = false;
        foreach (var i in updated.Where(i => string.IsNullOrEmpty(i.ProductId))) i.ProductId = DefaultProductId;
        if (!string.IsNullOrEmpty(_form.ProductId)) _productId = _form.ProductId; // follow the ingredient to its product
        await IngredientsChanged.InvokeAsync(updated);
        _feedback = "Saving formulation to cloud...";
        StateHasChanged();
        var res = await Api.AdminSaveIngredientsAsync(updated);
        await ShowFeedbackAsync(res.Success ? "✓ Formulation saved and published live!" : $"Error: {res.Message ?? "Formulation could not be saved."}", 4000);
    }

    private async Task DeleteIngredientAsync(FormulationIngredientDto item)
    {
        if (!await Browser.ConfirmAsync($"Are you sure you want to remove \"{item.Name}\" from the formulation table?")) return;
        var updated = Ingredients.Where(i => !string.IsNullOrEmpty(item.Id) ? i.Id != item.Id : i.Name != item.Name).ToList();
        await IngredientsChanged.InvokeAsync(updated);
        var res = await Api.AdminSaveIngredientsAsync(updated);
        await ShowFeedbackAsync(res.Success ? $"✓ Removed {item.Name}" : $"Error: {res.Message ?? "Could not save the change."}", 3000);
    }

    private async Task ResetIngredientsAsync()
    {
        var name = _products.FirstOrDefault(p => p.Id == _productId)?.Name ?? "this product";
        if (!await Browser.ConfirmAsync($"Reset the formulation of \"{name}\" to the 17 standard clinical defaults? Its custom entries will be overwritten.")) return;
        var defaults = AdminDefaults.Ingredients();
        foreach (var d in defaults) { d.ProductId = _productId; d.Id = $"{d.Id}-{_productId}"; }
        var updated = Ingredients.Where(i => !FormulationScope.Belongs(i, _productId, DefaultProductId)).Concat(defaults).ToList();
        await IngredientsChanged.InvokeAsync(updated);
        var res = await Api.AdminSaveIngredientsAsync(updated);
        await ShowFeedbackAsync(res.Success ? "✓ Reset to authentic clinical defaults" : $"Error: {res.Message ?? "Could not save the change."}", 3000);
    }

    // ---------------------------------------------------------------- metrics
    private void OpenEditMetrics()
    {
        _mf = new FormulationMetricsDto
        {
            TotalIngredients = new FormulationMetricDto
            {
                Label = Or(Metrics.TotalIngredients.Label, "Total Ingredients"),
                Value = Or(Metrics.TotalIngredients.Value, $"{ProductIngredients.Count} Botanicals"),
                UseAutoCount = Metrics.TotalIngredients.UseAutoCount,
            },
            DailyServing = new FormulationMetricDto { Label = Or(Metrics.DailyServing.Label, "Daily Serving Base"), Value = Or(Metrics.DailyServing.Value, "20,000 mg (20g)") },
            Bioavailability = new FormulationMetricDto { Label = Or(Metrics.Bioavailability.Label, "Bioavailability Catalyst"), Value = Or(Metrics.Bioavailability.Value, "BioPerine® +2000%") },
            Transparency = new FormulationMetricDto { Label = Or(Metrics.Transparency.Label, "Public Transparency"), Value = Or(Metrics.Transparency.Value, "100% Unmasked") },
        };
        _metricsError = null;
        _showMetricsModal = true;
    }

    private void OnAutoCountChanged(ChangeEventArgs e)
    {
        var on = e.Value is true || (e.Value?.ToString() ?? "").Equals("true", StringComparison.OrdinalIgnoreCase);
        _mf.TotalIngredients.UseAutoCount = on;
        if (on) _mf.TotalIngredients.Value = $"{ProductIngredients.Count} Botanicals";
    }

    private async Task SaveMetricsAsync()
    {
        _savingMetrics = true;
        _metricsError = null;
        var res = await Api.AdminSaveMetricsAsync(_mf);
        _savingMetrics = false;
        if (!res.Success)
        {
            _metricsError = res.Message ?? "Failed to save formulation metrics.";
            return;
        }
        await MetricsChanged.InvokeAsync(_mf);
        _showMetricsModal = false;
        await ShowFeedbackAsync("✓ Summary metric highlights saved successfully!", 3500);
    }

    private async Task ResetMetricsAsync()
    {
        if (!await Browser.ConfirmAsync("Reset all 4 formulation summary metrics to standard defaults?")) return;
        _mf = new FormulationMetricsDto();
        _savingMetrics = true;
        _metricsError = null;
        var res = await Api.AdminSaveMetricsAsync(_mf);
        _savingMetrics = false;
        if (!res.Success)
        {
            _metricsError = res.Message ?? "Failed to reset formulation metrics.";
            return;
        }
        await MetricsChanged.InvokeAsync(_mf);
        _showMetricsModal = false;
        await ShowFeedbackAsync("✓ Restored standard formulation metric defaults", 3500);
    }
}
