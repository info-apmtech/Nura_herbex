@inject NavigationManager Nav
@inject BrowserInterop Browser
@inject CartState Cart
@inject ApiClient Api
@inject Microsoft.JSInterop.IJSRuntime Js

@* =================================================================== *@
@* STAGE 2: FULL PRODUCT DETAIL & ORDER PAGE (AMAZON ADAPTATION)        *@
@* =================================================================== *@
<div class="animate-in fade-in duration-300 font-sans">

  @* Top Navigation & Breadcrumbs (Clean Nura Herbex Style) *@
  <div class="flex items-center justify-between pb-6 mb-8 border-b border-white/10">
    <button @onclick="BackToPreview"
            class="flex items-center gap-2 text-xs font-bold text-purple-400 hover:text-purple-300 transition-colors cursor-pointer">
      <Icon Name="ArrowLeft" Size="14" />
      <span>Back to Shop</span>
    </button>

    <nav class="flex items-center gap-2 text-xs text-slate-400 font-medium">
      <button @onclick="GoHome" class="hover:text-white transition-colors cursor-pointer">
        Home
      </button>
      <Icon Name="ChevronRight" Size="12" Class="text-slate-600" />
      <button @onclick="BackToPreview" class="hover:text-white transition-colors cursor-pointer">
        Shop
      </button>
      <Icon Name="ChevronRight" Size="12" Class="text-slate-600" />
      <span class="text-purple-300 font-semibold">Stamix™ Botanical Vitality Formula</span>
    </nav>
  </div>

  @* 3-Column Product Detail & Order Layout (Adapted Layout, Dark Aesthetic) *@
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 xl:gap-8 mb-16 items-start">

    @* =============================================================== *@
    @* COLUMN 1: LEFT GALLERY (Vertical Thumbnails + Main Viewport)    *@
    @* =============================================================== *@
    <div class="lg:col-span-5 flex flex-row gap-3 items-start">

      @* Vertical Thumbnail Strip *@
      <div class="flex flex-col gap-2.5 shrink-0">
        @for (var idx = 0; idx < ProductImages.Length; idx++)
        {
          var i = idx;
          var img = ProductImages[i];
          <button @key="img.Id" @onclick="() => _activeImageIndex = i" @onmouseover="() => _activeImageIndex = i"
                  class="@($"w-12 h-14 sm:w-14 sm:h-16 rounded-xl border p-1 bg-[#0d0a18] flex items-center justify-center transition-all cursor-pointer {(_activeImageIndex == i ? "border-purple-500 ring-2 ring-purple-500/40 shadow-lg shadow-purple-900/30" : "border-white/10 hover:border-white/20 opacity-70 hover:opacity-100")}")"
                  title="@img.ThumbLabel">
            <img src="@img.Src" alt="@img.ThumbLabel" class="max-h-full max-w-full object-contain" />
          </button>
        }
      </div>

      @* Main Product Viewport with Zoom *@
      <div id="shop-zoom-viewport"
           class="relative flex-1 rounded-2xl border border-white/10 bg-gradient-to-b from-[#130f24] via-[#0b0816] to-[#07050d] p-4 sm:p-6 flex flex-col items-center justify-center min-h-[420px] sm:min-h-[480px] group overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.8)]"
           @onmouseenter="OnZoomEnter"
           @onmouseleave="() => _isZoomed = false"
           @onmousemove="OnMouseMove">
        <div class="absolute inset-0 bg-radial from-purple-600/15 via-transparent to-transparent pointer-events-none"></div>

        @* Share Button *@
        <button @onclick="ShareAsync"
                title="Share product"
                class="absolute top-4 right-4 z-10 p-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors border border-white/10 cursor-pointer">
          <Icon Name="Share2" Size="16" />
        </button>

        @* Product Mockup Image *@
        <div class="relative w-full h-[340px] sm:h-[400px] flex items-center justify-center overflow-hidden">
          <img src="@ProductImages[_activeImageIndex].Src"
               alt="@ProductImages[_activeImageIndex].Title"
               class="@($"max-h-full max-w-full object-contain filter drop-shadow-[0_20px_35px_rgba(0,0,0,0.9)] transition-transform duration-300 ease-out cursor-crosshair {(_isZoomed ? "scale-140" : "scale-100")}")"
               style="@(_isZoomed ? $"transform-origin: {ZoomX}% {ZoomY}%" : null)" />
        </div>

        <div class="text-[11px] text-slate-400 mt-3 flex items-center gap-1.5 select-none opacity-80 group-hover:opacity-100 transition-opacity">
          <Icon Name="Eye" Size="12" Class="text-purple-400" />
          <span>Hover to magnify label</span>
        </div>
      </div>

    </div>

    @* =============================================================== *@
    @* COLUMN 2: CENTER PRODUCT DETAILS & SPECIFICATIONS                *@
    @* =============================================================== *@
    <div class="lg:col-span-4 xl:col-span-4 flex flex-col gap-4">

      @* Header Tag & Title *@
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#9929ea]/20 border border-[#cc66da]/40 text-[#fff3bf] text-[11px] font-bold uppercase tracking-widest mb-2 shadow-sm font-heading">
          <Icon Name="Sparkles" Size="12" /> BEST SELLER
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-[#fff3bf] tracking-tight leading-tight mb-1 font-heading">
          Stamix™ Botanical Vitality Formula
        </h1>
        <p class="text-xs sm:text-sm text-[#cc66da] font-medium">
          15-Day Supply (300g) · Botanical Vitality Formula for Men
        </p>
      </div>

      @* Published customer rating *@
      <div class="flex items-center gap-2 text-xs pb-3 border-b border-white/10">
        @if (_loadingReviews)
        {
          <span class="text-slate-400">Loading customer reviews…</span>
        }
        else if (_customerReviews.Count > 0)
        {
          <div class="flex items-center gap-1 text-[#fff3bf]" aria-label="@($"{AverageReviewRating:0.0} average from {_customerReviews.Count} published reviews")">
            @for (var i = 0; i < 5; i++)
            {
              <Icon Name="Star" Size="14" Class="@(i < (int)Math.Round(AverageReviewRating, MidpointRounding.AwayFromZero) ? "fill-current text-[#fff3bf]" : "text-slate-500")" />
            }
          </div>
          <span class="font-bold text-white text-sm">@AverageReviewRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
          <span class="text-slate-400">(@_customerReviews.Count published @(_customerReviews.Count == 1 ? "review" : "reviews"))</span>
        }
        else
        {
          <span class="text-slate-400">No customer reviews published yet</span>
        }
      </div>

      @* Price Display *@
      <div class="space-y-1 pb-4 border-b border-white/10">
        <div class="flex items-baseline gap-3">
          <span class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            ₹@(Fmt(Price))
          </span>
          <span class="text-base text-slate-500 line-through">
            ₹@(Fmt(OriginalPrice))
          </span>
        </div>
        <p class="text-xs text-slate-400">
          Inclusive of all taxes · Free pan-India delivery
        </p>
      </div>

      @* Clinical Description *@
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        Stamix is a herbal health supplement for adult men — 17 botanicals, herbs, seeds and nuts, at a full 20 g daily serving. Expertly formulated to support everyday energy, stamina, focus and recovery.
      </p>

      @* Specifications Grid *@
      <div class="p-4 rounded-xl bg-white/[0.02] border border-white/10 space-y-2 text-xs">
        <div class="grid grid-cols-2">
          <span class="text-slate-400">Brand</span>
          <span class="font-semibold text-white">Nura Herbex</span>
        </div>
        <div class="grid grid-cols-2">
          <span class="text-slate-400">Serving Size</span>
          <span class="font-semibold text-white">20g Daily (10g Twice Daily)</span>
        </div>
        <div class="grid grid-cols-2">
          <span class="text-slate-400">Net Quantity</span>
          <span class="font-semibold text-white">300g (15 Servings · 15-Day Supply)</span>
        </div>
        <div class="grid grid-cols-2">
          <span class="text-slate-400">Item Form</span>
          <span class="font-semibold text-white">Herbal Health Supplement Powder</span>
        </div>
        <div class="grid grid-cols-2">
          <span class="text-slate-400">Formulation</span>
          <span class="font-semibold text-emerald-400">Formulated on Unani Principles</span>
        </div>
      </div>

      @* Dynamic Active Batch Verification Card *@
      <div class="pt-1">
        <button type="button" @onclick="GoLatestBatch"
                class="w-full p-3 rounded-xl bg-purple-950/40 hover:bg-purple-900/50 border border-purple-500/30 hover:border-purple-400/60 flex items-center justify-between px-4 text-left transition-all cursor-pointer group shadow-sm shadow-purple-950/20"
                title="Click to view batch certificate">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
              <Icon Name="ShieldCheck" Size="18" />
            </div>
            <div class="min-w-0">
              <span class="text-[10px] font-mono text-purple-300 uppercase tracking-wider block leading-none mb-0.5">
                Verified Active Batch
              </span>
              <span class="text-sm font-mono font-bold text-white group-hover:text-purple-200 truncate block">
                @(string.IsNullOrEmpty(_latestBatchNo) ? "Verify Batch Certificate" : $"#{_latestBatchNo}")
              </span>
            </div>
          </div>
          <Icon Name="ChevronRight" Size="16" Class="text-purple-400 group-hover:translate-x-0.5 transition-transform shrink-0" />
        </button>
      </div>

    </div>

    @* =============================================================== *@
    @* COLUMN 3: RIGHT ORDER BOX (Matches Website Dark Theme)          *@
    @* =============================================================== *@
    <div class="lg:col-span-3 xl:col-span-3 lg:sticky lg:top-24">
      <div class="rounded-2xl border border-white/10 bg-[#0d0a18]/90 backdrop-blur-xl p-5 shadow-2xl space-y-4">

        @* Stock Status *@
        <div class="flex items-center gap-2 text-xs">
          @if (InStock)
          {
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-bold text-emerald-400">In Stock · Ready to Dispatch</span>
          }
          else
          {
            <span class="w-2 h-2 rounded-full bg-red-400"></span>
            <span class="font-bold text-red-400">Currently Out of Stock</span>
          }
        </div>

        @* Delivery Info *@
        <div class="space-y-1 text-xs text-slate-300">
          <div class="flex items-center gap-1.5">
            <Icon Name="Truck" Size="13" Class="text-purple-400 shrink-0" />
            <span>Free Express Pan-India Delivery</span>
          </div>
          <p class="text-[11px] text-slate-400 pl-4">
            Expected delivery within 2–3 business days
          </p>
        </div>

        @* Quantity Selector *@
        <div class="flex items-center justify-between text-xs pt-1">
          <span class="font-bold text-slate-300">Quantity:</span>
          <div class="flex items-center rounded-xl bg-white/5 border border-white/15 p-1">
            <button type="button" @onclick="() => _quantity = Math.Max(1, _quantity - 1)"
                    disabled="@(_quantity <= 1)"
                    class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-300 hover:text-white hover:bg-white/10 active:scale-95 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-slate-500 transition-all cursor-pointer"
                    aria-label="Decrease quantity">
              <Icon Name="Minus" Size="13" />
            </button>
            <span class="w-8 text-center text-sm font-bold text-white font-mono select-none">
              @_quantity
            </span>
            <button type="button" @onclick="() => _quantity = Math.Min(10, _quantity + 1)"
                    disabled="@(_quantity >= 10)"
                    class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-300 hover:text-white hover:bg-white/10 active:scale-95 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-slate-500 transition-all cursor-pointer"
                    aria-label="Increase quantity">
              <Icon Name="Plus" Size="13" />
            </button>
          </div>
        </div>

        @* Button Stack: ADD TO CART, BUY IT NOW, VERIFY PRODUCT *@
        <div class="space-y-2.5 pt-2">
          <button @onclick="AddToCart"
                  class="w-full py-3.5 px-4 rounded-xl bg-[#9929ea] hover:bg-[#a93df0] active:bg-[#851ecc] text-white font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg shadow-[#9929ea]/30 transition-all hover:scale-[1.01] cursor-pointer font-heading">
            <Icon Name="ShoppingBag" Size="16" />
            <span>ADD TO CART</span>
          </button>

          <button @onclick="InstantBuy"
                  class="w-full py-3 px-4 rounded-xl bg-[#9929ea] hover:bg-[#a83bed] active:bg-[#851ecc] text-white font-black text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-md shadow-[#9929ea]/30 transition-all hover:scale-[1.01] cursor-pointer font-heading">
            <span>BUY IT NOW</span>
            <Icon Name="ExternalLink" Size="14" />
          </button>

          <button @onclick="@(() => Nav.NavigateTo("/quality-reports"))"
                  class="w-full py-3 px-4 rounded-xl bg-white/5 hover:bg-white/10 active:bg-white/15 border border-purple-500/30 hover:border-purple-500/60 text-purple-200 hover:text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all hover:scale-[1.01] cursor-pointer"
                  title="View Stamix product quality and batch lab reports">
            <Icon Name="ShieldCheck" Size="15" Class="text-emerald-400" />
            <span>VIEW QUALITY &amp; BATCH REPORTS</span>
          </button>
        </div>

      </div>
    </div>

  </div>

  @* =============================================================== *@
  @* BELOW THE FOLD: TABBED SPECIFICATIONS & REVIEWS (DARK THEME)    *@
  @* =============================================================== *@
  <div id="shop-tabs" class="mt-16 pt-12 border-t border-white/10">

    @* Tab Navigation Header *@
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar border-b border-white/10">
      @foreach (var tab in Tabs)
      {
        var t = tab.Id;
        <button @key="t" @onclick="() => _activeTab = t"
                class="@($"px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider whitespace-nowrap transition-all cursor-pointer {(_activeTab == t ? "bg-white text-black shadow-lg shadow-white/20" : "text-slate-400 hover:text-white bg-white/[0.02] hover:bg-white/5 border border-white/5")}")">
          @tab.Label
        </button>
      }
    </div>

    @* Tab 1: Product Overview *@
    @if (_activeTab == "overview")
    {
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-2 space-y-6">
          <h3 class="text-2xl font-bold text-white">
            Botanical Vitality Formula for Men
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Stamix™ is a herbal health supplement for adult men — 17 botanicals, herbs, seeds and nuts, at a full 20 g daily serving. Expertly formulated on traditional Unani principles to support everyday energy, stamina, focus and recovery.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            @foreach (var benefit in Benefits)
            {
              <div class="flex items-start gap-2.5 text-xs text-slate-300">
                <div class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                  <Icon Name="Check" Size="11" />
                </div>
                <span>@benefit</span>
              </div>
            }
          </div>
        </div>

        @* "What's in the Box" Card *@
        <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/10 space-y-4">
          <h4 class="text-sm font-bold text-white uppercase tracking-wider">
            What's In The Package
          </h4>
          <ul class="space-y-2.5 text-xs text-slate-300">
            <li class="flex items-center gap-2">
              <span class="text-purple-400 font-mono font-bold">•</span>
              <span>1 × Stamix 300g Canister (15-Day Supply)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-purple-400 font-mono font-bold">•</span>
              <span>1 × Precision 10g Measuring Scoop</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-purple-400 font-mono font-bold">•</span>
              <span>1 × 15-Day Routine &amp; Usage Protocol Guide</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-purple-400 font-mono font-bold">•</span>
              <span>1 × Authentic QR Verified ICP-MS Batch Certificate</span>
            </li>
          </ul>

        </div>
      </div>
    }

    @* Tab 2: Nutrition Facts *@
    @if (_activeTab == "nutrition")
    {
      <div class="max-w-3xl space-y-6">
        <div>
          <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider block mb-1">
            Certified Label Analysis
          </span>
          <h3 class="text-2xl font-bold text-white">
            Nutrition Facts (Approx Value Per 100g)
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            Directly extracted from authentic packaging label (Mockup 2).
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 overflow-hidden bg-white/[0.02]">
          <div class="grid grid-cols-2 p-3.5 bg-purple-900/20 border-b border-white/10 text-xs font-bold text-purple-300">
            <span>NUTRIENTS</span>
            <span class="text-right">QUANTITY PER 100G</span>
          </div>

          @foreach (var row in NutritionRows)
          {
            <div class="@($"grid grid-cols-2 p-3 text-xs border-b border-white/5 {(row.Indent ? "text-slate-400 pl-6 bg-white/[0.01]" : "text-slate-200")}")">
              <span class="font-medium">@row.Name</span>
              <span class="text-right font-mono font-bold text-white">@row.Value</span>
            </div>
          }
        </div>

        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-200 space-y-1">
          <p class="font-bold">ALLERGEN NOTICE (From Label):</p>
          <p class="text-slate-300">
            Contains: Almonds, Walnuts, Pistachios.
          </p>
          <p class="text-slate-400 text-[11px] pt-1">
            Not recommended for children, pregnant or lactating women.
          </p>
        </div>
      </div>
    }

    @* Tab 3: 17 Botanicals *@
    @if (_activeTab == "ingredients")
    {
      <div class="space-y-6">
        <div>
          <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider block mb-1">
            17 Botanicals, Herbs, Seeds &amp; Nuts
          </span>
          <h3 class="text-2xl font-bold text-white">
            The Complete 17-Botanical Formula
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          @for (var idx = 0; idx < Botanicals.Length; idx++)
          {
            var item = Botanicals[idx];
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-purple-500/30 transition-all flex items-start gap-3">
              <div class="w-6 h-6 rounded-lg bg-purple-500/20 text-purple-300 font-mono text-xs flex items-center justify-center shrink-0">
                @(idx + 1)
              </div>
              <div>
                <h4 class="font-bold text-sm text-white">@item.Name</h4>
                <p class="text-xs text-slate-400 mt-0.5">@item.Role</p>
              </div>
            </div>
          }
        </div>
      </div>
    }

    @* Tab 4: Directions & Dosage *@
    @if (_activeTab == "dosage")
    {
      <div class="max-w-3xl space-y-6">
        <div>
          <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider block mb-1">
            Official Intake Protocol
          </span>
          <h3 class="text-2xl font-bold text-white">
            Directions of Use &amp; Recommended Dosage
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-6 rounded-2xl bg-purple-900/20 border border-purple-500/30 space-y-2">
            <div class="flex items-center gap-2 text-purple-300 font-bold text-sm">
              <Icon Name="Clock" Size="16" /> RECOMMENDED DOSAGE
            </div>
            <p class="text-lg font-bold text-white">
              2 heaping spoons (20 grams) per day
            </p>
            <p class="text-xs text-slate-300">
              Use the included precision stainless scoop for accurate measurement.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
              <Icon Name="FlaskConical" Size="16" /> MIXING DIRECTIONS
            </div>
            <p class="text-sm font-semibold text-white">
              Mix one heaping tablespoon with 200ml–250ml milk or water.
            </p>
            <p class="text-xs text-slate-300">
              Stir well or shake in shaker bottle. Consume twice a day.
            </p>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-black/40 border border-white/10 space-y-3 text-xs text-slate-300">
          <h4 class="font-bold text-white text-sm">STORAGE INSTRUCTIONS:</h4>
          <p>• Store in a cool, dry place, away from direct sunlight.</p>
          <p>• Keep away from reach of children.</p>
          <p class="text-amber-400 font-semibold">• DO NOT REFRIGERATE. KEEP OUT OF CHILDREN'S REACH.</p>
          <p>• Herbal Health Supplement - Adults. Not for medicinal use.</p>
        </div>
      </div>
    }

    @* Tab 5: Certifications & Quality *@
    @if (_activeTab == "quality")
    {
      <div class="max-w-3xl space-y-6">
        <div>
          <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider block mb-1">
            Government &amp; Independent Standards
          </span>
          <h3 class="text-2xl font-bold text-white">
            Verified Manufacturing Standards
          </h3>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          @foreach (var item in Certifications)
          {
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/10 space-y-1">
              <span class="text-[10px] font-mono font-bold text-purple-400 uppercase">
                @item.Badge
              </span>
              <h4 class="font-bold text-sm text-white">@item.Title</h4>
              <p class="text-xs text-slate-400">@item.Desc</p>
            </div>
          }
        </div>
      </div>
    }

    @* Tab 6: Customer Reviews *@
    @if (_activeTab == "reviews")
    {
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-2xl font-bold text-white">Customer reviews</h3>
            <p class="text-xs text-slate-400">Reviews are published after our team has reviewed them.</p>
          </div>
          <button type="button" @onclick='() => Nav.NavigateTo("/account/reviews")'
                  class="px-4 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs tracking-wide">
            Write a review
          </button>
        </div>

        @if (_loadingReviews)
        {
          <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 text-center text-sm text-slate-400">Loading published reviews…</div>
        }
        else if (_customerReviews.Count == 0)
        {
          <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-8 sm:p-10 text-center">
            <Icon Name="MessageSquare" Size="26" Class="text-purple-300 mx-auto mb-3" />
            <h4 class="text-white font-semibold text-base mb-2">Be the first to share your experience</h4>
            <p class="text-slate-400 text-sm max-w-lg mx-auto mb-5">Sign in to your account to submit a review. Reviews are shown here after approval.</p>
            <button type="button" @onclick='() => Nav.NavigateTo("/account/reviews")'
                    class="px-5 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs tracking-wide">
              Go to account reviews
            </button>
          </div>
        }
        else
        {
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          @foreach (var rev in _customerReviews)
          {
            <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/10 space-y-2.5">
              <div class="flex justify-between items-start">
                <div>
                  <h4 class="font-bold text-sm text-white">@rev.Name</h4>
                  @if (!string.IsNullOrWhiteSpace(rev.City))
                  {
                    <span class="text-[10px] text-purple-300">@rev.City</span>
                  }
                </div>
                <div class="flex text-yellow-400">
                  @for (var s = 0; s < Math.Clamp(rev.Rating, 0, 5); s++)
                  {
                    <Icon Name="Star" Size="12" Fill="currentColor" Class="fill-current" />
                  }
                </div>
              </div>
              @if (!string.IsNullOrWhiteSpace(rev.Title))
              {
                <h4 class="text-sm font-semibold text-white">@rev.Title</h4>
              }
              <p class="text-xs text-slate-300 leading-relaxed">@rev.Body</p>
              <div class="text-[10px] text-slate-500 font-medium">
                @(rev.CreatedAt != default ? rev.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") : "Published")
              </div>
            </div>
          }
          </div>
        }
      </div>
    }

    @* Tab 7: FAQs *@
    @if (_activeTab == "faqs")
    {
      <div class="max-w-3xl space-y-4">
        <h3 class="text-2xl font-bold text-white mb-4">Frequently Asked Questions</h3>
        @for (var idx = 0; idx < Faqs.Length; idx++)
        {
          var i = idx;
          var faq = Faqs[i];
          <div @key="i" class="rounded-2xl bg-white/[0.02] border border-white/10 overflow-hidden">
            <button @onclick="() => _openFaq = (_openFaq == i ? null : i)"
                    class="w-full p-4 sm:p-5 text-left flex items-center justify-between font-bold text-sm text-white hover:text-purple-300 transition-colors cursor-pointer">
              <span>@faq.Q</span>
              <Icon Name="ChevronDown" Size="16"
                    Class="@($"transition-transform duration-300 {(_openFaq == i ? "rotate-180 text-purple-400" : "text-slate-500")}")" />
            </button>
            @if (_openFaq == i)
            {
              <div class="px-5 pb-5 text-xs text-slate-300 leading-relaxed border-t border-white/5 pt-3 animate-in fade-in">
                @faq.A
              </div>
            }
          </div>
        }
      </div>
    }
  </div>
</div>

