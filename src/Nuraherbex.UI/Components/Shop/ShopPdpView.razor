    private bool InStock => ActiveProduct is { Status: "active" } && ActiveProduct.StockQuantity >= _quantity;
    private decimal AverageReviewRating => _customerReviews.Count == 0 ? 0m : _customerReviews.Average(r => (decimal)Math.Clamp(r.Rating, 1, 5));

    private static string Fmt(decimal v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var batches = await Api.GetBatchesAsync();
            if (batches is { Count: > 0 })
            {
                var newest = batches[0];
                var bNo = string.IsNullOrEmpty(newest.BatchNo) ? newest.Id : newest.BatchNo;
                if (!string.IsNullOrEmpty(bNo)) _latestBatchNo = bNo;
            }
        }
        catch
        {
            // batch link simply stays generic
        }

        _customerReviews = await Api.GetReviewsAsync();
        _loadingReviews = false;
    }

    private async Task BackToPreview()
    {
        Nav.NavigateTo("/shop");
        await Browser.ScrollToTopAsync();
    }

    private void GoHome() => Nav.NavigateTo("/");

    private void GoLatestBatch() =>
        Nav.NavigateTo(string.IsNullOrEmpty(_latestBatchNo) ? "/quality-reports" : $"/quality-reports/{Uri.EscapeDataString(_latestBatchNo)}");

    private async Task OnZoomEnter()
    {
        _isZoomed = true;
        try
        {
            _zoomRect = await Js.InvokeAsync<double[]?>("nura.getRect", "shop-zoom-viewport");
        }
        catch { _zoomRect = null; }
    }

    private void OnMouseMove(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (_zoomRect is not { Length: 4 } r || r[2] <= 0 || r[3] <= 0) return;
        ZoomX = (e.ClientX - r[0]) / r[2] * 100;
        ZoomY = (e.ClientY - r[1]) / r[3] * 100;
    }

    private async Task ShareAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("nura.share", "Stamix Vitality Formula", Nav.Uri);
        }
        catch
        {
            await Browser.CopyToClipboardAsync(Nav.Uri);
        }
    }

    private CartItem BuildCartItem(bool subscription) => new()
    {
        Id = SelectedProtocolId,
        VariantId = SelectedVariantId,
        Name = ActiveProduct?.Name ?? "Stamix",
        Price = Price,
        Image = ActiveProduct?.ImageUrl ?? ProductImages[0].Src,
        ServingsText = "15-Day Supply · Botanical Vitality Formula",
        Quantity = _quantity,
        IsSubscription = subscription,
    };

    private async Task AddToCart() { if (InStock) await Cart.AddToCartAsync(BuildCartItem(IsSubscription), _quantity); }

    private async Task InstantBuy()
    {
        if (!InStock) return;
        await Cart.AddToCartAsync(BuildCartItem(false), _quantity);
        Nav.NavigateTo("/checkout");
    }

