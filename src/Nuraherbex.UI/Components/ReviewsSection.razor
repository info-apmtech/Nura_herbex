@inject ApiClient Api
@inject ModalState ModalState

<section class="py-24 sm:py-32 bg-[#06040a] relative z-10 text-left overflow-hidden" id="testimonials">
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-[radial-gradient(circle,rgba(88,28,135,0.15)_0%,transparent_70%)] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">

    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12 px-4">
      <span class="text-sm font-medium text-purple-300 block mb-3 tracking-wide">
        Real Stories
      </span>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-4">
        Voices of the
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-fuchsia-400 to-indigo-400">
          Stamix Movement
        </span>
      </h2>

      <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-xl mx-auto font-light">
        Authentic experiences from men who made Stamix part of their daily ritual.
      </p>
    </div>

    <div class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap pb-2 mb-12 sm:mb-14">
      @foreach (var tag in FilterTags)
      {
        var t = tag;
        var isActive = _selectedTag == t;
        <button
          @key="t"
          type="button"
          @onclick="() => _selectedTag = t"
          class="@($"px-5 py-1.5 rounded-full text-xs sm:text-sm font-medium transition-all duration-300 cursor-pointer {(isActive ? "bg-[#d8b4fe] text-[#0d091a] font-semibold shadow-md shadow-purple-900/30" : "bg-[#0f0c18] border border-white/10 text-slate-400 hover:text-white hover:border-white/20")}")">
          @t
        </button>
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      @foreach (var r in FilteredReviews)
      {
        <div
          @key="r.Id"
          class="p-7 sm:p-8 rounded-[24px] bg-[#0c0a14] border border-white/10 hover:border-purple-500/30 transition-all duration-300 flex flex-col justify-between shadow-xl group">
          <div>
            <div class="flex items-start justify-between mb-5">
              <div class="flex items-center gap-3.5">
                @if (!string.IsNullOrEmpty(r.Avatar))
                {
                  <img
                    src="@r.Avatar"
                    alt="@r.Author"
                    class="w-12 h-12 rounded-full object-cover border border-white/15 shrink-0"
                    loading="lazy"
                    decoding="async" />
                }
                else
                {
                  <div class="w-12 h-12 rounded-full border border-white/15 shrink-0 bg-[#1e1435] text-purple-300 font-bold flex items-center justify-center">
                    @Initial(r.Author)
                  </div>
                }
                <div>
                  <h4 class="text-white font-bold text-sm sm:text-base leading-snug">
                    @r.Author
                  </h4>
                  <div class="text-slate-400 text-xs mb-1">
                    @r.Location
                  </div>
                  <div class="flex items-center gap-0.5 text-[#a855f7]">
                    @for (var i = 0; i < r.Rating; i++)
                    {
                      <Icon Name="Star" Size="13" Fill="currentColor" Class="fill-[#a855f7] text-[#a855f7]" />
                    }
                  </div>
                </div>
              </div>

              <svg class="w-8 h-8 text-white/15 shrink-0 select-none group-hover:text-purple-400/25 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>

            <p class="text-xs sm:text-[13.5px] text-slate-300 leading-relaxed font-light mt-4">
              "@r.Quote"
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5">
            <span class="text-[11px] font-medium text-purple-300 bg-[#1e1435] border border-purple-500/25 px-3 py-1 rounded-md inline-block">
              @r.Tag
            </span>
          </div>
        </div>
      }
    </div>

  </div>
</section>

@code {
    private record ReviewCard(string Id, string Author, string Location, string? Avatar, int Rating, string Tag, string Quote);

    private static readonly string[] FilterTags = { "All", "Energy", "Stress", "Recovery", "Vitality", "Focus", "General" };

    private static readonly ReviewCard[] StaticReviews =
    {
        new("r1", "Rajesh Kumar", "Chennai, India", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80", 5, "Energy",
            "I started taking Stamix a few weeks ago and honestly, the mid-afternoon energy slumps that used to ruin my productivity are pretty much gone. It feels like a clean, steady boost that actually lasts through my entire shift without any jitters."),
        new("r2", "Amit Shah", "Ahmedabad, India", "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80", 5, "Energy",
            "I have been taking Stamix for a month and finally feel like I have a consistent flow of energy throughout my workday without the typical afternoon crash."),
        new("r3", "Vikram Iyer", "Pune, India", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&auto=format&fit=crop&q=80", 5, "Stress",
            "Work stress used to wreck my evenings. Stamix took the edge off without making me feel numb — I'm more present with my family now."),
        new("r4", "Arun Patel", "Bengaluru, India", "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=150&auto=format&fit=crop&q=80", 5, "Recovery",
            "Lifting heavy 5 days a week used to leave me sore for days. With Stamix, DOMS recovery is noticeable within 24 hours. Strength progression has stayed consistent."),
        new("r5", "Sameer Sen", "Mumbai, India", "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=150&auto=format&fit=crop&q=80", 5, "Vitality",
            "Waking up with real drive without needing three cups of coffee is a game changer. My HRV has improved and overall stamina is through the roof."),
        new("r6", "Deepak Roy", "Delhi, India", "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=150&auto=format&fit=crop&q=80", 5, "Focus",
            "As a software architect, cognitive endurance is everything. Stamix delivers a sustained, calm focus that carries me through intense 10-hour coding sprints."),
        new("r7", "Nikhil Verma", "Hyderabad, India", "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80", 5, "General",
            "The formulation transparency and medical-grade sourcing sold me. Within 30 days, my vitality and day-to-day resilience transformed completely."),
    };

    private List<ReviewCard> _live = new();
    private string _selectedTag = "All";

    private IEnumerable<ReviewCard> FilteredReviews =>
        _live.Concat(StaticReviews).Where(r => _selectedTag == "All" || r.Tag == _selectedTag);

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        var list = await Api.GetReviewsAsync();
        _live = list
            .Where(r => !string.IsNullOrWhiteSpace(r.Body))
            .Select(r => new ReviewCard("api-" + r.Id, r.Name, string.IsNullOrWhiteSpace(r.City) ? "India" : r.City!, null,
                Math.Clamp(r.Rating, 1, 5), "General", r.Body))
            .ToList();
    }
}
