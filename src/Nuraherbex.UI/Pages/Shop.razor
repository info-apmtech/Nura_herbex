@page "/shop"
@page "/store"
@page "/catalog/{ProductId}"
@page "/products/stamix"
@page "/product/stamix"
@page "/products"
@page "/product"
@page "/shop/stamix"
@using Nuraherbex.UI.Components.Shop
@using Nuraherbex.UI.Components.Home
@implements IDisposable
@inject NavigationManager Nav
@inject ApiClient Api
@inject BrowserInterop Browser

<PageTitle>Shop All Products — Nura Herbex | Ayurvedic Wellness</PageTitle>

@if (IsPdp)
{
  <div class="nh-storefront pdp-shell">
    <HomeNavbar />
    <div class="sp-page text-left text-slate-200 min-h-screen relative overflow-hidden">
      <div class="sp-container relative z-10">
        <ShopPdpView Products="_products" />
      </div>
    </div>
    <HomeFooter />
  </div>
}
else
{
  <div class="nh-storefront">
    <HomeNavbar />
    <StoreCatalog Products="_products" ProductId="@CatalogProductId" />
    @if (CatalogProductId is null)
    {
        <MobileSection Id="shop.extras"><ShopExtras /></MobileSection>
    }
    <HomeFooter />
  </div>
}

@code {
    [Parameter] public string? ProductId { get; set; }
    private bool _loading = true;
    private string? _loadError;
    private static readonly string[] PdpPaths = { "products/stamix", "product/stamix", "shop/stamix" };
    private static readonly string[] PreviewPaths = { "shop", "store", "products", "product" };

    private bool IsPdp { get; set; }
    private string? CatalogProductId => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/').StartsWith("catalog/", StringComparison.OrdinalIgnoreCase) ? ProductId : null;
    private bool _metaDirty = true;
    private List<ProductDto> _products = new();

    protected override void OnInitialized()
    {
        Sync();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override Task OnInitializedAsync() => LoadProductsAsync();
    private async Task LoadProductsAsync() { _loading = true; var result = await Api.GetCatalogAsync(); _products = result.Products; _loadError = result.Success ? null : result.Message; _loading = false; }

    protected override void OnParametersSet() => Sync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_metaDirty)
        {
            _metaDirty = false;
            await Browser.SetMetaAsync(IsPdp ? RouteMeta.Pdp : RouteMeta.Shop);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (Sync()) _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Recomputes IsPdp from the current path; ignores paths that belong to other pages. Returns true when the view changed.</summary>
    private bool Sync()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cut = path.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) path = path[..cut];
        path = path.Trim('/').ToLowerInvariant();

        bool? pdp = PdpPaths.Contains(path) ? true : (PreviewPaths.Contains(path) || path.StartsWith("catalog/")) ? false : null;
        if (pdp is null || pdp == IsPdp) return false;
        IsPdp = pdp.Value;
        _metaDirty = true;
        return true;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
