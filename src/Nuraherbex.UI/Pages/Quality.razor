@page "/quality"
@page "/quality-manufacturing"
@using Nuraherbex.UI.Components.Home
@inject BrowserInterop Browser

<PageTitle>Quality &amp; Manufacturing — Nura Herbex</PageTitle>

<div class="nh-storefront tp-shell">
    <HomeNavbar />

    <MobileSection Id="quality.hero"><section class="bp-hero">
        <div class="bp-hero-in">
            <span class="bp-eyebrow">Quality &amp; Manufacturing</span>
            <h1>Pure Ingredients. Trusted Quality.</h1>
            <p>From nature's finest botanicals to careful manufacturing, we are committed to delivering safe, effective and trustworthy supplements for your everyday wellness journey.</p>
            <div class="bp-icons">
                <div class="bp-icon"><span><Icon Name="Leaf" Size="22" /></span><strong>Premium Botanicals</strong></div>
                <div class="bp-icon"><span><Icon Name="Award" Size="22" /></span><strong>GMP Certified Facility</strong></div>
                <div class="bp-icon"><span><Icon Name="FlaskConical" Size="22" /></span><strong>Quality Tested</strong></div>
                <div class="bp-icon"><span><Icon Name="ShieldCheck" Size="22" /></span><strong>Safe &amp; Secure Packaging</strong></div>
            </div>
        </div>
    </section></MobileSection>

    <div class="bp-wrap">
        <MobileSection Id="quality.sourcing"><section class="bp-card">
            <span class="bp-kicker">01 · Ingredient sourcing</span>
            <h2>The Best of Nature, Selected with Care</h2>
            <p>We source high-quality botanicals, herbs, seeds and natural ingredients from trusted growers, with attention to purity, authenticity and sustainability.</p>
            <div class="bp-icons">
                <div class="bp-icon"><span><Icon Name="Leaf" Size="20" /></span><strong>Ethically sourced</strong></div>
                <div class="bp-icon"><span><Icon Name="Heart" Size="20" /></span><strong>Sustainably grown</strong></div>
                <div class="bp-icon"><span><Icon Name="Star" Size="20" /></span><strong>Premium-grade ingredients</strong></div>
            </div>
        </section></MobileSection>

        <MobileSection Id="quality.manufacturing"><section class="bp-card">
            <span class="bp-kicker">02 · Clean &amp; controlled manufacturing</span>
            <h2>World-Class GMP Certified Facility</h2>
            <p>Our supplements are manufactured in a facility that follows strict quality and safety standards, to keep every batch consistent, pure and effective.</p>
            <div class="bp-icons">
                <div class="bp-icon"><span><Icon Name="Award" Size="20" /></span><strong>GMP certified</strong></div>
                <div class="bp-icon"><span><Icon Name="ShieldCheck" Size="20" /></span><strong>Strict quality standards</strong></div>
                <div class="bp-icon"><span><Icon Name="Leaf" Size="20" /></span><strong>Clean &amp; hygienic environment</strong></div>
            </div>
        </section></MobileSection>

        <MobileSection Id="quality.testing"><section class="bp-card">
            <span class="bp-kicker">03 · Quality testing</span>
            <h2>Tested for Purity, Safety &amp; Potency</h2>
            <p>Each batch is tested for identity, purity, potency and safety by third-party laboratories. You can read the report for your own batch on the Trust Passport page.</p>
            <div class="bp-icons">
                <div class="bp-icon"><span><Icon Name="FileText" Size="20" /></span><strong>Third-party lab tested</strong></div>
                <div class="bp-icon"><span><Icon Name="Check" Size="20" /></span><strong>Purity &amp; potency verified</strong></div>
                <div class="bp-icon"><span><Icon Name="Leaf" Size="20" /></span><strong>Free from harmful contaminants</strong></div>
            </div>
            <p style="margin-top:14px"><a class="bp-btn" href="/trust-passport"><Icon Name="ShieldCheck" Size="16" /> Open Trust Passport</a></p>
        </section></MobileSection>

        <MobileSection Id="quality.packaging"><section class="bp-card">
            <span class="bp-kicker">04 · Safe &amp; sustainable packaging</span>
            <h2>Freshness You Can Trust</h2>
            <p>Our supplements are packed in food-grade containers designed to protect potency and keep the product fresh.</p>
            <div class="bp-icons">
                <div class="bp-icon"><span><Icon Name="Package" Size="20" /></span><strong>Food-grade packaging</strong></div>
                <div class="bp-icon"><span><Icon Name="ShieldCheck" Size="20" /></span><strong>Sealed for freshness</strong></div>
            </div>
        </section></MobileSection>

        <MobileSection Id="quality.commitment"><section class="bp-card" style="text-align:center">
            <span class="bp-kicker">Our commitment</span>
            <h2>A Healthier Tomorrow, Backed by Quality.</h2>
            <p>We are dedicated to creating natural supplements you can trust, today and for a healthier tomorrow.</p>
            <p><a class="bp-btn" href="/shop">Shop our products <Icon Name="ArrowRight" Size="16" /></a></p>
        </section></MobileSection>
    </div>

    <HomeFooter />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.ScrollToTopAsync();
    }
}
