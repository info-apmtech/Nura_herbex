@page "/admin"
@page "/admin/{Section}"
@layout AdminLayout
@implements IDisposable
@inject AdminSession AdminAuth
@inject ApiClient Api
@inject NavigationManager Nav
@inject BrowserInterop Browser
@inject ProjectState Project

@if (!_initDone)
{
    <div class="admin-loading" role="status"><span class="admin-brand-symbol">@(Project.IsMidFit ? "M" : "N")</span><p>Opening your workspace…</p></div>
}
else if (!AdminAuth.IsAuthenticated)
{
    <AdminLogin OnLoggedIn="OnLoggedInAsync" />
}
else
{
    <div class="@($"admin-shell {(_collapsed ? "nav-collapsed" : "")}")">
        <aside class="admin-sidebar @(_mobileMenu ? "is-open" : "")" aria-label="Admin navigation">
            <a class="admin-brand" href="/admin">
                @if (Project.IsMidFit)
                {
                    <span class="admin-brand-symbol">M</span>
                }
                else
                {
                    <img class="admin-brand-logo" src="/_content/Nuraherbex.UI/images/logo-mark.png" alt="" />
                }
                <span>@Project.BrandName<small>@Project.BrandSubtitle</small></span>
            </a>
            <div class="admin-store-label"><span class="admin-store-dot"></span> @(Project.IsMidFit ? "Your fitness workspace" : "Your store workspace")</div>
            <nav>@foreach (var group in Navigation.GroupBy(n => n.Group)) { <span class="admin-nav-label">@group.Key</span> @foreach (var item in group) { <button class="admin-nav-item @(_activeTab == item.Id ? "is-active" : "")" aria-current="@(_activeTab == item.Id ? "page" : null)" @onclick="() => Navigate(item.Id)"><Icon Name="@item.Icon" Size="19" /><span>@item.Label</span>@if (BadgeFor(item.Id) is { Count: > 0 } badge) { <small class="@(badge.Urgent ? "is-urgent" : "")" title="@badge.Tip">@(badge.Count > 99 ? "99+" : badge.Count.ToString())</small> }</button> } }</nav>
            <div class="admin-sidebar-bottom"><a class="admin-nav-item" href="/shop"><Icon Name="ExternalLink" Size="18" /> View storefront</a><div class="admin-user"><span class="admin-avatar">@(string.IsNullOrEmpty(AdminAuth.Name) ? "A" : AdminAuth.Name[..1].ToUpperInvariant())</span><span><strong>@(string.IsNullOrEmpty(AdminAuth.Name) ? "Administrator" : AdminAuth.Name)</strong><small>@(AdminAuth.Designation ?? AdminAuth.Email)</small></span><button class="admin-icon-btn" title="Sign out" aria-label="Sign out" @onclick="() => _showLogoutConfirm = true"><Icon Name="LogOut" Size="18" /></button></div></div>
        </aside>
        @if (_mobileMenu) { <button class="admin-mobile-backdrop" aria-label="Close navigation" @onclick="() => _mobileMenu = false"></button> }
        <div class="admin-main"><header class="admin-topbar"><div class="admin-actions"><button class="admin-icon-btn admin-menu-toggle" aria-label="@(_collapsed ? "Show navigation menu" : "Hide navigation menu")" title="@(_collapsed ? "Show the menu" : "Hide the menu to give the page more room")" aria-expanded="@(!_collapsed)" @onclick="ToggleNavAsync"><Icon Name="Menu" Size="22" /></button><span class="admin-breadcrumb">Workspace <span>/</span> <strong>@PageName</strong></span></div><div class="admin-actions">@if (AdminAuth.IsAuthenticated) { <AdminWhatsAppToggle /><AdminBell /> }<span class="admin-today">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span><a class="admin-btn admin-btn-small" href="/shop"><Icon Name="ExternalLink" Size="15" /> Open store</a></div></header>
        <main class="admin-content">
        @if (_loadErrors.Count > 0) { <div role="alert" class="admin-error">@string.Join(" · ", _loadErrors.Select(e => e.Key + ": " + e.Value)) <button class="admin-btn admin-btn-small" @onclick="RefreshAsync">Retry</button></div> }
        @if (!AdminAuth.HasAnyPage) { <div class="admin-error" role="status"><strong>No pages assigned yet.</strong> Ask an administrator to give your account a designation.</div> }
        else if (_activeTab == "products") { <AdminProductsTab /> }
        else if (_activeTab == "stock") { <AdminStockTab /> }
        else if (_activeTab == "coupons") { <AdminCouponsTab /> }
        else if (_activeTab == "reviews") { <AdminReviewsTab /> }
        else if (_activeTab == "overview") { <AdminDashboard Orders="_orders" Customers="_customers" Loading="@(_ordersLoading || _customersLoading)" OnNavigate="Navigate" /> }
        else
        {
            @if (_activeTab is not ("team" or "tasks" or "reports" or "crm" or "whatsapp" or "employee_report" or "doctor_portal" or "doctor_completed")) {<div class="admin-section-heading"><div><span class="admin-eyebrow">STORE OPERATIONS</span><h2>@PageName</h2><p>Manage your @PageName.ToLowerInvariant() in one place.</p></div></div>}
            <div class="admin-legacy">
            @if (_activeTab == "orders") { <AdminOrdersTab Orders="_orders" Loading="_ordersLoading" OnReload="LoadOrdersAsync" /> }
            else if (_activeTab == "shipping") { <AdminShippingTab /> }
            else if (_activeTab == "payments") { <AdminPaymentsTab Attempts="_payments" Loading="_paymentsLoading" OnReload="LoadPaymentsAsync" /> }
            else if (_activeTab == "customers") { <AdminCustomersTab Customers="_customers" Loading="_customersLoading" OnReload="LoadCustomersAsync" OnOrderCreated="OnCustomerOrderCreatedAsync" /> }
            else if (_activeTab == "batches") { <AdminBatchesTab Batches="_batches" Loading="_batchesLoading" OnReload="LoadBatchesAsync" /> }
            else if (_activeTab == "formulation") { <AdminFormulationTab Ingredients="_ingredients" Metrics="_metrics" IngredientsChanged="OnIngredientsChanged" MetricsChanged="OnMetricsChanged" /> }
            else if (_activeTab == "content") { <AdminPageContentEditor /><AdminContentTab /> }
            else if (_activeTab == "crm") { <AdminCrmDashboard /> }
            else if (_activeTab == "leads") { <AdminLeadsTab Mode="leads" /> }
            else if (_activeTab == "transfers") { <AdminLeadsTab Mode="transfers" /> }
            else if (_activeTab == "no_answer") { <AdminLeadsTab Mode="no_answer" /> }
            else if (_activeTab == "interested") { <AdminLeadsTab Mode="interested" /> }
            else if (_activeTab == "care") { <AdminLeadsTab Mode="care" /> }
            else if (_activeTab == "campaigns") { <AdminAdsDashboard /> }
            else if (_activeTab == "followups") { <AdminFollowUpsTab /> }
            else if (_activeTab == "bulk_messages") { <AdminBulkMessagesTab /> }
            else if (_activeTab == "drive_files") { <AdminDriveTab /> }
            else if (_activeTab == "whatsapp") { <AdminWhatsAppTab /> }
            else if (_activeTab == "team") { <AdminOrganisation /> }
            else if (_activeTab == "tasks") { <AdminTasksTab /> }
            else if (_activeTab == "reports") { <AdminReportsTab /> }
            else if (_activeTab == "employee_report") { <AdminEmployeeReportTab /> }
            else if (_activeTab == "doctor_portal") { <AdminDoctorPortalTab /> }
            else if (_activeTab == "doctor_completed") { <AdminDoctorCompletedTab /> }
            </div>
        }
        <footer class="admin-footer"><span>Nura Herbex · Store administration</span><span>Made for your everyday operations</span></footer>
        </main></div>
    </div>

    @if (_showLogoutConfirm)
    {
        <div class="fu-modal-backdrop" @onclick="() => _showLogoutConfirm = false" style="position:fixed;inset:0;background:rgba(15,23,42,0.65);backdrop-filter:blur(4px);z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;">
            <div class="fu-modal" role="dialog" aria-modal="true" aria-labelledby="logout-dialog-title" @onclick:stopPropagation="true" style="max-width:420px;width:100%;background:#fff;border-radius:20px;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25);overflow:hidden;text-align:center;padding:28px 24px;border:1px solid #f1f5f9;">
                <div style="width:56px;height:56px;margin:0 auto 16px;border-radius:50%;background:#fee2e2;color:#dc2626;display:flex;align-items:center;justify-content:center;">
                    <Icon Name="LogOut" Size="26" />
                </div>
                <h3 id="logout-dialog-title" style="margin:0 0 8px;font-size:20px;font-weight:700;color:#0f172a;">Sign Out of Workspace?</h3>
                <p style="margin:0 0 24px;font-size:14px;color:#64748b;line-height:1.5;">
                    Are you sure you want to log out from <strong style="color:#0f172a;">@(string.IsNullOrEmpty(AdminAuth.Name) ? "Administrator" : AdminAuth.Name)</strong>? You will need to sign in again to access the workspace.
                </p>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button type="button" class="admin-btn" style="flex:1;padding:10px 16px;border-radius:10px;font-weight:600;justify-content:center;" @onclick="() => _showLogoutConfirm = false" disabled="@_isLoggingOut">
                        Cancel
                    </button>
                    <button type="button" class="admin-btn" style="flex:1;padding:10px 16px;border-radius:10px;font-weight:600;background:#dc2626 !important;color:#ffffff !important;border-color:#dc2626 !important;justify-content:center;gap:6px;cursor:pointer;" @onclick="ConfirmLogoutAsync" disabled="@_isLoggingOut">
                        @if (_isLoggingOut)
                        {
                            <Icon Name="RefreshCw" Size="16" Class="animate-spin" />
                            <span style="color:#ffffff !important;">Signing out…</span>
                        }
                        else
                        {
                            <Icon Name="LogOut" Size="16" />
                            <span style="color:#ffffff !important;">Yes, Log Out</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}
@code {
    [Parameter] public string? Section { get; set; }
    private readonly Dictionary<string, string> _loadErrors = new();
    private bool _mobileMenu;
    /// <summary>Desktop: the left menu is hidden so pages such as Leads get the full width. Remembered between visits.</summary>
    private bool _collapsed;
    private const string NavKey = "nura.admin.navCollapsed";

    private async Task ToggleNavAsync()
    {
        _collapsed = !_collapsed; _mobileMenu = !_mobileMenu; // phones use the slide-in menu, larger screens the collapse; each ignores the other flag
        try { await Browser.SetLocalAsync(NavKey, _collapsed ? "1" : "0"); } catch { }
    }
    private record NavItem(string Id, string Label, string Icon, string Group);
    private static readonly HashSet<string> NeuraHerbexOnlyPages =
        new() { "products", "stock", "batches", "formulation", "shipping", "coupons", "reviews", "customers" };

    private static readonly HashSet<string> MidFitOnlyPages =
        new() { "doctor_portal", "doctor_completed" };

    private static readonly NavItem[] AllPages =
    {
        new("overview", "Overview", "TrendingUp", "MANAGE"), new("orders", "Orders", "ShoppingBag", "MANAGE"), new("payments", "Payments", "CreditCard", "MANAGE"), new("shipping", "Shipping setup", "Truck", "MANAGE"), new("customers", "Customers", "Users", "MANAGE"),
        new("stock", "Stock / Inventory", "Layers", "MANAGE"), new("products", "Products", "Package", "MANAGE"), new("coupons", "Coupons", "Tag", "MANAGE"), new("reviews", "Reviews", "MessageSquare", "MANAGE"),
        new("crm", "Sales dashboard", "BarChart3", "SALES & WORK"), new("leads", "Leads", "Phone", "SALES & WORK"), new("transfers", "Pending Transfers", "ArrowRightLeft", "SALES & WORK"), new("no_answer", "No Answer Follow-up", "PhoneMissed", "SALES & WORK"), new("interested", "Hot Leads Follow-up", "Flame", "SALES & WORK"),
        new("doctor_completed", "Completed from Doctor", "UserCheck", "SALES & WORK"),
        new("doctor_portal", "Doctor Consultation", "HeartPulse", "CLINICAL"),
        new("care", "Customer care", "HeartPulse", "SALES & WORK"), new("campaigns", "Ad campaigns", "TrendingUp", "SALES & WORK"), new("followups", "Follow-ups", "Clock", "SALES & WORK"), new("bulk_messages", "Bulk messaging", "Send", "SALES & WORK"), new("tasks", "Tasks", "CheckCircle2", "SALES & WORK"), new("employee_report", "Employee report", "UserCheck", "SALES & WORK"),
        new("reports", "Reports", "BarChart3", "ADMIN"), new("whatsapp", "WhatsApp log", "MessageCircle", "ADMIN"), new("drive_files", "Google Drive", "Layers", "ADMIN"), new("team", "Team & organisation", "KeyRound", "ADMIN"),
        new("batches", "Batch reports", "ShieldCheck", "STOREFRONT & SUPPORT"), new("formulation", "Formulation", "FlaskConical", "STOREFRONT & SUPPORT"), new("content", "Store content", "FileText", "STOREFRONT & SUPPORT"),
    };
    /// <summary>Only the pages this person's designation allows. People who only see their own records get "My" wording.</summary>
    private NavItem[] Navigation => AllPages
        .Where(p => Project.IsMidFit ? !NeuraHerbexOnlyPages.Contains(p.Id) : !MidFitOnlyPages.Contains(p.Id))
        .Where(p => AdminAuth.Can(p.Id) || (Project.IsMidFit && p.Id is "doctor_portal" or "doctor_completed") || (p.Id is "no_answer" or "transfers" or "interested" && (AdminAuth.Can("no_answer") || AdminAuth.Can("leads") || AdminAuth.Can("interested"))) || (p.Id == "stock" && (AdminAuth.Can("stock") || AdminAuth.Can("products") || AdminAuth.IsAdmin)) || (p.Id == "employee_report" && (AdminAuth.Can("employee_report") || AdminAuth.Can("reports") || AdminAuth.Can("leads") || AdminAuth.Can("followups"))) || (p.Id == "reports" && (AdminAuth.Can("leads") || AdminAuth.Can("followups") || AdminAuth.Can("tasks")))).Select(p => p.Id switch
    {
        "crm" when !AdminAuth.CanAll("crm") => p with { Label = "My dashboard" },
        "leads" when !AdminAuth.CanAll("leads") => p with { Label = "My leads" },
        "transfers" => p with { Label = "Pending Transfers" },
        "no_answer" => p with { Label = "No Answer Follow-up" },
        "interested" when !AdminAuth.CanAll("interested") => p with { Label = "My hot leads follow-up" },
        "interested" => p with { Label = "Hot Leads Follow-up" },
        "doctor_portal" => p with { Label = "Doctor Consultation" },
        "doctor_completed" => p with { Label = "Completed from Doctor" },
        "stock" => p with { Label = "Stock / Inventory" },
        "care" when !AdminAuth.CanAll("care") => p with { Label = "My customers" },
        "campaigns" when !AdminAuth.CanAll("campaigns") => p with { Label = "My ad leads" },
        "followups" when !AdminAuth.CanAll("followups") => p with { Label = "My follow-ups" },
        "tasks" when !AdminAuth.CanAll("tasks") => p with { Label = "My tasks" },
        "employee_report" when !AdminAuth.CanAll("reports") && !AdminAuth.CanAll("leads") => p with { Label = "My report" },
        "reports" when !AdminAuth.CanAll("reports") => p with { Label = "My reports" },
        _ => p,
    }).ToArray();
    private string PageName => Navigation.FirstOrDefault(n => n.Id == _activeTab)?.Label ?? "Workspace";
    private string DefaultTab => Navigation.Any(n => n.Id == "overview") ? "overview" : Navigation.Any(n => n.Id == "leads") ? "leads" : Navigation.FirstOrDefault()?.Id ?? "overview";
    protected override void OnParametersSet() => _activeTab = Navigation.Any(n => n.Id == Section) ? Section! : DefaultTab;
    /// <summary>Anyone who opens a page they have no right to is sent to the first page they can use.</summary>
    private void EnsureRoleView()
    {
        if (!AdminAuth.IsAuthenticated || Navigation.Length == 0) return;
        var want = Navigation.Any(n => n.Id == Section) ? Section! : DefaultTab;
        if (want != _activeTab) _activeTab = want;
        if (Section is not null && want != Section) Nav.NavigateTo("/admin/" + want, replace: true);
    }
    private void Navigate(string id) { _mobileMenu = false; Nav.NavigateTo("/admin/" + id); _ = RefreshBadgesAsync(); }
    private void RecordError(string key, ApiResult result) { if (result.Success) _loadErrors.Remove(key); else _loadErrors[key] = result.Message ?? "Could not load data."; }
    private async Task RefreshAsync() { _dataLoaded = false; await LoadAllAsync(); }
    private bool _initDone;
    private bool _dataLoaded;
    private string _activeTab = "overview"; // orders | customers | batches | formulation | content | whatsapp | overview

    private List<OrderDto> _orders = new();
    private bool _ordersLoading = true;
    private List<PaymentAttemptDto> _payments = new();
    private bool _paymentsLoading = true;
    private List<AdminCustomerDto> _customers = new();
    private bool _customersLoading = true;
    private List<TrustBatchDto> _batches = new();
    private bool _batchesLoading = true;
    private List<FormulationIngredientDto> _ingredients = AdminDefaults.Ingredients();
    private FormulationMetricsDto _metrics = new();

    // ---- Sidebar counts: what needs attention on each page (orders, leads, follow-ups, tasks) ----
    private sealed record NavBadge(int Count, bool Urgent, string Tip);
    private readonly Dictionary<string, NavBadge> _badges = new();
    private Timer? _badgeTimer;

    private NavBadge? BadgeFor(string page) => page switch
    {
        "orders" => _orders.Count(o => o.FulfillmentStatus == "PENDING") is > 0 and var n ? new NavBadge(n, false, $"{n} order(s) waiting to be shipped") : null,
        _ => _badges.GetValueOrDefault(page),
    };

    private async Task RefreshBadgesAsync()
    {
        if (!AdminAuth.IsAuthenticated) return;
        var next = new Dictionary<string, NavBadge>();
        var firstLeadView = AdminAuth.Can("leads") ? LeadViews.Leads
            : AdminAuth.Can("care") ? LeadViews.Care
            : AdminAuth.Can("interested") ? LeadViews.Interested
            : null;

        if (firstLeadView != null)
        {
            var r = await Api.AdminLeadsAsync(take: 1, view: firstLeadView);
            if (r.Success)
            {
                var leadsCount = r.ViewCounts.GetValueOrDefault(LeadViews.Leads);
                if (AdminAuth.Can("leads") && leadsCount > 0)
                    next["leads"] = new NavBadge(leadsCount, false, $"{leadsCount} active lead(s)");

                var naCount = r.ViewCounts.GetValueOrDefault("no_answer", r.StatusCounts.GetValueOrDefault(LeadBuckets.NoAnswer));
                if ((AdminAuth.Can("no_answer") || AdminAuth.Can("leads")) && naCount > 0)
                    next["no_answer"] = new NavBadge(naCount, false, $"{naCount} unanswered follow-up lead(s)");

                if (r.PendingTransfersCount > 0 && AdminAuth.Can("leads"))
                    next["transfers"] = new NavBadge(r.PendingTransfersCount, true, $"{r.PendingTransfersCount} pending transfer(s) awaiting acceptance");

                var hotCount = r.ViewCounts.GetValueOrDefault(LeadViews.Interested);
                if (AdminAuth.Can("interested") && hotCount > 0)
                    next["interested"] = new NavBadge(hotCount, r.ViewUnread.GetValueOrDefault(LeadViews.Interested) > 0, $"{hotCount} hot lead(s)");

                var careCount = r.ViewCounts.GetValueOrDefault(LeadViews.Care);
                if (AdminAuth.Can("care") && careCount > 0)
                    next["care"] = new NavBadge(careCount, r.ViewUnread.GetValueOrDefault(LeadViews.Care) > 0, $"{careCount} customer(s)");
            }
        }
        if (AdminAuth.Can("followups"))
        {
            var r = await Api.AdminFollowUpsAsync();
            var due = r.Counts.Overdue + r.Counts.Today;
            if (r.Success && due > 0)
                next["followups"] = new NavBadge(due, r.Counts.Overdue > 0, $"{r.Counts.Overdue} overdue, {r.Counts.Today} due today");
        }
        if (AdminAuth.Can("tasks"))
        {
            var r = await Api.AdminTasksAsync();
            var due = r.Counts.Overdue + r.Counts.DueToday;
            if (r.Success && due > 0)
                next["tasks"] = new NavBadge(due, r.Counts.Overdue > 0, $"{r.Counts.Overdue} overdue, {r.Counts.DueToday} due today");
        }
        _badges.Clear();
        foreach (var kv in next) _badges[kv.Key] = kv.Value;
        await InvokeAsync(StateHasChanged);
    }

    private void StartBadgeTimer()
    {
        _badgeTimer ??= new Timer(_ => _ = InvokeAsync(RefreshBadgesAsync), null, TimeSpan.Zero, TimeSpan.FromSeconds(60));
    }

    protected override void OnInitialized() => AdminAuth.Changed += OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Browser.SetMetaAsync(RouteMeta.Admin);
        try { _collapsed = await Browser.GetLocalAsync(NavKey) == "1"; } catch { }
        await AdminAuth.InitAsync(); // validates a stored token with the server
        _initDone = true;
        EnsureRoleView();
        if (AdminAuth.IsAuthenticated) await LoadAllAsync();
        StateHasChanged();
    }

    private void OnAuthChanged() => _ = InvokeAsync(StateHasChanged);

    private string TabClass(string tab) =>
        $"px-3.5 py-1.5 rounded-md text-xs font-medium tracking-tight flex items-center gap-2 transition-all cursor-pointer {(_activeTab == tab ? "bg-zinc-800 text-white shadow-sm border border-zinc-700/60" : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40 border border-transparent")}";

    private async Task OnLoggedInAsync()
    {
        _initDone = true;
        EnsureRoleView();
        StateHasChanged();
        await LoadAllAsync();
    }

    private bool _showLogoutConfirm;
    private bool _isLoggingOut;

    private async Task ConfirmLogoutAsync()
    {
        if (_isLoggingOut) return;
        _isLoggingOut = true;
        StateHasChanged();
        try { await AdminAuth.SignOutAsync(); } catch { }
        _showLogoutConfirm = false;
        _dataLoaded = false;
        _orders = new(); _customers = new(); _batches = new(); _payments = new();
        _ordersLoading = _customersLoading = _batchesLoading = _paymentsLoading = true;
        Nav.NavigateTo("/admin", forceLoad: true);
    }

    private async Task LoadAllAsync()
    {
        if (_dataLoaded || !AdminAuth.IsAuthenticated) return;
        _dataLoaded = true;
        StartBadgeTimer();
        var jobs = new List<Task>();
        if (AdminAuth.Can("orders")) jobs.Add(LoadOrdersAsync()); else _ordersLoading = false;
        if (AdminAuth.Can("payments")) jobs.Add(LoadPaymentsAsync()); else _paymentsLoading = false;
        if (AdminAuth.Can("batches")) jobs.Add(LoadBatchesAsync()); else _batchesLoading = false;
        if (AdminAuth.Can("customers")) jobs.Add(LoadCustomersAsync()); else _customersLoading = false;
        if (AdminAuth.Can("formulation")) { jobs.Add(LoadIngredientsAsync()); jobs.Add(LoadMetricsAsync()); }
        await Task.WhenAll(jobs);
    }

    private async Task LoadOrdersAsync()
    {
        _ordersLoading = true; StateHasChanged();
        var res = await Api.AdminOrdersAsync(); RecordError("Orders", res);
        _orders = res.Success ? res.Orders : new();
        _ordersLoading = false; StateHasChanged();
    }

    private async Task LoadPaymentsAsync()
    {
        _paymentsLoading = true; StateHasChanged();
        var res = await Api.AdminPaymentsAsync(); RecordError("Payments", res);
        _payments = res.Success ? res.Attempts : new();
        _paymentsLoading = false; StateHasChanged();
    }

    private async Task LoadCustomersAsync()
    {
        _customersLoading = true; StateHasChanged();
        var res = await Api.AdminCustomersAsync(); RecordError("Customers", res);
        if (res.Success) _customers = res.Customers;
        _customersLoading = false; StateHasChanged();
    }

    private async Task OnCustomerOrderCreatedAsync()
    {
        var jobs = new List<Task> { LoadCustomersAsync() };
        if (AdminAuth.Can("orders")) jobs.Add(LoadOrdersAsync());
        await Task.WhenAll(jobs);
    }

    private async Task LoadBatchesAsync()
    {
        _batchesLoading = true; StateHasChanged();
        var res = await Api.AdminBatchesAsync(); RecordError("Batches", res);
        _batches = res.Success ? res.Batches : new();
        _batchesLoading = false; StateHasChanged();
    }

    private async Task LoadIngredientsAsync()
    {
        var data = await Api.GetIngredientsAsync();
        if (data is { Count: > 0 }) { _ingredients = data; StateHasChanged(); }
    }

    private async Task LoadMetricsAsync()
    {
        var data = await Api.GetMetricsAsync();
        if (data is not null) { _metrics = data; StateHasChanged(); }
    }

    private void OnIngredientsChanged(List<FormulationIngredientDto> list) => _ingredients = list;
    private void OnMetricsChanged(FormulationMetricsDto m) => _metrics = m;

    public void Dispose() { AdminAuth.Changed -= OnAuthChanged; _badgeTimer?.Dispose(); }
}
