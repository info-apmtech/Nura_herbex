@page "/admin"
@page "/admin/{Section}"
@layout AdminLayout
@implements IDisposable
@inject AdminSession AdminAuth
@inject ApiClient Api
@inject NavigationManager Nav
@inject BrowserInterop Browser

@if (!_initDone)
{
    <div class="admin-loading" role="status"><span class="admin-brand-symbol">N</span><p>Opening your workspace…</p></div>
}
else if (!AdminAuth.IsAuthenticated)
{
    <AdminLogin OnLoggedIn="OnLoggedInAsync" />
}
else
{
    <div class="admin-shell">
        <aside class="admin-sidebar @(_mobileMenu ? "is-open" : "")" aria-label="Admin navigation">
            <a class="admin-brand" href="/admin"><img class="admin-brand-logo" src="/_content/Nuraherbex.UI/images/logo-mark.png" alt="" /><span>Nura Herbex<small>STORE ADMINISTRATION</small></span></a>
            <div class="admin-store-label"><span class="admin-store-dot"></span> Your store workspace</div>
            <nav>@foreach (var group in Navigation.GroupBy(n => n.Group)) { <span class="admin-nav-label">@group.Key</span> @foreach (var item in group) { <button class="admin-nav-item @(_activeTab == item.Id ? "is-active" : "")" aria-current="@(_activeTab == item.Id ? "page" : null)" @onclick="() => Navigate(item.Id)"><Icon Name="@item.Icon" Size="19" /><span>@item.Label</span>@if (item.Id == "orders" && _orders.Any(o => o.FulfillmentStatus == "PENDING")) { <small>@_orders.Count(o => o.FulfillmentStatus == "PENDING")</small> }</button> } }</nav>
            <div class="admin-sidebar-bottom"><a class="admin-nav-item" href="/shop"><Icon Name="ExternalLink" Size="18" /> View storefront</a><div class="admin-user"><span class="admin-avatar">@(string.IsNullOrEmpty(AdminAuth.Name) ? "A" : AdminAuth.Name[..1].ToUpperInvariant())</span><span><strong>@(string.IsNullOrEmpty(AdminAuth.Name) ? "Administrator" : AdminAuth.Name)</strong><small>@(AdminAuth.Designation ?? AdminAuth.Email)</small></span><button class="admin-icon-btn" title="Sign out" aria-label="Sign out" @onclick="LogoutAsync"><Icon Name="LogOut" Size="18" /></button></div></div>
        </aside>
        @if (_mobileMenu) { <button class="admin-mobile-backdrop" aria-label="Close navigation" @onclick="() => _mobileMenu = false"></button> }
        <div class="admin-main"><header class="admin-topbar"><div class="admin-actions"><button class="admin-icon-btn admin-menu-toggle" aria-label="Toggle navigation" aria-expanded="@_mobileMenu" @onclick="() => _mobileMenu = !_mobileMenu"><Icon Name="Menu" Size="22" /></button><span class="admin-breadcrumb">Workspace <span>/</span> <strong>@PageName</strong></span></div><div class="admin-actions">@if (AdminAuth.IsAuthenticated) { <AdminWhatsAppToggle /><AdminBell /> }<span class="admin-today">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span><a class="admin-btn admin-btn-small" href="/shop"><Icon Name="ExternalLink" Size="15" /> Open store</a></div></header>
        <main class="admin-content">
        @if (_loadErrors.Count > 0) { <div role="alert" class="admin-error">@string.Join(" · ", _loadErrors.Select(e => e.Key + ": " + e.Value)) <button class="admin-btn admin-btn-small" @onclick="RefreshAsync">Retry</button></div> }
        @if (!AdminAuth.HasAnyPage) { <div class="admin-error" role="status"><strong>No pages assigned yet.</strong> Ask an administrator to give your account a designation.</div> }
        else if (_activeTab == "products") { <AdminProductsTab /> }
        else if (_activeTab == "coupons") { <AdminCouponsTab /> }
        else if (_activeTab == "reviews") { <AdminReviewsTab /> }
        else if (_activeTab == "overview") { <AdminDashboard Orders="_orders" Customers="_customers" Loading="@(_ordersLoading || _customersLoading)" OnNavigate="Navigate" /> }
        else
        {
            @if (_activeTab is not ("team" or "tasks" or "reports" or "crm" or "whatsapp")) {<div class="admin-section-heading"><div><span class="admin-eyebrow">STORE OPERATIONS</span><h2>@PageName</h2><p>Manage your @PageName.ToLowerInvariant() in one place.</p></div></div>}
            <div class="admin-legacy">
            @if (_activeTab == "orders") { <AdminOrdersTab Orders="_orders" Loading="_ordersLoading" OnReload="LoadOrdersAsync" /> }
            else if (_activeTab == "payments") { <AdminPaymentsTab Attempts="_payments" Loading="_paymentsLoading" OnReload="LoadPaymentsAsync" /> }
            else if (_activeTab == "customers") { <AdminCustomersTab Customers="_customers" Loading="_customersLoading" OnReload="LoadCustomersAsync" /> }
            else if (_activeTab == "batches") { <AdminBatchesTab Batches="_batches" Loading="_batchesLoading" OnReload="LoadBatchesAsync" /> }
            else if (_activeTab == "formulation") { <AdminFormulationTab Ingredients="_ingredients" Metrics="_metrics" IngredientsChanged="OnIngredientsChanged" MetricsChanged="OnMetricsChanged" /> }
            else if (_activeTab == "content") { <AdminPageContentEditor /><AdminContentTab /> }
            else if (_activeTab == "crm") { <AdminCrmDashboard /> }
            else if (_activeTab == "leads") { <AdminLeadsTab /> }
            else if (_activeTab == "followups") { <AdminFollowUpsTab /> }
            else if (_activeTab == "whatsapp") { <AdminWhatsAppTab /> }
            else if (_activeTab == "team") { <AdminOrganisation /> }
            else if (_activeTab == "tasks") { <AdminTasksTab /> }
            else if (_activeTab == "reports") { <AdminReportsTab /> }
            </div>
        }
        <footer class="admin-footer"><span>Nura Herbex · Store administration</span><span>Made for your everyday operations</span></footer>
        </main></div>
    </div>
}
@code {
    [Parameter] public string? Section { get; set; }
    private readonly Dictionary<string, string> _loadErrors = new();
    private bool _mobileMenu;
    private record NavItem(string Id, string Label, string Icon, string Group);
    private static readonly NavItem[] AllPages =
    {
        new("overview", "Overview", "TrendingUp", "MANAGE"), new("orders", "Orders", "ShoppingBag", "MANAGE"), new("payments", "Payments", "CreditCard", "MANAGE"), new("customers", "Customers", "Users", "MANAGE"),
        new("products", "Products", "Package", "MANAGE"), new("coupons", "Coupons", "Tag", "MANAGE"), new("reviews", "Reviews", "MessageSquare", "MANAGE"),
        new("crm", "Sales dashboard", "BarChart3", "SALES & WORK"), new("leads", "Leads", "Phone", "SALES & WORK"), new("followups", "Follow-ups", "Clock", "SALES & WORK"), new("tasks", "Tasks", "CheckCircle2", "SALES & WORK"),
        new("reports", "Reports", "BarChart3", "ADMIN"), new("whatsapp", "WhatsApp log", "MessageCircle", "ADMIN"), new("team", "Team & organisation", "KeyRound", "ADMIN"),
        new("batches", "Batch reports", "ShieldCheck", "STOREFRONT & SUPPORT"), new("formulation", "Formulation", "FlaskConical", "STOREFRONT & SUPPORT"), new("content", "Store content", "FileText", "STOREFRONT & SUPPORT"),
    };
    /// <summary>Only the pages this person's designation allows. People who only see their own records get "My" wording.</summary>
    private NavItem[] Navigation => AllPages.Where(p => AdminAuth.Can(p.Id) || (p.Id == "reports" && (AdminAuth.Can("leads") || AdminAuth.Can("followups") || AdminAuth.Can("tasks")))).Select(p => p.Id switch
    {
        "crm" when !AdminAuth.CanAll("crm") => p with { Label = "My dashboard" },
        "followups" when !AdminAuth.CanAll("followups") => p with { Label = "My follow-ups" },
        "tasks" when !AdminAuth.CanAll("tasks") => p with { Label = "My tasks" },
        "reports" when !AdminAuth.CanAll("reports") => p with { Label = "My reports" },
        _ => p,
    }).ToArray();
    private string PageName => Navigation.FirstOrDefault(n => n.Id == _activeTab)?.Label ?? "Workspace";
    private string DefaultTab => Navigation.Any(n => n.Id == "overview") ? "overview" : Navigation.Any(n => n.Id == "leads") ? "leads" : Navigation.FirstOrDefault()?.Id ?? "overview";
    protected override void OnParametersSet() => _activeTab = Navigation.Any(n => n.Id == Section) ? Section! : DefaultTab;
    /// <summary>Anyone who opens a page they have no right to is sent to the first page they can use.</summary>
    private void EnsureRoleView()
    {
        if (!AdminAuth.IsAuthenticated || Navigation.Length == 0) return;
        var want = Navigation.Any(n => n.Id == Section) ? Section! : DefaultTab;
        if (want != _activeTab) _activeTab = want;
        if (Section is not null && want != Section) Nav.NavigateTo("/admin/" + want, replace: true);
    }
    private void Navigate(string id) { _mobileMenu = false; Nav.NavigateTo("/admin/" + id); }
    private void RecordError(string key, ApiResult result) { if (result.Success) _loadErrors.Remove(key); else _loadErrors[key] = result.Message ?? "Could not load data."; }
    private async Task RefreshAsync() { _dataLoaded = false; await LoadAllAsync(); }
    private bool _initDone;
    private bool _dataLoaded;
    private string _activeTab = "overview"; // orders | customers | batches | formulation | content | whatsapp | overview

    private List<OrderDto> _orders = new();
    private bool _ordersLoading = true;
    private List<PaymentAttemptDto> _payments = new();
    private bool _paymentsLoading = true;
    private List<AdminCustomerDto> _customers = new();
    private bool _customersLoading = true;
    private List<TrustBatchDto> _batches = new();
    private bool _batchesLoading = true;
    private List<FormulationIngredientDto> _ingredients = AdminDefaults.Ingredients();
    private FormulationMetricsDto _metrics = new();

    protected override void OnInitialized() => AdminAuth.Changed += OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Browser.SetMetaAsync(RouteMeta.Admin);
        await AdminAuth.InitAsync(); // validates a stored token with the server
        _initDone = true;
        EnsureRoleView();
        if (AdminAuth.IsAuthenticated) await LoadAllAsync();
        StateHasChanged();
    }

    private void OnAuthChanged() => _ = InvokeAsync(StateHasChanged);

    private string TabClass(string tab) =>
        $"px-3.5 py-1.5 rounded-md text-xs font-medium tracking-tight flex items-center gap-2 transition-all cursor-pointer {(_activeTab == tab ? "bg-zinc-800 text-white shadow-sm border border-zinc-700/60" : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40 border border-transparent")}";

    private async Task OnLoggedInAsync()
    {
        _initDone = true;
        EnsureRoleView();
        StateHasChanged();
        await LoadAllAsync();
    }

    private async Task LogoutAsync()
    {
        await AdminAuth.SignOutAsync();
        _dataLoaded = false;
        _orders = new(); _customers = new(); _batches = new(); _payments = new();
        _ordersLoading = _customersLoading = _batchesLoading = _paymentsLoading = true;
    }

    private async Task LoadAllAsync()
    {
        if (_dataLoaded || !AdminAuth.IsAuthenticated) return;
        _dataLoaded = true;
        var jobs = new List<Task>();
        if (AdminAuth.Can("orders")) jobs.Add(LoadOrdersAsync()); else _ordersLoading = false;
        if (AdminAuth.Can("payments")) jobs.Add(LoadPaymentsAsync()); else _paymentsLoading = false;
        if (AdminAuth.Can("batches")) jobs.Add(LoadBatchesAsync()); else _batchesLoading = false;
        if (AdminAuth.Can("customers")) jobs.Add(LoadCustomersAsync()); else _customersLoading = false;
        if (AdminAuth.Can("formulation")) { jobs.Add(LoadIngredientsAsync()); jobs.Add(LoadMetricsAsync()); }
        await Task.WhenAll(jobs);
    }

    private async Task LoadOrdersAsync()
    {
        _ordersLoading = true; StateHasChanged();
        var res = await Api.AdminOrdersAsync(); RecordError("Orders", res);
        _orders = res.Success ? res.Orders : new();
        _ordersLoading = false; StateHasChanged();
    }

    private async Task LoadPaymentsAsync()
    {
        _paymentsLoading = true; StateHasChanged();
        var res = await Api.AdminPaymentsAsync(); RecordError("Payments", res);
        _payments = res.Success ? res.Attempts : new();
        _paymentsLoading = false; StateHasChanged();
    }

    private async Task LoadCustomersAsync()
    {
        _customersLoading = true; StateHasChanged();
        var res = await Api.AdminCustomersAsync(); RecordError("Customers", res);
        if (res.Success) _customers = res.Customers;
        _customersLoading = false; StateHasChanged();
    }

    private async Task LoadBatchesAsync()
    {
        _batchesLoading = true; StateHasChanged();
        var res = await Api.AdminBatchesAsync(); RecordError("Batches", res);
        _batches = res.Success ? res.Batches : new();
        _batchesLoading = false; StateHasChanged();
    }

    private async Task LoadIngredientsAsync()
    {
        var data = await Api.GetIngredientsAsync();
        if (data is { Count: > 0 }) { _ingredients = data; StateHasChanged(); }
    }

    private async Task LoadMetricsAsync()
    {
        var data = await Api.GetMetricsAsync();
        if (data is not null) { _metrics = data; StateHasChanged(); }
    }

    private void OnIngredientsChanged(List<FormulationIngredientDto> list) => _ingredients = list;
    private void OnMetricsChanged(FormulationMetricsDto m) => _metrics = m;

    public void Dispose() => AdminAuth.Changed -= OnAuthChanged;
}
