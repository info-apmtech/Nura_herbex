@page "/checkout"
@implements IDisposable
@inject NavigationManager Nav
@inject ApiClient Api
@inject CartState Cart
@inject AuthState Auth
@inject BrowserInterop Browser

@if (_confirmed is not null)
{
    var isPrepaid = _confirmed.PaymentMethod.ToLowerInvariant().Contains("prepaid") || _confirmed.PaymentStatus == "PAID";

    <div class="min-h-screen pt-4 sm:pt-14 md:pt-20 pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-left">
        <div class="rounded-3xl bg-[#0c0a16] border border-emerald-500/30 p-8 sm:p-12 shadow-2xl shadow-emerald-950/40 relative overflow-hidden">
            @* Ambient Glow *@
            <div class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 space-y-6">
                <div class="w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
                    <Icon Name="CheckCircle2" Size="36" />
                </div>

                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 block mb-1">
                        @(isPrepaid ? "Order Confirmed · Payment Received" : "Order Confirmed · Cash on Delivery")
                    </span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
                        Thank you, @_confirmed.FullName!
                    </h1>
                    <p class="text-slate-400 text-sm mt-2">
                        Your order <span class="font-mono text-white font-bold">@_confirmed.OrderId</span> has been received and is being prepared for clinical dispatch.
                    </p>
                </div>

                @* Order Details Card *@
                <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 space-y-4 text-xs">
                    <div class="flex justify-between items-center pb-3 border-b border-white/10">
                        <span class="text-slate-400">Order Reference:</span>
                        <span class="font-mono font-bold text-white text-sm">@_confirmed.OrderId</span>
                    </div>
                    <div class="flex justify-between items-center pb-3 border-b border-white/10">
                        <span class="text-slate-400">Payment Status:</span>
                        <span class="@($"font-bold {(isPrepaid ? "text-emerald-400" : "text-amber-400")}")">
                            @(isPrepaid ? "PAID (Verified)" : "COD PENDING (Pay on Delivery)")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(_confirmed.Awb))
                    {
                        <div class="flex justify-between items-center pb-3 border-b border-white/10">
                            <span class="text-slate-400">Shiprocket Waybill (AWB):</span>
                            <span class="font-mono font-bold text-purple-300">
                                @_confirmed.Awb (@(string.IsNullOrEmpty(_confirmed.Courier) ? "Express Air" : _confirmed.Courier))
                            </span>
                        </div>
                    }
                    <div class="flex justify-between items-center pb-3 border-b border-white/10">
                        <span class="text-slate-400">Estimated Delivery:</span>
                        <span class="font-bold text-emerald-300">2–4 Business Days (Express Air)</span>
                    </div>
                    <div class="flex justify-between items-center pb-3 border-b border-white/10">
                        <span class="text-slate-400">Delivery Address:</span>
                        <span class="text-white text-right max-w-xs truncate">
                            @_confirmed.AddressLine1, @_confirmed.City, @_confirmed.State - @_confirmed.Pincode
                        </span>
                    </div>
                    <div class="flex justify-between items-center pt-1 font-bold text-sm">
                        <span class="text-slate-300">@(isPrepaid ? "Total Paid Amount:" : "Amount Due on Delivery (COD):")</span>
                        <span class="text-white text-base">₹@Num(_confirmed.Total)</span>
                    </div>
                </div>

                @* Account Confirmation Callout (Option C) *@
                <div class="p-4 rounded-2xl bg-gradient-to-r from-purple-950/70 to-indigo-950/50 border border-purple-500/40 flex items-start gap-3.5 text-xs text-purple-200 shadow-md">
                    <Icon Name="Sparkles" Size="20" Class="text-purple-400 shrink-0 mt-0.5" />
                    <div>
                        <div class="font-bold text-white text-sm">
                            @(_confirmed.AccountCreated ? "Vitality Account Activated!" : "Order Linked to Your Vitality Account!")
                        </div>
                        <div class="text-purple-300 text-[11px] mt-0.5 leading-relaxed">
                            You can now monitor real-time Shiprocket dispatch milestones, review your batch laboratory test certificate (COA), and manage saved shipping addresses directly in your account.
                        </div>
                    </div>
                </div>

                @* Notification Callout *@
                <div class="p-4 rounded-xl bg-purple-950/30 border border-purple-500/20 text-xs text-purple-200 flex items-center gap-3">
                    <Icon Name="Truck" Size="18" Class="text-purple-400 shrink-0" />
                    <span>
                        You will receive a WhatsApp tracking link with live carrier updates as soon as your batch is dispatched.
                    </span>
                </div>

                @* Action Buttons *@
                <div class="flex items-center gap-3 pt-4 flex-wrap">
                    <button @onclick="@(() => Nav.NavigateTo("/account"))"
                            class="px-6 py-3 rounded-xl bg-[#9929ea] hover:bg-[#a83bed] text-white font-bold text-xs uppercase tracking-wider cursor-pointer transition-all shadow-lg shadow-purple-900/40 flex items-center gap-2">
                        <Icon Name="User" Size="14" />
                        <span>Go to My Account</span>
                    </button>
                    <button @onclick="@(() => Nav.NavigateTo($"/track?id={Uri.EscapeDataString(_confirmed.OrderId)}"))"
                            class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs uppercase tracking-wider cursor-pointer transition-all">
                        Track Order Live
                    </button>
                    <button @onclick="@(() => Nav.NavigateTo("/"))"
                            class="px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-[#0c0916] font-bold text-xs uppercase tracking-wider cursor-pointer transition-all">
                        Return to Store
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    var isLoggedIn = Auth.IsAuthenticated;
    var customer = Auth.Customer;

    <div class="min-h-screen pt-4 sm:pt-14 md:pt-20 pb-20 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto text-left relative">

        @* Top Breadcrumb Header *@
        <div class="flex items-center justify-between pb-3 mb-4 sm:pb-6 sm:mb-8 border-b border-white/10 pr-12 sm:pr-0">
            <button @onclick="@(() => Nav.NavigateTo("/shop"))"
                    class="flex items-center gap-2 text-xs font-bold text-purple-400 hover:text-purple-300 transition-colors cursor-pointer">
                <Icon Name="ArrowLeft" Size="14" />
                <span>Back to Shop</span>
            </button>
        </div>

        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

            @* LEFT COLUMN: Shipping Details & Payment Method *@
            <div class="lg:col-span-7 space-y-6">

                @* Card 1: Shipping Details *@
                <div class="p-6 sm:p-8 rounded-3xl bg-[#0c0a16] border border-white/10 shadow-xl space-y-5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2.5 text-white font-bold text-lg">
                            <Icon Name="Truck" Size="20" Class="text-purple-400" />
                            <span>Shipping details</span>
                        </div>

                        @if (isLoggedIn)
                        {
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-[10px] font-mono font-bold text-emerald-300">
                                ★ Address Pre-filled
                            </span>
                        }
                    </div>

                    @if (isLoggedIn && customer is not null)
                    {
                        <div class="p-3.5 rounded-2xl bg-purple-950/40 border border-purple-500/30 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-purple-600/30 border border-purple-500/40 flex items-center justify-center text-[#fff3bf] font-bold text-xs">
                                    @((string.IsNullOrEmpty(customer.FullName) ? "U" : customer.FullName.Substring(0, 1)).ToUpperInvariant())
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <span>Signed in as @customer.FullName</span>
                                        <span class="text-[10px] font-mono text-slate-400">(@customer.Email)</span>
                                    </div>
                                    <div class="text-[11px] text-purple-300/80">Order will automatically link to your Vitality Account.</div>
                                </div>
                            </div>
                            <button type="button" @onclick="@(() => Auth.SignOutAsync())"
                                    class="text-xs text-purple-400 hover:text-purple-300 underline cursor-pointer">
                                Sign out
                            </button>
                        </div>
                    }

                    <div class="space-y-4 text-xs">
                        @* Row 1: Full name * & Phone * *@
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-slate-300 font-semibold mb-1.5">
                                    Full name *
                                </label>
                                <input type="text" required placeholder="Enter your name"
                                       @bind="_f.FullName" @bind:event="oninput"
                                       class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                            </div>

                            <div>
                                <label class="block text-slate-300 font-semibold mb-1.5">
                                    Phone *
                                </label>
                                <input type="tel" required placeholder="Enter your number"
                                       @bind="_f.Phone" @bind:event="oninput"
                                       class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                            </div>
                        </div>

                        @* Row 2: Email * *@
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1.5">
                                Email *
                            </label>
                            <input type="email" required placeholder="Enter your email"
                                   @bind="_f.Email" @bind:event="oninput"
                                   class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                        </div>

                        @* Row 3: Address line 1 * *@
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1.5">
                                Address line 1 *
                            </label>
                            <input type="text" required placeholder="Street address, flat / house no."
                                   @bind="_f.AddressLine1" @bind:event="oninput"
                                   class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                        </div>

                        @* Row 4: Address line 2 *@
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1.5">
                                Address line 2
                            </label>
                            <input type="text" placeholder="Apartment, suite, landmark (optional)"
                                   @bind="_f.AddressLine2" @bind:event="oninput"
                                   class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                        </div>

                        @* Row 5: City * & State * *@
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-slate-300 font-semibold mb-1.5">
                                    City *
                                </label>
                                <input type="text" required placeholder="City"
                                       @bind="_f.City" @bind:event="oninput"
                                       class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                            </div>

                            <div>
                                <label class="block text-slate-300 font-semibold mb-1.5">
                                    State *
                                </label>
                                <input type="text" required placeholder="State"
                                       @bind="_f.State" @bind:event="oninput"
                                       class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                            </div>
                        </div>

                        @* Row 6: Pincode * *@
                        <div>
                            <label class="block text-slate-300 font-semibold mb-1.5">
                                Pincode *
                            </label>
                            <input type="text" required maxlength="6" placeholder="6-digit"
                                   value="@_f.Pincode" @oninput="OnPincodeInputAsync"
                                   class="w-full sm:w-1/2 px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                            @if (_pincodeServiceable == false)
                            {
                                <p class="mt-1.5 text-[11px] text-amber-400">We may not be able to deliver to this pincode yet. You can still place the order and we will contact you if delivery is not possible.</p>
                            }
                        </div>
                    </div>
                </div>

                @* Card 1.5: Account Security & Order Tracking (Option C) *@
                @if (!isLoggedIn)
                {
                    <div class="p-6 sm:p-8 rounded-3xl bg-[#0c0a16] border border-white/10 shadow-xl space-y-4">
                        <div class="flex items-center justify-between flex-wrap gap-2">
                            <div class="flex items-center gap-2.5 text-white font-bold text-lg">
                                <Icon Name="Lock" Size="20" Class="text-purple-400" />
                                <span>Account Security &amp; Order Tracking</span>
                            </div>
                            <button type="button"
                                    @onclick="@(() => { _signInOpen = !_signInOpen; _signInError = ""; })"
                                    class="text-xs text-purple-400 hover:text-purple-300 font-semibold underline cursor-pointer">
                                @(_signInOpen ? "← Create new account instead" : "Already have an account? Sign in")
                            </button>
                        </div>

                        @if (_signInOpen)
                        {
                            @* Inline Sign In for Returning Customers *@
                            <div class="p-4 rounded-2xl bg-black/40 border border-purple-500/20 space-y-3.5 text-xs">
                                <div class="flex items-center justify-between">
                                    <span class="text-slate-300 font-medium">Sign in to auto-fill your saved address:</span>

                                    @* Method Selector *@
                                    <div class="flex items-center gap-1.5 p-0.5 rounded-lg bg-black/60 border border-white/10">
                                        <button type="button"
                                                @onclick="@(() => { _authMethod = "password"; _signInError = ""; })"
                                                class="@($"px-2.5 py-1 rounded text-[10px] font-bold uppercase transition-all {(_authMethod == "password" ? "bg-white/15 text-white" : "text-slate-400 hover:text-white")}")">
                                            Password
                                        </button>
                                        <button type="button"
                                                @onclick="@(() => { _authMethod = "otp"; _signInError = ""; })"
                                                class="@($"px-2.5 py-1 rounded text-[10px] font-bold uppercase transition-all {(_authMethod == "otp" ? "bg-purple-900/70 text-purple-200 border border-purple-500/30" : "text-slate-400 hover:text-white")}")">
                                            Email OTP
                                        </button>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(_signInError))
                                {
                                    <div class="p-2.5 rounded-xl bg-red-950/40 border border-red-500/30 text-red-300 text-xs">
                                        @_signInError
                                    </div>
                                }

                                @if (_authMethod == "password")
                                {
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-slate-400 mb-1 font-semibold">Email or Phone</label>
                                            <input type="text" placeholder="e.g. rahul@@example.com"
                                                   @bind="_signInEmailOrPhone" @bind:event="oninput"
                                                   class="w-full px-3.5 py-2.5 rounded-xl bg-black/60 border border-white/15 text-white text-xs outline-none focus:border-purple-500" />
                                        </div>
                                        <div>
                                            <label class="block text-slate-400 mb-1 font-semibold">Password</label>
                                            <input type="password" placeholder="Your password"
                                                   @bind="_signInPassword" @bind:event="oninput"
                                                   class="w-full px-3.5 py-2.5 rounded-xl bg-black/60 border border-white/15 text-white text-xs outline-none focus:border-purple-500" />
                                        </div>
                                    </div>
                                    <button type="button" disabled="@_signInLoading" @onclick="InlineSignInAsync"
                                            class="py-2.5 px-5 rounded-xl bg-[#9929ea] hover:bg-[#a83bed] text-white font-bold text-xs uppercase tracking-wider cursor-pointer transition-all disabled:opacity-50 flex items-center gap-2">
                                        @if (_signInLoading)
                                        {
                                            <Icon Name="RefreshCw" Size="12" Class="animate-spin" />
                                        }
                                        <span>@(_signInLoading ? "Signing In..." : "Sign In with Password")</span>
                                    </button>
                                }
                                else
                                {
                                    @* Inline Email OTP Form *@
                                    <div class="space-y-3">
                                        @if (!_otpSent)
                                        {
                                            <div class="flex flex-col sm:flex-row gap-3 items-end">
                                                <div class="flex-1 w-full">
                                                    <label class="block text-slate-400 mb-1 font-semibold">Email Address</label>
                                                    <input type="email" placeholder="name@@example.com"
                                                           value="@(string.IsNullOrEmpty(_signInEmailOrPhone) ? _f.Email : _signInEmailOrPhone)"
                                                           @oninput="e => _signInEmailOrPhone = e.Value?.ToString() ?? string.Empty"
                                                           class="w-full px-3.5 py-2.5 rounded-xl bg-black/60 border border-white/15 text-white text-xs outline-none focus:border-purple-500" />
                                                </div>
                                                <button type="button" disabled="@_signInLoading" @onclick="InlineSendOtpAsync"
                                                        class="py-2.5 px-4 rounded-xl bg-[#9929ea] hover:bg-[#a83bed] text-white font-bold text-xs uppercase tracking-wider cursor-pointer transition-all disabled:opacity-50 whitespace-nowrap flex items-center gap-1.5">
                                                    <Icon Name="Mail" Size="13" />
                                                    <span>@(_signInLoading ? "Sending..." : "Send OTP")</span>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="space-y-3">
                                                <div class="flex items-center justify-between text-[11px] text-slate-400 bg-white/[0.03] p-2 rounded-lg">
                                                    <span>Code sent to <strong class="text-white">@(string.IsNullOrEmpty(_signInEmailOrPhone) ? _f.Email : _signInEmailOrPhone)</strong></span>
                                                    <button type="button"
                                                            @onclick="@(() => { _otpSent = false; _otpCode = ""; })"
                                                            class="text-purple-400 hover:text-purple-300 underline">
                                                        Edit
                                                    </button>
                                                </div>
                                                <div class="flex flex-col sm:flex-row gap-3 items-center">
                                                    <input type="text" maxlength="6" placeholder="Enter 6-digit OTP"
                                                           value="@_otpCode" @oninput="e => _otpCode = Digits(e.Value?.ToString())"
                                                           class="w-full sm:w-48 px-3.5 py-2 rounded-xl bg-black/60 border border-purple-500/60 font-mono text-center text-base font-bold tracking-widest text-[#fff3bf] outline-none focus:border-purple-400" />
                                                    <button type="button" disabled="@_signInLoading" @onclick="InlineVerifyOtpAsync"
                                                            class="w-full sm:w-auto py-2.5 px-5 rounded-xl bg-[#9929ea] hover:bg-[#a83bed] text-white font-bold text-xs uppercase tracking-wider cursor-pointer transition-all disabled:opacity-50 flex items-center justify-center gap-1.5">
                                                        <Icon Name="CheckCircle2" Size="13" />
                                                        <span>@(_signInLoading ? "Verifying..." : "Verify & Sign In")</span>
                                                    </button>
                                                </div>
                                                <div class="text-right">
                                                    @if (_otpCountdown > 0)
                                                    {
                                                        <span class="text-[11px] text-slate-500 font-mono">
                                                            Resend code in @(_otpCountdown)s
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" @onclick="InlineSendOtpAsync"
                                                                class="text-[11px] text-purple-400 hover:text-purple-300 underline cursor-pointer">
                                                            Resend OTP
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* New Customer Password Setup *@
                            <div class="space-y-3.5 text-xs">
                                <div class="p-3.5 rounded-2xl bg-purple-950/30 border border-purple-500/20 flex items-start gap-2.5 text-slate-300">
                                    <Icon Name="Sparkles" Size="16" Class="text-purple-400 shrink-0 mt-0.5" />
                                    <span>
                                        Set a password to create your <strong>Nura Herbex account</strong>. You can track orders, manage delivery details, and submit product reviews from your account.
                                    </span>
                                </div>

                                <div>
                                    <label class="block text-slate-300 font-semibold mb-1.5">
                                        Choose Account Password (min. 6 characters) *
                                    </label>
                                    <div class="relative">
                                        <input type="@(_showPassword ? "text" : "password")" required minlength="6"
                                               placeholder="Create a secure password"
                                               @bind="_accountPassword" @bind:event="oninput"
                                               class="w-full px-4 py-3 rounded-xl bg-black/40 border border-white/15 text-white text-xs outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all pr-10 placeholder:text-slate-600" />
                                        <button type="button" @onclick="@(() => _showPassword = !_showPassword)"
                                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white transition-colors cursor-pointer">
                                            @if (_showPassword)
                                            {
                                                <Icon Name="EyeOff" Size="16" />
                                            }
                                            else
                                            {
                                                <Icon Name="Eye" Size="16" />
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* Card 2: Payment Method *@
                <div class="p-6 sm:p-8 rounded-3xl bg-[#0c0a16] border border-white/10 shadow-xl space-y-4">
                    <div class="text-white font-bold text-lg">
                        Payment method
                    </div>

                    <div class="space-y-3 text-xs">
                        @* COD Option *@
                        <div @onclick="@(() => _paymentMethod = "cod")"
                             class="@($"p-4 rounded-2xl border transition-all cursor-pointer flex items-center justify-between {(_paymentMethod == "cod" ? "bg-purple-900/20 border-purple-500 ring-1 ring-purple-500" : "bg-black/30 border-white/10")}")">
                            <div class="flex items-center gap-3">
                                <div class="@($"w-5 h-5 rounded-full border-2 flex items-center justify-center p-0.5 {(_paymentMethod == "cod" ? "border-purple-400" : "border-slate-600")}")">
                                    <div class="@($"w-full h-full rounded-full {(_paymentMethod == "cod" ? "bg-purple-500" : "bg-transparent")}")"></div>
                                </div>
                                <div>
                                    <div class="font-bold text-white text-sm">Cash on Delivery</div>
                                    <div class="text-slate-400 text-[11px]">Pay when you receive your order</div>
                                </div>
                            </div>
                            <Icon Name="Truck" Size="18" Class="text-slate-400" />
                        </div>

                        @* Pay Online Option *@
                        <div @onclick="@(() => _paymentMethod = "online")"
                             class="@($"p-4 rounded-2xl border transition-all cursor-pointer flex items-center justify-between {(_paymentMethod == "online" ? "bg-purple-900/20 border-purple-500 ring-1 ring-purple-500" : "bg-black/30 border-white/10 hover:border-white/20")}")">
                            <div class="flex items-center gap-3">
                                <div class="@($"w-5 h-5 rounded-full border-2 flex items-center justify-center p-0.5 {(_paymentMethod == "online" ? "border-purple-400" : "border-slate-600")}")">
                                    <div class="@($"w-full h-full rounded-full {(_paymentMethod == "online" ? "bg-purple-500" : "bg-transparent")}")"></div>
                                </div>
                                <div>
                                    <div class="font-bold text-white text-sm">Pay Online (PayU Instant Dispatch)</div>
                                    <div class="text-slate-400 text-[11px]">UPI (Google Pay, PhonePe, Paytm, QR), Cards, Net Banking</div>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-[9px] font-bold text-emerald-300 uppercase tracking-wider">
                                FASTEST
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @* RIGHT COLUMN: Order Summary *@
            <div class="lg:col-span-5">
                <div class="p-6 sm:p-8 rounded-3xl bg-[#0c0a16] border border-white/10 shadow-xl sticky top-28 space-y-6">
                    <div class="text-white font-bold text-lg border-b border-white/10 pb-4">
                        Order summary
                    </div>

                    @* Product Items List *@
                    <div class="space-y-3">
                        @foreach (var item in CheckoutItems)
                        {
                            <div @key="item.Id" class="flex items-center justify-between gap-3 text-xs">
                                <div class="flex items-center gap-3">
                                    <div class="w-14 h-14 rounded-2xl bg-black/60 border border-white/10 p-1.5 flex items-center justify-center shrink-0">
                                        <img src="@(string.IsNullOrEmpty(item.Image) ? Media.StamixMockup1 : item.Image)" alt="@item.Name"
                                             class="max-h-full object-contain filter drop-shadow-md" />
                                    </div>
                                    <div>
                                        <div class="font-bold text-white text-sm leading-tight">@item.Name</div>
                                        <div class="text-slate-400 text-[11px] mt-0.5">Qty @item.Quantity</div>
                                    </div>
                                </div>
                                <span class="font-extrabold text-white text-sm">
                                    ₹@Num(item.Price * item.Quantity)
                                </span>
                            </div>
                        }
                    </div>

                    @* Coupon Code Section *@
                    <div class="pt-2">
                        <div class="flex gap-2">
                            <input type="text" placeholder="Coupon code"
                                   @bind="_couponCode" @bind:event="oninput"
                                   class="flex-1 px-4 py-2.5 rounded-xl bg-black/50 border border-white/15 text-white text-xs outline-none focus:border-purple-500 uppercase tracking-wider" />
                            <button type="button" @onclick="ApplyCouponAsync"
                                    class="px-5 py-2.5 rounded-xl bg-[#2a223f] hover:bg-[#392f54] text-purple-200 border border-purple-500/30 font-bold text-xs uppercase tracking-wider transition-all cursor-pointer">
                                Apply
                            </button>
                        </div>
                        @if (_couponApplied)
                        {
                            <p class="text-[11px] text-emerald-400 font-semibold mt-1.5 flex items-center gap-1">
                                <Icon Name="Check" Size="12" /> Coupon applied (@SavingsLabel savings)
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(_couponError))
                        {
                            <p class="text-[11px] text-red-400 font-semibold mt-1.5">
                                @_couponError
                            </p>
                        }
                    </div>

                    @* Price Calculations *@
                    <div class="space-y-2.5 pt-4 border-t border-white/10 text-xs">
                        <div class="flex justify-between text-slate-300">
                            <span>Subtotal</span>
                            <span class="font-mono font-bold text-white">₹@Num(SubtotalValue)</span>
                        </div>

                        @if (DiscountValue > 0)
                        {
                            <div class="flex justify-between text-emerald-400">
                                <span>Coupon Discount (@SavingsLabel)</span>
                                <span class="font-mono font-bold">-₹@Num(DiscountValue)</span>
                            </div>
                        }

                        <div class="flex justify-between text-slate-300 items-center">
                            <span>Shipping</span>
                            @if (ShippingValue > 0)
                            {
                                <span class="font-mono font-bold text-white">₹@Num(ShippingValue)</span>
                            }
                            else
                            {
                                <span class="text-emerald-400 font-bold uppercase tracking-wider text-[11px]">Free</span>
                            }
                        </div>
                    </div>

                    @* Total Line *@
                    <div class="pt-4 border-t border-white/10 flex justify-between items-baseline">
                        <span class="text-white font-bold text-base">Total</span>
                        <span class="text-2xl font-black text-white font-mono">
                            ₹@Num(FinalTotalValue)
                        </span>
                    </div>

                    @* Submit Action Button *@
                    <div class="pt-2">
                        <button type="submit" disabled="@_isSubmitting"
                                class="w-full py-4 px-6 rounded-2xl bg-[#9929ea] hover:bg-[#a83bed] disabled:bg-purple-950/70 disabled:cursor-not-allowed disabled:pointer-events-none text-white font-black text-sm uppercase tracking-wider flex items-center justify-center gap-2.5 shadow-xl shadow-[#9929ea]/30 transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer font-heading">
                            @if (_isSubmitting)
                            {
                                <Icon Name="RefreshCw" Size="18" Class="animate-spin text-purple-200" />
                                <span>
                                    @(_paymentMethod == "online" ? "CONNECTING TO PAYU..." : "SECURING ORDER...")
                                </span>
                            }
                            else
                            {
                                <Icon Name="Check" Size="18" StrokeWidth="3" Class="text-white" />
                                <span>
                                    @(_paymentMethod == "cod" ? "PLACE ORDER (COD)" : $"PAY NOW · ₹{Num(FinalTotalValue)}")
                                </span>
                            }
                        </button>

                        <div class="flex items-center justify-center gap-1.5 text-xs text-slate-400 pt-3 text-center">
                            <Icon Name="ShieldCheck" Size="14" Class="text-emerald-400" />
                            <span>Secure checkout · Free returns within 7 days</span>
                        </div>
                    </div>

                </div>
            </div>
        </form>

        @* Floating Red Error Toast *@
        <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none">
            @foreach (var toast in _toasts)
            {
                <div @key="toast.Id"
                     class="px-5 py-3 rounded-xl bg-red-600/95 text-white font-bold text-xs shadow-2xl shadow-red-950/60 flex items-center gap-2.5 animate-in slide-in-from-bottom-5 duration-200 border border-red-400/40">
                    <Icon Name="AlertCircle" Size="16" Class="text-white shrink-0" />
                    <span>@toast.Message</span>
                </div>
            }
        </div>

    </div>
}

@code {
    // null = unknown / not checked. Advisory only: checkout is never blocked on this.
    private bool? _pincodeServiceable;

    private async Task OnPincodeInputAsync(ChangeEventArgs e)
    {
        _f.Pincode = Digits(e.Value?.ToString());
        _pincodeServiceable = null;
        if (_f.Pincode.Length != 6) return;

        var pin = _f.Pincode;
        var res = await Api.CheckPincodeAsync(pin);
        if (_f.Pincode == pin) _pincodeServiceable = res.Serviceable; // ignore stale replies if the user kept typing
        StateHasChanged();
    }

    [SupplyParameterFromQuery(Name = "status"), Parameter] public string? StatusParam { get; set; }
    [SupplyParameterFromQuery(Name = "orderId"), Parameter] public string? OrderIdParam { get; set; }
    [SupplyParameterFromQuery(Name = "message"), Parameter] public string? MessageParam { get; set; }

    private sealed class FormModel
    {
        public string FullName = "", Phone = "", Email = "", AddressLine1 = "", AddressLine2 = "", City = "", State = "", Pincode = "";
    }

    private sealed class ConfirmedOrder
    {
        public string OrderId = "";
        public string FullName = "", AddressLine1 = "", City = "", State = "", Pincode = "";
        public decimal Total;
        public string PaymentMethod = "";
        public string PaymentStatus = "";
        public string? Awb, Courier;
        public bool AccountCreated;
    }

    private sealed record Toast(long Id, string Message);

    private readonly FormModel _f = new();
    private ConfirmedOrder? _confirmed;
    private readonly List<Toast> _toasts = new();
    private long _toastSeq;

    private string _accountPassword = "";
    private bool _showPassword;
    private bool _signInOpen;
    private string _authMethod = "password";
    private string _signInEmailOrPhone = "", _signInPassword = "", _signInError = "", _otpCode = "";
    private bool _signInLoading, _otpSent;
    private int _otpCountdown;

    private string _paymentMethod = "cod";
    private string _couponCode = "";
    private bool _couponApplied;
    private string _couponError = "";
    private bool _isSubmitting;

    private OrderTotalsDto? _totals;
    private int _totalsVersion;
    private bool _disposed;
    private string? _handledKey;
    private CustomerDto? _prefilledFor;

    private static readonly CartItem FallbackItem = new()
    {
        Id = "stamix-single", Name = "Stamix", Price = 1899, Quantity = 1,
        Image = Media.StamixMockup1, ServingsText = "15-Day Supply · Botanical Vitality Formula",
    };

    private List<CartItem> CheckoutItems => Cart.Items.Count > 0 ? Cart.Items : new List<CartItem> { FallbackItem };
    private decimal LocalSubtotal => CheckoutItems.Sum(i => i.Price * i.Quantity);

    private decimal SubtotalValue => _totals is { Success: true } ? _totals.Subtotal : LocalSubtotal;
    private decimal DiscountValue => _totals is { Success: true } ? _totals.DiscountAmount : 0;
    private decimal ShippingValue => _totals is { Success: true } ? _totals.ShippingFee : 0;
    private decimal FinalTotalValue => _totals is { Success: true } ? _totals.FinalTotal : Math.Max(0, LocalSubtotal);
    private string SavingsLabel => _totals is { DiscountPercent: > 0 } ? $"{Num(_totals.DiscountPercent)}%" : $"₹{Num(DiscountValue)}";

    private static string Num(decimal d) => d % 1 == 0 ? ((long)d).ToString() : d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Digits(string? s) => new string((s ?? "").Where(char.IsDigit).ToArray());

    protected override void OnInitialized()
    {
        Cart.Changed += OnCartChanged;
        Auth.Changed += OnAuthChanged;
        ApplyCustomer();
        _ = RefreshTotalsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.SetMetaAsync(RouteMeta.Checkout);
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{StatusParam}|{OrderIdParam}|{MessageParam}";
        if (key == _handledKey) return;
        _handledKey = key;

        if (StatusParam == "confirmed" && !string.IsNullOrEmpty(OrderIdParam))
        {
            var res = await Api.GetOrderAsync(OrderIdParam);
            if (res.Success && res.Order is { } o)
            {
                _confirmed = new ConfirmedOrder
                {
                    OrderId = o.Id,
                    FullName = o.CustomerName,
                    AddressLine1 = o.ShippingAddress.AddressLine1,
                    City = o.ShippingAddress.City,
                    State = o.ShippingAddress.State,
                    Pincode = o.ShippingAddress.Pincode,
                    Total = o.TotalAmount,
                    PaymentMethod = "Prepaid Online (PayU Verified)",
                    PaymentStatus = o.PaymentStatus,
                    Awb = o.ShiprocketAwb,
                    Courier = o.ShiprocketCourier,
                };
                await Cart.ClearAsync();
            }
        }
        else if (StatusParam == "failed")
        {
            ShowToast(string.IsNullOrWhiteSpace(MessageParam) ? "Payment was unsuccessful or cancelled by user." : MessageParam);
        }
    }

    private void OnCartChanged()
    {
        if (_confirmed is null) _ = RefreshTotalsAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnAuthChanged()
    {
        ApplyCustomer();
        _ = InvokeAsync(StateHasChanged);
    }

    // Auto-fill form when logged in or customer profile changes
    private void ApplyCustomer()
    {
        var c = Auth.Customer;
        if (c is null || ReferenceEquals(c, _prefilledFor)) return;
        _prefilledFor = c;
        string Pick(string? v, string prev) => string.IsNullOrEmpty(v) ? prev : v;
        _f.FullName = Pick(c.FullName, _f.FullName);
        _f.Email = Pick(c.Email, _f.Email);
        _f.Phone = Pick(c.Phone, _f.Phone);
        _f.AddressLine1 = Pick(c.ShippingAddress?.AddressLine1, _f.AddressLine1);
        _f.AddressLine2 = Pick(c.ShippingAddress?.AddressLine2, _f.AddressLine2);
        _f.City = Pick(c.ShippingAddress?.City, _f.City);
        _f.State = Pick(c.ShippingAddress?.State, _f.State);
        _f.Pincode = Pick(c.ShippingAddress?.Pincode, _f.Pincode);
    }

    private List<CartLineDto> Lines() =>
        Cart.Items.Count > 0 ? Cart.ToLines() : new List<CartLineDto> { new() { Id = FallbackItem.Id, Quantity = FallbackItem.Quantity } };

    private Task<OrderTotalsDto> ValidateAsync(string? coupon) =>
        Api.ValidateCartAsync(new ValidateCartRequest { Items = Lines(), CouponCode = string.IsNullOrWhiteSpace(coupon) ? null : coupon });

    /// <summary>Authoritative totals from the API (falls back to local math when the call fails).</summary>
    private async Task RefreshTotalsAsync()
    {
        var version = ++_totalsVersion;
        var res = await ValidateAsync(_couponApplied ? _couponCode.Trim().ToUpperInvariant() : null);
        if (version != _totalsVersion || _disposed) return;
        if (res.Success) _totals = res;
        else
        {
            _totals = null;
            _couponApplied = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyCouponAsync()
    {
        _couponError = "";
        var code = _couponCode.Trim().ToUpperInvariant();
        if (code.Length == 0) return;

        var res = await ValidateAsync(code);
        if (res.Success && (res.DiscountAmount > 0 || !string.IsNullOrEmpty(res.CouponCode)))
        {
            _couponApplied = true;
            _totals = res;
        }
        else
        {
            _couponApplied = false;
            _couponError = string.IsNullOrEmpty(res.Message) || res.Success ? "Invalid coupon code" : res.Message!;
            var plain = await ValidateAsync(null);
            _totals = plain.Success ? plain : null;
        }
    }

    private void ShowToast(string message)
    {
        var toast = new Toast(++_toastSeq, message);
        _toasts.Add(toast);
        _ = RemoveToastLater(toast);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RemoveToastLater(Toast toast)
    {
        await Task.Delay(4000);
        if (_disposed) return;
        _toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    // ----------------------------------------------------------------- inline sign-in
    private async Task InlineSignInAsync()
    {
        if (string.IsNullOrEmpty(_signInEmailOrPhone) || string.IsNullOrEmpty(_signInPassword))
        {
            _signInError = "Please enter both email/phone and password";
            return;
        }
        _signInLoading = true;
        _signInError = "";
        var res = await Auth.LoginAsync(_signInEmailOrPhone, _signInPassword);
        if (res.Success)
        {
            _signInOpen = false;
            ShowToast("Signed in successfully! Saved address applied.");
        }
        else _signInError = string.IsNullOrEmpty(res.Message) ? "Login failed. Please check your credentials." : res.Message!;
        _signInLoading = false;
    }

    private string OtpTarget => (string.IsNullOrEmpty(_signInEmailOrPhone) ? _f.Email : _signInEmailOrPhone).Trim();

    private async Task InlineSendOtpAsync()
    {
        var target = OtpTarget;
        if (string.IsNullOrEmpty(target) || !target.Contains('@'))
        {
            _signInError = "Please enter a valid email address to receive a login code";
            return;
        }
        _signInLoading = true;
        _signInError = "";
        var res = await Auth.SendOtpAsync(target);
        if (res.Success)
        {
            _otpSent = true;
            _otpCountdown = 30;
            ShowToast($"6-digit login code sent to {target}");
            _ = RunCountdownAsync();
        }
        else _signInError = string.IsNullOrEmpty(res.Message) ? "Failed to send login code" : res.Message!;
        _signInLoading = false;
    }

    private async Task RunCountdownAsync()
    {
        while (_otpCountdown > 0 && !_disposed)
        {
            await Task.Delay(1000);
            if (_disposed) return;
            _otpCountdown--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task InlineVerifyOtpAsync()
    {
        var target = OtpTarget;
        if (string.IsNullOrEmpty(_otpCode) || _otpCode.Trim().Length < 6)
        {
            _signInError = "Please enter the 6-digit verification code";
            return;
        }
        _signInLoading = true;
        _signInError = "";
        var res = await Auth.VerifyOtpAsync(target, _otpCode);
        if (res.Success)
        {
            _signInOpen = false;
            ShowToast("Signed in successfully! Saved address applied.");
        }
        else _signInError = string.IsNullOrEmpty(res.Message) ? "Invalid or expired code. Please try again." : res.Message!;
        _signInLoading = false;
    }

    // ----------------------------------------------------------------- submit
    private async Task HandleSubmit()
    {
        if (_isSubmitting) return;

        if (CheckoutItems.Count == 0) { ShowToast("Your cart is empty"); return; }

        if (new[] { _f.FullName, _f.Phone, _f.Email, _f.AddressLine1, _f.City, _f.State, _f.Pincode }.Any(string.IsNullOrWhiteSpace))
        {
            ShowToast("Please fill all required shipping fields");
            return;
        }

        if (Digits(_f.Phone.Trim()).Length < 10) { ShowToast("Please enter a valid 10-digit Phone number"); return; }
        if (_f.Pincode.Trim().Length < 6) { ShowToast("Please enter a valid 6-digit Pincode"); return; }

        var isLoggedIn = Auth.IsAuthenticated;
        if (!isLoggedIn && (string.IsNullOrEmpty(_accountPassword) || _accountPassword.Length < 6))
        {
            ShowToast("Please choose an account password (at least 6 characters) to secure your order");
            return;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var online = _paymentMethod != "cod";
            var req = new CreateOrderRequest
            {
                Customer = new CheckoutCustomerDto
                {
                    FullName = _f.FullName, Phone = _f.Phone, Email = _f.Email,
                    Password = !isLoggedIn ? _accountPassword : null,
                },
                Shipping = new AddressDto
                {
                    AddressLine1 = _f.AddressLine1, AddressLine2 = _f.AddressLine2, City = _f.City,
                    State = _f.State, Pincode = _f.Pincode, Country = "India",
                },
                Items = Lines(),
                CouponCode = _couponApplied ? _couponCode.Trim().ToUpperInvariant() : null,
                PaymentMethod = online ? "ONLINE" : "COD",
            };

            var res = await Api.CreateOrderAsync(req);
            if (!res.Success) throw new InvalidOperationException(string.IsNullOrEmpty(res.Message) ? "Failed to create order" : res.Message);

            if (res.CustomerAuth is not null) await Auth.AdoptAsync(res.CustomerAuth);

            var created = res.Order;
            var orderId = !string.IsNullOrEmpty(res.OrderId) ? res.OrderId : created?.Id ?? "";
            var total = created?.TotalAmount ?? FinalTotalValue;

            if (!online)
            {
                _confirmed = new ConfirmedOrder
                {
                    OrderId = orderId, FullName = _f.FullName, AddressLine1 = _f.AddressLine1, City = _f.City,
                    State = _f.State, Pincode = _f.Pincode, Total = total,
                    PaymentMethod = "Cash on Delivery",
                    PaymentStatus = string.IsNullOrEmpty(created?.PaymentStatus) ? "COD_PENDING" : created!.PaymentStatus,
                    Awb = created?.ShiprocketAwb, Courier = created?.ShiprocketCourier,
                    AccountCreated = res.CustomerAuth is not null || !isLoggedIn,
                };
                await Cart.ClearAsync();
                _isSubmitting = false;
                await Browser.ScrollToTopAsync();
                return;
            }

            var pay = await Api.PayUInitiateAsync(orderId);
            if (!pay.Success) throw new InvalidOperationException(string.IsNullOrEmpty(pay.Message) ? "Payment initialization failed" : pay.Message);

            if (pay.Simulated)
            {
                var fields = new Dictionary<string, string>(pay.Fields)
                {
                    ["udf1"] = orderId,
                    ["status"] = "success",
                    ["simulated"] = "true",
                    ["mihpayid"] = $"payu_sim_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
                };
                if (!fields.ContainsKey("txnid")) fields["txnid"] = $"TXN_{orderId}_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
                if (!fields.ContainsKey("amount")) fields["amount"] = pay.Amount;

                var verify = await Api.PayUVerifyAsync(fields);
                _confirmed = new ConfirmedOrder
                {
                    OrderId = orderId, FullName = _f.FullName, AddressLine1 = _f.AddressLine1, City = _f.City,
                    State = _f.State, Pincode = _f.Pincode, Total = total,
                    PaymentMethod = "Prepaid Online (PayU Instant Dispatch)",
                    PaymentStatus = "PAID",
                    Awb = verify.Order?.ShiprocketAwb, Courier = verify.Order?.ShiprocketCourier,
                    AccountCreated = res.CustomerAuth is not null || !isLoggedIn,
                };
                await Cart.ClearAsync();
                _isSubmitting = false;
                await Browser.ScrollToTopAsync();
                return;
            }

            // Live PayU checkout: POST form to the gateway
            await Browser.PostFormAsync(pay.ActionUrl, pay.Fields);
        }
        catch (Exception ex)
        {
            ShowToast(string.IsNullOrEmpty(ex.Message) ? "An error occurred during order submission" : ex.Message);
            _isSubmitting = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Cart.Changed -= OnCartChanged;
        Auth.Changed -= OnAuthChanged;
    }
}
