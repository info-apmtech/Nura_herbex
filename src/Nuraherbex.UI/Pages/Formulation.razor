@page "/formulation"
@page "/ingredients"
@page "/the-formula"
@using Nuraherbex.UI.Components.Home
@inject NavigationManager Nav
@inject ApiClient Api
@inject BrowserInterop Browser

<div class="nh-storefront">
<HomeNavbar />
<div class="fm">

  @* Hero *@
  <MobileSection Id="fm.hero"><section class="fm-hero">
    <span class="fm-orb o1" aria-hidden="true"></span>
    <span class="fm-orb o2" aria-hidden="true"></span>
    <span class="fm-orb o3" aria-hidden="true"></span>
    <div class="fm-wrap">
      <nav class="fm-crumbs" aria-label="Breadcrumb"><button @onclick="HandleBack">Home</button><Icon Name="ChevronRight" Size="12" /><span>Formulation</span></nav>
      <span class="fm-eyebrow"><Icon Name="FlaskConical" Size="14" /> 100% label transparency</span>
      <h1>Every milligram accounted for.<br /><em>Zero proprietary blends.</em></h1>
      <p>Most supplements hide their dosages behind unverified "proprietary matrices". STAMIX™ discloses the precise inclusion of all 17 botanicals, herbs, seeds and nuts in every daily serving.</p>

      <div class="fm-metrics">
        <div><Icon Name="Scale" Size="20" /><strong>@ServingMain</strong><span>@ServingSub</span></div>
        <div><Icon Name="Leaf" Size="20" /><strong>@TotalIngredientsText</strong><span>Whole-food actives</span></div>
        <div><Icon Name="ShieldCheck" Size="20" /><strong>Lab tested</strong><span>Third-party verified</span></div>
        <div><Icon Name="Zap" Size="20" /><strong>0.00%</strong><span>Synthetic fillers</span></div>
      </div>
    </div>
  </section></MobileSection>

  @* Ingredient ticker *@
  <MobileSection Id="fm.ticker">
  @if (_ingredients.Count > 0)
  {
    <div class="fm-ticker" aria-hidden="true">
      <div class="fm-ticker-track">
        @for (var pass = 0; pass < 2; pass++)
        {
          foreach (var t in _ingredients)
          {
            <span>@t.Name <i></i></span>
          }
        }
      </div>
    </div>
  }
  </MobileSection>

  @* Matrix *@
  <MobileSection Id="fm.matrix"><section class="fm-section" id="ingredient-matrix">
    <div class="fm-wrap">
      <header class="fm-head">
        <span class="fm-eyebrow">The ingredient matrix</span>
        <h2>What goes into <em>every serving</em></h2>
        <p>Amounts are listed per daily dose (20 g, two scoops). Search or filter by category.</p>
      </header>

      @if (_products.Count > 0)
      {
        <div class="fm-pills fm-products" role="tablist" aria-label="Select product">
          @foreach (var p in _products)
          {
            var prod = p;
            <button @key="prod.Id" role="tab" aria-selected="@(_productId == prod.Id)" @onclick="() => SelectProduct(prod.Id)" class="fm-pill @(_productId == prod.Id ? "is-on" : "")">@prod.Name</button>
          }
        </div>
      }

      <div class="fm-toolbar">
        <label class="fm-search"><Icon Name="Search" Size="17" />
          <input type="text" @bind="_searchQuery" @bind:event="oninput" placeholder="Search ingredients, compounds or benefits" aria-label="Search ingredients" />
          @if (!string.IsNullOrEmpty(_searchQuery)) { <button type="button" @onclick="() => _searchQuery = string.Empty">Clear</button> }
        </label>
        <div class="fm-pills" role="tablist">
          @foreach (var cat in Categories)
          {
            var c = cat;
            <button @key="c" @onclick="() => _selectedCategory = c" class="fm-pill @(_selectedCategory == c ? "is-on" : "")">@c@(c == "All" ? $" ({_ingredients.Count})" : "")</button>
          }
        </div>
      </div>

      <div class="fm-meta"><span>Showing @Filtered.Count of @_ingredients.Count ingredients</span><span>Batch standard · STAMIX-BP-2025</span></div>

      <div class="fm-table">
        <div class="fm-row fm-row-head">
          <div>Ingredient</div><div>Amount per serving</div><div>Extract / category</div><div>Purpose</div>
        </div>
        @foreach (var (item, i) in Filtered.Select((x, i) => (x, i)))
        {
          <div @key="item.Id" class="fm-row">
            <div class="fm-name">
              <span class="fm-no">@((i + 1).ToString("00"))</span>
              <div>
                <strong>@item.Name</strong>
                @if (!string.IsNullOrEmpty(item.BotanicalName)) { <em>@item.BotanicalName</em> }
                @if (!string.IsNullOrEmpty(item.ActiveCompound)) { <small>Active: @item.ActiveCompound</small> }
              </div>
            </div>
            <div class="fm-amt">
              <b>@item.Amount</b>
              <i><u style="width:@(Pct(item).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></u></i>
            </div>
            <div class="fm-cat">
              <span class="fm-tag">@(string.IsNullOrEmpty(item.ExtractRatio) ? "Standardized extract" : item.ExtractRatio)</span>
              @if (!string.IsNullOrEmpty(item.Category)) { <small>@item.Category</small> }
            </div>
            <div class="fm-purpose">@(string.IsNullOrWhiteSpace(item.Purpose) ? item.Benefit : item.Purpose)</div>
          </div>
        }
        @if (Filtered.Count == 0)
        {
          <div class="fm-empty">
            <Icon Name="FlaskConical" Size="34" />
            <p>No ingredients match "@_searchQuery".</p>
            <button @onclick="ResetFilters">Reset filters</button>
          </div>
        }
      </div>
    </div>
  </section></MobileSection>

  @* Principles *@
  <MobileSection Id="fm.principles"><section class="fm-section fm-light">
    <div class="fm-wrap">
      <header class="fm-head">
        <span class="fm-eyebrow">The science</span>
        <h2>Three principles behind <em>the formula</em></h2>
      </header>
      <div class="fm-cards">
        <article><span><Icon Name="Activity" Size="22" /></span><h3>Endothelial vasodilation</h3><p>L-Citrulline combined with Beetroot and Horny Goat Weed (Icariin) stimulates endothelial nitric oxide synthase (eNOS), increasing blood flow and smooth muscle relaxation.</p></article>
        <article><span><Icon Name="Zap" Size="22" /></span><h3>HPA axis &amp; cortisol balance</h3><p>Gold-standard KSM-66® Ashwagandha downregulates serum cortisol by up to 27.9%, shielding natural testosterone synthesis from stress-induced degradation.</p></article>
        <article><span><Icon Name="ShieldCheck" Size="22" /></span><h3>Enhanced bioavailability</h3><p>Patented BioPerine® black pepper extract inhibits intestinal glucuronidation, vastly amplifying the systemic absorption of herbal active compounds.</p></article>
      </div>
    </div>
  </section></MobileSection>

  @* Standards *@
  <MobileSection Id="fm.standards"><section class="fm-standards">
    <div class="fm-wrap">
      <div class="fm-std-grid">
        @for (var i = 0; i < Standards.Length; i++)
        {
          var s = Standards[i];
          <article data-nh-reveal style="--d:@(i * 100)ms"><span><Icon Name="@s.Icon" Size="22" /></span><div><strong>@s.Title</strong><small>@s.Text</small></div></article>
        }
      </div>
    </div>
  </section></MobileSection>

  @* FAQ *@
  <MobileSection Id="fm.faq"><section class="fm-faq">
    <div class="fm-wrap fm-faq-wrap">
      <header class="fm-head" data-nh-reveal>
        <span class="fm-eyebrow">Formulation questions</span>
        <h2>Answers, <em>in plain words</em></h2>
      </header>
      <div class="fm-faq-list" data-nh-reveal>
        @for (var i = 0; i < Faq.Length; i++)
        {
          var idx = i;
          <div class="fm-faq-item @(_faqOpen == idx ? "open" : "")">
            <button type="button" class="fm-faq-q" aria-expanded="@(_faqOpen == idx)" @onclick="() => _faqOpen = _faqOpen == idx ? -1 : idx">@Faq[idx].Q <i><Icon Name="Plus" Size="16" /></i></button>
            <div class="fm-faq-a"><div><p>@Faq[idx].A</p></div></div>
          </div>
        }
      </div>
      <p class="fm-faq-note">STAMIX is a food supplement, not a medicine. Speak to a healthcare professional if you are pregnant, nursing or taking medication.</p>
    </div>
  </section></MobileSection>

  @* CTA *@
  <MobileSection Id="fm.cta"><section class="fm-cta">
    <div class="fm-wrap fm-cta-inner">
      <div>
        <span class="fm-eyebrow"><Icon Name="Award" Size="14" /> Independent lab verification</span>
        <h2>View available batch lab reports</h2>
        <p>Review the Certificate of Analysis (COA) and laboratory results associated with a Stamix batch.</p>
      </div>
      <div class="fm-cta-actions">
        <button class="fm-btn fm-btn-line" @onclick="HandleVerify"><Icon Name="ShieldCheck" Size="16" /> Batch lab reports</button>
        <button class="fm-btn fm-btn-gold" @onclick="HandleShop"><Icon Name="ShoppingBag" Size="16" /> Shop STAMIX™ <Icon Name="ArrowRight" Size="16" /></button>
      </div>
    </div>
  </section></MobileSection>

</div>
<HomeFooter />
</div>

@code {
    private static double Mg(string? amount)
    {
        var digits = new string((amount ?? "").TakeWhile(ch => char.IsDigit(ch) || ch is ',' or '.' or ' ').Where(char.IsDigit).ToArray());
        return double.TryParse(digits, out var v) ? v : 0;
    }

    /// <summary>Bar length for an ingredient: its dose relative to the largest dose in the formula.</summary>
    private double Pct(FormulationIngredientDto item)
    {
        var max = _ingredients.Select(i => Mg(i.Amount)).DefaultIfEmpty(0).Max();
        return max <= 0 ? 0 : Math.Clamp(Mg(item.Amount) / max * 100, 3, 100);
    }

    private static readonly string[] Anchors = { "label", "clinical-data", "supplement-facts" };

    private int _faqOpen = 0;
    private sealed record Std(string Icon, string Title, string Text);
    private sealed record Qa(string Q, string A);
    private static readonly Std[] Standards =
    {
        new("Scale", "Full disclosure", "Every ingredient and its amount per serving is listed. Nothing is hidden in a blend."),
        new("FlaskConical", "Independently tested", "Third-party ICP-MS testing checks each batch for heavy metals and contaminants."),
        new("ShieldCheck", "Batch verified", "Use the batch code on your jar to check where and when it was made."),
        new("Leaf", "Whole botanicals", "Herbs, seeds and nuts used in whole-food form, with no synthetic fillers."),
    };
    private static readonly Qa[] Faq =
    {
        new("What is the daily serving?", "A daily serving is 20 g, taken as two level scoops (10 g twice a day). Stir into warm milk or water until smooth and follow the directions on your pack."),
        new("Do you use proprietary blends?", "No. The table above lists every ingredient with the exact amount in each daily serving, so you can see precisely what you are taking."),
        new("How is each batch checked?", "Each batch is tested by an independent laboratory using ICP-MS for heavy metals and contaminants. You can view the batch lab reports from this page or verify the batch code with our Trust Passport."),
        new("Why are some doses so much larger than others?", "The nuts and seeds form the nutritional base of the blend, so their weights are larger. Concentrated botanicals such as Shilajit are used in smaller amounts."),
        new("Where can I read the lab reports?", "Open the batch lab reports page, choose the batch printed on your jar and you will see its Certificate of Analysis."),
    };

    private List<FormulationIngredientDto> _all = DefaultIngredients();
    private List<ProductDto> _products = new();
    private string _productId = "";
    private string? DefaultProductId => _products.FirstOrDefault()?.Id;
    /// <summary>Ingredients of the selected product (legacy unassigned rows belong to the first product).</summary>
    private List<FormulationIngredientDto> _ingredients => _products.Count == 0
        ? _all
        : _all.Where(i => FormulationScope.Belongs(i, _productId, DefaultProductId)).ToList();
    private FormulationMetricsDto _metrics = new();
    private string _searchQuery = "";
    private string _selectedCategory = "All";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var ingTask = Api.GetIngredientsAsync();
            var metTask = Api.GetMetricsAsync();
            var ing = await ingTask;
            var met = await metTask;
            if (ing is { Count: > 0 }) _all = ing;
            if (met is not null) _metrics = met;
            try { _products = await Api.GetProductsAsync(); } catch { /* no product switcher offline */ }
            _productId = DefaultProductId ?? "";
        }
        catch
        {
            // keep the offline defaults
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Browser.SetMetaAsync(RouteMeta.Formulation);

        var uri = new Uri(Nav.Uri);
        var frag = uri.Fragment.TrimStart('#');
        if (Anchors.Contains(frag)) await Browser.ScrollToIdAsync(frag);
    }

    private List<string> Categories =>
        new[] { "All" }
            .Concat(_ingredients.Select(i => string.IsNullOrEmpty(i.Category) ? "Botanical" : i.Category).Distinct())
            .ToList();

    private List<FormulationIngredientDto> Filtered
    {
        get
        {
            var q = _searchQuery?.Trim() ?? "";
            return _ingredients.Where(item =>
            {
                var matchesCategory = _selectedCategory == "All" || item.Category == _selectedCategory;
                var matchesSearch = q.Length == 0
                    || Has(item.Name, _searchQuery!)
                    || Has(item.BotanicalName, _searchQuery!)
                    || Has(item.Purpose, _searchQuery!) || Has(item.Benefit, _searchQuery!)
                    || Has(item.Category, _searchQuery!)
                    || Has(item.ActiveCompound, _searchQuery!);
                return matchesCategory && matchesSearch;
            }).ToList();
        }
    }

    private static bool Has(string? source, string term) =>
        !string.IsNullOrEmpty(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private string ServingMain
    {
        get
        {
            var v = _metrics.DailyServing?.Value;
            return string.IsNullOrEmpty(v) ? "20,000 mg" : System.Text.RegularExpressions.Regex.Replace(v, @"\s*\(.*?\)", "", System.Text.RegularExpressions.RegexOptions.None, TimeSpan.FromSeconds(1)).Trim();
        }
    }

    private string ServingSub
    {
        get
        {
            var v = _metrics.DailyServing?.Value;
            if (!string.IsNullOrEmpty(v) && v.Contains('('))
            {
                var m = System.Text.RegularExpressions.Regex.Match(v, @"\((.*?)\)");
                if (m.Success) return m.Groups[1].Value;
            }
            return "2 scoops (10g twice daily)";
        }
    }

    private string TotalIngredientsText
    {
        get
        {
            var auto = $"{_ingredients.Count} Botanicals";
            var t = _metrics.TotalIngredients;
            if (t is null || t.UseAutoCount) return auto;
            return string.IsNullOrEmpty(t.Value) ? auto : t.Value;
        }
    }

    private static string CategoryBadge(string category) =>
        category.Contains("Nitric") ? "bg-amber-950/40 text-amber-300 border border-amber-500/20" :
        category.Contains("Adaptogen") ? "bg-purple-950/40 text-purple-300 border border-purple-500/20" :
        category.Contains("Vitality") ? "bg-rose-950/40 text-rose-300 border border-rose-500/20" :
        "bg-zinc-800/60 text-zinc-300 border border-zinc-700/40";

    private void SelectProduct(string id) { _productId = id; _selectedCategory = "All"; _searchQuery = ""; }

    private void ResetFilters() { _searchQuery = ""; _selectedCategory = "All"; }

    private async Task HandleBack() { Nav.NavigateTo("/"); await Browser.ScrollToTopAsync(); }
    private async Task HandleShop() { Nav.NavigateTo("/shop"); await Browser.ScrollToTopAsync(); }
    private async Task HandleVerify() { Nav.NavigateTo("/quality-reports"); await Browser.ScrollToTopAsync(); }

    private static FormulationIngredientDto I(string id, string name, string botanical, string amount, string category, string benefit) =>
        new() { Id = id, Name = name, BotanicalName = botanical, Amount = amount, Category = category, Benefit = benefit };

    private static List<FormulationIngredientDto> DefaultIngredients() => new()
    {
        I("ing-1", "Ashwagandha", "Withania somnifera (Root)", "1,500 mg", "Adaptogen & Vigor", "Supports adrenal resilience, reduces serum cortisol, and boosts stamina."),
        I("ing-2", "Purified Himalayan Shilajit", "Asphaltum punjabianum (Exudate)", "500 mg", "Bioactive Minerals", "Contains >50% Fulvic Acid; accelerates mitochondrial ATP cellular energy."),
        I("ing-3", "Safed Musli", "Chlorophytum borivilianum (Tuber)", "1,200 mg", "Strength & Vitality", "Rich in natural saponins to support male reproductive vitality and physical vigor."),
        I("ing-4", "Gokshura (Tribulus)", "Tribulus terrestris (Fruit)", "1,000 mg", "Hormonal Balance", "Standardized to protodioscin to optimize nitric oxide and free testosterone."),
        I("ing-5", "Kaunch Beej", "Mucuna pruriens (Seed)", "1,000 mg", "Neuro-Endocrine", "Natural L-DOPA precursor promoting dopamine, drive, and peak physical performance."),
        I("ing-6", "Shatavari", "Asparagus racemosus (Root)", "800 mg", "Cellular Nourishment", "Rasayana rejuvenator that enhances tissue recovery and oxidative defense."),
        I("ing-7", "Vidarikand", "Pueraria tuberosa (Tuber)", "750 mg", "Endurance & Bulk", "Supports healthy lean muscle tone and replenishes depleted vital fluids."),
        I("ing-8", "Akarkara", "Anacyclus pyrethrum (Root)", "400 mg", "Nerve & Microcirculation", "Enhances nervous system response, libido, and vascular blood flow."),
        I("ing-9", "Jaiphal (Nutmeg)", "Myristica fragrans (Seed)", "250 mg", "Restorative Synergy", "Aromatic therapeutic compound supporting deep neuromuscular relaxation."),
        I("ing-10", "Elaichi (Green Cardamom)", "Elettaria cardamomum (Pod)", "300 mg", "Bioavailability Enhancer", "Improves digestion, cellular uptake, and nutrient bioavailability."),
        I("ing-11", "Dalchini (Ceylon Cinnamon)", "Cinnamomum verum (Bark)", "300 mg", "Metabolic Support", "Supports healthy insulin sensitivity and blood glucose metabolism."),
        I("ing-12", "California Almond Powder", "Prunus dulcis (Whole Nut)", "4,000 mg", "Nuts & Seed Matrix", "Plant protein, healthy monosaturated lipids, and bioavailable Vitamin E."),
        I("ing-13", "Kashmiri Walnut Kernel", "Juglans regia (Nut)", "3,000 mg", "Nuts & Seed Matrix", "High-density plant Omega-3 ALA fatty acids for cardiovascular and brain health."),
        I("ing-14", "Pistachio Matrix", "Pistacia vera (Nut)", "2,000 mg", "Nuts & Seed Matrix", "Potassium, lutein, and amino acids for sustained stamina output."),
        I("ing-15", "Watermelon Seed Extract", "Citrullus lanatus (Seed)", "1,000 mg", "Nuts & Seed Matrix", "Naturally rich in L-Citrulline, promoting healthy arterial vasodilation."),
        I("ing-16", "Pumpkin Seed Protein", "Cucurbita pepo (Seed)", "1,000 mg", "Trace Mineral Zinc", "Rich bioavailable zinc and magnesium crucial for prostate and hormone synthesis."),
        I("ing-17", "Sunflower & Sesame Meal", "Helianthus annuus & Sesamum indicum", "1,000 mg", "Nuts & Seed Matrix", "Provides structural lignans, calcium, and complete amino acid profile."),
    };
}
