@page "/terms"
@page "/terms-and-conditions"
@using Nuraherbex.UI.Components.Policy

<PageTitle>Terms & Conditions — Nura Herbex</PageTitle>

<PolicyPage Slug="terms" Title="Terms & Conditions" IconName="FileText" Eyebrow="Legal"
            Intro="These terms govern your use of the Nura Herbex website and app and every order you place with us. Please read them carefully — by browsing or buying, you agree to be bound by them."
