@page "/"
@inject BrowserInterop Browser

<main class="w-full relative hm-home">
  <HomeHero />
  <HomeTrustBar />
  <HomeProducts />
  <HomeSpotlight />
  <HomeIngredients />
  <HomeVideoFeature />
  <HomeSteps />
  <HomeReviews />
  <StamixAssistant />
