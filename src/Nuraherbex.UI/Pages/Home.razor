@page "/"
@using Nuraherbex.UI.Components.Home
@inject BrowserInterop Browser

<PageTitle>Nura Herbex — Better Digestion, Brighter Living | Ayurvedic Wellness</PageTitle>

<div class="nh-storefront">
    <MobileSection Id="home.announce"><HomeAnnouncementBar /></MobileSection>
    <HomeNavbar />
    <MobileSection Id="home.hero"><HomeHeroSection /></MobileSection>
    <MobileSection Id="home.benefits"><HomeBenefitsBar /></MobileSection>
    <MobileSection Id="home.featured"><HomeFeaturedProducts /></MobileSection>
    <MobileSection Id="home.stamina"><HomeStaminaPower /></MobileSection>
    <MobileSection Id="home.stats"><HomeStatsStrip /></MobileSection>
    <MobileSection Id="home.why"><HomeWhyChoose /></MobileSection>
    <MobileSection Id="home.goals"><HomeWellnessGoals /></MobileSection>
    <MobileSection Id="home.ingredients"><HomeIngredientSpotlight /></MobileSection>
    <MobileSection Id="home.bundles"><HomeBundles /></MobileSection>
    <MobileSection Id="home.reviews"><HomeReviewsSection /></MobileSection>
    <MobileSection Id="home.story"><HomeOurStory /></MobileSection>
    <MobileSection Id="home.perks"><HomePerks /></MobileSection>
    <MobileSection Id="home.faq"><HomeFaq /></MobileSection>
    <HomeNewsletterFooter />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.SetMetaAsync(RouteMeta.Home);
    }
}
