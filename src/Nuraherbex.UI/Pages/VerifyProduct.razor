@page "/quality-reports"
@page "/quality-reports/{BatchNo?}"
@page "/trust-passport"
@page "/trust-passport/{BatchNo?}"
@page "/verify"
@page "/verify-product"
@page "/verify-batch"
@using Nuraherbex.UI.Components.Verify
@using Nuraherbex.UI.Components.Home
@inject ApiClient Api
@inject NavigationManager Nav
@inject BrowserInterop Browser

@{
    var batch = ActiveBatch;
}

<div class="nh-storefront tp-shell">
<HomeNavbar />

<main class="tp-page">
    <img class="tp-leaf tp-leaf-r" src="_content/Nuraherbex.UI/images/leaf-sprig-right.png" alt="" aria-hidden="true" />
    <img class="tp-leaf tp-leaf-l" src="_content/Nuraherbex.UI/images/leaf-sprig-left.png" alt="" aria-hidden="true" />

    @if (batch is null)
    {
        <section class="tp-hero">
            <span class="tp-badge"><Icon Name="ShieldCheck" Size="30" /></span>
            <h1>Trust Passport</h1>
            <p class="tp-tag">Verify your product. Build your trust.</p>
            <i class="tp-rule" aria-hidden="true"></i>
            <p class="tp-sub">Enter your product's batch number to view lab test reports and certifications.</p>
        </section>

        <section class="tp-card tp-entry" aria-labelledby="tp-enter">
            <div class="tp-entry-head">
                <span class="tp-entry-ic"><Icon Name="Scan" Size="26" /></span>
                <div>
                    <h2 id="tp-enter">Enter Batch Number</h2>
                    <p>Find the batch number on your product packaging and enter it below.</p>
                </div>
            </div>
            <form @onsubmit="HandleSearch" @onsubmit:preventDefault>
                <label class="tp-input">
                    <input @ref="_searchInput" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" placeholder="e.g. NHB240801" aria-label="Batch number"
                           @bind="_searchText" @bind:event="oninput" />
                    <Icon Name="Tag" Size="24" />
                </label>
                <button type="submit" class="tp-btn tp-btn-solid">Verify Batch <Icon Name="ArrowRight" Size="18" /></button>
            </form>
            @if (!string.IsNullOrEmpty(_feedback)) { <p role="status" class="@($"tp-feedback {(_feedback.StartsWith("✓") ? "ok" : "bad")}")">@_feedback</p> }
            <div class="tp-or"><span>OR</span></div>
            <a class="tp-btn tp-btn-ghost" href="@RequestMailto"><Icon Name="Mail" Size="18" /> Request Batch Number <Icon Name="ChevronRight" Size="16" /></a>

            <button type="button" class="tp-help" aria-expanded="@_helpOpen" @onclick="() => _helpOpen = !_helpOpen">
                <Icon Name="Info" Size="22" /> <span>Where to find the batch number?</span> <Icon Name="ChevronDown" Size="18" Class="@(_helpOpen ? "tp-flip" : "")" />
            </button>
            @if (_helpOpen)
            {
                <p class="tp-help-body">Look at the base or the side label of your jar. The batch number is printed next to the manufacturing and expiry dates.</p>
            }
        </section>

        @if (_batches.Count > 0)
        {
            <div class="tp-chips"><span>Recent batches</span>
                @foreach (var b in _batches.Take(6))
                {
                    var no = BatchLabel(b);
                    <button type="button" @key="no" @onclick="() => SelectQuickBatch(no)">#@no</button>
                }
            </div>
        }

        <div class="tp-products" aria-hidden="true">
            <img src="_content/Nuraherbex.UI/images/product-gut365.png" alt="" />
            <img src="_content/Nuraherbex.UI/images/product-stamix.png" alt="" />
            <p class="tp-script">Pure<br />Nature<br />Real Results</p>
        </div>
    }
    else
    {
        <nav class="tp-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/trust-passport" @onclick="VerifyAnotherAsync" @onclick:preventDefault>Trust Passport</a><span>›</span><strong>Batch Results</strong></nav>

        <section class="tp-hero tp-hero-ok">
            <span class="tp-badge tp-badge-ok"><Icon Name="Check" Size="32" StrokeWidth="3" /></span>
            <h1>Batch Verified</h1>
            <p class="tp-sub">Here are your product details, lab test report and certifications for this batch.</p>
        </section>

        <section class="tp-card tp-product">
            <img src="@ProductImage(batch)" alt="@batch.ProductName" />
            <div>
                <h2>@(string.IsNullOrWhiteSpace(batch.ProductName) ? "Nura Herbex" : batch.ProductName)</h2>
                <p class="tp-prod-sub">@ProductSubtitle(batch)</p>
                <dl>
                    <div><dt>Batch No.</dt><dd>@BatchLabel(batch)</dd></div>
                    <div><dt>Mfg. Date</dt><dd>@batch.MfgDate</dd></div>
                    <div><dt>Expiry Date</dt><dd>@batch.ExpDate</dd></div>
                    <div><dt>Pack Size</dt><dd>@batch.PackSize</dd></div>
                </dl>
            </div>
        </section>

        <section class="tp-card">
            <div class="tp-sec-head">
                <span class="tp-sec-ic"><Icon Name="FileText" Size="24" /></span>
                <div><h3>Lab Test Report (This Batch)</h3><p>Third-party lab test report for this specific batch number@(string.IsNullOrWhiteSpace(batch.LabName) ? "." : $" · {batch.LabName}.")</p></div>
            </div>
            @if (!string.IsNullOrEmpty(batch.DocumentUrl))
            {
                <a class="tp-file" href="@batch.DocumentUrl" download="@FileName(batch)" aria-label="Download lab report">
                    <span class="tp-file-badge">@(IsPdf(batch) ? "PDF" : "IMG")</span>
                    <span><strong>@FileName(batch)</strong><small>@(string.IsNullOrWhiteSpace(batch.FileSize) ? "" : batch.FileSize + " • ")@(IsPdf(batch) ? "PDF" : "Image")</small></span>
                    <Icon Name="Download" Size="22" />
                </a>
                <a class="tp-btn tp-btn-ghost" href="@batch.DocumentUrl" target="_blank" rel="noopener noreferrer"><Icon Name="Eye" Size="20" /> View Lab Report</a>
            }
            else { <p class="tp-none">The lab report for this batch has not been uploaded yet.</p> }
            @if (!string.IsNullOrWhiteSpace(batch.Notes)) { <p class="tp-note">@batch.Notes</p> }
        </section>

        var productCerts = Certs(batch, "product"); var brandCerts = Certs(batch, "brand");
        @if (productCerts.Count > 0)
        {
            <section class="tp-card">
                <div class="tp-sec-head">
                    <span class="tp-sec-ic"><Icon Name="ShieldCheck" Size="24" /></span>
                    <div><h3>Product Certifications</h3><p>Certifications specific to @(string.IsNullOrWhiteSpace(batch.ProductName) ? "this product" : batch.ProductName).</p></div>
                </div>
                <div class="tp-certs">@foreach (var c in productCerts) { <TrustCert Doc="c" /> }</div>
            </section>
        }
        @if (brandCerts.Count > 0)
        {
            <section class="tp-card">
                <div class="tp-sec-head">
                    <span class="tp-sec-ic"><Icon Name="Building2" Size="24" /></span>
                    <div><h3>Brand &amp; Manufacturing Certifications</h3><p>Our manufacturing facility and brand certifications.</p></div>
                </div>
                <div class="tp-certs">@foreach (var c in brandCerts) { <TrustCert Doc="c" /> }</div>
            </section>
        }

        <button type="button" class="tp-btn tp-btn-solid tp-again" @onclick="VerifyAnotherAsync"><Icon Name="Search" Size="18" /> Verify another batch</button>
    }
</main>

<HomeFooter />
</div>

@code {
    private bool _helpOpen;
    private string RequestMailto => "mailto:care@nuraherbex.com?subject=" + Uri.EscapeDataString("Batch number request") + "&body=" + Uri.EscapeDataString("Hello, I would like to verify my product. Product name and order number: ");
    private static List<BatchDocumentDto> Certs(TrustBatchDto b, string kind) => b.Documents.Where(d => string.Equals(d.Kind, kind, StringComparison.OrdinalIgnoreCase)).ToList();
    private static bool IsGut(TrustBatchDto b) => (b.ProductName ?? "").Contains("GUT", StringComparison.OrdinalIgnoreCase);
    private static string ProductImage(TrustBatchDto b) => "_content/Nuraherbex.UI/images/" + (IsGut(b) ? "product-gut365.png" : "product-stamix.png");
    private static string ProductSubtitle(TrustBatchDto b) => IsGut(b) ? "Digestive Health & Gut Support" : "Men's Wellness Support";
    private static string FileName(TrustBatchDto b) => string.IsNullOrWhiteSpace(b.DocumentName) ? $"{BatchLabel(b)}_Lab_Report" : b.DocumentName!;

    [Parameter] public string? BatchNo { get; set; }
    [SupplyParameterFromQuery(Name = "batch")] public string? QBatch { get; set; }
    [SupplyParameterFromQuery(Name = "batch_no")] public string? QBatchNo { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? QId { get; set; }

    private List<TrustBatchDto> _batches = new();
    private string _activeBatchNo = "";
    private string _searchText = "";
    private string _feedback = "";
    private ElementReference _searchInput;
    private bool _loaded;
    private string? _lastRequested;
    private int _feedbackToken;

    private static string BatchLabel(TrustBatchDto b) => string.IsNullOrEmpty(b.BatchNo) ? b.Id : b.BatchNo;
    private static bool IsPdf(TrustBatchDto b) => string.Equals(b.DocumentType, "pdf", StringComparison.OrdinalIgnoreCase) || b.DocumentUrl?.StartsWith("data:application/pdf", StringComparison.OrdinalIgnoreCase) == true;

    private TrustBatchDto? ActiveBatch => string.IsNullOrEmpty(_activeBatchNo)
        ? null
        : _batches.FirstOrDefault(b => string.Equals(BatchLabel(b), _activeBatchNo, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _batches = (await Api.GetBatchesAsync()).Where(b => b.IsActive).ToList();
        _loaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        var requested = FirstNonEmpty(BatchNo, QBatch, QBatchNo, QId);
        if (!_loaded) { _batches = (await Api.GetBatchesAsync()).Where(b => b.IsActive).ToList(); _loaded = true; }
        if (requested == _lastRequested) return;
        _lastRequested = requested;
        if (string.IsNullOrEmpty(requested)) return;

        var found = await FindAsync(requested);
        if (found is not null)
        {
            _activeBatchNo = BatchLabel(found);
            _searchText = _activeBatchNo;
        }
        else
        {
            _searchText = requested;
        }
    }

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim();

    /// <summary>Looks the batch up in the loaded registry, falling back to the single-batch API endpoint.</summary>
    private async Task<TrustBatchDto?> FindAsync(string batchNo)
    {
        var local = _batches.FirstOrDefault(b => string.Equals(BatchLabel(b), batchNo, StringComparison.OrdinalIgnoreCase));
        if (local is not null) return local;
        var res = await Api.GetBatchAsync(batchNo);
        if (res.Success && res.Batch is not null && res.Batch.IsActive)
        {
            _batches.Add(res.Batch);
            return res.Batch;
        }
        return null;
    }

    private async Task HandleSearch()
    {
        var clean = (_searchText ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(clean))
        {
            await ShowFeedback("Please enter a batch number from your canister or jar.", 4000);
            return;
        }

        var found = await FindAsync(clean);
        if (found is not null)
        {
            _activeBatchNo = BatchLabel(found);
            await ShowFeedback($"✓ Batch {_activeBatchNo} verified authentic", 4000);
        }
        else
        {
            _activeBatchNo = "";
            await ShowFeedback($"Batch \"{clean}\" not found in manufacturing records. Please check the code on your jar.", 6000);
        }
    }

    private async Task SelectQuickBatch(string bNo)
    {
        _searchText = bNo;
        _activeBatchNo = bNo;
        await ShowFeedback($"✓ Batch {bNo} loaded from registry", 3000);
    }

    private async Task ShowFeedback(string msg, int ms)
    {
        var token = ++_feedbackToken;
        _feedback = msg;
        StateHasChanged();
        await Task.Delay(ms);
        if (token == _feedbackToken) { _feedback = ""; StateHasChanged(); }
    }

    private async Task VerifyAnotherAsync()
    {
        _activeBatchNo = "";
        _searchText = "";
        _lastRequested = null;
        Nav.NavigateTo("/quality-reports", replace: true);
        try { await _searchInput.FocusAsync(); } catch { }
    }

    private async Task HandleBack()
    {
        Nav.NavigateTo("/shop");
        await Browser.ScrollToTopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.SetMetaAsync(RouteMeta.QualityReports);
    }
}
