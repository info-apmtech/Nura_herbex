@page "/account"
@page "/account/reviews"
@page "/my-account"
@page "/profile"
@using Nuraherbex.UI.Components.Account
@using Nuraherbex.UI.Components.Home
@implements IDisposable
@inject AuthState Auth
@inject BrowserInterop Browser

<HeadContent>
    <link rel="stylesheet" href="_content/Nuraherbex.UI/css/account.css" />
</HeadContent>

@if (Auth.IsLoading)
{
    <div class="nh-storefront au-loading">
        <div><Icon Name="RefreshCw" Size="22" Class="animate-spin" /><span>Restoring your session...</span></div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <AccountSignedOut />
}
else
{
    <div class="nh-storefront">
        <HomeNavbar />
        <AccountDashboard />
        <HomeFooter />
    </div>
}

@code {
    protected override void OnInitialized() { Auth.Changed += OnChanged; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.SetMetaAsync(RouteMeta.Account);
    }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;
}
