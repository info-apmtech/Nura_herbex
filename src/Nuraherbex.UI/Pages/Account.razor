@page "/account"
@page "/account/reviews"
@page "/my-account"
@page "/profile"
@using Nuraherbex.UI.Components.Account
@implements IDisposable
@inject AuthState Auth
@inject BrowserInterop Browser

<HeadContent>
    <link rel="stylesheet" href="_content/Nuraherbex.UI/css/account.css" />
</HeadContent>

@if (Auth.IsLoading)
{
    <div class="customer-account-loading min-h-screen text-slate-100 font-sans antialiased pt-24 pb-16 px-4 flex items-center justify-center">
        <div class="text-center space-y-4">
            <div class="relative w-16 h-16 mx-auto">
                <div class="absolute inset-0 rounded-2xl bg-[#9929ea]/20 border border-[#9929ea]/40"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <Icon Name="RefreshCw" Size="22" Class="animate-spin text-[#fff3bf]" />
                </div>
            </div>
            <div class="text-[11px] font-mono uppercase tracking-[0.25em] text-slate-500">Restoring your session...</div>
        </div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <AccountSignedOut />
}
else
{
    <AccountDashboard />
}

@code {
    protected override void OnInitialized() { Auth.Changed += OnChanged; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.SetMetaAsync(RouteMeta.Account);
    }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.Changed -= OnChanged;
}
