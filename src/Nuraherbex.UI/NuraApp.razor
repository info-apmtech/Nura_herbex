@* Root of the shared UI. Hosted by Nuraherbex.Web (WebAssembly) and Nuraherbex.Maui (Blazor Hybrid). *@
<Router AppAssembly="typeof(NuraApp).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(StoreLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(StoreLayout)">
            <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 pt-32 pb-24">
                <p class="text-xs font-bold uppercase tracking-[0.3em] text-purple-400 mb-4">Error 404</p>
                <h1 class="font-display text-4xl sm:text-5xl text-white mb-4">This page doesn't exist</h1>
                <p class="text-slate-400 max-w-md mb-8">The page you're looking for has moved or never existed. Head back to the store.</p>
                <a href="/" class="inline-flex items-center px-8 py-3 rounded-full bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm tracking-widest uppercase transition-colors">Back to Home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
